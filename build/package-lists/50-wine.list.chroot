# DevOS Windows Compatibility & Gaming Package List (Phase 3)
# Wine Staging, Vulkan DXVK translation, and GameMode

# Wine & 32-bit Architecture Support
wine
wine64
# 32-bit Windows programs (most installers, e.g. AnyDesk). Needs the i386
# architecture, which build-iso.sh enables before installing packages.
wine32:i386
winetricks

# Vulkan & DirectX Translation Libraries
libvulkan1
mesa-vulkan-drivers
vulkan-tools

# Performance & Process Boosters
gamemode
mangohud

# Sandbox & Container Isolation
bubblewrap
firejail
cabextract
p7zip-full
unzip
