# DevOS Hardware, Drivers, Audio & Network Package List
# Comprehensive driver and peripheral hardware support for modern laptops and desktops

# 1. Firmware and CPU Microcode
linux-firmware
intel-microcode
amd64-microcode
firmware-sof-signed
thermald
fwupd
mokutil
lm-sensors
pciutils
usbutils

# 2. Graphics, Display, and Video Acceleration
mesa-vulkan-drivers
mesa-libgallium
libvulkan1
vulkan-tools
intel-media-va-driver
vainfo
brightnessctl
ddcutil

# 3. GPU Proprietary Driver Detection / Management
ubuntu-drivers-common

# 4. Networking, Wi-Fi & Ethernet
network-manager
systemd-resolved
netplan.io
wpasupplicant
wireless-regdb
iw
iw
ethtool
iproute2
net-tools
rfkill

# 5. Bluetooth & Wireless Audio Codecs
bluez
bluez-tools
libspa-0.2-bluetooth

# 6. Audio & Sound Subsystem (PipeWire + WirePlumber)
pipewire
pipewire-alsa
pipewire-pulse
pipewire-audio
wireplumber
alsa-utils
plasma-pa
pavucontrol-qt

# 6b. Camera (always-on OS basic — not an installer Features checkbox)
