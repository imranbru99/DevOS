#!/bin/bash
# 02-disable-services.hook.chroot - Optimize startup time by disabling bloat services
set -euo pipefail

echo "==> Running DevOS 02-disable-services hook..."

# 1. Disable / Mask unneeded systemd services
# Printer discovery stays off at boot (local CUPS on demand). ModemManager
# stays masked: it delays boot on PCs with no mobile modem.
SERVICES_TO_MASK=(
    "ModemManager.service"
    "apport.service"
    "whoopsie.service"
    "motd-news.service"
    "motd-news.timer"
    "snapd.service"
    "snapd.socket"
    "snapd.seeded.service"
    "dnsmasq.service"
    "NetworkManager-wait-online.service"
    # File indexer burns RAM for little gain; Start search still works without it.
    "kde-baloo.service"
    "baloo_file.service"
    # Always-on mDNS / printer browse tax; enable from Print settings if needed.
    "cups-browsed.service"
    "avahi-daemon.service"
    "avahi-daemon.socket"
)

for svc in "${SERVICES_TO_MASK[@]}"; do
    if systemctl list-unit-files | grep -q "^${svc}"; then
        echo "Masking ${svc}..."
        systemctl mask "${svc}" || true
    fi
done
# Ensure NetworkManager-wait-online does not stall boot even when masked in chroot
ln -sfn /dev/null /etc/systemd/system/NetworkManager-wait-online.service

# Developer databases / caches should start on-demand, not stall OS boot
for db_svc in postgresql mariadb mysql redis-server redis php8.5-fpm php8.4-fpm php8.3-fpm php-fpm; do
    systemctl disable "${db_svc}" 2>/dev/null || true
done
ln -sfn /dev/null /etc/systemd/system/redis-server.service 2>/dev/null || true
ln -sfn /dev/null /etc/systemd/system/redis.service 2>/dev/null || true
# dnsmasq and systemd-resolved both want port 53. Keep resolved, and mask
# dnsmasq even when systemctl cannot see the unit inside the build chroot.
ln -sfn /dev/null /etc/systemd/system/dnsmasq.service
# A live USB has no containers. These units print a red FAILED line and
# make the boot look like the installer crashed.
for svc in podman-auto-update.service podman-auto-update.timer podman-restart.service; do
    ln -sfn /dev/null "/etc/systemd/system/${svc}"
done

# 2. Block snapd completely via APT pinning
cat << 'EOF' > /etc/apt/preferences.d/nosnap.pref
Package: snapd
Pin: release *
Pin-Priority: -10
EOF

# 3. Enable fstrim.timer for SSD health
systemctl enable fstrim.timer || true
systemctl enable snapper-cleanup.timer || true

# NetworkManager owns Ethernet and Wi-Fi. A masked networkd cannot take the cable.
systemctl enable NetworkManager.service || true
systemctl enable systemd-resolved.service || true
systemctl mask systemd-networkd.service systemd-networkd.socket systemd-networkd-wait-online.service || true
# systemctl enable can fail in a chroot. Write the boot links directly so
# name lookup and the cable bring-up still start after install.
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sfn /etc/systemd/system/devos-network.service \
    /etc/systemd/system/multi-user.target.wants/devos-network.service
# Measures RAM/CPU/disk for the installer's "Choose your DevOS AI" page.
ln -sfn /etc/systemd/system/devos-ai-hwprobe.service \
    /etc/systemd/system/multi-user.target.wants/devos-ai-hwprobe.service
for unit in systemd-resolved.service NetworkManager.service; do
    if [ -f "/usr/lib/systemd/system/${unit}" ]; then
        ln -sfn "/usr/lib/systemd/system/${unit}" \
            "/etc/systemd/system/multi-user.target.wants/${unit}"
    elif [ -f "/lib/systemd/system/${unit}" ]; then
        ln -sfn "/lib/systemd/system/${unit}" \
            "/etc/systemd/system/multi-user.target.wants/${unit}"
    fi
done
# The image build copies the builder DNS (often 127.0.0.11) over this file.
# Leave the stub symlink so a connected cable can resolve names.
rm -f /etc/resolv.conf
ln -s ../run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
chmod 755 /etc/NetworkManager/dispatcher.d/99-devos-dns || true
systemctl enable bluetooth.service || true
# Keep printer discovery off by default (masked above). Local printing via
# cups.socket / Print Manager still works when the user prints.
systemctl disable cups-browsed.service avahi-daemon.service 2>/dev/null || true
systemctl enable cups.socket 2>/dev/null || true
chmod 755 /usr/local/sbin/devos-snapshot-pre-upgrade || true
systemctl enable devos-rfkill.service || true
systemctl enable devos-network.service || true
chmod 600 /etc/NetworkManager/system-connections/devos-ethernet.nmconnection || true
chmod 600 /etc/netplan/01-network-manager-all.yaml || true
# SDDM refuses the installer session when this script is not executable.
chmod 755 \
    /usr/local/bin/devos-live-session \
    /usr/local/bin/devos-session \
    /usr/local/bin/devos-browser \
    /usr/local/bin/devos-install-gui \
    /usr/local/sbin/devos-bring-up-network \
    /usr/local/sbin/devos-install-finalize \
    /usr/local/sbin/devos-postinstall-deferred \
    /usr/local/sbin/devos-set-boot-order \
    /usr/local/sbin/devos-force-installer-session \
    /usr/local/sbin/devos-chrome-tune \
    || true

# Live admin can start the installer without a password prompt.
cat > /etc/sudoers.d/devos << 'EOF'
devos ALL=(ALL) NOPASSWD:SETENV: ALL
%sudo ALL=(ALL) NOPASSWD:SETENV: ALL
EOF
chown root:root /etc/sudoers.d/devos
chmod 440 /etc/sudoers.d/devos
chmod 755 /usr/local/bin/dolphin /usr/local/bin/devos-files /usr/local/bin/devos-apps \
    /usr/local/bin/devos-ai-code-agent /usr/local/bin/devos-code-agent /usr/local/bin/devos-antigravity \
    /usr/local/bin/devos-taskman /usr/local/bin/devos-power /usr/local/bin/devos-network-usage \
    /usr/local/bin/devos-about /usr/local/bin/kinfocenter /usr/local/bin/devos-profile \
    /usr/local/bin/devos-resources || true
# App history for Task Manager, for every account.
mkdir -p /etc/systemd/user/timers.target.wants
ln -sfn /usr/lib/systemd/user/devos-taskman-history.timer \
    /etc/systemd/user/timers.target.wants/devos-taskman-history.timer
# Network Usage daily counters (12-month retention) for every account.
ln -sfn /usr/lib/systemd/user/devos-network-usage.timer \
    /etc/systemd/user/timers.target.wants/devos-network-usage.timer

# 4. Status page stays off the live USB. The installer session is forced first.
systemctl enable devos-dashboard.service || true
systemctl enable devos-force-installer.service || true
mkdir -p /etc/systemd/system/sddm.service.wants /etc/systemd/system/multi-user.target.wants
ln -sfn /etc/systemd/system/devos-force-installer.service \
    /etc/systemd/system/sddm.service.wants/devos-force-installer.service
ln -sfn /etc/systemd/system/devos-force-installer.service \
    /etc/systemd/system/multi-user.target.wants/devos-force-installer.service

# 5. Local AI used by DevOS Code. It listens only on this computer.
systemctl enable devos-ai-core.service || true
# Multi-day AI coding agents (24–72h): keep sleep inhibited while they run.
mkdir -p /etc/systemd/user/graphical-session.target.wants
ln -sfn /etc/systemd/user/devos-agent-endurance.service \
    /etc/systemd/user/graphical-session.target.wants/devos-agent-endurance.service
systemctl --global enable devos-agent-endurance.service 2>/dev/null || true

# Ubuntu's installer must not be available. DevOS uses Calamares only.
apt-get purge -y ubuntu-desktop-bootstrap ubuntu-desktop-installer ubiquity ubiquity-frontend-gtk gnome-initial-setup subiquity subiquity-server curtin >/dev/null 2>&1 || true
systemctl mask ubuntu-desktop-bootstrap.service subiquity.service 2>/dev/null || true
rm -f \
    /etc/xdg/autostart/ubuntu-desktop-bootstrap.desktop \
    /etc/xdg/autostart/ubiquity.desktop \
    /etc/xdg/autostart/org.gnome.InitialSetup.desktop \
    /usr/share/applications/ubuntu-desktop-bootstrap.desktop \
    /var/lib/snapd/desktop/applications/ubuntu-desktop-bootstrap.desktop \
    2>/dev/null || true

# App source for native DevOS versions of Windows apps (AnyDesk, Zoom...).
# devos-open-app also adds it per user, so a failed download here is fine.
flatpak remote-add --system --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo >/dev/null 2>&1 || true
# Apps chosen in the installer arrive as Flatpaks after first sign-in. KDE only
# watches menu folders that exist when the session starts, so create them now.
mkdir -p /var/lib/flatpak/exports/share/applications /var/lib/flatpak/exports/share/icons

echo "==> DevOS 02-disable-services hook completed."
