#!/bin/bash
# 01-strip-bloat.hook.chroot - Remove non-essential files to keep ISO <= 4GB
set -euo pipefail

echo "==> Running DevOS 01-strip-bloat hook..."

# 1. Remove documentation, manuals, and groff files
rm -rf /usr/share/doc/*
rm -rf /usr/share/man/*
rm -rf /usr/share/info/*
rm -rf /usr/share/lintian/*
rm -rf /usr/share/linda/*
rm -rf /usr/share/bug/*

# 2. Re-create essential copyright directories if needed by packaging guidelines
mkdir -p /usr/share/doc

# 3. Keep only the newest kernel. Upgrades in a reused chroot left two
# (image, modules, extra modules, headers: ~300 MB) and the ISO hit 4 GB.
latest="$(ls -1 /boot/vmlinuz-* 2>/dev/null | sort -V | tail -n 1 | sed 's#.*/vmlinuz-##; s#-generic$##')"
if [ -n "$latest" ]; then
    old_kernels="$(dpkg-query -W -f='${Package}\n' 'linux-image-[0-9]*' 'linux-modules-[0-9]*' \
        'linux-modules-extra-[0-9]*' 'linux-headers-[0-9]*' 'linux-tools-[0-9]*' 2>/dev/null \
        | grep -v -- "-${latest}" || true)"
    if [ -n "$old_kernels" ]; then
        echo "Removing old kernels (keeping ${latest}): ${old_kernels}"
        # shellcheck disable=SC2086
        apt-get purge -y $old_kernels || true
    fi
fi

# 4. Clean Apt and temporary directories
apt-get autoremove --purge -y || true
apt-get clean
rm -rf /var/lib/apt/lists/*
rm -rf /var/cache/apt/archives/*
rm -rf /tmp/* /var/tmp/*

# 5. Prune unused locales - keep English (en) and Bengali (bn)
if command -v locale-gen >/dev/null 2>&1; then
    echo "Configuring locales for en_US.UTF-8 and bn_BD.UTF-8..."
    cat << 'EOF' > /etc/locale.gen
en_US.UTF-8 UTF-8
bn_BD.UTF-8 UTF-8
EOF
    locale-gen
fi

# 6. Prevent apt from re-downloading man pages and translation files
cat << 'EOF' > /etc/apt/apt.conf.d/99devos-nodoc
Dir::Cache::pkgcache "";
Dir::Cache::srcpkgcache "";
Acquire::Languages "none";
EOF

echo "==> DevOS 01-strip-bloat hook completed."
