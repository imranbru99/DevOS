#!/bin/bash
# 01-strip-bloat.hook.chroot - Clean temporary caches while preserving full system documentation and locales
set -euo pipefail

echo "==> Running DevOS 01-strip-bloat hook (Full 26.04 edition: preserving documentation and all locales)..."

# Keep only the newest kernel to avoid duplicate boot entries
latest="$(ls -1 /boot/vmlinuz-* 2>/dev/null | sort -V | tail -n 1 | sed 's#.*/vmlinuz-##; s#-generic$##')"
if [ -n "$latest" ]; then
    old_kernels="$(dpkg-query -W -f='${Package}\n' 'linux-image-[0-9]*' 'linux-modules-[0-9]*' \
        'linux-modules-extra-[0-9]*' 'linux-headers-[0-9]*' 'linux-tools-[0-9]*' 2>/dev/null \
        | grep -v -- "-${latest}" || true)"
    if [ -n "$old_kernels" ]; then
        echo "Removing old kernels (keeping ${latest}): ${old_kernels}"
        # shellcheck disable=SC2086
        apt-get purge -y $old_kernels || true
    fi
fi

# Clean Apt archives and temporary build directories
apt-get autoremove --purge -y || true
apt-get clean
rm -rf /var/cache/apt/archives/*
rm -rf /tmp/* /var/tmp/*

echo "==> DevOS 01-strip-bloat hook completed."
