#!/bin/sh
# Diagnose only: filesystem corruption must never trigger automatic repair writes.
# Retain this filename so previously built initramfs hooks remain compatible.
case "${1:-}" in
    prereqs) exit 0 ;;
esac

# A root filesystem mounted read-only here is normal: systemd remounts it later.
# A failed write alone cannot distinguish this from ENOSPC, I/O or permissions.
target="${rootmnt:-/root}"
if [ -x "$target/sbin/init" ] || [ -x "$target/bin/sh" ] || [ -x "$target/usr/lib/systemd/systemd" ]; then
    exit 0
fi

[ -n "${ROOT:-}" ] || exit 0
kind="${ROOTFSTYPE:-${FSTYPE:-}}"
if [ -z "$kind" ] && command -v blkid >/dev/null 2>&1; then
    kind=$(blkid -s TYPE -o value "$ROOT" 2>/dev/null || true)
fi
[ "$kind" = btrfs ] || exit 0

echo "DevOS: the Btrfs root filesystem is not available at $target."
echo "No automatic repair or forced write mount was attempted."
echo "Use the live USB to inspect the drive, preserve your files and diagnose the kernel error."
exit 0
