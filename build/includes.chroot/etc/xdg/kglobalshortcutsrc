# DevOS Windows-Style Global Shortcuts for KDE Plasma 6
[kwin]
# Win+D: Show Desktop
Show Desktop=Meta+D,Meta+D,Toggle Show Desktop
# Win+L: Lock Screen
Lock Session=Meta+L,Meta+L,Lock Screen
# Win+R: Run Dialog (KRunner)
Overview=Meta+W,none,Toggle Overview
# Win+Arrow Snapping
Window Quick Tile Left=Meta+Left,none,Quick Tile Window to the Left
Window Quick Tile Right=Meta+Right,none,Quick Tile Window to the Right
Window Quick Tile Top=Meta+Up,none,Quick Tile Window to the Top
Window Quick Tile Bottom=Meta+Down,none,Quick Tile Window to the Bottom
Window Maximize=Meta+Up,none,Maximize Window
Window Minimize=Meta+Down,none,Minimize Window
# Alt+Tab Window Switching
Walk Through Windows=Alt+Tab,Alt+Tab,Walk Through Windows

[org.kde.krunner.desktop]
_launch=Meta+R,none,KRunner

[org.kde.spectacle.desktop]
RectangularRegionScreenShot=Meta+Shift+S,none,Capture Rectangular Region

[org.kde.dolphin.desktop]
_launch=Meta+E,none,Open File Manager (Explorer)

[plasmashell]
activate widget 2=Meta,none,Open Start Menu

# DevOS AI voice command: press, speak, done (Ctrl+Alt+Space as a second key)
[services][devos-voice.desktop]
_launch=Meta+H\tCtrl+Alt+Space

# Same shortcut in the Plasma 5.27 format (group named after the .desktop file).
[devos-voice.desktop]
_k_friendly_name=Voice Command
_launch=Meta+H,none,Voice Command

# DevOS Voice Typing: dictate into the focused app (Win+Alt+H; Win+H stays the voice command)
[services][devos-voice-typing.desktop]
_launch=Meta+Alt+H

[devos-voice-typing.desktop]
_k_friendly_name=Voice Typing
_launch=Meta+Alt+H,none,Voice Typing

# DevOS AI Actions on the selected text (Win+Alt+A)
[services][devos-ai-actions.desktop]
_launch=Meta+Alt+A

[devos-ai-actions.desktop]
_k_friendly_name=AI Actions
_launch=Meta+Alt+A,none,AI Actions

# DevOS Task Manager (same keys as Windows)
[services][devos-taskman.desktop]
_launch=Ctrl+Shift+Esc

[devos-taskman.desktop]
_k_friendly_name=Task Manager
_launch=Ctrl+Shift+Esc,none,Task Manager

# Clipboard history, same keys as Windows
[services][devos-clipboard.desktop]
_launch=Meta+V

[devos-clipboard.desktop]
_k_friendly_name=Clipboard
_launch=Meta+V,none,Clipboard

# Emoji panel, same keys as Windows
[services][devos-emoji.desktop]
_launch=Meta+.

[devos-emoji.desktop]
_k_friendly_name=Emoji
_launch=Meta+.,none,Emoji

[services][devos-kids-mode.desktop]
_launch=Meta+K

[devos-kids-mode.desktop]
_k_friendly_name=Kids Mode
_launch=Meta+K,Meta+K,Kids Mode
