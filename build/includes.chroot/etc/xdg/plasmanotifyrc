# Screenshot notifications are explicit user interactions, always show them
[Applications][org.kde.spectacle]
ShowPopupsInDndMode=true

# Defaults for media players so their track change notifications don't accumulate in the history
[Applications][vlc]
ShowInHistory=false

# Klipper notifications might contain sensitive information
[Applications][org.kde.klipper]
ShowInHistory=false

# DrKonqi creates a tray icon, no point in being in history
[Applications][org.kde.drkonqi]
ShowInHistory=false

# Non-configurable applications don't deserve to be in history by default
[Applications][@other]
ShowInHistory=false
# Badges wouldn't work anyway
ShowBadges=false

# Keep inhibition summary out of history.
[Services][libnotificationmanager]
ShowInHistory=false

# Cursor agent "Approve" UI is an in-app Electron card, not a Plasma toast —
# it cannot be auto-closed via org.freedesktop.Notifications. Cursor's own
# system notifications are also fire-and-forget (Cursor does not CloseNotification
# after you act). Only real desktop toasts respect the timeout below.
[Applications][cursor]
ShowInHistory=false
ShowPopups=true

# DevOS: normal Plasma toasts auto-hide quickly (Windows-style banners)
[Notifications]
ShowPopupTimeout=true
PopupTimeout=1000
