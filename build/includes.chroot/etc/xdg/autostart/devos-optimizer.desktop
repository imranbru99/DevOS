[Desktop Entry]
Type=Application
Name=DevOS Optimizer
Comment=Keeps the PC fast with friendly cleanup and memory suggestions
Exec=/usr/bin/python3 /usr/local/share/devos/components/optimizer/optimizer.py --tray
Icon=preferences-system-performance
Terminal=false
OnlyShowIn=KDE;
X-KDE-autostart-phase=2
# Tray is started once via systemd user unit (devos-optimizer.service).
# Dual autostart wasted RAM/CPU every login.
X-GNOME-Autostart-enabled=false
Hidden=true
NoDisplay=true
