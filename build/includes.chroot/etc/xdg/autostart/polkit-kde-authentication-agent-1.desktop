[Desktop Entry]
Name=PolicyKit Authentication Agent
Comment=DevOS-styled PolicyKit Authentication Agent
Exec=/usr/local/bin/devos-authentication-agent
Icon=dialog-password
Terminal=false
Type=Application
OnlyShowIn=KDE;
X-KDE-StartupNotify=false
X-KDE-autostart-phase=0
NoDisplay=true
X-DBUS-StartupType=Unique
X-systemd-skip=true
