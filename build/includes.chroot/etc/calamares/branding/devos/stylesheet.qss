/* DevOS installer theme. Calamares only loads a file named stylesheet.qss;
   the old devos.qss was never read, so the installer showed stock light Qt. */

/* Scenic backdrop on the main shell only.
   Never put border-image on QDialog — QMessageBox subclasses it and stretched
   the photo into a tiny confirm panel (black void + broken icon layout). */
QMainWindow {
    border-image: url(bg/04.jpg) 0 0 0 0 stretch stretch;
    background-color: #070a12;
}
QDialog {
    background-color: #0f172a;
    color: #e2e8f0;
    border-image: none;
}

QWidget {
    font-family: "Inter", "Noto Sans", "Liberation Sans", sans-serif;
    font-size: 14px;
    color: #e2e8f0;
    background-color: transparent;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QLabel { background: transparent; }

/* Soft veil — not opaque black — so partition/summary photos stay visible */
QFrame#mainApp {
    background-color: rgba(7, 10, 18, 110);
}
QStackedWidget {
    background-color: rgba(7, 10, 18, 90);
    border: none;
}
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* Page titles inside widget-based steps.
   Keep titles compact so Next/Back stay on-screen on 1366x768 laptops. */
QLabel#viewTitle, QLabel#pageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #f8fafc;
    margin-bottom: 4px;
    max-height: 40px;
    padding: 4px 2px;
}

/* Content panes must scroll; never grow the shell past the nav bar. */
QMainWindow > QWidget#mainApp {
    max-height: 16777215;
}
QWidget#mainApp QScrollArea {
    min-height: 120px;
}

/* Buttons that live inside pages (Change..., partition actions) */
QPushButton, QToolButton {
    background-color: rgba(20, 27, 45, 230);
    border: 1px solid #26324d;
    border-radius: 12px;
    padding: 10px 18px;
    font-weight: 600;
    color: #e2e8f0;
}
QPushButton:hover, QToolButton:hover { background-color: #1c2740; border-color: #38bdf8; }
QPushButton:pressed, QToolButton:pressed { background-color: #0f172a; }
QPushButton:disabled, QToolButton:disabled { color: #475569; border-color: #1e293b; }

/* Text inputs and drop-downs */
QLineEdit, QComboBox, QSpinBox {
    background-color: rgba(15, 23, 42, 230);
    border: 1px solid #2a3550;
    border-radius: 12px;
    padding: 9px 12px;
    color: #f8fafc;
    min-height: 22px;
}
QLineEdit:focus, QComboBox:focus { border-color: #38bdf8; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox QAbstractItemView {
    background-color: #0f172a;
    border: 1px solid #2a3550;
    selection-background-color: #1d4ed8;
    outline: none;
}

/* Lists: keyboard layouts, disks, partitions — frosted cards over the photo */
QListView, QTreeView, QTableView {
    background-color: rgba(13, 19, 34, 210);
    alternate-background-color: rgba(17, 26, 44, 210);
    border: 1px solid #1e293b;
    border-radius: 14px;
    padding: 6px;
    outline: none;
}

QListView::item, QTreeView::item { padding: 7px 10px; border-radius: 8px; }
QListView::item:selected, QTreeView::item:selected {
    background-color: #1d3a63;
    color: #ffffff;
}
QListView::item:hover, QTreeView::item:hover { background-color: #15213a; }
QHeaderView::section {
    background-color: #0f172a;
    color: #94a3b8;
    border: none;
    border-bottom: 1px solid #1e293b;
    padding: 8px;
    font-weight: 600;
}

QRadioButton, QCheckBox { spacing: 10px; color: #e2e8f0; background: transparent; }

/* Partition choice radios (Erase disk / Manual) sit on a frosted card */
QGroupBox {
    background-color: rgba(15, 23, 42, 210);
    border: 1px solid #1e3a5f;
    border-radius: 14px;
    margin-top: 12px;
    padding: 12px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #7dd3fc;
}

/* Tall widget pages must scroll inside the content pane */
QScrollArea, QAbstractScrollArea {
    background: transparent;
    border: none;
}
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #334155; border-radius: 4px; min-height: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }

/* Install progress: the real progress, so make it the visual focus. */
QProgressBar {
    background-color: #111827;
    border: none;
    border-radius: 9px;
    min-height: 18px;
    max-height: 18px;
    text-align: center;
    color: #f8fafc;
    font-weight: 700;
    font-size: 12px;
}
QProgressBar::chunk {
    border-radius: 9px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #22d3ee, stop:0.5 #38bdf8, stop:1 #818cf8);
}

QToolTip {
    background-color: #111827;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px;
}

/* Install confirm (Calamares QMessageBox). Must stay opaque — global QWidget
   transparency + scenic QDialog border-image caused the black empty panel. */
QMessageBox {
    background-color: #0f172a;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 16px;
    border-image: none;
    padding: 8px;
    font-size: 14px;
    min-width: 420px;
    max-width: 560px;
}
QMessageBox > QWidget,
QMessageBox QDialogButtonBox,
QMessageBox QGridLayout {
    background-color: #0f172a;
    border-image: none;
}
QMessageBox QLabel {
    color: #e2e8f0;
    font-size: 14px;
    background-color: transparent;
    min-width: 0px;
    max-width: 420px;
}
QMessageBox QLabel#qt_msgbox_label,
QMessageBox QLabel#qt_msgboxex_informativelabel {
    color: #cbd5e1;
    font-size: 14px;
    padding: 8px 4px 12px 4px;
    qproperty-wordWrap: true;
}
/* Keep the stock question icon in a tight column — not a huge black slab. */
QMessageBox QLabel#qt_msgboxex_icon_label {
    min-width: 48px;
    max-width: 56px;
    min-height: 48px;
    max-height: 56px;
    padding: 8px;
    background-color: transparent;
}
QMessageBox QDialogButtonBox {
    padding: 8px 4px 4px 4px;
    min-height: 52px;
    background-color: #0f172a;
}
QMessageBox QPushButton {
    min-width: 118px;
    min-height: 40px;
    border-radius: 12px;
    padding: 10px 18px;
    font-weight: 700;
    font-size: 14px;
    background-color: #141b2d;
    color: #e2e8f0;
    border: 1px solid #26324d;
}
QMessageBox QPushButton:hover {
    background-color: #1c2740;
    border-color: #38bdf8;
}
QMessageBox QPushButton:default,
QMessageBox QPushButton[text="Install Now"],
QMessageBox QPushButton[text="&Install Now"] {
    background-color: #38bdf8;
    color: #04121f;
    border: none;
}
QMessageBox QPushButton:default:hover,
QMessageBox QPushButton[text="Install Now"]:hover,
QMessageBox QPushButton[text="&Install Now"]:hover {
    background-color: #7dd3fc;
}
QMessageBox QPushButton:!default {
    background-color: #141b2d;
    color: #e2e8f0;
    border: 1px solid #26324d;
}

/* Radio buttons and check boxes: visible on the dark background */
QRadioButton::indicator, QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #475569;
    background: #0f172a;
}
QRadioButton::indicator { border-radius: 10px; }
QCheckBox::indicator { border-radius: 5px; }
QRadioButton::indicator:hover, QCheckBox::indicator:hover { border-color: #38bdf8; }
QRadioButton::indicator:checked {
    border-color: #38bdf8;
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
        stop:0 #38bdf8, stop:0.5 #38bdf8, stop:0.6 #0f172a, stop:1 #0f172a);
}
QCheckBox::indicator:checked { border-color: #38bdf8; background: #38bdf8; }

/* Partition bars — keep readable over the scenic backdrop */
PartitionLabelsView, PartitionBarsView, PartitionSplitterWidget {
    color: #e2e8f0;
    background: transparent;
    border: none;
    padding: 4px;
}
PartitionBarsView {
    min-height: 36px;
    border-radius: 12px;
    background-color: rgba(15, 23, 42, 160);
}

QAbstractItemView { color: #e2e8f0; }

/* Legend card: Calamares paints some names in black — light plate keeps them readable */
PartitionLabelsView {
    background-color: #e8eef7;
    border-radius: 12px;
    padding: 6px;
}
