/* DevOS Luxury Dark Modern Calamares Theme */
QWidget {
    font-family: "Segoe UI", "Inter", "Ubuntu", sans-serif;
    color: #e0def4;
    background-color: #0d0f18;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
}

/* Sidebar styling */
#sidebarApp {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #090a10, stop:1 #131722);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
}

#sidebarWidget {
    background: transparent;
    padding: 18px;
}

/* Navigation items */
#sidebarWidget QWidget {
    background: transparent;
}

QListWidget::item {
    padding: 12px 16px;
    border-radius: 8px;
    margin: 4px 8px;
    color: #94a3b8;
    font-weight: 500;
}

QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(59, 130, 246, 0.25), stop:1 rgba(139, 92, 246, 0.15));
    border: 1px solid rgba(59, 130, 246, 0.4);
    color: #38bdf8;
    font-weight: 600;
}

/* Main Installer Viewport */
#centralWidget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0f121d, stop:1 #090b12);
}

/* Headings */
QLabel#viewTitle {
    font-size: 24px;
    font-weight: 700;
    color: #f8fafc;
    letter-spacing: -0.5px;
    margin-bottom: 8px;
}

QLabel#viewSubtitle {
    font-size: 14px;
    color: #94a3b8;
    margin-bottom: 20px;
}

/* Buttons */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1e293b, stop:1 #334155);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 9px 22px;
    font-size: 13px;
    font-weight: 600;
    color: #f1f5f9;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563eb, stop:1 #3b82f6);
    border: 1px solid #60a5fa;
    color: #ffffff;
}

QPushButton:pressed {
    background: #1d4ed8;
}

QPushButton#nextButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563eb, stop:1 #7c3aed);
    border: 1px solid rgba(147, 197, 253, 0.3);
    color: #ffffff;
    font-weight: 700;
}

QPushButton#nextButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3b82f6, stop:1 #8b5cf6);
    box-shadow: 0 0 16px rgba(59, 130, 246, 0.5);
}

/* Inputs and LineEdits */
QLineEdit, QComboBox {
    background-color: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 8px 12px;
    color: #f8fafc;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #38bdf8;
    background-color: rgba(30, 41, 59, 0.95);
}

/* Progress bar during installation */
QProgressBar {
    background-color: #1e293b;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    text-align: center;
    color: #f8fafc;
    font-weight: 600;
    height: 18px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #06b6d4, stop:0.5 #3b82f6, stop:1 #8b5cf6);
    border-radius: 5px;
}
