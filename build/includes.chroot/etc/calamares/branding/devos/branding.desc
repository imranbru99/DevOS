# DevOS Calamares Branding Descriptor (Calamares 3.3)
---
componentName: devos

welcomeStyleCalamares: false
welcomeExpandingLogo: true

# Never use fullscreen — it hid Cancel/Back/Next under bezels and panels.
# noexpand + a height that fits 1366x768 work areas keeps Next on-screen;
# users can still maximize manually on large displays.
windowExpanding: noexpand
windowSize: 960px,580px
windowPlacement: center

# Sidebar and the Back/Next bar are drawn by calamares-sidebar.qml and
# calamares-navigation.qml in this folder. The rest of the window uses
# stylesheet.qss (Calamares only loads a file with exactly that name).
sidebar: qml
navigation: qml

strings:
    productName: DevOS
    version: "26.04 LTS"
    shortVersion: "26.04"
    versionedName: DevOS 26.04 LTS
    shortVersionedName: DevOS 26.04
    bootloaderEntryName: DevOS
    productUrl: https://imrandev.bd
    supportUrl: https://github.com/imranbru99/DevOS/issues
    releaseNotesUrl: https://github.com/imranbru99/DevOS

images:
    productIcon: "logo.png"
    productLogo: "logo.png"
    productWelcome: "installer-background.svg"

style:
    SidebarBackground: "#080b14"
    SidebarText: "#8b97ad"
    SidebarTextCurrent: "#f8fafc"
    SidebarBackgroundCurrent: "#16213a"

slideshow: "show.qml"
slideshowAPI: 2
