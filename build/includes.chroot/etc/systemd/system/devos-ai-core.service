[Unit]
Description=DevOS Local AI Core
After=network.target

[Service]
Type=simple
WorkingDirectory=/usr/local/share/devos/components/ai-core
ExecStart=/usr/bin/python3 /usr/local/share/devos/components/ai-core/server.py
Restart=on-failure
RestartSec=3
# A reply should beat background scans for CPU time. The service also switches
# the CPU out of powersave while a reply is generating, then puts it back.
Nice=-2
CPUWeight=150
# Lets big PCs lock the weights in RAM (use_mlock). Unused on smaller PCs.
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
