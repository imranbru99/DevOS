[Unit]
Description=DevOS Local AI Core
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/usr/local/share/devos/components/ai-core
ExecStart=/usr/bin/python3 /usr/local/share/devos/components/ai-core/server.py
Restart=on-failure
RestartSec=3
# Isolate optional AI work so it can yield resources to the desktop.
Slice=devos-workloads.slice
Nice=5
CPUWeight=50
IOWeight=50
MemoryAccounting=yes
MemoryHigh=60%
MemoryMax=75%
MemorySwapMax=1G
LimitMEMLOCK=64M
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
