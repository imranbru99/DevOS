[Unit]
Description=Install the apps chosen in the DevOS installer
# Enabled by "devos-features installer-plan" when the "Choose your apps" page
# picked downloads; it disables itself once everything is installed.
After=network.target devos-network.service
ConditionPathExists=/etc/devos/features.conf
StartLimitIntervalSec=0

[Service]
# Start the worker in the background so graphical.target can open while it runs.
Type=exec
ExecStart=/usr/local/bin/devos-features apply
Slice=devos-workloads.slice
Nice=15
CPUWeight=20
IOWeight=15
CPUQuota=30%
IOSchedulingClass=idle
Restart=on-failure
RestartSec=300

[Install]
WantedBy=multi-user.target
