[Unit]
Description=DevOS hardware-aware responsiveness tuning
Documentation=file:///usr/local/sbin/devos-performance-tune
After=local-fs.target systemd-sysctl.service
Before=display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/devos-performance-tune
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
