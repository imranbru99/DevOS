[Unit]
Description=DevOS Optimizer System Tray
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Background worker: never compete with focused Chrome / Plasma.
Slice=background.slice
Nice=15
CPUWeight=15
IOWeight=15
ExecStart=/bin/bash -c "if [ -f /home/imran/project/dev-os/components/optimizer/optimizer.py ]; then exec /usr/bin/python3 /home/imran/project/dev-os/components/optimizer/optimizer.py --tray; else exec /usr/bin/python3 /usr/local/share/devos/components/optimizer/optimizer.py --tray; fi"
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
