[Unit]
Description=DevOS Sound Tray
PartOf=graphical-session.target
After=graphical-session.target
# Autostart desktop launches the tray; keep this unit available but not
# double-started (no graphical-session.target.wants link).

[Service]
Type=simple
ExecStart=/usr/local/bin/devos-sound --tray
Restart=on-failure
RestartSec=2
# Inherit DISPLAY / WAYLAND / XDG_RUNTIME_DIR from the graphical session.
# Do not hard-code :1 or uid 1000 — that breaks every other seat/user.

[Install]
WantedBy=graphical-session.target
