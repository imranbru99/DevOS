[Unit]
Description=DevOS Quick Selection Bar
PartOf=graphical-session.target
After=graphical-session.target
# Autostart desktop launches this; no wants symlink (avoid double start).

[Service]
Type=simple
ExecStart=/usr/local/bin/devos-quick-selection
Restart=on-failure
RestartSec=2
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=graphical-session.target
