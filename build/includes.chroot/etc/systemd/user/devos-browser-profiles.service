[Unit]
Description=DevOS Chrome Multi-Profile Window and Taskbar Manager
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Background worker: badge sync must not steal CPU from active Chrome windows.
Slice=background.slice
Nice=10
CPUWeight=20
IOWeight=15
ExecStart=/usr/local/bin/devos-browser-profiles-daemon
Restart=always
RestartSec=2
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Inherit DISPLAY / WAYLAND_DISPLAY / XAUTHORITY from the graphical session.
# Hardcoding DISPLAY=:1 broke avatar pins when the session was on :0.
PassEnvironment=DISPLAY WAYLAND_DISPLAY XAUTHORITY

[Install]
WantedBy=graphical-session.target
