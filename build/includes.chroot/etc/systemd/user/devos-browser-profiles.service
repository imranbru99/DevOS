[Unit]
Description=DevOS Chrome Multi-Profile Window and Taskbar Manager
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Background worker: badge sync must not steal CPU from active Chrome windows.
Slice=background.slice
Nice=10
CPUWeight=20
IOWeight=15
ExecStart=/usr/local/bin/devos-browser-profiles-daemon
Restart=always
RestartSec=2
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=DISPLAY=:1
Environment=WAYLAND_DISPLAY=wayland-0

[Install]
WantedBy=graphical-session.target
