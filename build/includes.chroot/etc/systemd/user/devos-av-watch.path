[Unit]
Description=DevOS Security: scan new downloads
Documentation=file:///usr/local/share/devos/components/security/av.py
# inotify inside the user's own systemd: no extra process while nothing changes.
ConditionPathExists=/usr/bin/clamscan
After=devos-av-watch-setup.service

[Path]
# More folders (XDG download folder, Telegram, Flatpak apps) are added by
# devos-av-watch-setup.service in ~/.config/systemd/user/devos-av-watch.path.d/.
PathChanged=%h/Downloads
PathChanged=%h/Desktop
Unit=devos-av-watch.service

[Install]
WantedBy=default.target
