[Desktop Entry]
Type=Application
Name=Apps
GenericName=Installed apps
Comment=Uninstall apps and clear their cache or cookies
Exec=/usr/bin/python3 /usr/local/share/devos/components/apps/apps_manager.py
Icon=preferences-desktop-apps
Terminal=false
StartupNotify=true
StartupWMClass=apps_manager.py
Categories=System;Settings;
Keywords=uninstall;remove;apps;programs;cache;cookies;
