[Desktop Entry]
Version=1.0
Name=Notepad
GenericName=Simple notes
Comment=Write and edit notes and plain text
Exec=/usr/local/bin/devos-notepad %F
Icon=devos-notepad
Terminal=false
Type=Application
Categories=Qt;Utility;TextEditor;
MimeType=text/plain;text/markdown;
StartupNotify=true
StartupWMClass=devos-notepad
