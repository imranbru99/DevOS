[Desktop Entry]
Version=1.0
Name=DevOS Browser
GenericName=Web Browser
Comment=Browse the web in DevOS
Exec=/usr/local/bin/devos-web-browser %U
Icon=devos-browser
Terminal=false
Type=Application
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=devos-browser
