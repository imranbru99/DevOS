[Desktop Entry]
Version=1.0
Name=VLC Media Player
GenericName=Media Player
Comment=Play audio, music, movies, and video streams
Exec=/usr/bin/vlc --started-from-file %U
Icon=vlc
Terminal=false
Type=Application
Categories=AudioVideo;Player;Recorder;
MimeType=video/mp4;video/mkv;video/webm;audio/mp3;audio/flac;audio/wav;audio/ogg;
