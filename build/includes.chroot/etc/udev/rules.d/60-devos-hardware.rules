# Re-tune a disk when it appears, including a drive plugged in later.
ACTION=="add|change", SUBSYSTEM=="block", KERNEL=="sd[a-z]|nvme[0-9]*n[0-9]*", RUN+="/usr/local/sbin/devos-tune-hardware"

# Spin down idle mechanical HDDs after 10 minutes (120 * 5s = 600s) for quiet operation
ACTION=="add", SUBSYSTEM=="block", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="1", ENV{ID_ATA_FEATURE_SET_PM_STANDBY}="120"

# Keep a USB Bluetooth adapter from sleeping and disappearing.
ACTION=="add", SUBSYSTEM=="usb", DRIVERS=="btusb", ATTR{power/control}="on"
