[Unit]
Description=DevOS — restore preferred audio devices
Documentation=file:///usr/local/share/devos/components/audio/mic_defaults.py
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service wireplumber.service

[Service]
Type=oneshot
# USB audio often appears a moment after the session audio stack; apply twice.
ExecStart=/bin/sh -c '/usr/local/bin/devos-audio-defaults restore-devices; sleep 3; /usr/local/bin/devos-audio-defaults restore-devices'

[Install]
WantedBy=default.target
