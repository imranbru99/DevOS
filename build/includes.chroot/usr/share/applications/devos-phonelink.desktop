[Desktop Entry]
Type=Application
Name=Phone Link
GenericName=Control this PC from your phone
Comment=Use your phone's browser to control this PC, send files and copy text
Exec=/usr/local/bin/devos-run --desktop=devos-phonelink --name="Phone Link" /usr/local/share/devos/components/phonelink/phonelink.py gui
Icon=devos-phonelink
Terminal=false
Categories=System;Network;
Keywords=phone;mobile;remote;android;iphone;qr;pair;kdeconnect;
StartupNotify=true
StartupWMClass=devos-phonelink
