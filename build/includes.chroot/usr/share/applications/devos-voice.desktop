[Desktop Entry]
Type=Application
Version=1.0
Name=Voice Command
GenericName=DevOS AI voice command
Comment=Say a command and DevOS AI does it (press Meta+H, speak, done)
Exec=/usr/bin/python3 /usr/local/share/devos/components/assistant/listen.py --once
Icon=audio-input-microphone
Terminal=false
NoDisplay=false
StartupNotify=false
Categories=Utility;Accessibility;
Keywords=voice;speak;talk;command;microphone;assistant;devos ai;hands-free;
X-KDE-Shortcuts=Meta+H,Ctrl+Alt+Space
