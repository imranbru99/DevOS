[Desktop Entry]
Type=Application
Name=Google Antigravity IDE
GenericName=AI-First Code Editor & Agent
Comment=Next-generation AI-first integrated development environment by Google
Exec=antigravity %F
Icon=antigravity
Terminal=false
Categories=Development;IDE;TextEditor;
MimeType=text/plain;inode/directory;
Keywords=google;antigravity;ide;agent;ai;code;editor;pair-programmer;
StartupNotify=true
StartupWMClass=antigravity
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=antigravity --new-window %F
Icon=antigravity
