[Desktop Entry]
Type=Application
# Hidden until Features installs the real /opt binary (wrappers alone are not enough).
NoDisplay=true
Hidden=true
X-DevOS-Hidden=true
Name=Google Antigravity
GenericName=AI coding (main account)
Comment=Primary Antigravity — own Google account, projects, and Gemini profile
TryExec=/opt/antigravity/antigravity
Exec=/usr/local/bin/devos-antigravity %U
Icon=antigravity
Terminal=false
Categories=Development;IDE;
MimeType=text/plain;inode/directory;
Keywords=antigravity;google;ai;ide;coding;agent;main;
StartupNotify=true
StartupWMClass=antigravity
Actions=SoftwareRendering;

[Desktop Action SoftwareRendering]
Name=Open with software rendering
Exec=/usr/local/bin/devos-antigravity --software-rendering %U
Icon=antigravity
