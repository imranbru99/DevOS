[Desktop Entry]
Type=Application
Name=Password Manager
GenericName=Store passwords safely
Comment=Keep passwords in a locked vault on this PC
Exec=keepassxc %U
Icon=keepassxc
Terminal=false
Categories=Qt;Utility;Security;
MimeType=application/x-keepass2;
Keywords=password;keepass;vault;security;credentials;keepassxc;
StartupNotify=true
StartupWMClass=keepassxc
