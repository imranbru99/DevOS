[Desktop Entry]
Type=Application
Name=PC Optimizer
GenericName=Clean up and speed up
Comment=Free disk space and find apps using too much memory
Exec=/usr/local/bin/devos-run --desktop=devos-optimizer --name="PC Optimizer" /usr/local/share/devos/components/optimizer/optimizer.py --cleanup
Icon=devos-optimizer
Terminal=false
Categories=System;Utility;
Keywords=clean;cleanup;cache;trash;disk;memory;speed;optimize;
StartupNotify=false
StartupWMClass=devos-optimizer
