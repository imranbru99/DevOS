[Desktop Entry]
Type=ApplicationStartupWMClass=devos-fingerprint

Name=Fingerprint sign-in
GenericName=Windows Hello-style sign-in
Comment=Save a fingerprint and use it at the lock screen
Exec=/usr/local/bin/devos-run --desktop=devos-fingerprint --name="Fingerprint sign-in" /usr/local/share/devos/components/settings/fingerprint.py gui
Icon=devos-fingerprint
Terminal=false
StartupNotify=true
Categories=System;Security;
Keywords=fingerprint;hello;fprintd;login;
