[Desktop Entry]
Type=Application
Name=Paint
GenericName=Paint pictures
Comment=Draw and edit simple pictures — like Windows Paint
TryExec=/usr/bin/kolourpaint
Exec=/usr/bin/kolourpaint %U
Icon=devos-paint
Terminal=false
Categories=Qt;Graphics;2DGraphics;RasterGraphics;
MimeType=image/png;image/jpeg;image/gif;image/bmp;image/webp;image/x-xpm;
Keywords=paint;drawing;mspaint;kolourpaint;brush;image;
StartupNotify=true
StartupWMClass=kolourpaint
