[Desktop Entry]
Type=Application
Name=Disk Space Report
GenericName=Storage breakdown
Comment=See why DevOS is using disk space
Exec=konsole --hold -e /usr/local/bin/devos-disk-why
Icon=devos-disk-report
Terminal=false
Categories=Qt;System;Filesystem;
Keywords=disk;space;storage;usage;du;70gb;clean;
StartupNotify=true
StartupWMClass=devos-disk-why
NoDisplay=false
