[Desktop Entry]
Type=Application
Name=Cloud Backup
GenericName=Back up to Google Drive or OneDrive
Comment=Optional copy of Documents, Desktop, Pictures and Downloads in your cloud
Exec=/usr/bin/python3 /usr/local/share/devos/components/backup/cloud_backup.py gui
Icon=folder-cloud
Terminal=false
StartupNotify=true
StartupWMClass=cloud_backup.py
Categories=System;Utility;
Keywords=backup;cloud;google drive;onedrive;restore;sync;files;
