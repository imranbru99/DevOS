[Desktop Entry]
Type=Application
Name=Cloud Backup
GenericName=Backup files to the cloud
Comment=Copy Documents, Desktop, Pictures and Downloads to Google Drive or OneDrive
Exec=/usr/local/bin/devos-run --desktop=devos-backup --name="Cloud Backup" /usr/local/share/devos/components/backup/cloud_backup.py gui
Icon=devos-backup
Terminal=false
StartupNotify=true
StartupWMClass=devos-backup
Categories=System;Utility;
Keywords=backup;cloud;google drive;onedrive;restore;sync;files;
