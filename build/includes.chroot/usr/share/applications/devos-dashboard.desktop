[Desktop Entry]
Type=Application
Name=DevOS Dashboard
Comment=Hardware status, disks and PIN setup, in its own DevOS window
Exec=/usr/local/bin/devos-run --desktop=devos-dashboard --name="DevOS Dashboard" /usr/local/share/devos/components/dashboard/dashboard_server.py
Icon=devos-dashboard
Terminal=false
Categories=System;
Keywords=dashboard;status;devos;disk;storage;
StartupNotify=true
StartupWMClass=DevOS-dashboard
