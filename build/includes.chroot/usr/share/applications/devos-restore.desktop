[Desktop Entry]
Type=Application
StartupWMClass=devos-restore

Name=Restore points
GenericName=System restore
Comment=Create a restore point or roll the system back
Exec=/usr/local/bin/devos-run --desktop=devos-restore --name="Restore points" /usr/local/share/devos/components/settings/snapshot_manager.py gui
Icon=devos-restore
Terminal=false
StartupNotify=true
Categories=System;
Keywords=restore;snapshot;rollback;backup;snapper;
