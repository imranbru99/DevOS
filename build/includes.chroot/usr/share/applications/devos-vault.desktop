[Desktop Entry]
Type=Application
StartupWMClass=devos-vault

Name=DevOS Vault
GenericName=Encrypted folder
Comment=Encrypt a folder with a password after install
Exec=/usr/local/bin/devos-run --desktop=devos-vault --name="DevOS Vault" /usr/local/share/devos/components/settings/vault.py gui
Icon=devos-vault
Terminal=false
StartupNotify=true
Categories=System;Security;
Keywords=encrypt;vault;luks;bitlocker;folder;
