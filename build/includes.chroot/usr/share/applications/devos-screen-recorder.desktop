[Desktop Entry]
Name=Screen Recorder
GenericName=Screen Recording Tool
Comment=1-Click high quality screen recording for DevOS
Exec=devos-recorder
Icon=devos-recorder
Type=Application
Categories=AudioVideo;Recorder;Video;Utility;
Keywords=screen;record;recorder;screencast;video;capture;
StartupNotify=true
StartupWMClass=devos-screen-recorder
Actions=RecordScreen;RecordRegion;RecordWindow;

[Desktop Action RecordScreen]
Name=Record Entire Screen
Exec=devos-recorder --screen

[Desktop Action RecordRegion]
Name=Record Selected Area
Exec=devos-recorder --region

[Desktop Action RecordWindow]
Name=Record Active Window
Exec=devos-recorder --window
