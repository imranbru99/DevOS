[Desktop Entry]
Type=Application
Name=Antigravity Studio
GenericName=AI Development Studio (KDE Edition)
Comment=Next-generation autonomous AI development studio with deep KDE Plasma integration
Exec=/usr/local/bin/antigravity-kde %F
Icon=antigravity-kde
Terminal=false
Categories=Development;IDE;TextEditor;
MimeType=text/plain;inode/directory;
Keywords=antigravity;studio;kde;agent;ai;ide;coding;pair-programmer;
StartupNotify=true
StartupWMClass=antigravity-kde
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=/usr/local/bin/antigravity-kde --new-window %F
Icon=antigravity-kde
