[Desktop Entry]
Type=Application
Version=1.0
Name=Notes
GenericName=Sticky notes & notebooks
Comment=Sticky notes on the desktop, notebooks, and voice notes — not the same as Notepad
Exec=/usr/local/bin/devos-run --desktop=devos-notes --name=Notes /usr/local/share/devos/components/notes/notes.py
Icon=devos-notes
Terminal=false
StartupNotify=true
StartupWMClass=devos-notes
Categories=Office;Utility;
Keywords=notes;sticky notes;onenote;memo;to-do;todo;checklist;notebook;markdown;
Actions=NewNote;NewSticky;

[Desktop Action NewNote]
Name=New note
Exec=/usr/local/bin/devos-run --desktop=devos-notes --name=Notes /usr/local/share/devos/components/notes/notes.py --new

[Desktop Action NewSticky]
Name=New sticky note
Exec=/usr/local/bin/devos-run --desktop=devos-notes --name=Notes /usr/local/share/devos/components/notes/notes.py --new-sticky
