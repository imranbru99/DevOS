[Desktop Entry]
Name=WinLayer (DevOS Windows Compatibility)
Comment=Run Windows Executables and Installers
Exec=python3 /usr/lib/devos/components/devos_cli.py win launch %f
Icon=application-x-msdownload
Terminal=false
Type=Application
MimeType=application/x-msdownload;application/x-ms-dos-executable;application/x-msi;application/x-bat;
Categories=System;Emulator;Utility;
StartupNotify=true
