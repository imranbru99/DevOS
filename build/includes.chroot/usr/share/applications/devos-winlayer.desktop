[Desktop Entry]
Name=WinLayer (Windows Compatibility Starter)
GenericName=Windows Compatibility Starter
Comment=Run Windows Executables (.exe, .msi) and Installers
Exec=/usr/local/bin/devos-open-app %f
Icon=devos-winlayer
Terminal=false
Type=Application
MimeType=application/x-msdownload;application/x-ms-dos-executable;application/vnd.microsoft.portable-executable;application/x-msdos-program;application/x-msi;application/x-ms-installer;application/x-bat;
Categories=System;Emulator;Utility;
Keywords=windows;wine;exe;msi;winlayer;starter;compat;
StartupNotify=true
