[Desktop Entry]
Name=Windows apps
GenericName=Windows apps
Comment=Install and run Windows programs (.exe, .msi) as Windows apps
Exec=/usr/local/bin/devos-open-app %f
Icon=devos-winlayer
Terminal=false
Type=Application
StartupWMClass=devos-winlayer

MimeType=application/x-msdownload;application/x-ms-dos-executable;application/vnd.microsoft.portable-executable;application/x-msdos-program;application/x-msi;application/x-ms-installer;application/x-bat;
Categories=System;Emulator;Utility;
Keywords=windows;wine;exe;msi;winlayer;console;install;apps;
StartupNotify=true
