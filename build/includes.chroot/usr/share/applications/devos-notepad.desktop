[Desktop Entry]
Version=1.0
Name=Notepad
GenericName=Plain text editor
Comment=Edit plain text files — like Windows Notepad (not sticky Notes)
Exec=/usr/local/bin/devos-notepad %F
Icon=devos-notepad
Terminal=false
Type=Application
Categories=Qt;Utility;TextEditor;
MimeType=text/plain;text/markdown;
Keywords=notepad;text;editor;txt;plain;
StartupNotify=true
StartupWMClass=devos-notepad
