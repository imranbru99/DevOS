[Desktop Entry]
Type=Application
Name=DevOS Features
GenericName=Apps & features
Comment=Add or remove apps and choose your default apps
Exec=/usr/bin/python3 /usr/local/share/devos/components/features/features_gui.py
Icon=preferences-system
Terminal=false
Categories=System;Settings;
Keywords=apps;features;install;uninstall;remove;office;word;excel;powerpoint;default apps;optional features;programs;
StartupNotify=true
StartupWMClass=devos-features
