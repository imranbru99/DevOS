[Desktop Entry]
Type=Application
Name=Scanner
GenericName=Scan documents and photos
Comment=Scan papers and photos to this PC
TryExec=/usr/bin/skanlite
Exec=/usr/bin/skanlite %U
Icon=devos-scanner
Terminal=false
Categories=Qt;Graphics;Scanning;OCR;
Keywords=scanner;scan;skanlite;document;photo;
StartupNotify=true
StartupWMClass=skanlite
