[Desktop Entry]
Type=Application
Version=1.0
Name=AI Actions
GenericName=Rewrite, translate or summarize selected text
Comment=Select text in any app and press Meta+Alt+A: rewrite, fix grammar, translate or summarize it with DevOS AI on this PC
