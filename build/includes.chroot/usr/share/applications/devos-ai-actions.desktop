[Desktop Entry]
Type=Application
Version=1.0
Name=AI Actions
GenericName=Rewrite or fix selected text
Comment=Select text, then open from the app menu (or Win+Alt+Shift+A) to rewrite, fix grammar, translate
Exec=/usr/local/bin/devos-ai-actions
Icon=devos-ai-actions
Terminal=false
StartupNotify=false
Categories=Utility;TextTools;
Keywords=ai;rewrite;grammar;translate;bangla;summarize;explain;reply;writing;selection;
X-KDE-Shortcuts=Meta+Alt+Shift+A
StartupWMClass=devos-ai-actions
NoDisplay=false
