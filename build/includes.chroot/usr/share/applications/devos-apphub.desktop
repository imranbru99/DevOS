[Desktop Entry]
Type=Application
Name=DevOS App Hub
GenericName=Install Windows, Android, and Linux apps
Comment=Install a downloaded .exe, .apk, .deb or AppImage safely
Exec=/usr/local/bin/devos-apphub %f
Icon=devos-apphub
Terminal=false
StartupWMClass=devos-apphub
MimeType=application/vnd.android.package-archive;application/vnd.debian.binary-package;application/vnd.appimage;application/x-msdownload;application/x-msi;
Categories=System;PackageManager;
Keywords=app;hub;install;exe;apk;deb;windows;android;
StartupNotify=true
