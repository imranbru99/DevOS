[Desktop Entry]
Type=Application
Name=Apps
GenericName=Installed apps & Store
Comment=Uninstall apps, browse stores, and manage app data
Exec=/usr/local/bin/devos-apps %U
Icon=devos-apps
Terminal=false
StartupNotify=true
StartupWMClass=devos-apps
Categories=System;Settings;
Keywords=uninstall;remove;apps;programs;cache;cookies;
