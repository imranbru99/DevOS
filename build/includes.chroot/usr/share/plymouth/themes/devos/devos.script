# DevOS boot splash.
# The screen size is 0 when this file is first read, and it changes again
# when the display mode switches. Every frame places the logo and the word
# from the live size. Measuring once leaves "DevOS" on the left.
Window.SetBackgroundTopColor(0.027, 0.039, 0.071);
Window.SetBackgroundBottomColor(0.027, 0.039, 0.071);

logo.image = Image("logo.png").Scale(148, 148);
logo.sprite = Sprite(logo.image);
logo.sprite.SetZ(20);

title.image = Image.Text("DevOS", 0.973, 0.980, 0.996, 1.0, "Ubuntu 32", "center");
title.sprite = Sprite(title.image);
title.sprite.SetZ(30);

status.image = Image.Text("Welcome", 0.490, 0.827, 0.988, 1.0, "Ubuntu 16", "center");
status.sprite = Sprite(status.image);
status.sprite.SetZ(30);

track.image = Image("track.png");
track.sprite = Sprite(track.image);
track.sprite.SetZ(15);

thumb.image = Image("thumb.png");
thumb.sprite = Sprite(thumb.image);
thumb.sprite.SetZ(16);

boot_progress = 0;
last_phrase = -1;

fun set_status(text) {
    global.status.image = Image.Text(text, 0.490, 0.827, 0.988, 1.0, "Ubuntu 16", "center");
    status.sprite.SetImage(status.image);
}

fun place() {
    screen_w = Window.GetWidth();
    screen_h = Window.GetHeight();
    if (screen_w < 64 || screen_h < 64)
        return;

    logo_w = logo.image.GetWidth();
    logo_h = logo.image.GetHeight();
    title_w = title.image.GetWidth();
    title_h = title.image.GetHeight();
    status_w = status.image.GetWidth();
    status_h = status.image.GetHeight();
    track_w = track.image.GetWidth();
    thumb_w = thumb.image.GetWidth();
    if (logo_w < 2) logo_w = 148;
    if (logo_h < 2) logo_h = 148;
    if (title_w < 2) title_w = 160;
    if (title_h < 2) title_h = 40;
    if (status_w < 2) status_w = 180;
    if (status_h < 2) status_h = 20;
    if (track_w < 2) track_w = 280;
    if (thumb_w < 2) thumb_w = 72;

    block = logo_h + 20 + title_h + 12 + status_h + 22 + 4;
    top = Window.GetY() + screen_h / 2 - block / 2;
    mid = Window.GetX() + screen_w / 2;

    logo.sprite.SetX(mid - logo_w / 2);
    logo.sprite.SetY(top);

    title_y = top + logo_h + 20;
    title.sprite.SetX(mid - title_w / 2);
    title.sprite.SetY(title_y);

    status_y = title_y + title_h + 12;
    status.sprite.SetX(mid - status_w / 2);
    status.sprite.SetY(status_y);

    track_x = mid - track_w / 2;
    track_y = status_y + status_h + 22;
    track.sprite.SetX(track_x);
    track.sprite.SetY(track_y);

    span = track_w - thumb_w;
    if (span < 1)
        span = 1;
    travel = Math.Int(Plymouth.GetTime() * 80);
    offset = travel - (Math.Int(travel / span) * span);
    thumb.sprite.SetX(track_x + offset);
    thumb.sprite.SetY(track_y);
}

fun boot_progress_callback(duration, progress) {
    if (progress < 0)
        progress = 0;
    if (progress > 1)
        progress = 1;
    global.boot_progress = progress;
}

fun refresh_callback() {
    now = Plymouth.GetTime();
    phrase = Math.Int(now / 2.4);
    if (phrase != last_phrase) {
        global.last_phrase = phrase;
        # Friendly words for every boot (live USB and installed PC).
        # Do not mention the installer here — after install that feels wrong.
        step = phrase - (Math.Int(phrase / 4) * 4);
        if (boot_progress > 0.78)
            set_status("Almost there");
        else if (step == 0)
            set_status("Welcome");
        else if (step == 1)
            set_status("Starting DevOS");
        else if (step == 2)
            set_status("Getting your desktop ready");
        else
            set_status("Just a moment");
    }
    place();
}

Plymouth.SetBootProgressFunction(boot_progress_callback);
Plymouth.SetRefreshFunction(refresh_callback);
