# DevOS motion splash — DRM-safe, no method chaining, no backdrop plates.
# Earlier theme aborted on some Intel TVs (Image().Scale / multi-PNG), leaving
# only the plain title/status bar. This script stays dumb and loud.
Window.SetBackgroundTopColor(0.05, 0.45, 0.85);
Window.SetBackgroundBottomColor(0.02, 0.15, 0.40);

# Optional glow orbs (never chained Scale). If Image fails, sprites stay empty.
orb_a.image = Image("orb_cyan.png");
orb_a.sprite = Sprite(orb_a.image);
orb_a.sprite.SetZ(5);

orb_b.image = Image("orb_sky.png");
orb_b.sprite = Sprite(orb_b.image);
orb_b.sprite.SetZ(6);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetZ(20);

track.image = Image("track.png");
track.sprite = Sprite(track.image);
track.sprite.SetZ(30);

thumb.image = Image("thumb.png");
thumb.sprite = Sprite(thumb.image);
thumb.sprite.SetZ(31);

# Text-only layers — these are the motion the TV must show.
eyebrow.image = Image.Text("WELCOME", 1, 1, 1, 1, "Sans 20");
eyebrow.sprite = Sprite(eyebrow.image);
eyebrow.sprite.SetZ(40);

title.image = Image.Text("DevOS", 1, 1, 1, 1, "Sans 48");
title.sprite = Sprite(title.image);
title.sprite.SetZ(42);

motion.image = Image.Text("DevOS Motion", 0.2, 1, 1, 1, "Sans 28");
motion.sprite = Sprite(motion.image);
motion.sprite.SetZ(43);

status.image = Image.Text("Starting DevOS", 1, 1, 1, 1, "Sans 22");
status.sprite = Sprite(status.image);
status.sprite.SetZ(42);

bar.image = Image.Text("[ #################### ]", 0.3, 0.95, 1, 1, "Sans 26");
bar.sprite = Sprite(bar.image);
bar.sprite.SetZ(44);

boot_progress = 0;
last_tick = -1;

fun tri(now, period) {
    if (period < 1)
        period = 1;
    t = now - Math.Int(now / period) * period;
    half = period / 2;
    if (t > half)
        t = period - t;
    return t / half;
}

fun width_or(img, fallback) {
    w = img.GetWidth();
    if (w < 2)
        return fallback;
    return w;
}

fun height_or(img, fallback) {
    h = img.GetHeight();
    if (h < 2)
        return fallback;
    return h;
}

fun set_motion(step, breath) {
    if (step == 0)
        t = ">>> DevOS Motion <<<";
    else if (step == 1)
        t = ">>>> DevOS Motion <<<<";
    else if (step == 2)
        t = "> DevOS Motion <";
    else
        t = "DevOS Motion";
    global.motion.image = Image.Text(t, 0.15 + breath * 0.85, 1, 1, 1, "Sans 28");
    motion.sprite.SetImage(motion.image);
}

fun set_bar(step) {
    if (step == 0)
        t = "[ ##                  ]";
    else if (step == 1)
        t = "[ ######              ]";
    else if (step == 2)
        t = "[ ##########          ]";
    else if (step == 3)
        t = "[ ##############      ]";
    else if (step == 4)
        t = "[ ##################  ]";
    else
        t = "[ #################### ]";
    global.bar.image = Image.Text(t, 0.25, 1, 1, 1, "Sans 26");
    bar.sprite.SetImage(bar.image);
}

fun set_status(text) {
    global.status.image = Image.Text(text, 1, 1, 1, 1, "Sans 22");
    status.sprite.SetImage(status.image);
}

fun place() {
    screen_w = Window.GetWidth();
    screen_h = Window.GetHeight();
    if (screen_w < 64)
        return;
    if (screen_h < 64)
        return;

    now = Plymouth.GetTime();
    mid = Window.GetX() + screen_w / 2;
    top = Window.GetY() + screen_h / 4;
    bob = Math.Int((tri(now, 1.2) * 2 - 1) * 16);
    slide = Math.Int((tri(now, 1.6) * 2 - 1) * screen_w * 16 / 100);

    ew = width_or(eyebrow.image, 120);
    eh = height_or(eyebrow.image, 22);
    tw = width_or(title.image, 240);
    th = height_or(title.image, 56);
    mw = width_or(motion.image, 280);
    mh = height_or(motion.image, 32);
    sw = width_or(status.image, 260);
    sh = height_or(status.image, 28);
    bw = width_or(bar.image, 360);

    eyebrow.sprite.SetX(mid - ew / 2);
    eyebrow.sprite.SetY(top + bob);
    eyebrow.sprite.SetOpacity(1);

    title_y = top + eh + 12 + bob;
    title.sprite.SetX(mid - tw / 2);
    title.sprite.SetY(title_y);
    title.sprite.SetOpacity(1);

    motion.sprite.SetX(mid - mw / 2 + slide);
    motion.sprite.SetY(title_y + th + 10);
    motion.sprite.SetOpacity(1);

    status.sprite.SetX(mid - sw / 2);
    status.sprite.SetY(title_y + th + mh + 18);
    status.sprite.SetOpacity(1);

    bar.sprite.SetX(mid - bw / 2 - slide / 2);
    bar.sprite.SetY(title_y + th + mh + sh + 28);
    bar.sprite.SetOpacity(1);

    # Orbs / logo — best effort, never required.
    oa_w = width_or(orb_a.image, 1);
    oa_h = height_or(orb_a.image, 1);
    if (oa_w > 2) {
        drift = tri(now, 2.2);
        orb_a.sprite.SetX(mid - oa_w / 2 + Math.Int((drift * 2 - 1) * screen_w * 28 / 100));
        orb_a.sprite.SetY(title_y - oa_h / 2);
        orb_a.sprite.SetOpacity(0.8);
    }

    ob_w = width_or(orb_b.image, 1);
    ob_h = height_or(orb_b.image, 1);
    if (ob_w > 2) {
        drift2 = tri(now + 0.7, 2.8);
        orb_b.sprite.SetX(mid - ob_w / 2 + Math.Int((drift2 * 2 - 1) * screen_w * 32 / 100));
        orb_b.sprite.SetY(title_y - ob_h / 2 + 40);
        orb_b.sprite.SetOpacity(0.75);
    }

    lw = width_or(logo.image, 1);
    lh = height_or(logo.image, 1);
    if (lw > 2) {
        logo.sprite.SetX(mid - lw / 2);
        logo.sprite.SetY(title_y - lh - 12 + bob);
        logo.sprite.SetOpacity(0.95);
    }

    trw = width_or(track.image, 1);
    thw = width_or(thumb.image, 1);
    thh = height_or(thumb.image, 1);
    if (trw > 2) {
        track_x = mid - trw / 2;
        track_y = title_y + th + mh + sh + 70;
        track.sprite.SetX(track_x);
        track.sprite.SetY(track_y);
        span = trw - thw;
        if (span < 1)
            span = 1;
        travel = Math.Int(now * 340);
        cycle = travel - Math.Int(travel / (span * 2)) * span * 2;
        off = cycle;
        if (cycle > span)
            off = span * 2 - cycle;
        thumb.sprite.SetX(track_x + off);
        thumb.sprite.SetY(track_y);
        thumb.sprite.SetOpacity(1);
        track.sprite.SetOpacity(1);
    }
}

fun boot_progress_callback(duration, progress) {
    if (progress < 0)
        progress = 0;
    if (progress > 1)
        progress = 1;
    global.boot_progress = progress;
}

fun refresh_callback() {
    now = Plymouth.GetTime();
    breath = tri(now, 0.9);

    # Loud wash — must read as motion even with zero PNGs.
    Window.SetBackgroundTopColor(0.02 + breath * 0.30, 0.30 + breath * 0.55, 0.55 + breath * 0.45);
    Window.SetBackgroundBottomColor(0.01 + breath * 0.18, 0.10 + breath * 0.35, 0.28 + breath * 0.40);

    tick = Math.Int(now * 6);
    if (tick != last_tick) {
        global.last_tick = tick;
        step = tick - Math.Int(tick / 6) * 6;
        set_motion(step - Math.Int(step / 4) * 4, breath);
        set_bar(step);

        phrase = Math.Int(now / 1.3);
        p = phrase - Math.Int(phrase / 4) * 4;
        dots = tick - Math.Int(tick / 4) * 4;
        if (dots == 0)
            e = "";
        else if (dots == 1)
            e = ".";
        else if (dots == 2)
            e = "..";
        else
            e = "...";
        if (boot_progress > 0.85)
            set_status("Almost there" + e);
        else if (p == 0)
            set_status("Welcome" + e);
        else if (p == 1)
            set_status("Starting DevOS" + e);
        else if (p == 2)
            set_status("DevOS Motion" + e);
        else
            set_status("Loading desktop" + e);
    }
    place();
}

Plymouth.SetBootProgressFunction(boot_progress_callback);
Plymouth.SetRefreshFunction(refresh_callback);
place();
