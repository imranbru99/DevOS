#!/bin/bash
# Apply CPU and disk settings for best responsiveness under heavy Chrome / AI load.
# On AC (or desktop with no battery): prefer performance clocks.
# On battery: schedutil + balance_performance so laptops still last.
set -u

on_battery=0
for supply in /sys/class/power_supply/*; do
    [ -d "$supply" ] || continue
    type="$(cat "$supply/type" 2>/dev/null || true)"
    case "$type" in
        Battery)
            status="$(cat "$supply/status" 2>/dev/null || true)"
            # Discharging / Not charging with capacity = on battery.
            if [ "$status" = "Discharging" ]; then
                on_battery=1
                break
            fi
            ;;
    esac
done

for gov_path in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    [ -e "$gov_path" ] || continue
    available="$(cat "${gov_path%/*}/scaling_available_governors" 2>/dev/null || true)"
    if [ "$on_battery" -eq 0 ] && printf '%s' "$available" | grep -qw performance; then
        echo performance > "$gov_path" 2>/dev/null || true
    elif printf '%s' "$available" | grep -qw schedutil; then
        echo schedutil > "$gov_path" 2>/dev/null || true
    elif printf '%s' "$available" | grep -qw ondemand; then
        echo ondemand > "$gov_path" 2>/dev/null || true
    fi
done

epp_value=performance
[ "$on_battery" -eq 1 ] && epp_value=balance_performance
for pref in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
    [ -e "$pref" ] || continue
    echo "$epp_value" > "$pref" 2>/dev/null || true
done

if [ -f /sys/kernel/mm/transparent_hugepage/defrag ]; then
    echo defer+madvise > /sys/kernel/mm/transparent_hugepage/defrag 2>/dev/null || true
fi

if [ -f /sys/kernel/mm/transparent_hugepage/enabled ]; then
    echo madvise > /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null || true
fi

# Prefer low-latency PCIe when on AC (helps NVMe + GPU under load).
if [ "$on_battery" -eq 0 ] && [ -f /sys/module/pcie_aspm/parameters/policy ]; then
    echo performance > /sys/module/pcie_aspm/parameters/policy 2>/dev/null || true
fi

for dev in /sys/block/*; do
    name="$(basename "$dev")"
    case "$name" in
        loop*|ram*|dm-*|sr*|fd*|zram*|nbd*) continue ;;
    esac
    sched="$dev/queue/scheduler"
    [ -f "$sched" ] || continue
    rot="$(cat "$dev/queue/rotational" 2>/dev/null || echo 1)"
    available="$(tr -d '[]' < "$sched" 2>/dev/null || true)"
    choices="mq-deadline bfq"
    ahead=128
    if [[ "$name" == nvme* ]]; then
        choices="none mq-deadline"
        ahead=256
    elif [ "$rot" != "0" ]; then
        choices="bfq mq-deadline"
        ahead=1024
        # Mechanical HDD: configure idle spindown (10 minutes = 600s) for quiet operation
        if command -v gdbus >/dev/null 2>&1; then
            for drive_obj in /org/freedesktop/UDisks2/drives/*; do
                gdbus call --system --dest org.freedesktop.UDisks2 \
                    --object-path "$drive_obj" \
                    --method org.freedesktop.UDisks2.Drive.SetConfiguration \
                    "{'standby-timeout': <uint32 600>}" "{}" >/dev/null 2>&1 || true
            done
        fi
    fi
    for candidate in $choices; do
        if printf '%s' "$available" | grep -qw "$candidate"; then
            echo "$candidate" > "$sched" 2>/dev/null || true
            break
        fi
    done
    echo "$ahead" > "$dev/queue/read_ahead_kb" 2>/dev/null || true
done

exit 0
