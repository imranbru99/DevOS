#!/bin/bash
# Ensure the Antigravity KDE / Studio wrapper is ready (second pipeline agent slot).
# Installs a dedicated launcher binary so the IDE does not share the main
# Google Antigravity Electron single-instance lock by accident.
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    echo "Run: sudo devos-install-antigravity-kde" >&2
    exit 1
fi

WRAPPER=/usr/local/bin/antigravity-kde
BIN=/opt/antigravity/antigravity
IDE_DIR=/usr/local/share/devos/antigravity-ide/bin
IDE_LOCAL="${IDE_DIR}/antigravity-ide"

if [ ! -x "$BIN" ] && [ ! -x "$IDE_LOCAL" ]; then
    if [ -x /usr/local/sbin/devos-install-antigravity ]; then
        /usr/local/sbin/devos-install-antigravity
    fi
fi

if [ ! -x "$WRAPPER" ]; then
    echo "Antigravity KDE wrapper missing at $WRAPPER." >&2
    exit 1
fi

if [ ! -x "$BIN" ] \
    && [ ! -x "$IDE_LOCAL" ] \
    && [ ! -x "${HOME:-/root}/.local/lib/antigravity-ide/antigravity-ide" ]; then
    echo "Antigravity IDE binary not found. Install Google Antigravity first (DevOS Features → Google Antigravity)." >&2
    exit 1
fi

# Dedicated IDE entrypoint: small wrapper that always re-enters antigravity-kde
# with isolation env, even if a menu/shortcut points at this path directly.
if [ -x "$BIN" ]; then
    mkdir -p "$IDE_DIR"
    cat > "$IDE_LOCAL" <<'EOF'
#!/usr/bin/env bash
# Dedicated Antigravity IDE entry — always use the isolated DevOS launcher.
exec /usr/local/bin/antigravity-kde "$@"
EOF
    chmod 755 "$IDE_LOCAL"
fi

# Unhide Start-menu launcher when the real binary exists.
if [ -x "$BIN" ] || [ -x "$IDE_LOCAL" ]; then
    for desktop in devos-antigravity-studio.desktop antigravity-kde.desktop; do
        for dir in /usr/local/share/applications /usr/share/applications; do
            path="${dir}/${desktop}"
            if [ -f "$path" ]; then
                # Show the Studio tile; keep internal aliases as-is if already hidden on purpose.
                if [ "$desktop" = "devos-antigravity-studio.desktop" ]; then
                    sed -i \
                        -e '/^Hidden=true$/d' \
                        -e '/^NoDisplay=true$/d' \
                        -e '/^X-DevOS-Hidden=true$/d' \
                        "$path" 2>/dev/null || true
                fi
            fi
        done
    done
fi

# Ensure the command is findable even when /usr/local/bin is missing from PATH.
if [ -x "$WRAPPER" ]; then
    mkdir -p /usr/bin
    ln -sfn "$WRAPPER" /usr/bin/antigravity-kde
fi

echo "Antigravity KDE (Studio) is ready."
echo "Launch with: antigravity-kde   (or /usr/local/bin/antigravity-kde)"
echo "Separate account from Google Antigravity — quit the main app first if both share a window."
exit 0
