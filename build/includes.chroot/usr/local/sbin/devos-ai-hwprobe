#!/usr/bin/env python3
# Measure this PC at live boot and write the facts the installer's
# "Choose your DevOS AI" page reads (aimodel-hw.js): RAM, processor, disk,
# which models fit and which one to pre-select. Runs before the installer
# opens (devos-ai-hwprobe.service); the ISO ships a safe default file in case
# it never runs.
import json
import os
import sys

sys.path.insert(0, "/usr/local/share/devos/components/ai-core")
import models_cli  # noqa: E402

target = sys.argv[1] if len(sys.argv) > 1 else "/etc/calamares/branding/devos/aimodel-hw.js"
info = models_cli.hardware(installer=True)
body = ".pragma library\n// Written by devos-ai-hwprobe at boot.\nvar hw = " + json.dumps(info, indent=1) + ";\n"
tmp = target + ".new"
with open(tmp, "w", encoding="utf-8") as handle:
    handle.write(body)
os.chmod(tmp, 0o644)
os.replace(tmp, target)
print(f"DevOS AI: {info['ram_gb']} GB RAM, {info['threads']} threads -> recommended {info['recommended']}")
