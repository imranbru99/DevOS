#!/bin/bash
# The live USB must open the disk installer. Casper can replace the login
# session with the Plasma desktop, and the status page then covers setup.
set -u

grep -q 'boot=casper' /proc/cmdline || exit 0

mkdir -p /etc/sddm.conf.d /run/devos-hidden-sessions
# The installer starts X11 applications, not a Wayland compositor. A same-named
# Wayland entry takes precedence in SDDM and starts the script without Xorg.
rm -f /usr/share/wayland-sessions/devos-install.desktop
# Hide every normal desktop session on this boot only.
# Ensure any fallback entry (plasma.desktop, plasmax11.desktop) maps to devos-install.desktop
# so casper or SDDM autologin can never spawn an empty session on real hardware.
for session in /usr/share/xsessions/*.desktop /usr/share/wayland-sessions/*.desktop; do
    [ -f "$session" ] || continue
    name=$(basename "$session")
    [ "$name" = "devos-install.desktop" ] && continue
    hidden="/run/devos-hidden-sessions/$name"
    cp -a "$session" "$hidden" 2>/dev/null || true
    if [[ "$session" == /usr/share/xsessions/* ]] && { [ "$name" = "plasma.desktop" ] || [ "$name" = "plasmax11.desktop" ]; }; then
        mount --bind /usr/share/xsessions/devos-install.desktop "$session" 2>/dev/null || cp -f /usr/share/xsessions/devos-install.desktop "$session" 2>/dev/null || true
    else
        mount --bind /dev/null "$session" 2>/dev/null || rm -f "$session"
    fi
done

# Kill and remove any Ubuntu installer leftovers
killall -9 ubuntu-desktop-bootstrap subiquity curtin 2>/dev/null || true
rm -f \
    /etc/xdg/autostart/ubuntu-desktop-bootstrap.desktop \
    /etc/xdg/autostart/ubiquity.desktop \
    /etc/xdg/autostart/org.gnome.InitialSetup.desktop \
    /usr/share/applications/ubuntu-desktop-bootstrap.desktop \
    /var/lib/snapd/desktop/applications/ubuntu-desktop-bootstrap.desktop \
    /home/devos/.config/autostart/ubuntu-desktop-bootstrap.desktop \
    2>/dev/null || true

# Ensure user 'devos' is in autologin / video groups and has no password lock
groupadd -f nopasswdlogin 2>/dev/null || true
groupadd -f autologin 2>/dev/null || true
if id devos >/dev/null 2>&1; then
    usermod -a -G nopasswdlogin,autologin,sudo,video,render,input devos 2>/dev/null || true
    passwd -d devos 2>/dev/null || true
fi

# Ensure PAM unconditionally permits autologin on live boot so "Login failed" is impossible
mkdir -p /etc/pam.d
cat > /etc/pam.d/sddm-autologin << 'EOF'
#%PAM-1.0
auth    required        pam_env.so
auth    required        pam_permit.so
account required        pam_permit.so
password required       pam_permit.so
session required        pam_permit.so
EOF


cat > /etc/sddm.conf.d/zz-devos-install.conf << 'EOF'
[Autologin]
User=devos
# One valid session file only. SDDM does not accept a comma list, and an unknown
# name leaves autologin without a session (blank screen or a bare terminal).
Session=devos-install.desktop
Relogin=false

[General]
DisplayServer=x11
EOF

# casper-bottom/15autologin appends "Session=plasma.desktop" to /etc/sddm.conf.
# SDDM reads /etc/sddm.conf after sddm.conf.d, so that line wins, and plasma.desktop
# was just hidden above: autologin starts an empty session and the installer
# never appears. Replace the file so the installer session is the only choice.
cat > /etc/sddm.conf << 'EOF'
[Autologin]
User=devos
Session=devos-install.desktop
Relogin=false

[General]
DisplayServer=x11
EOF

systemctl stop devos-dashboard.service >/dev/null 2>&1 || true
exit 0
