#!/bin/bash
# Re-apply the DevOS name on top of the Ubuntu base.
# Safe to run more than once: image build, apt upgrades, and the installed system.
set -u

ensure_divert() {
    local f="$1"
    if ! command -v dpkg-divert >/dev/null 2>&1; then
        return 0
    fi
    if dpkg-divert --list "$f" 2>/dev/null | grep -q "diversion of ${f}"; then
        return 0
    fi
    dpkg-divert --local --rename --divert "${f}.ubuntu" --add "$f" >/dev/null 2>&1 || \
        dpkg-divert --local --divert "${f}.ubuntu" --add "$f" >/dev/null 2>&1 || true
}

# Follow Ubuntu's real base version during a release upgrade. The diverted
# upstream file is updated by base-files; never pin an installed PC to the ISO.
base_identity=/usr/lib/os-release.ubuntu
[ -f "$base_identity" ] || base_identity=/etc/os-release
base_version=$(. "$base_identity" 2>/dev/null; printf '%s' "${VERSION_ID:-26.04}")
base_codename=$(. "$base_identity" 2>/dev/null; printf '%s' "${UBUNTU_CODENAME:-${VERSION_CODENAME:-resolute}}")

# Keep base-files upgrades from putting the Ubuntu name back.
ensure_divert /usr/lib/os-release
ensure_divert /etc/lsb-release
ensure_divert /etc/issue
ensure_divert /etc/issue.net

mkdir -p /usr/lib /etc/default/grub.d /usr/share/plymouth/themes/devos /etc/plymouth

cat > /usr/lib/os-release << EOF
NAME="DevOS"
VERSION="${base_version} LTS"
ID=devos
ID_LIKE="ubuntu debian"
PRETTY_NAME="DevOS ${base_version} LTS"
VERSION_ID="${base_version}"
VERSION_CODENAME=${base_codename}
UBUNTU_CODENAME=${base_codename}
HOME_URL="https://github.com/imranbru99/DevOS"
SUPPORT_URL="https://github.com/imranbru99/DevOS/issues"
BUG_REPORT_URL="https://github.com/imranbru99/DevOS/issues"
EOF
ln -sfn ../usr/lib/os-release /etc/os-release

cat > /etc/lsb-release << EOF
DISTRIB_ID=DevOS
DISTRIB_RELEASE=${base_version}
DISTRIB_CODENAME=${base_codename}
DISTRIB_DESCRIPTION="DevOS ${base_version} LTS"
EOF

printf '%s\n' "DevOS ${base_version} LTS \n \l" '' > /etc/issue
printf '%s\n' "DevOS ${base_version} LTS" > /etc/issue.net

cat > /etc/default/grub.d/devos.cfg << 'EOF'
# DevOS boot-menu title. This file is read after /etc/default/grub.
GRUB_DISTRIBUTOR="DevOS"
EOF

if [ -f /etc/default/grub ] && grep -q '^GRUB_DISTRIBUTOR=' /etc/default/grub; then
    sed -i 's|^GRUB_DISTRIBUTOR=.*|GRUB_DISTRIBUTOR="DevOS"|' /etc/default/grub
fi

# Keep the animated script splash. The text theme is only three dots.

cat > /etc/plymouth/plymouthd.conf << 'EOF'
[Daemon]
Theme=devos
ShowDelay=0
EOF
ln -sfn devos/devos.plymouth /usr/share/plymouth/themes/default.plymouth || true
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme devos >/dev/null 2>&1 || true
fi

# Brand plasma icon with DevOS logo across icon themes
if [ -f /usr/share/pixmaps/devos-logo.png ]; then
    for size in 16 22 24 32 48 64 128 256 512; do
        apps_dir="/usr/share/icons/hicolor/${size}x${size}/apps"
        places_dir="/usr/share/icons/hicolor/${size}x${size}/places"
        mkdir -p "$apps_dir" "$places_dir"
        cp -f /usr/share/pixmaps/devos-logo.png "${apps_dir}/plasma.png" 2>/dev/null || true
        cp -f /usr/share/pixmaps/devos-logo.png "${apps_dir}/devos-logo.png" 2>/dev/null || true
        cp -f /usr/share/pixmaps/devos-logo.png "${places_dir}/start-here-kde.png" 2>/dev/null || true
        cp -f /usr/share/pixmaps/devos-logo.png "${places_dir}/start-here-kde-symbolic.png" 2>/dev/null || true
        cp -f /usr/share/pixmaps/devos-logo.png "${places_dir}/start-here.png" 2>/dev/null || true
        cp -f /usr/share/pixmaps/devos-logo.png "${places_dir}/distributor-logo.png" 2>/dev/null || true
    done
    mkdir -p /usr/share/icons/hicolor/scalable/apps /usr/share/icons/hicolor/scalable/places
    cp -f /usr/share/pixmaps/devos-logo.png /usr/share/icons/hicolor/scalable/apps/plasma.png 2>/dev/null || true
    cp -f /usr/share/pixmaps/devos-logo.png /usr/share/icons/hicolor/scalable/apps/devos-logo.png 2>/dev/null || true
fi

# Desktop names: Files, Terminal, Settings, the "DevOS" session.
if [ -f /usr/local/sbin/devos-debrand-desktop ]; then
    /bin/bash /usr/local/sbin/devos-debrand-desktop || true
fi

exit 0
