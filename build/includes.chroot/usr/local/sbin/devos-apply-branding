#!/bin/bash
# Apply DevOS app icons, desktop launchers, and OS branding (no Ubuntu/Plasma leaks).
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    echo "Run: sudo devos-apply-branding" >&2
    exit 1
fi

SRC_ROOT="${DEVOS_SRC:-/home/imran/project/dev-os}"
CHROOT_APPS="${SRC_ROOT}/build/includes.chroot/usr/share/applications"
CHROOT_ICONS="${SRC_ROOT}/build/includes.chroot/usr/share/icons/hicolor/scalable/apps"
CHROOT_BIN="${SRC_ROOT}/build/includes.chroot/usr/local/bin"
CHROOT_ABOUT="${SRC_ROOT}/build/includes.chroot/etc/xdg/kcm-about-distrorc"
CHROOT_OS="${SRC_ROOT}/build/includes.chroot/etc/os-release"

# 1) Icons
install -d /usr/share/icons/hicolor/scalable/apps
if [ -d "${CHROOT_ICONS}" ]; then
    cp -a "${CHROOT_ICONS}"/devos-*.svg /usr/share/icons/hicolor/scalable/apps/ 2>/dev/null || true
fi
gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
xdg-icon-resource forceupdate >/dev/null 2>&1 || true

# 2) Desktop launchers from image tree
if [ -d "${CHROOT_APPS}" ]; then
    install -d /usr/share/applications
    for f in "${CHROOT_APPS}"/devos-*.desktop; do
        [ -f "$f" ] || continue
        install -m 644 "$f" "/usr/share/applications/$(basename "$f")"
    done
fi

# 3) Launch helpers
install -m 755 "${CHROOT_BIN}/devos-run" /usr/local/bin/devos-run
# Refresh wrappers that still exec python3 without -a
for w in clipboard emoji features islamic familysafe; do
    src="${CHROOT_BIN}/devos-${w}"
    [ -f "$src" ] || continue
    install -m 755 "$src" "/usr/local/bin/devos-${w}"
done

# 4) Identity module
install -d /usr/local/share/devos/components
install -m 644 "${SRC_ROOT}/components/app_identity.py" /usr/local/share/devos/components/app_identity.py

# 5) About System / os-release branding
if [ -f "${CHROOT_ABOUT}" ]; then
    install -d /etc/xdg
    install -m 644 "${CHROOT_ABOUT}" /etc/xdg/kcm-about-distrorc
fi
# Force current version string even if older image file was copied earlier.
cat > /etc/xdg/kcm-about-distrorc <<'EOF'
[General]
Name=DevOS
LogoPath=/usr/share/pixmaps/devos-logo.png
Website=https://github.com/imranbru99/DevOS
Version=26.04 LTS
Variant=Desktop
UseOSReleaseVersion=true
EOF

if [ -f "${CHROOT_OS}" ]; then
    install -m 644 "${CHROOT_OS}" /etc/os-release
    install -m 644 "${CHROOT_OS}" /usr/lib/os-release
fi
cat > /etc/lsb-release <<'EOF'
DISTRIB_ID=DevOS
DISTRIB_RELEASE=26.04
DISTRIB_CODENAME=resolute
DISTRIB_DESCRIPTION="DevOS 26.04 LTS"
EOF

# GRUB distributor
if [ -f /etc/default/grub ]; then
    sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="DevOS"/' /etc/default/grub || true
fi

# Hide stock Python interpreter from the app menu (devs can still run python3).
for pydesk in /usr/share/applications/python3*.desktop; do
    [ -f "$pydesk" ] || continue
    install -d /usr/local/share/applications
    cat > "/usr/local/share/applications/$(basename "$pydesk")" <<EOF
[Desktop Entry]
Type=Application
Name=Python
Exec=python3
NoDisplay=true
Hidden=true
EOF
done

# Drop stale user overrides that force generic icons / python3 Exec.
for f in /home/*/.local/share/applications/devos-*.desktop; do
    [ -f "$f" ] || continue
    # Keep only intentional user customizations that aren't broken copies.
    if grep -qE '^Icon=(edit-paste|preferences-|applications-|face-|view-|folder-|tools-|computer|fingerprint|smartphone|security-|audio-|code|backup)' "$f" \
        || grep -qE '^Exec=(/usr/bin/)?python3 ' "$f"; then
        rm -f "$f"
    fi
done

# Refresh desktop database
update-desktop-database /usr/share/applications >/dev/null 2>&1 || true

echo "DevOS branding applied: icons, launchers, About System, os-release."
echo "Log out and back in (or restart plasmashell) to refresh taskbar icons."
