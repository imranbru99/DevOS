#!/bin/bash
# Move the DevOS EFI entry in front of Windows Boot Manager.
# A missing entry is not a failure: BIOS machines have no EFI variables.
set +e

if [ ! -d /sys/firmware/efi ]; then
    exit 0
fi
if ! command -v efibootmgr >/dev/null 2>&1; then
    exit 0
fi

# QEMU and some firmware block forever on EFI variables. A hang here is
# reported as "External command failed to finish."
boot="$(timeout -k 5 15 efibootmgr 2>/dev/null)" || boot=""

# Match Boot#### whether or not it is the current (*) entry. From the live USB
# the asterisk sits on the USB entry, not on DevOS — requiring * skipped DevOS
# and left Windows first after reboot.
pick_entry() {
    local label="$1"
    # BRE: optional literal '*', then spaces, then the EFI description.
    printf '%s\n' "$boot" | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)\*\?[[:space:]]*'"${label}"'.*/\1/p' | head -n 1
}

first="$(pick_entry 'DevOS')"
if [ -z "$first" ]; then
    first="$(pick_entry 'ubuntu')"
fi
if [ -z "$first" ]; then
    exit 0
fi

order="$(printf '%s\n' "$boot" | sed -n 's/^BootOrder:[[:space:]]*//p' | tr -d ' ')"
new="$first"
old_ifs="$IFS"
IFS=','
for id in $order; do
    [ -n "$id" ] || continue
    if [ "$(printf '%s' "$id" | tr '[:lower:]' '[:upper:]')" = "$(printf '%s' "$first" | tr '[:lower:]' '[:upper:]')" ]; then
        continue
    fi
    new="${new},${id}"
done
IFS="$old_ifs"

# Put DevOS first and set BootNext so the immediate reboot skips Windows.
timeout -k 5 15 efibootmgr -o "$new" >/dev/null 2>&1 || true
timeout -k 5 15 efibootmgr -n "$first" >/dev/null 2>&1 || true
# Some firmware ignores BootOrder until Windows Boot Manager is deactivated.
win="$(pick_entry 'Windows Boot Manager')"
if [ -n "$win" ] && [ "$win" != "$first" ]; then
    timeout -k 5 15 efibootmgr -A -b "$win" >/dev/null 2>&1 || true
fi
timeout -k 5 15 efibootmgr -a -b "$first" >/dev/null 2>&1 || true
exit 0
