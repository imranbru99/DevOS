#!/bin/bash
# Register the exact EFI partition selected and mounted by Calamares.
set -euo pipefail
export LC_ALL=C

esp="$1"
loader='\EFI\DevOS\shimx64.efi'
device="$(findmnt -n -o SOURCE --mountpoint "$esp")"
disk_name="$(lsblk -ndo PKNAME "$device")"
kernel_name="$(lsblk -ndo KNAME "$device")"
part="$(cat "/sys/class/block/$kernel_name/partition")"
partuuid="$(lsblk -ndo PARTUUID "$device")"
test -n "$disk_name"
test -n "$part"
test -n "$partuuid"
test -s "$esp/EFI/DevOS/shimx64.efi"

efi() { timeout -k 2 12 efibootmgr "$@"; }

matching_entry() {
    # Match partition identity and path. Labels are display text only.
    awk -v id="$partuuid" -v part="$part" '
        BEGIN {
            id = tolower(id)
            if (length(id) == 36)
                device_path = "hd(" part ",gpt," id ","
            else
                device_path = "hd(" part ",mbr,0x" substr(id, 1, 8) ","
        }
        /^Boot[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]/ {
            line = tolower($0)
            if (index(line, device_path) && index(line, "file(\\efi\\devos\\shimx64.efi)")) {
                print substr($0, 5, 4)
                exit
            }
        }'
}

entries="$(efi -v)"
entry="$(matching_entry <<< "$entries")"
if [ -z "$entry" ]; then
    efi -C -d "/dev/$disk_name" -p "$part" -L DevOS -l "$loader"
    entries="$(efi -v)"
    entry="$(matching_entry <<< "$entries")"
    test -n "$entry"
fi
order="$(sed -n 's/^BootOrder:[[:space:]]*//p' <<< "$entries")"
new_order="$entry"
IFS=, read -ra old_entries <<< "$order"
for old in "${old_entries[@]}"; do
    if [ -n "$old" ] && [ "${old^^}" != "${entry^^}" ]; then
        new_order+=",$old"
    fi
done
efi -b "$entry" -a
efi -o "$new_order"
efi -n "$entry"
entries="$(efi -v)"
test "$(matching_entry <<< "$entries")" = "$entry"
test "$(sed -n 's/^BootOrder:[[:space:]]*//p' <<< "$entries")" = "$new_order"
test "$(sed -n 's/^BootNext:[[:space:]]*//p' <<< "$entries")" = "$entry"
