#!/bin/bash
# Calamares runs this inside the new installation, not on the live USB.
# The live image must keep casper. The installed disk must not.
set -u

export DEBIAN_FRONTEND=noninteractive

# Calamares bind-mounts the live system's /run into this new install.
# Removing casper runs "systemctl daemon-reload", which then waits on the
# live system. This step is killed at 5 minutes and the installer says
# "External command failed to finish." While /run/devos-chroot-install
# exists, systemctl in this install does nothing. The file is on the live
# /run, so a reboot of the new system does not keep that behaviour.
# /run/devos-skip-initramfs does the same for the boot-image rebuild, and
# only for this script. The initramfs step later does that rebuild once.
install_wrapper() {
    bin="$1"
    real="${bin}.devos-real"
    flag="$2"
    if [ -x "$real" ] || [ ! -x "$bin" ]; then
        return 0
    fi
    mv "$bin" "$real"
    cat > "$bin" << EOF
#!/bin/sh
if [ -f "$flag" ]; then
    exit 0
fi
exec "$real" "\$@"
EOF
    chmod 755 "$bin"
}
install_wrapper /usr/bin/systemctl /run/devos-chroot-install
install_wrapper /usr/sbin/update-initramfs /run/devos-skip-initramfs
touch /run/devos-chroot-install /run/devos-skip-initramfs

echo "==> Removing the live-session boot hooks from the installed system"
# --no-triggers: do not rebuild the boot image or run shim/grub from here.
# timeout: a stuck package script must not use up the whole install step.
timeout -k 5 60 dpkg --purge --no-triggers --force-depends casper >/dev/null 2>&1 || true
timeout -k 5 30 dpkg --purge --no-triggers --force-depends discover laptop-detect >/dev/null 2>&1 || true
echo "==> Live packages removed"

rm -rf \
    /usr/share/initramfs-tools/scripts/casper \
    /usr/share/initramfs-tools/scripts/casper-bottom \
    /usr/share/initramfs-tools/scripts/casper-premount \
    /usr/share/initramfs-tools/hooks/casper

echo "==> Removing live-only login, installer autostart, and passwordless sudo"
rm -f \
    /etc/sddm.conf.d/autologin.conf \
    /etc/xdg/autostart/calamares-welcome.desktop \
    /etc/sudoers.d/devos \
    /etc/skel/Desktop/calamares.desktop

rm -f /home/*/Desktop/calamares.desktop /root/Desktop/calamares.desktop 2>/dev/null || true

echo "==> Pinning DevOS Start favorites and scrubbing dead taskbar pins"
# Kickoff otherwise keeps Plasma defaults (Dolphin/Kate/Konsole). The Install
# pin is deleted above, so leaving it in appletsrc leaves blank taskbar icons.
python3 - << 'PY'
from pathlib import Path
import re

LAUNCHERS = (
    "applications:devos-search.desktop,applications:devos-taskman.desktop,"
    "applications:devos-windows.desktop,applications:google-chrome.desktop,"
    "applications:devos-thispc.desktop,applications:devos-chat.desktop,"
    "applications:devos-code.desktop,applications:systemsettings.desktop"
)
FAVORITES = (
    "applications:google-chrome.desktop,applications:devos-thispc.desktop,"
    "applications:devos-notepad.desktop,applications:devos-code.desktop,"
    "applications:devos-chat.desktop,applications:devos-dashboard.desktop,"
    "applications:devos-apps.desktop,applications:systemsettings.desktop"
)
DEAD = (
    "devos-install.desktop",
    "org.kde.dolphin.desktop",
    "org.kde.kate.desktop",
    "org.kde.konsole.desktop",
    "preferred://filemanager",
)

def scrub_launchers(value: str) -> str:
    keep = []
    for part in value.split(","):
        entry = part.strip()
        if not entry:
            continue
        if any(dead in entry for dead in DEAD):
            continue
        keep.append(entry)
    return ",".join(keep) if keep else LAUNCHERS

def patch(path: Path) -> None:
    if not path.is_file():
        return
    text = path.read_text(encoding="utf-8", errors="replace")
    original = text
    text = re.sub(
        r"(?m)^(launchers=).*$",
        lambda m: m.group(1) + scrub_launchers(m.group(0).split("=", 1)[1]),
        text,
    )
    if re.search(r"(?m)^plugin=org\.kde\.plasma\.kickoff$", text):
        if re.search(r"(?ms)\[Containments\]\[\d+\]\[Applets\]\[\d+\]\[Configuration\]\[General\]\n(?:.*\n)*?icon=devos-logo", text):
            if "favorites=" not in text:
                text = text.replace(
                    "icon=devos-logo",
                    "icon=devos-logo\n"
                    f"favorites={FAVORITES}\n"
                    "favoritesDisplay=0\n"
                    "favoritesPortedToKAstats=false\n"
                    "systemFavorites=hibernate,reboot,shutdown",
                    1,
                )
            else:
                text = re.sub(r"(?m)^(favorites=).*$", r"\1" + FAVORITES, text)
                if "favoritesPortedToKAstats=" not in text:
                    text = re.sub(
                        r"(?m)^(favorites=.*)$",
                        r"\1\nfavoritesDisplay=0\nfavoritesPortedToKAstats=false",
                        text,
                        count=1,
                    )
                else:
                    text = re.sub(
                        r"(?m)^(favoritesPortedToKAstats=).*$",
                        r"\1false",
                        text,
                    )
    if text != original:
        path.write_text(text, encoding="utf-8")

homes = [Path("/etc/skel")]
homes.extend(sorted(Path("/home").glob("*")))
homes.append(Path("/root"))
for home in homes:
    patch(home / ".config" / "plasma-org.kde.plasma.desktop-appletsrc")
    # Force first-login UI script to rewrite Kickoff even if an older stamp exists.
    stamp = home / ".config" / "devos-ui.stamp"
    stamp.unlink(missing_ok=True)
    for dead in (
        home / "Desktop" / "calamares.desktop",
        home / "Desktop" / "org.kde.dolphin.desktop",
        home / "Desktop" / "org.kde.konsole.desktop",
        home / "Desktop" / "org.kde.kate.desktop",
    ):
        dead.unlink(missing_ok=True)
PY

echo "==> Removing the installer login session"
# SDDM lists sessions by name and "Install DevOS" sorts before Plasma, so a
# first login after the reboot would reopen the installer instead of the desktop.
rm -f \
    /usr/share/xsessions/devos-install.desktop \
    /usr/share/wayland-sessions/devos-install.desktop \
    /usr/share/applications/devos-install.desktop \
    /usr/local/bin/devos-live-session \
    /etc/sddm.conf.d/zz-devos-install.conf
rm -f /etc/systemd/system/sddm.service.wants/devos-force-installer.service
rm -f /etc/systemd/system/devos-force-installer.service

plasma_session=""
for s in /usr/share/xsessions/plasma.desktop /usr/share/xsessions/plasmax11.desktop \
         /usr/share/wayland-sessions/plasma.desktop; do
    if [ -f "$s" ]; then plasma_session="$s"; break; fi
done
if [ -n "$plasma_session" ]; then
    mkdir -p /var/lib/sddm
    printf '[Last]\nSession=%s\n' "$plasma_session" > /var/lib/sddm/state.conf
    chown sddm:sddm /var/lib/sddm/state.conf 2>/dev/null || true
fi

# Ensure SDDM loads the DevOS Modern login theme on the installed system
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/devos-theme.conf << 'EOF'
[General]
DisplayServer=x11

[Theme]
Current=devos
EOF
chmod 644 /etc/sddm.conf.d/devos-theme.conf

# The live account "devos" does not exist on the disk. Run the dashboard as
# the account the installer just created (uid 1000).
owner="$(getent passwd 1000 | cut -d: -f1)"
# Test as the actual desktop user; root can hide ownership mistakes.
if [ -n "$owner" ]; then
    if ! runuser -u "$owner" -- /usr/local/bin/devos-storage-check; then
        echo "The installed account cannot write its home or settings folders. Installation has not been marked complete. Inspect the reported path and filesystem before rebooting." >&2
        exit 1
    fi
else
    echo "No desktop account was created. Installation has not been marked complete." >&2
    exit 1
fi

if [ -n "$owner" ] && [ -f /etc/systemd/system/devos-dashboard.service ]; then
    mkdir -p /etc/systemd/system/devos-dashboard.service.d
    printf '[Service]\nUser=%s\n' "$owner" > /etc/systemd/system/devos-dashboard.service.d/user.conf
fi

# The account page lets people install without a password. Give that
# account an empty password (sudo and the lock screen accept Enter) and
# open the desktop without the sign-in screen.
if [ -n "$owner" ]; then
    hash="$(getent shadow "$owner" | cut -d: -f2)"
    if python3 - "$hash" << 'PY'
import sys, warnings
warnings.filterwarnings("ignore")
h = sys.argv[1]
if h in ("", "!", "*", "!*", "!!"):
    sys.exit(0)
try:
    try:
        import crypt
    except ImportError:
        import legacycrypt as crypt
    sys.exit(0 if crypt.crypt("", h) == h else 1)
except Exception:
    sys.exit(1)
PY
    then
        echo "==> ${owner} has no password: enabling automatic sign-in"
        passwd -d "$owner" >/dev/null 2>&1 || true
        mkdir -p /etc/sddm.conf.d
        printf '[Autologin]\nUser=%s\nSession=%s\nRelogin=false\n' "$owner" "${plasma_session##*/}" \
            > /etc/sddm.conf.d/zz-devos-autologin.conf
    fi
fi

# Ensure /vmlinuz and /initrd.img root symlinks exist for the installed kernel
latest_vmlinuz=$(ls -1 /boot/vmlinuz-* 2>/dev/null | sort -V | tail -n 1)
latest_initrd=$(ls -1 /boot/initrd.img-* 2>/dev/null | sort -V | tail -n 1)
if [ -n "$latest_vmlinuz" ]; then
    ln -sfn "$latest_vmlinuz" /vmlinuz
fi
if [ -n "$latest_initrd" ]; then
    ln -sfn "$latest_initrd" /initrd.img
fi

# Ensure btrfs driver is guaranteed in target initramfs configuration
mkdir -p /etc/initramfs-tools
if ! grep -q '^btrfs' /etc/initramfs-tools/modules 2>/dev/null; then
    echo "btrfs" >> /etc/initramfs-tools/modules
fi

# The image carries a Btrfs Snapper template. Remove only that root template
# when the installed root uses ext4, so scheduled snapshot jobs do not fail.
if [ "$(stat -f -c %T /)" != "btrfs" ]; then
    rm -f /etc/snapper/configs/root
    if [ -f /etc/default/snapper ]; then
        sed -i 's/^SNAPPER_CONFIGS="root"$/SNAPPER_CONFIGS=""/' /etc/default/snapper
    fi
fi

echo "==> Applying the DevOS system name"
if [ -f /usr/local/sbin/devos-apply-branding ]; then
    /bin/bash /usr/local/sbin/devos-apply-branding || true
elif [ -x /usr/local/sbin/devos-debrand-desktop ]; then
    /bin/bash /usr/local/sbin/devos-debrand-desktop || true
fi

# Match the daily DevOS layout: zram ≈ 50% of RAM (fast compressed swap) plus
# a disk swapfile of the same size (capped) for overflow under heavy load.
# Calamares leaves disk swap off so the EFI+root wipe stays simple; we add
# the file here inside the new install.
echo "==> Creating performance swapfile (≈50% RAM, max 16 GiB)"
ensure_swapfile() {
    local mem_kb size_b size_gb free_kb need_kb swapdir swapfile
    mem_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
    if [ "${mem_kb:-0}" -lt 1048576 ]; then
        echo "Skipping swapfile: less than 1 GiB RAM reported"
        return 0
    fi
    # Half of RAM, at least 2 GiB, at most 16 GiB (same ballpark as this PC's 15–16G).
    size_b=$(( mem_kb * 1024 / 2 ))
    if [ "$size_b" -lt $((2 * 1024 * 1024 * 1024)) ]; then
        size_b=$((2 * 1024 * 1024 * 1024))
    fi
    if [ "$size_b" -gt $((16 * 1024 * 1024 * 1024)) ]; then
        size_b=$((16 * 1024 * 1024 * 1024))
    fi
    need_kb=$(( size_b / 1024 + 1048576 ))
    free_kb=$(df -Pk / | awk 'NR==2 {print $4}')
    if [ "${free_kb:-0}" -lt "$need_kb" ]; then
        echo "Skipping swapfile: not enough free space on / (need ~$((need_kb/1024/1024)) GiB)"
        return 0
    fi
    swapdir=/swap
    swapfile="${swapdir}/swapfile"
    mkdir -p "$swapdir"
    if [ "$(stat -f -c %T / 2>/dev/null || true)" = "btrfs" ]; then
        chattr +C "$swapdir" 2>/dev/null || true
    fi
    if [ -f "$swapfile" ]; then
        echo "Swapfile already present at ${swapfile}"
    else
        if ! fallocate -l "$size_b" "$swapfile" 2>/dev/null; then
            dd if=/dev/zero of="$swapfile" bs=1M count=$((size_b/1024/1024)) status=none || {
                echo "Swapfile create failed; continuing without disk swap" >&2
                rm -f "$swapfile"
                return 0
            }
        fi
        chmod 600 "$swapfile"
        mkswap "$swapfile" >/dev/null || {
            echo "mkswap failed; removing incomplete swapfile" >&2
            rm -f "$swapfile"
            return 0
        }
        size_gb=$(( size_b / 1024 / 1024 / 1024 ))
        echo "Created ${swapfile} (${size_gb} GiB)"
    fi
    if ! grep -qE '^[[:space:]]*/swap/swapfile[[:space:]]' /etc/fstab 2>/dev/null; then
        printf '/swap/swapfile none swap defaults,pri=10 0 0\n' >> /etc/fstab
    fi
}
ensure_swapfile

# The initramfs step, which runs next, must be allowed to rebuild the boot image.
rm -f /run/devos-skip-initramfs

exit 0
