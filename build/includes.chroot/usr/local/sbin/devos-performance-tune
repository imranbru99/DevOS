#!/bin/bash
# DevOS Maximum Performance & Low-Latency Hardware Tuning Engine
set -euo pipefail

# 1. CPU Maximum Responsiveness (Governor & EPP)
for gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    if [ -f "$gov" ]; then
        echo "performance" > "$gov" 2>/dev/null || echo "schedutil" > "$gov" 2>/dev/null || true
    fi
done

for epp in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
    if [ -f "$epp" ]; then
        echo "performance" > "$epp" 2>/dev/null || echo "balance_performance" > "$epp" 2>/dev/null || true
    fi
done

# 2. Transparent Huge Pages (THP) - Zero-Stutter Tuning
# Use 'defer+madvise' so THP allocation never stalls interactive UI threads
if [ -f /sys/kernel/mm/transparent_hugepage/defrag ]; then
    echo "defer+madvise" > /sys/kernel/mm/transparent_hugepage/defrag 2>/dev/null || true
fi
if [ -f /sys/kernel/mm/transparent_hugepage/enabled ]; then
    echo "madvise" > /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null || true
fi

# 3. Fast NVMe & SSD I/O Queue Optimization
for disk in /sys/block/nvme* /sys/block/sd*; do
    if [ -d "$disk/queue" ]; then
        # Increase read-ahead to 2048 KB for fast sequential AI & project reads
        [ -f "$disk/queue/read_ahead_kb" ] && echo "2048" > "$disk/queue/read_ahead_kb" 2>/dev/null || true
        # Low latency I/O scheduler: 'none' for NVMe, 'mq-deadline' or 'bfq' for SATA SSD
        if [[ "$disk" == *"nvme"* ]] && [ -f "$disk/queue/scheduler" ]; then
            echo "none" > "$disk/queue/scheduler" 2>/dev/null || true
        elif [ -f "$disk/queue/scheduler" ]; then
            echo "mq-deadline" > "$disk/queue/scheduler" 2>/dev/null || echo "bfq" > "$disk/queue/scheduler" 2>/dev/null || true
        fi
        # Optimize I/O queue depth
        [ -f "$disk/queue/nr_requests" ] && echo "512" > "$disk/queue/nr_requests" 2>/dev/null || true
    fi
done

# 4. Disable PCIe ASPM Link Power-Saving for Maximum Throughput
for aspm in /sys/module/pcie_aspm/parameters/policy; do
    [ -f "$aspm" ] && echo "performance" > "$aspm" 2>/dev/null || true
done

exit 0
