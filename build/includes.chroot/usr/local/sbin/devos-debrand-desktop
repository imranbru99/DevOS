os.makedirs(DST, exist_ok=True)


def rewrite(app_id, name=None, generic=None, keywords=None, icon=None, hide=False):
    src = os.path.join(SRC, app_id + ".desktop")
    if not os.path.isfile(src):
        return
    out, section = [], None
    saw_keywords = False
    with open(src, encoding="utf-8", errors="replace") as handle:
        for line in handle:
            stripped = line.strip()
            if stripped.startswith("["):
                section = stripped
            main = section == "[Desktop Entry]"
            if main and re.match(r"^(Name|GenericName|Comment|Keywords)\[", stripped):
                continue  # translations would show the old name
            if main and name and stripped.startswith("Name="):
                line = f"Name={name}\n"
            elif main and generic and stripped.startswith("GenericName="):
                line = f"GenericName={generic}\n"
            elif main and keywords and stripped.startswith("Keywords="):
                line = f"Keywords={keywords}\n"
                saw_keywords = True
            elif main and icon and stripped.startswith("Icon="):
                line = f"Icon={icon}\n"
            out.append(line)
            if main and stripped == "[Desktop Entry]" and hide:
                out.append("NoDisplay=true\n")
    if keywords and not saw_keywords:
        # Insert after Name= so search indexes the friendly terms.
        inserted = []
        done = False
        for line in out:
            inserted.append(line)
            if not done and line.startswith("Name="):
                inserted.append(f"Keywords={keywords}\n")
                done = True
        out = inserted
    for dest_dir in (DST, SRC):
        try:
            os.makedirs(dest_dir, exist_ok=True)
            with open(os.path.join(dest_dir, app_id + ".desktop"), "w", encoding="utf-8") as handle:
                handle.writelines(out)
        except OSError:
            if dest_dir == DST:
                raise


for app_id, (name, generic, keywords, icon) in RENAME.items():
    # Critical: rename + hide in ONE write. A later hide-only pass used to
    # re-read upstream and restore "KCalc" / "Dolphin" on the override.
    rewrite(
        app_id,
        name=name,
        generic=generic,
        keywords=keywords,
        icon=icon,
        hide=app_id in HIDE,
    )

for app_id in sorted(HIDE):
    if app_id not in RENAME:
        rewrite(app_id, hide=True)

# Calculator / Photos / PDF / Zip / Snip: visible DevOS names in the menu.
# Upstream org.kde.* stay as named backends for taskbar matching.
for filename, body in WRAPPERS.items():
    path = os.path.join(DST, filename)
    # Also publish under /usr/share/applications so first-boot menus see them
    # before update-desktop-database merges local.
    for dest_dir in (DST, SRC):
        try:
            os.makedirs(dest_dir, exist_ok=True)
            with open(os.path.join(dest_dir, filename), "w", encoding="utf-8") as handle:
                handle.write(body)
        except OSError:
            pass
PY

# Also drop stock wrappers into the image tree for builds that copy applications/.
python3 - << 'PY'
import os
ROOT = "/usr/share/applications"
# Files already written above into SRC/DST; nothing else required here.
os.makedirs(ROOT, exist_ok=True)
PY

# Every settings page, menu entry and theme name. Package upgrades restore
# the upstream words; this runs again afterwards and puts DevOS back.
python3 - << 'PY'
import json
import os
import re

ROOTS = (
    "/usr/share/applications",
    "/usr/local/share/applications",
    "/usr/share/desktop-directories",
    "/usr/share/kservices5",
    "/usr/share/kpackage",
    "/usr/share/plasma",
    "/usr/share/knsrcfiles",
    "/usr/share/ksmserver",
)
VISIBLE = {"Name", "GenericName", "Comment", "Keywords", "Description", "X-KDE-PluginInfo-Category"}
JSON_KEYS = {"Name", "Description", "Comment", "Category", "Keywords"}
DESKTOP_SUFFIXES = (".desktop", ".directory", ".knsrc")

# Never leave these upstream product names in anything a person can read.
APP_BRAND = (
    (re.compile(r"\bKCalc\b", re.I), "Calculator"),
    (re.compile(r"\bkcalc\b"), "Calculator"),
    (re.compile(r"\bDolphin\b"), "File Explorer"),
    (re.compile(r"\bKate\b"), "Text Editor"),
    (re.compile(r"\bKWrite\b", re.I), "Text Editor"),
    (re.compile(r"\bKonsole\b"), "Terminal"),
    (re.compile(r"\bSpectacle\b"), "Snipping Tool"),
    (re.compile(r"\bOkular\b"), "PDF Viewer"),
