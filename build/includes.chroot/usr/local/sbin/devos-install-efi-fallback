#!/bin/bash
# Stage a matching signed shim/GRUB pair and a target-specific config on the ESP.
set -euo pipefail
export LC_ALL=C

esp=/boot/efi
mountpoint -q "$esp"
test -s /boot/grub/grub.cfg

uuid="$(grub-probe --target=fs_uuid /boot/grub)"
relative="$(grub-mkrelpath /boot/grub)"
test -n "$uuid"
test -n "$relative"
abstraction="$(grub-probe --target=abstraction /boot/grub)"
stub="$(mktemp)"
trap 'rm -f "$stub"' EXIT
if [[ " $abstraction " == *" cryptodisk "* ]]; then
    crypt_uuids="$(grub-probe --target=cryptodisk_uuid /boot/grub)"
    test -n "$crypt_uuids"
    for crypt_uuid in $crypt_uuids; do
        printf 'cryptomount -u %s\n' "$crypt_uuid" >> "$stub"
    done
fi
printf "search --no-floppy --fs-uuid --set=root %s\nset prefix=(\$root)'%s'\nconfigfile \$prefix/grub.cfg\n" \
    "$uuid" "$relative" >> "$stub"
grub-script-check "$stub"

shim=/usr/lib/shim/shimx64.efi.signed.latest
[ -s "$shim" ] || shim=/usr/lib/shim/shimx64.efi.signed
grub=/usr/lib/grub/x86_64-efi-signed/grubx64.efi.signed
test -s "$shim"
test -s "$grub"

copy_verified() {
    cp -fL -- "$1" "$2"
    cmp -s -- "$1" "$2"
}

write_stamp() {
    local version
    version="$(. /etc/os-release; printf '%s' "$VERSION_ID")"
    printf 'version=%s\ninstalled_at=%s\n' "$version" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$1"
}

vendor="$esp/EFI/DevOS"
fallback="$esp/EFI/BOOT"
mkdir -p "$vendor" "$fallback"
copy_verified "$shim" "$vendor/shimx64.efi"
copy_verified "$grub" "$vendor/grubx64.efi"
copy_verified "$stub" "$vendor/grub.cfg"

# Keep a foreign removable loader on a shared ESP. DevOS's own previous
# fallback can be updated, and a fresh ESP receives a complete fallback.
if [ ! -e "$fallback/BOOTX64.EFI" ] || [ -f "$fallback/.devos-fallback" ] ||
        cmp -s "$shim" "$fallback/BOOTX64.EFI"; then
    copy_verified "$shim" "$fallback/BOOTX64.EFI"
    copy_verified "$grub" "$fallback/grubx64.efi"
    copy_verified "$stub" "$fallback/grub.cfg"
    touch "$fallback/.devos-fallback"
    write_stamp "$fallback/.devos-installed"
fi

# Ubuntu-signed GRUB can use its distro prefix. Supply its config on a fresh
# ESP while preserving an existing Ubuntu installation.
ubuntu="$esp/EFI/ubuntu"
if [ ! -e "$ubuntu/grubx64.efi" ] && [ ! -e "$ubuntu/shimx64.efi" ]; then
    mkdir -p "$ubuntu"
    copy_verified "$stub" "$ubuntu/grub.cfg"
fi

mok=/usr/lib/shim/mmx64.efi.signed
if [ -s "$mok" ]; then
    copy_verified "$mok" "$vendor/mmx64.efi"
    if [ -f "$fallback/.devos-fallback" ]; then
        copy_verified "$mok" "$fallback/mmx64.efi"
    fi
fi
write_stamp "$vendor/.installed"
sync -f "$esp"
