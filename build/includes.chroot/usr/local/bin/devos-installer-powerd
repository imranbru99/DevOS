#!/usr/bin/env python3
"""Localhost-only helper so the Calamares QML nav bar can Restart / Shut down.

Calamares QML cannot spawn processes; the branding bar POSTs to this tiny
server (127.0.0.1 only). Started by devos-install-gui alongside Calamares.
"""
from __future__ import annotations

import os
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOST = "127.0.0.1"
PORT = 41777
PID_FILE = "/run/devos-installer-powerd.pid"


def _run(op: str) -> None:
    if op == "reboot":
        cmds = [
            ["systemctl", "reboot", "--force"],
            ["systemctl", "reboot", "--force", "--force"],
            ["/sbin/reboot", "-f"],
        ]
    elif op == "poweroff":
        cmds = [
            ["systemctl", "poweroff", "--force"],
            ["systemctl", "poweroff", "--force", "--force"],
            ["/sbin/poweroff", "-f"],
        ]
    else:
        return
    for cmd in cmds:
        try:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
        except OSError:
            continue


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt: str, *args) -> None:  # noqa: A003
        return

    def _ok(self, code: int = 204) -> None:
        self.send_response(code)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()

    def do_OPTIONS(self) -> None:  # noqa: N802
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "*")
        self.end_headers()

    def do_GET(self) -> None:  # noqa: N802
        path = (self.path or "/").split("?", 1)[0].rstrip("/") or "/"
        if path in ("/health", "/"):
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            self.wfile.write(b"ok")
            return
        if path == "/reboot":
            self._ok()
            _run("reboot")
            return
        if path in ("/poweroff", "/shutdown"):
            self._ok()
            _run("poweroff")
            return
        self.send_error(404)

    def do_POST(self) -> None:  # noqa: N802
        self.do_GET()


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "stop":
        try:
            with open(PID_FILE, encoding="utf-8") as fh:
                os.kill(int(fh.read().strip()), 15)
        except (OSError, ValueError):
            pass
        try:
            os.remove(PID_FILE)
        except OSError:
            pass
        return 0

    # Replace a stale listener from a previous installer launch.
    try:
        if os.path.isfile(PID_FILE):
            with open(PID_FILE, encoding="utf-8") as fh:
                os.kill(int(fh.read().strip()), 15)
    except (OSError, ValueError):
        pass

    server = ThreadingHTTPServer((HOST, PORT), Handler)
    os.makedirs("/run", exist_ok=True)
    with open(PID_FILE, "w", encoding="utf-8") as fh:
        fh.write(str(os.getpid()))
    try:
        server.serve_forever()
    finally:
        try:
            os.remove(PID_FILE)
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
