    CONFIG_DIR = os.path.expanduser("~/.config/devos")
    PINNED_FILE = os.path.join(CONFIG_DIR, "quick_access.json")

    def load_pinned_folders(self):
        try:
            if os.path.exists(self.PINNED_FILE):
                with open(self.PINNED_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    if isinstance(data, list):
                        return [p for p in data if isinstance(p, str) and os.path.isdir(p)]
        except Exception:
            pass
        return []

    def save_pinned_folders(self):
        try:
            os.makedirs(self.CONFIG_DIR, exist_ok=True)
            with open(self.PINNED_FILE, "w", encoding="utf-8") as f:
                json.dump(self._pinned_folders, f, indent=2)
        except Exception:
            pass

    def pin_to_quick_access(self, path, name=None):
        if path and path not in self._pinned_folders and os.path.isdir(path):
            self._pinned_folders.append(path)
            self.save_pinned_folders()
            self._rebuild_sidebar()

    def unpin_from_quick_access(self, path):
        if path in self._pinned_folders:
            self._pinned_folders.remove(path)
            self.save_pinned_folders()
            self._rebuild_sidebar()

    def _rebuild_sidebar(self):
        """Populate Quick Access with pinned items, and This PC with personal folders and drives."""
        while self.qa_sidebar_layout.count():
            item = self.qa_sidebar_layout.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

        while self.this_pc_items_layout.count():
            item = self.this_pc_items_layout.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

        self.drive_sidebar_layout = QVBoxLayout()
        self.drive_sidebar_layout.setContentsMargins(0, 0, 0, 0)
        self.drive_sidebar_layout.setSpacing(2)

        home = os.path.expanduser("~")
        std_folders = [
            ("Desktop", os.path.join(home, "Desktop"), "folder-desktop"),
            ("Downloads", os.path.join(home, "Downloads"), "folder-downloads"),
            ("Documents", os.path.join(home, "Documents"), "folder-documents"),
            ("Pictures", os.path.join(home, "Pictures"), "folder-pictures"),
            ("Music", os.path.join(home, "Music"), "folder-music"),
            ("Videos", os.path.join(home, "Videos"), "folder-videos"),
        ]

        # 1. Quick access standard folders
        for name, path, icon_name in std_folders:
            btn = QPushButton(name)
            btn.setIcon(get_win_icon(icon_name, 20))
            btn.setIconSize(QSize(20, 20))
            btn.setObjectName("sideBtn")
            btn.setCursor(Qt.PointingHandCursor)
            btn.clicked.connect(lambda _=False, p=path: self.navigate_to(p))
            btn.setContextMenuPolicy(Qt.CustomContextMenu)
            btn.customContextMenuRequested.connect(lambda pos, p=path, b=btn: self._show_sidebar_folder_context_menu(p, False, b.mapToGlobal(pos)))
            self.qa_sidebar_layout.addWidget(btn)
            self._side_btns[path] = btn

        # Pinned folders under Quick access
        for path in self._pinned_folders:
            if not os.path.exists(path):
                continue
            name = os.path.basename(path) or path
            btn = QPushButton(f"📌 {name}")
            btn.setIcon(get_win_icon("folder", 20))
            btn.setIconSize(QSize(20, 20))
            btn.setObjectName("sideBtn")
            btn.setCursor(Qt.PointingHandCursor)
            btn.clicked.connect(lambda _=False, p=path: self.navigate_to(p))
            btn.setContextMenuPolicy(Qt.CustomContextMenu)
            btn.customContextMenuRequested.connect(lambda pos, p=path, b=btn: self._show_sidebar_folder_context_menu(p, True, b.mapToGlobal(pos)))
            self.qa_sidebar_layout.addWidget(btn)
            self._side_btns[path] = btn

        # 2. This PC Personal folders (Always show on left side!)
        for name, path, icon_name in std_folders:
            btn = QPushButton(name)
            btn.setIcon(get_win_icon(icon_name, 18))
            btn.setIconSize(QSize(18, 18))
            btn.setObjectName("sideBtn")
            btn.setCursor(Qt.PointingHandCursor)
            btn.clicked.connect(lambda _=False, p=path: self.navigate_to(p))
            btn.setContextMenuPolicy(Qt.CustomContextMenu)
            btn.customContextMenuRequested.connect(lambda pos, p=path, b=btn: self._show_sidebar_folder_context_menu(p, False, b.mapToGlobal(pos)))
            self.this_pc_items_layout.addWidget(btn)

        # 3. This PC Drives
        for drive in self._drives:
            btn = QPushButton(drive["title"])
            icon_type = "drive-c" if drive["is_system"] else ("drive-usb" if drive["removable"] else "drive-fixed")
            btn.setIcon(get_win_icon(icon_type, 18))
            btn.setIconSize(QSize(18, 18))
            btn.setObjectName("sideBtn")
            btn.setCursor(Qt.PointingHandCursor)
            btn.clicked.connect(lambda _=False, d=drive: self.open_drive(d))
            btn.setContextMenuPolicy(Qt.CustomContextMenu)
            btn.customContextMenuRequested.connect(lambda pos, d=drive, b=btn: self._show_drive_context_menu(d, b.mapToGlobal(pos)))
            self.drive_sidebar_layout.addWidget(btn)

        self.this_pc_items_layout.addLayout(self.drive_sidebar_layout)

    def reload_drives(self):
        """Fetch and populate drives."""
        while self.drives_grid.count():
            item = self.drives_grid.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

        self._drives = list_drives()
        self.drives_heading.setText(f"Devices and drives ({len(self._drives)})")

        self._rebuild_sidebar()

        # Place drive cards in 2-column or 3-column grid
        columns = 2
        for idx, drive in enumerate(self._drives):
            card = DriveCard(drive, on_open=self.open_drive, on_context=self._show_drive_context_menu)
            self.drives_grid.addWidget(card, idx // columns, idx % columns)

    def open_drive(self, drive):
        """Open a drive; mounts it automatically if unmounted."""
        mount = drive.get("mount") or ""
        if not mount and drive.get("path"):
            try:
                out = subprocess.check_output(
                    ["udisksctl", "mount", "-b", drive["path"]],
                    text=True,
                    stderr=subprocess.STDOUT,
                )
                for part in out.split():
                    if part.startswith("/"):
                        mount = part
                        drive["mount"] = mount
                        break
            except Exception:
                pass
            if not mount:
                for item in list_drives():
                    if item.get("path") == drive.get("path") and item.get("mount"):
                        mount = item["mount"]
                        drive["mount"] = mount
                        break

        if mount and os.path.exists(mount):
            self.navigate_to(mount, label=drive["title"])

    def navigate_to(self, path, label="", add_to_history=True):
        """Navigate to 'This PC' (empty string) or any folder path."""
        # Clean path if passed as file:// or computer:/
        if path.startswith("file://"):
            path = path[7:]
        if path in ("computer:/", "computer:", "thispc"):
            path = ""

        if add_to_history and self._current_path != path:
            self._history.append(self._current_path)
            self._future.clear()
            self.btn_back.setEnabled(True)
            self.btn_forward.setEnabled(False)

        self._current_path = path

        # Update sidebar highlights
        for p, btn in self._side_btns.items():
            btn.setObjectName("sideBtnSelected" if p == path else "sideBtn")
            btn.setStyle(btn.style())

        self.address_bar.set_location(path, label)
        self.search_box.clear()

        if not path or path == "This PC":
            self.setWindowTitle("This PC")
            self.search_box.setPlaceholderText("Search This PC")
            self.reload_drives()
            self.content_stack.setCurrentIndex(0)
            self.btn_up.setEnabled(False)
            self.btn_new_folder.setEnabled(False)
            self.status_items_count.setText(f"{len(self._drives)} drives, 6 folders")
            self.status_selected_info.setText("")
        else:
            folder_name = os.path.basename(path) or path
            self.setWindowTitle(f"{folder_name} - File Explorer")
            self.search_box.setPlaceholderText(f"Search {folder_name}")
            self.content_stack.setCurrentIndex(1)
            self.btn_up.setEnabled(True)
            self.btn_new_folder.setEnabled(True)
            self._load_folder_contents(path)

    def go_back(self):
        if self._history:
            prev = self._history.pop()
            self._future.append(self._current_path)
            self.btn_forward.setEnabled(True)
            self.btn_back.setEnabled(bool(self._history))
            self.navigate_to(prev, add_to_history=False)

    def go_forward(self):
        if self._future:
            nxt = self._future.pop()
            self._history.append(self._current_path)
            self.btn_back.setEnabled(True)
            self.btn_forward.setEnabled(bool(self._future))
            self.navigate_to(nxt, add_to_history=False)

    def go_up(self):
        if not self._current_path:
            return
        parent = os.path.dirname(self._current_path)
        if not parent or parent == self._current_path:
            self.navigate_to("")
        else:
            self.navigate_to(parent)

    def refresh(self):
        self.navigate_to(self._current_path, add_to_history=False)

    def _load_folder_contents(self, path):
        """Populate table and list view with items in directory."""
        self.table_view.setSortingEnabled(False)
        self.table_view.setRowCount(0)
        self.list_view.clear()

        try:
            entries = os.listdir(path)
        except OSError as err:
            self.status_items_count.setText(f"Unable to access: {err.strerror}")
            return

        # Separate folders and files
        dirs = []
        files = []
        for entry in entries:
            if entry.startswith(".") and entry not in [".", ".."]:
                continue
            full_path = os.path.join(path, entry)
            if os.path.isdir(full_path):
                dirs.append(entry)
            else:
                files.append(entry)

        dirs.sort(key=str.lower)
        files.sort(key=str.lower)
        all_items = dirs + files

        self.table_view.setRowCount(len(all_items))

        for row, entry in enumerate(all_items):
            full_path = os.path.join(path, entry)
            is_dir = os.path.isdir(full_path)

            try:
                st = os.stat(full_path)
                mtime = datetime.datetime.fromtimestamp(st.st_mtime).strftime("%Y-%m-%d  %I:%M %p")
                size_str = "" if is_dir else format_bytes(st.st_size)
                size_val = -1 if is_dir else st.st_size
            except OSError:
                mtime = ""
                size_str = ""
                size_val = -1

            item_type = get_file_type_description(full_path)
            icon = get_icon_for_file(full_path, is_dir)

            # Name Column
            name_item = ExplorerTableItem(entry)
            name_item.setIcon(icon)
            name_item.setData(Qt.UserRole, full_path)
            name_item.setData(Qt.UserRole + 1, is_dir)
            self.table_view.setItem(row, 0, name_item)

            # Date Modified Column
            date_item = ExplorerTableItem(mtime)
            date_item.setData(Qt.UserRole, st.st_mtime if "st" in locals() else 0)
            date_item.setData(Qt.UserRole + 1, is_dir)
            self.table_view.setItem(row, 1, date_item)

            # Type Column
            type_item = ExplorerTableItem(item_type)
            type_item.setData(Qt.UserRole, item_type)
            type_item.setData(Qt.UserRole + 1, is_dir)
            self.table_view.setItem(row, 2, type_item)

            # Size Column
            size_item = ExplorerTableItem(size_str)
            size_item.setData(Qt.UserRole, size_val)
            size_item.setData(Qt.UserRole + 1, is_dir)
            size_item.setTextAlignment(Qt.AlignRight | Qt.AlignVCenter)
            self.table_view.setItem(row, 3, size_item)

            # Also populate Icon list view
            list_item = QListWidgetItem(icon, entry)
            list_item.setData(Qt.UserRole, full_path)
            list_item.setData(Qt.UserRole + 1, is_dir)
            self.list_view.addItem(list_item)

        self.table_view.setSortingEnabled(True)
        self.status_items_count.setText(f"{len(all_items)} items")
        self.status_selected_info.setText("")

    def _on_table_item_double_clicked(self, item):
        row = item.row()
        name_item = self.table_view.item(row, 0)
        target = name_item.data(Qt.UserRole)
        is_dir = name_item.data(Qt.UserRole + 1)
        if is_dir:
            self.navigate_to(target)
        else:
            open_file_with_default(target)

    def _on_list_item_double_clicked(self, item):
        target = item.data(Qt.UserRole)
        is_dir = item.data(Qt.UserRole + 1)
        if is_dir:
            self.navigate_to(target)
        else:
            open_file_with_default(target)

    def _on_selection_changed(self):
        selected_paths = self.get_selected_paths()
        count = len(selected_paths)
        if count == 0:
            self.status_selected_info.setText("")
        elif count == 1:
            p = selected_paths[0]
            try:
                st = os.stat(p)
                info = format_bytes(st.st_size) if not os.path.isdir(p) else "Folder"
                self.status_selected_info.setText(f"1 item selected  {info}")
            except OSError:
                self.status_selected_info.setText("1 item selected")
        else:
            self.status_selected_info.setText(f"{count} items selected")

    def _on_search_text_changed(self, text):
        query = text.strip().lower()
        if self.content_stack.currentIndex() == 0:
            return
        for row in range(self.table_view.rowCount()):
            name = self.table_view.item(row, 0).text().lower()
            match = query in name if query else True
            self.table_view.setRowHidden(row, not match)
        for idx in range(self.list_view.count()):
            item = self.list_view.item(idx)
            match = query in item.text().lower() if query else True
            item.setHidden(not match)

    def get_selected_paths(self):
        if self._view_mode == "details":
            rows = set(item.row() for item in self.table_view.selectedItems())
            return [self.table_view.item(r, 0).data(Qt.UserRole) for r in rows]
        else:
            return [item.data(Qt.UserRole) for item in self.list_view.selectedItems()]

    def toggle_view_mode(self):
        if self._view_mode == "details":
            self._view_mode = "icons"
            self.table_view.hide()
            self.list_view.show()
            self.btn_view.setText("View: Icons")
        else:
            self._view_mode = "details"
            self.list_view.hide()
            self.table_view.show()
            self.btn_view.setText("View: Details")

    def action_new_folder(self):
        if not self._current_path or not os.path.isdir(self._current_path):
            return
        base_name = "New folder"
        target = os.path.join(self._current_path, base_name)
        counter = 2
        while os.path.exists(target):
            target = os.path.join(self._current_path, f"{base_name} ({counter})")
            counter += 1
        try:
            os.makedirs(target, exist_ok=True)
            self.refresh()
        except OSError as err:
            QMessageBox.critical(self, "Error", f"Failed to create folder: {err.strerror}")

    def action_cut(self):
        paths = self.get_selected_paths()
        if paths:
            self._clipboard = {"action": "cut", "paths": paths}

    def action_copy(self):
        paths = self.get_selected_paths()
        if paths:
            self._clipboard = {"action": "copy", "paths": paths}

    def action_paste(self):
        if not self._clipboard["paths"] or not self._current_path:
            return
        action = self._clipboard["action"]
        for src in self._clipboard["paths"]:
            if not os.path.exists(src):
                continue
            dest = os.path.join(self._current_path, os.path.basename(src))
            try:
                if action == "cut":
                    shutil.move(src, dest)
                else:
                    if os.path.isdir(src):
                        shutil.copytree(src, dest)
                    else:
                        shutil.copy2(src, dest)
            except Exception as err:
                QMessageBox.critical(self, "Paste Error", str(err))
        if action == "cut":
            self._clipboard = {"action": None, "paths": []}
        self.refresh()

    def action_rename(self):
        paths = self.get_selected_paths()
        if len(paths) != 1:
            return
        target = paths[0]
        old_name = os.path.basename(target)
        dlg = QDialog(self)
        dlg.setWindowTitle("Rename")
        layout = QVBoxLayout(dlg)
        layout.addWidget(QLabel(f"Rename '{old_name}' to:"))
        edit = QLineEdit(old_name)
        layout.addWidget(edit)
        btns = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        btns.accepted.connect(dlg.accept)
        btns.rejected.connect(dlg.reject)
        layout.addWidget(btns)
        if dlg.exec_() == QDialog.Accepted:
            new_name = edit.text().strip()
            if new_name and new_name != old_name:
                try:
                    os.rename(target, os.path.join(os.path.dirname(target), new_name))
                    self.refresh()
                except OSError as err:
                    QMessageBox.critical(self, "Error", f"Failed to rename: {err.strerror}")

    def action_delete(self):
        paths = self.get_selected_paths()
        if not paths:
            return
        trash_dir = os.path.expanduser("~/.local/share/Trash/files")
        os.makedirs(trash_dir, exist_ok=True)
        for p in paths:
            try:
                subprocess.run(["gio", "trash", p], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                if os.path.exists(p):
                    shutil.move(p, os.path.join(trash_dir, os.path.basename(p)))
            except Exception:
                pass
        self.refresh()

    def show_properties(self, target_path=None):
        """Open authentic Windows Properties dialog based on target type."""
        if target_path:
            target = target_path
        else:
            paths = self.get_selected_paths()
            target = paths[0] if paths else self._current_path

        if not target or target in ("This PC", "computer:/", "computer:", "thispc"):
            self.show_system_properties()
            return

        # Check if target is a drive
        for drive in self._drives:
            if drive.get("mount") == target or (target == "/" and drive.get("is_system")):
                self.show_drive_properties(drive)
                return

        if not os.path.exists(target):
            return

        if os.path.isdir(target):
            dlg = WindowsFolderPropertiesDialog(target, self)
            dlg.exec_()
        else:
            dlg = WindowsFilePropertiesDialog(target, self)
            dlg.exec_()

    def show_drive_properties(self, drive):
        dlg = WindowsDrivePropertiesDialog(drive, self)
        dlg.exec_()

    def show_system_properties(self):
        dlg = WindowsSystemPropertiesDialog(self)
        dlg.exec_()

    def _open_manage(self):
        for cmd in [["/usr/local/bin/devos-disk-gui"], ["python3", "/usr/local/share/devos/components/settings/hardware_manager.py"], ["kinfocenter"]]:
            try:
                subprocess.Popen(cmd)
                return
            except OSError:
                pass

    def _set_clipboard(self, action, paths):
        self._clipboard = {"action": action, "paths": list(paths)}

    def _delete_paths(self, paths):
        if not paths:
            return
        trash_dir = os.path.expanduser("~/.local/share/Trash/files")
        os.makedirs(trash_dir, exist_ok=True)
        for p in paths:
            try:
                subprocess.run(["gio", "trash", p], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                if os.path.exists(p):
                    shutil.move(p, os.path.join(trash_dir, os.path.basename(p)))
            except Exception:
                pass
        self.refresh()

    def action_rename_path(self, target):
        if not os.path.exists(target):
            return
        old_name = os.path.basename(target)
        dlg = QDialog(self)
        dlg.setWindowTitle("Rename")
        dlg.setWindowIcon(get_win_icon("folder" if os.path.isdir(target) else "file-doc", 24))
        dlg.resize(320, 120)
        layout = QVBoxLayout(dlg)
        layout.addWidget(QLabel(f"Rename '{old_name}' to:"))
        edit = QLineEdit(old_name)
        layout.addWidget(edit)
        btns = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        btns.accepted.connect(dlg.accept)
        btns.rejected.connect(dlg.reject)
        layout.addWidget(btns)
        if dlg.exec_() == QDialog.Accepted:
            new_name = edit.text().strip()
            if new_name and new_name != old_name:
                try:
                    os.rename(target, os.path.join(os.path.dirname(target), new_name))
                    self.refresh()
                except OSError as err:
                    QMessageBox.critical(self, "Error", f"Failed to rename: {err.strerror}")

    def action_rename_drive(self, drive):
        QMessageBox.information(self, "Rename Drive", f"Drive labels for {drive.get('title')} can be edited in Drive Properties or DevOS Disk Doctor.")

    def _show_this_pc_context_menu(self, global_pos):
        """Windows This PC right-click context menu."""
        menu = QMenu(self)
        act_open = menu.addAction(get_win_icon("this-pc", 18), "Open")
        act_open.triggered.connect(lambda: self.navigate_to(""))
        act_new_win = menu.addAction("Open in new window")
        act_new_win.triggered.connect(lambda: open_in_new_window(""))
        menu.addSeparator()
        act_pin = menu.addAction("Pin to Quick access")
        act_pin.triggered.connect(lambda: QMessageBox.information(self, "Quick access", "This PC is already pinned to your navigation pane."))
        act_manage = menu.addAction(get_win_icon("this-pc", 18), "Manage")
        act_manage.triggered.connect(self._open_manage)
        menu.addSeparator()
        act_map = menu.addAction("Map network drive...")
        act_map.triggered.connect(lambda: self.navigate_to("network:/"))
        act_disc = menu.addAction("Disconnect network drive...")
        act_disc.triggered.connect(lambda: self.navigate_to("network:/"))
        menu.addSeparator()
        act_props = menu.addAction("Properties")
        act_props.triggered.connect(self.show_system_properties)
        menu.exec_(global_pos)

    def _show_this_pc_bg_context_menu(self, pos):
        """Context menu on empty background in This PC view."""
        menu = QMenu(self)
        view_menu = menu.addMenu("View")
        act_details = view_menu.addAction("Details")
        act_details.triggered.connect(lambda: self.set_view_mode("details"))
        act_icons = view_menu.addAction("Large icons")
        act_icons.triggered.connect(lambda: self.set_view_mode("icons"))

        sort_menu = menu.addMenu("Sort by")
        for s in ["Name", "Type", "Total size", "Free space"]:
            act_s = sort_menu.addAction(s)
            act_s.triggered.connect(self.reload_drives)

        act_refresh = menu.addAction("Refresh")
        act_refresh.triggered.connect(self.refresh)
        menu.addSeparator()
        act_net = menu.addAction("Add a network location")
        act_net.triggered.connect(lambda: self.navigate_to("network:/"))
        menu.addSeparator()
        act_props = menu.addAction("Properties")
        act_props.triggered.connect(self.show_system_properties)
        sender = self.sender()
        global_pos = sender.mapToGlobal(pos) if (sender and hasattr(sender, "mapToGlobal")) else self.mapToGlobal(pos)
        menu.exec_(global_pos)

    def _show_drive_context_menu(self, drive, global_pos):
        """Windows Drive right-click context menu."""
        menu = QMenu(self)
        icon_type = "drive-c" if drive.get("is_system") else ("drive-usb" if drive.get("removable") else "drive-fixed")
        act_open = menu.addAction(get_win_icon(icon_type, 18), "Open")
        act_open.triggered.connect(lambda: self.open_drive(drive))
        act_new_win = menu.addAction("Open in new window")
        target_path = drive.get("mount") or "/"
        act_new_win.triggered.connect(lambda: open_in_new_window(target_path))
        act_pin = menu.addAction("Pin to Quick access")
        act_pin.triggered.connect(lambda: self.pin_to_quick_access(target_path, drive.get("title")))
        menu.addSeparator()
        act_guard = menu.addAction("Turn on DevOS DiskGuard")
        act_guard.triggered.connect(lambda: QMessageBox.information(self, "DiskGuard", f"DiskGuard is actively monitoring {drive.get('title')}."))
        menu.addSeparator()
        act_copy = menu.addAction("Copy")
        act_copy.triggered.connect(lambda: self._set_clipboard("copy", [target_path]))
        menu.addSeparator()
        act_rename = menu.addAction("Rename")
        act_rename.triggered.connect(lambda: self.action_rename_drive(drive))
        menu.addSeparator()
        act_props = menu.addAction("Properties")
        act_props.triggered.connect(lambda: self.show_drive_properties(drive))
        menu.exec_(global_pos)

    def _show_folder_tile_context_menu(self, path, global_pos):
        """Context menu for folder tile in This PC view."""
        self._show_folder_context_menu(path, global_pos, is_pinned=False)

    def _show_sidebar_folder_context_menu(self, path, is_pinned, global_pos):
        """Context menu for folders on the left sidebar."""
        self._show_folder_context_menu(path, global_pos, is_pinned=is_pinned)

    def _show_folder_context_menu(self, path, global_pos, is_pinned=False):
        """Generic Windows folder context menu."""
        menu = QMenu(self)
        act_open = menu.addAction(get_win_icon("folder", 18), "Open")
        act_open.triggered.connect(lambda: self.navigate_to(path))
        act_new_win = menu.addAction("Open in new window")
        act_new_win.triggered.connect(lambda: open_in_new_window(path))

        if is_pinned or path in self._pinned_folders:
            act_pin = menu.addAction("Unpin from Quick access")
            act_pin.triggered.connect(lambda: self.unpin_from_quick_access(path))
        else:
            act_pin = menu.addAction("Pin to Quick access")
            act_pin.triggered.connect(lambda: self.pin_to_quick_access(path))

        act_term = menu.addAction("Open in Terminal")
        act_term.triggered.connect(lambda: open_in_terminal(path))
        menu.addSeparator()
        act_cut = menu.addAction("Cut")
        act_cut.triggered.connect(lambda: self._set_clipboard("cut", [path]))
        act_copy = menu.addAction("Copy")
        act_copy.triggered.connect(lambda: self._set_clipboard("copy", [path]))
        menu.addSeparator()
        act_del = menu.addAction("Delete")
        act_del.triggered.connect(lambda: self._delete_paths([path]))
        act_rename = menu.addAction("Rename")
        act_rename.triggered.connect(lambda: self.action_rename_path(path))
        menu.addSeparator()
        act_props = menu.addAction("Properties")
        act_props.triggered.connect(lambda: self.show_properties(path))
        menu.exec_(global_pos)

    def _show_network_context_menu(self, global_pos):
        menu = QMenu(self)
        act_open = menu.addAction(get_win_icon("network", 18), "Open")
        act_open.triggered.connect(lambda: self.navigate_to("network:/"))
        act_map = menu.addAction("Map network drive...")
        act_map.triggered.connect(lambda: self.navigate_to("network:/"))
        menu.addSeparator()
        act_props = menu.addAction("Properties")
        act_props.triggered.connect(lambda: QMessageBox.information(self, "Network", "DevOS Network Discovery is active."))
        menu.exec_(global_pos)

    def _show_bin_context_menu(self, global_pos):
        trash_path = os.path.expanduser("~/.local/share/Trash/files")
        menu = QMenu(self)
        act_open = menu.addAction(get_win_icon("recycle-bin", 18), "Open")
        act_open.triggered.connect(lambda: self.navigate_to(trash_path))
        act_empty = menu.addAction("Empty Recycle Bin")
        act_empty.triggered.connect(self._empty_trash)
        menu.addSeparator()
        act_props = menu.addAction("Properties")
        act_props.triggered.connect(lambda: self.show_properties(trash_path))
        menu.exec_(global_pos)

    def _empty_trash(self):
        trash_dir = os.path.expanduser("~/.local/share/Trash/files")
        if os.path.exists(trash_dir):
            for f in os.listdir(trash_dir):
                fp = os.path.join(trash_dir, f)
                try:
                    if os.path.isdir(fp):
                        shutil.rmtree(fp, ignore_errors=True)
                    else:
                        os.remove(fp)
                except Exception:
                    pass
        self.refresh()

    def _show_context_menu(self, pos):
        """Context menu for items or empty space in folder view."""
        menu = QMenu(self)
        paths = self.get_selected_paths()

        if paths:
            target = paths[0]
            is_dir = os.path.isdir(target)

            act_open = menu.addAction("Open")
            act_open.triggered.connect(lambda: self._on_table_item_double_clicked(self.table_view.selectedItems()[0]))

            act_new_win = menu.addAction("Open in new window")
            act_new_win.triggered.connect(lambda: open_in_new_window(target))

            if is_dir:
                if target in self._pinned_folders:
                    act_pin = menu.addAction("Unpin from Quick access")
                    act_pin.triggered.connect(lambda: self.unpin_from_quick_access(target))
                else:
                    act_pin = menu.addAction("Pin to Quick access")
                    act_pin.triggered.connect(lambda: self.pin_to_quick_access(target))

            act_term = menu.addAction("Open in Terminal")
            act_term.triggered.connect(lambda: open_in_terminal(target))
            menu.addSeparator()
            act_cut = menu.addAction("Cut")
            act_cut.triggered.connect(self.action_cut)
            act_copy = menu.addAction("Copy")
            act_copy.triggered.connect(self.action_copy)
            menu.addSeparator()
            act_rename = menu.addAction("Rename")
            act_rename.triggered.connect(self.action_rename)
            act_del = menu.addAction("Delete")
            act_del.triggered.connect(self.action_delete)
            menu.addSeparator()
            act_props = menu.addAction("Properties")
            act_props.triggered.connect(lambda: self.show_properties(target))
        else:
            view_menu = menu.addMenu("View")
            act_details = view_menu.addAction("Details")
            act_details.triggered.connect(lambda: self.set_view_mode("details"))
            act_icons = view_menu.addAction("Large icons")
            act_icons.triggered.connect(lambda: self.set_view_mode("icons"))

            sort_menu = menu.addMenu("Sort by")
            for s in ["Name", "Date modified", "Type", "Size"]:
                act_s = sort_menu.addAction(s)
                act_s.triggered.connect(self.refresh)

            act_refresh = menu.addAction("Refresh")
            act_refresh.triggered.connect(self.refresh)
            menu.addSeparator()

            if self._clipboard["paths"]:
                act_paste = menu.addAction("Paste")
                act_paste.triggered.connect(self.action_paste)
                menu.addSeparator()

            act_term = menu.addAction("Open in Terminal")
            act_term.triggered.connect(lambda: open_in_terminal(self._current_path))
            menu.addSeparator()

            new_menu = menu.addMenu("New")
            act_new_f = new_menu.addAction(get_win_icon("folder", 16), "Folder")
            act_new_f.triggered.connect(self.action_new_folder)
            act_new_doc = new_menu.addAction(get_win_icon("file-doc", 16), "Text Document")
            act_new_doc.triggered.connect(self.action_new_text_document)
            menu.addSeparator()

            act_props = menu.addAction("Properties")
            act_props.triggered.connect(lambda: self.show_properties(self._current_path))

        sender = self.sender()
        global_pos = sender.mapToGlobal(pos) if (sender and hasattr(sender, "mapToGlobal")) else self.mapToGlobal(pos)
        menu.exec_(global_pos)

    def action_new_text_document(self):
        if not self._current_path or not os.path.exists(self._current_path):
            return
        base = os.path.join(self._current_path, "New Text Document.txt")
        idx = 2
        path = base
        while os.path.exists(path):
            path = os.path.join(self._current_path, f"New Text Document ({idx}).txt")
            idx += 1
        try:
            with open(path, "w", encoding="utf-8") as f:
                f.write("")
            self.refresh()
        except OSError as err:
            QMessageBox.critical(self, "Error", f"Failed to create file: {err.strerror}")

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Back:
            self.go_back()
        elif event.key() == Qt.Key_Backspace and not self.search_box.hasFocus() and not self.address_bar.path_edit.hasFocus():
            self.go_back()
        elif event.key() == Qt.Key_F5:
            self.refresh()
        elif event.key() == Qt.Key_Delete:
            self.action_delete()
        elif event.key() == Qt.Key_F2:
            self.action_rename()
        elif event.modifiers() == Qt.ControlModifier and event.key() == Qt.Key_C:
            self.action_copy()
        elif event.modifiers() == Qt.ControlModifier and event.key() == Qt.Key_X:
            self.action_cut()
        elif event.modifiers() == Qt.ControlModifier and event.key() == Qt.Key_V:
            self.action_paste()
        elif event.modifiers() == Qt.ControlModifier and event.key() == Qt.Key_L:
            self.address_bar.mouseDoubleClickEvent(None)
        elif event.modifiers() == Qt.ControlModifier and event.key() == Qt.Key_F:
            self.search_box.setFocus()
            self.search_box.selectAll()
        else:
            super().keyPressEvent(event)


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("This PC")
    initial_path = ""
    if len(sys.argv) > 1:
        arg = sys.argv[1].strip()
        if arg and arg not in ("computer:/", "computer:", "thispc"):
            initial_path = os.path.expanduser(arg)
    window = WindowsFileExplorer(initial_path)
    window.show()
    sys.exit(app.exec_())


if __name__ == "__main__":
    main()
