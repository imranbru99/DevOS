    def _empty_trash(self):
        self.action_empty_recycle_bin()

    def action_empty_recycle_bin(self):
        trash_dir = os.path.expanduser("~/.local/share/Trash/files")
        trash_info = os.path.expanduser("~/.local/share/Trash/info")

        has_items = False
        if os.path.exists(trash_dir) and os.listdir(trash_dir):
            has_items = True

        if not has_items:
            QMessageBox.information(self, "Recycle Bin", "The Recycle Bin is already empty.")
            return

        reply = QMessageBox.warning(
            self,
            "Empty Recycle Bin",
            "Are you sure you want to permanently delete all items in the Recycle Bin?\n\nThis cannot be undone.",
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No,
        )
        if reply != QMessageBox.Yes:
            return

        # Empty files
        if os.path.exists(trash_dir):
            for item in os.listdir(trash_dir):
                fp = os.path.join(trash_dir, item)
                try:
                    if os.path.isdir(fp) and not os.path.islink(fp):
                        shutil.rmtree(fp, ignore_errors=True)
                    else:
                        os.remove(fp)
                except Exception:
                    pass

        # Empty info
        if os.path.exists(trash_info):
            for item in os.listdir(trash_info):
                fp = os.path.join(trash_info, item)
                try:
                    os.remove(fp)
                except Exception:
                    pass

        sizes_file = os.path.expanduser("~/.local/share/Trash/directorysizes")
        if os.path.exists(sizes_file):
            try:
                os.remove(sizes_file)
            except OSError:
                pass

        self.refresh()
        if hasattr(self, "status"):
            self.status.showMessage("Recycle Bin emptied", 4000)

    def action_restore_selected(self):
        paths = self.get_selected_paths()
        if not paths:
            return
        self._restore_paths(paths)

    def action_restore_all(self):
        trash_dir = os.path.expanduser("~/.local/share/Trash/files")
        if not os.path.exists(trash_dir):
            return
        try:
            items = [os.path.join(trash_dir, f) for f in os.listdir(trash_dir)]
        except OSError:
            items = []
        if not items:
            QMessageBox.information(self, "Recycle Bin", "The Recycle Bin is already empty.")
            return

        reply = QMessageBox.question(
            self,
            "Restore All Items",
            "Are you sure you want to restore all items in the Recycle Bin?",
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.Yes,
        )
        if reply == QMessageBox.Yes:
            self._restore_paths(items)

    def _restore_paths(self, paths):
        restored = 0
        failed = 0
        info_dir = os.path.expanduser("~/.local/share/Trash/info")

        for p in paths:
            if not os.path.exists(p):
                continue
            base = os.path.basename(p)
            orig_path, _ = get_trash_info(p)

            # Strip any residual trash internal paths
            if not orig_path or is_recycle_bin_path(orig_path):
                clean_name = re.sub(r"\s+\(\d+\)(\.[^.]+)?$", r"\1", base)
                desktop = os.path.expanduser("~/Desktop")
                if os.path.exists(desktop):
                    orig_path = os.path.join(desktop, clean_name)
                else:
                    orig_path = os.path.expanduser(f"~/{clean_name}")

            try:
                dest_dir = os.path.dirname(orig_path)
                if dest_dir:
                    os.makedirs(dest_dir, exist_ok=True)

                target = orig_path
                if os.path.exists(target):
                    stem, ext = os.path.splitext(target)
                    c = 2
                    while os.path.exists(target):
                        target = f"{stem} (Restored {c}){ext}"
                        c += 1

                shutil.move(p, target)

                # Clean matching trashinfo files
                info_path = os.path.join(info_dir, f"{base}.trashinfo")
                if os.path.exists(info_path):
                    try:
                        os.remove(info_path)
                    except OSError:
                        pass
                clean_base = re.sub(r"\s+\(\d+\)(\.[^.]+)?$", r"\1", base)
                clean_info = os.path.join(info_dir, f"{clean_base}.trashinfo")
                if os.path.exists(clean_info):
                    try:
                        os.remove(clean_info)
                    except OSError:
                        pass

                restored += 1
            except Exception:
                failed += 1

        self.refresh()
        if hasattr(self, "status"):
            msg = f"Restored {restored} item(s)"
            if failed > 0:
                msg += f" ({failed} failed)"
            self.status.showMessage(msg, 4000)

    def action_delete_permanently(self):
        paths = self.get_selected_paths()
        if not paths:
            return

        count = len(paths)
        if count == 1:
            name = os.path.basename(paths[0])
            msg = f"Are you sure you want to permanently delete '{name}'?\n\nThis item will be permanently removed and cannot be restored."
        else:
            msg = f"Are you sure you want to permanently delete these {count} items?\n\nThese items will be permanently removed and cannot be restored."

        reply = QMessageBox.warning(
            self,
            "Delete Permanently",
            msg,
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No,
        )
        if reply != QMessageBox.Yes:
            return

        deleted = 0
        info_dir = os.path.expanduser("~/.local/share/Trash/info")
        for p in paths:
            base = os.path.basename(p)
            try:
                if os.path.isdir(p) and not os.path.islink(p):
                    shutil.rmtree(p, ignore_errors=True)
                else:
                    os.remove(p)
                deleted += 1
            except Exception:
                pass

            info_file = os.path.join(info_dir, f"{base}.trashinfo")
            if os.path.exists(info_file):
                try:
                    os.remove(info_file)
                except OSError:
                    pass
            clean_base = re.sub(r"\s+\(\d+\)(\.[^.]+)?$", r"\1", base)
            clean_info = os.path.join(info_dir, f"{clean_base}.trashinfo")
            if os.path.exists(clean_info):
                try:
                    os.remove(clean_info)
                except OSError:
                    pass

        self.refresh()
        if hasattr(self, "status"):
            self.status.showMessage(f"Permanently deleted {deleted} item(s)", 4000)

    def _show_context_menu(self, pos):
        """Context menu for items or empty space in folder view."""
        menu = QMenu(self)
        paths = self.get_selected_paths()
        in_trash = self.is_in_recycle_bin()

        if in_trash:
            if paths:
                act_restore = menu.addAction(get_win_icon("restore", 16), "Restore")
                act_restore.triggered.connect(self.action_restore_selected)
                act_cut = menu.addAction("Cut")
                act_cut.triggered.connect(self.action_cut)
                act_del = menu.addAction(get_win_icon("delete-perm", 16), "Delete permanently")
                act_del.triggered.connect(self.action_delete_permanently)
                menu.addSeparator()
                act_props = menu.addAction("Properties")
                act_props.triggered.connect(lambda: self.show_properties(paths[0]))
            else:
                view_menu = menu.addMenu("View")
                act_details = view_menu.addAction("Details")
                act_details.triggered.connect(lambda: self.set_view_mode("details"))
                act_icons = view_menu.addAction("Large icons")
                act_icons.triggered.connect(lambda: self.set_view_mode("icons"))
                view_menu.addSeparator()
                act_hidden = view_menu.addAction("Hidden items")
                act_hidden.setCheckable(True)
                act_hidden.setChecked(self._show_hidden)
                act_hidden.triggered.connect(self.toggle_hidden_files)

                sort_menu = menu.addMenu("Sort by")
                for s in ["Name", "Original location", "Date deleted", "Size"]:
                    act_s = sort_menu.addAction(s)
                    act_s.triggered.connect(self.refresh)

                act_refresh = menu.addAction("Refresh")
                act_refresh.triggered.connect(self.refresh)
                menu.addSeparator()

                act_empty = menu.addAction(get_win_icon("recycle-bin", 16), "Empty Recycle Bin")
                act_empty.triggered.connect(self.action_empty_recycle_bin)
                act_rest_all = menu.addAction(get_win_icon("restore", 16), "Restore all items")
                act_rest_all.triggered.connect(self.action_restore_all)
                menu.addSeparator()

                act_props = menu.addAction("Properties")
                act_props.triggered.connect(lambda: self.show_properties(self._current_path))

            sender = self.sender()
            global_pos = sender.mapToGlobal(pos) if (sender and hasattr(sender, "mapToGlobal")) else self.mapToGlobal(pos)
            menu.exec_(global_pos)
            return

        if paths:
            target = paths[0]
            is_dir = os.path.isdir(target)

            act_open = menu.addAction("Open")
            act_open.triggered.connect(lambda: self._on_table_item_double_clicked(self.table_view.selectedItems()[0]))

            if is_archive_file(target):
                menu.addSeparator()
                stem = get_archive_stem(target)
                act_ext_all = menu.addAction(get_win_icon("file-archive", 16), "Extract All…")
                act_ext_all.triggered.connect(lambda _, t=target: self.action_extract_dialog(t))

                act_ext_here = menu.addAction("Extract Here")
                act_ext_here.triggered.connect(lambda _, t=target: self.action_extract_here(t))

                act_ext_folder = menu.addAction(f"Extract to {stem}/")
                act_ext_folder.triggered.connect(lambda _, t=target: self.action_extract_to_subfolder(t))
                menu.addSeparator()

            act_new_win = menu.addAction("Open in new window")
            act_new_win.triggered.connect(lambda: open_in_new_window(target))

            menu.addSeparator()

            # Windows 11 & 7-Zip Style Compression Menu
            act_comp_zip = menu.addAction(get_win_icon("file-archive", 16), "Compress to ZIP file")
            act_comp_zip.triggered.connect(lambda _, p=paths: self.action_compress_zip(p))

            zip_menu = menu.addMenu(get_win_icon("file-archive", 16), "7-Zip")
            act_add_dlg = zip_menu.addAction("Add to archive…")
            act_add_dlg.triggered.connect(lambda _, p=paths: self.action_compress_dialog(p))

            if len(paths) == 1:
                if not is_dir:
                    stem_name = os.path.splitext(os.path.basename(target))[0] or "archive"
                else:
                    stem_name = os.path.basename(target.rstrip("/\\")) or "archive"
            else:
                p_dir = os.path.dirname(os.path.abspath(target))
                p_base = os.path.basename(p_dir.rstrip("/\\"))
                if p_base and p_base not in ("/", "\\", "."):
                    stem_name = p_base
                else:
                    stem_name = os.path.splitext(os.path.basename(target))[0] if not is_dir else os.path.basename(target.rstrip("/\\"))
                    stem_name = f"{stem_name}_files"
            act_add_zip = zip_menu.addAction(f'Add to "{stem_name}.zip"')
            act_add_zip.triggered.connect(lambda _, p=paths: self.action_compress_zip(p))

            act_add_7z = zip_menu.addAction(f'Add to "{stem_name}.7z"')
            act_add_7z.triggered.connect(lambda _, p=paths: self.action_compress_7z(p))

            menu.addSeparator()

            if is_dir:
                if target in self._pinned_folders:
                    act_pin = menu.addAction("Unpin from Quick access")
                    act_pin.triggered.connect(lambda: self.unpin_from_quick_access(target))
                else:
                    act_pin = menu.addAction("Pin to Quick access")
                    act_pin.triggered.connect(lambda: self.pin_to_quick_access(target))

            act_term = menu.addAction("Open in Terminal")
            act_term.triggered.connect(lambda: open_in_terminal(target))
            menu.addSeparator()
            act_cut = menu.addAction("Cut")
            act_cut.triggered.connect(self.action_cut)
            act_copy = menu.addAction("Copy")
            act_copy.triggered.connect(self.action_copy)
            act_copy_path = menu.addAction(get_win_icon("copy-path", 16), "Copy as path\tCtrl+Shift+C")
            act_copy_path.triggered.connect(self.action_copy_path)
            menu.addSeparator()
            act_rename = menu.addAction("Rename")
            act_rename.triggered.connect(self.action_rename)
            act_del = menu.addAction("Delete")
            act_del.triggered.connect(self.action_delete)
            menu.addSeparator()
            act_props = menu.addAction("Properties")
            act_props.triggered.connect(lambda: self.show_properties(target))
        else:
            view_menu = menu.addMenu("View")
            act_details = view_menu.addAction("Details")
            act_details.triggered.connect(lambda: self.set_view_mode("details"))
            act_icons = view_menu.addAction("Large icons")
            act_icons.triggered.connect(lambda: self.set_view_mode("icons"))
            view_menu.addSeparator()
            act_hidden = view_menu.addAction("Hidden items")
            act_hidden.setCheckable(True)
            act_hidden.setChecked(self._show_hidden)
            act_hidden.triggered.connect(self.toggle_hidden_files)

            sort_menu = menu.addMenu("Sort by")
            for s in ["Name", "Date modified", "Type", "Size"]:
                act_s = sort_menu.addAction(s)
                act_s.triggered.connect(self.refresh)

            act_refresh = menu.addAction("Refresh")
            act_refresh.triggered.connect(self.refresh)
            menu.addSeparator()

            if self._clipboard["paths"]:
                act_paste = menu.addAction("Paste")
                act_paste.triggered.connect(self.action_paste)
                menu.addSeparator()

            act_copy_path = menu.addAction(get_win_icon("copy-path", 16), "Copy path")
            act_copy_path.triggered.connect(lambda: self.action_copy_path(self._current_path))
            menu.addSeparator()

            act_term = menu.addAction("Open in Terminal")
            act_term.triggered.connect(lambda: open_in_terminal(self._current_path))
            menu.addSeparator()

            new_menu = menu.addMenu("New")
            act_new_f = new_menu.addAction(get_win_icon("folder", 16), "Folder")
            act_new_f.triggered.connect(self.action_new_folder)
            act_new_doc = new_menu.addAction(get_win_icon("file-doc", 16), "Text Document")
            act_new_doc.triggered.connect(self.action_new_text_document)
            menu.addSeparator()

            act_props = menu.addAction("Properties")
            act_props.triggered.connect(lambda: self.show_properties(self._current_path))

        sender = self.sender()
        global_pos = sender.mapToGlobal(pos) if (sender and hasattr(sender, "mapToGlobal")) else self.mapToGlobal(pos)
        menu.exec_(global_pos)

    def action_new_text_document(self):
        if not self._current_path or not os.path.exists(self._current_path):
            return
        base_name = "New Text Document.txt"
        idx = 2
        suggested_name = base_name
        while os.path.exists(os.path.join(self._current_path, suggested_name)):
            suggested_name = f"New Text Document ({idx}).txt"
            idx += 1

        dlg = QDialog(self)
        dlg.setWindowTitle("New Text Document")
        dlg.setMinimumWidth(320)
        layout = QVBoxLayout(dlg)
        layout.addWidget(QLabel("File name:"))
        edit = QLineEdit(suggested_name)
        if "." in suggested_name:
            edit.setSelection(0, suggested_name.rfind("."))
        else:
            edit.selectAll()
        layout.addWidget(edit)
        btns = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        btns.accepted.connect(dlg.accept)
        btns.rejected.connect(dlg.reject)
        layout.addWidget(btns)

        if dlg.exec_() != QDialog.Accepted:
            return

        file_name = edit.text().strip()
        if not file_name:
            return

        target = os.path.join(self._current_path, file_name)
        if os.path.exists(target):
            QMessageBox.warning(self, "Error", f"An item named '{file_name}' already exists.")
            return

        try:
            with open(target, "w", encoding="utf-8") as f:
                f.write("")
            self.refresh()
            self._select_path(target)
        except OSError as err:
            QMessageBox.critical(self, "Error", f"Failed to create file: {err.strerror}")

    def closeEvent(self, event):
        if self._picker_mode and not self._picker_accepted:
            QApplication.instance().exit(1)
        event.accept()

    def keyPressEvent(self, event):
        if self._picker_mode and event.key() == Qt.Key_Escape:
            self._on_picker_cancel()
            return
        if not self._picker_mode and event.modifiers() == Qt.ControlModifier:
            if event.key() == Qt.Key_T:
                self._new_tab(self._current_path)
                return
            if event.key() == Qt.Key_W:
                self._close_tab(self.folder_tabs.currentIndex())
                return
            if event.key() == Qt.Key_Tab:
                self.folder_tabs.setCurrentIndex((self.folder_tabs.currentIndex() + 1) % self.folder_tabs.count())
                return
        if event.key() == Qt.Key_P and event.modifiers() == Qt.AltModifier:
            self.toggle_preview()
            return
        if self._picker_mode:
            if event.key() == Qt.Key_Escape:
                self._on_picker_cancel()
                return
            elif event.key() in (Qt.Key_Return, Qt.Key_Enter):
                if self.table_view.hasFocus() or self.list_view.hasFocus():
                    paths = self.get_selected_paths()
                    if paths:
                        first = paths[0]
                        if os.path.isdir(first):
                            self.navigate_to(first)
                            return
                        else:
                            self._on_picker_accept_paths([first])
                            return

        if event.key() == Qt.Key_Back:
            self.go_back()
        elif event.key() == Qt.Key_Backspace and not self.search_box.hasFocus() and not self.address_bar.path_edit.hasFocus():
            self.go_back()
        elif event.key() == Qt.Key_F5:
            self.refresh()
        elif event.modifiers() == Qt.ShiftModifier and event.key() == Qt.Key_Delete:
            self.action_delete_permanently()
        elif event.key() == Qt.Key_Delete:
            if self.is_in_recycle_bin():
                self.action_delete_permanently()
            else:
                self.action_delete()
        elif event.key() == Qt.Key_F2:
            self.action_rename()
        elif event.modifiers() == (Qt.ControlModifier | Qt.ShiftModifier) and event.key() == Qt.Key_C:
            self.action_copy_path()
        elif event.modifiers() == Qt.ControlModifier and event.key() == Qt.Key_C:
            self.action_copy()
        elif event.modifiers() == Qt.ControlModifier and event.key() == Qt.Key_X:
            self.action_cut()
        elif event.modifiers() == Qt.ControlModifier and event.key() == Qt.Key_V:
            self.action_paste()
        elif event.modifiers() == Qt.ControlModifier and event.key() == Qt.Key_L:
            self.address_bar.switch_to_edit()
        elif event.modifiers() == Qt.AltModifier and event.key() == Qt.Key_D:
            self.address_bar.switch_to_edit()
        elif event.modifiers() == Qt.ControlModifier and event.key() == Qt.Key_H:
            self.toggle_hidden_files()
        elif event.modifiers() == Qt.ControlModifier and event.key() == Qt.Key_F:
            self.search_box.setFocus()
            self.search_box.selectAll()
        else:
            super().keyPressEvent(event)


def main():
    try:
        import ctypes
        libc = ctypes.cdll.LoadLibrary("libc.so.6")
        libc.prctl(15, b"devos-files", 0, 0, 0)
    except Exception:
        pass

    parser = argparse.ArgumentParser(description="DevOS File Explorer & File Chooser")
    parser.add_argument("path", nargs="?", default="", help="Initial path or URL")
    parser.add_argument("--picker", "--choose-file", action="store_true", dest="picker", help="Open in file chooser/picker mode")
    parser.add_argument("--save", "--save-file", action="store_true", dest="save", help="Save file mode")
    parser.add_argument("--directory", "--choose-dir", action="store_true", dest="directory", help="Choose folder mode")
    parser.add_argument("--multiple", "--choose-files", action="store_true", dest="multiple", help="Allow multiple file selection")
    parser.add_argument("--title", type=str, default="", help="Custom dialog title")
    parser.add_argument("--name", type=str, default="", help="Suggested file name")
    parser.add_argument("--filter", type=str, default="", help="Filter pattern(s), e.g. 'Images (*.png *.jpg);;All Files (*.*)'")
    parser.add_argument("--resume", action="store_true", help="Resume the last folder in open-file dialogs")
    parser.add_argument("--output", type=str, default="", help="File to write chosen JSON array of paths to")

    args, unknown = parser.parse_known_args()
    picker_mode = bool(args.picker or args.save or args.directory or args.multiple)

    app = QApplication(sys.argv)
    app.setApplicationName("devos-thispc")
    app.setApplicationDisplayName("File Explorer" if not picker_mode else (args.title or "Open File"))
    if hasattr(app, "setDesktopFileName"):
        app.setDesktopFileName("devos-thispc.desktop")
    if hasattr(app, "setWindowIcon"):
        app.setWindowIcon(get_win_icon("this-pc" if not picker_mode else "folder", 64))

    candidate_path = args.path.strip() if args.path else ""
    if not candidate_path and unknown:
        for u in unknown:
            if not u.startswith("-"):
                candidate_path = u.strip()
                break

    initial_path = ""
    if candidate_path and candidate_path not in ("computer:/", "computer:", "thispc"):
        initial_path = os.path.expanduser(candidate_path)

    picker_options = {
        "resume": bool(args.resume) and not args.save,
        "save": bool(args.save),
        "directory": bool(args.directory),
        "multiple": bool(args.multiple),
        "title": args.title,
        "name": args.name,
        "filters": parse_filter_string(args.filter),
        "output": args.output,
    }

    if picker_mode and initial_path and os.path.isfile(initial_path):
        dir_name, file_name = os.path.split(initial_path)
        initial_path = dir_name
        if not picker_options["name"]:
            picker_options["name"] = file_name

    window = WindowsFileExplorer(initial_path, picker_mode=picker_mode, picker_options=picker_options)
    window.show()
    sys.exit(app.exec_())


if __name__ == "__main__":
    main()
