        lbl.setTextInteractionFlags(Qt.TextSelectableByMouse)
        return lbl


class WindowsSystemPropertiesDialog(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("System Properties")
        self.setWindowIcon(get_win_icon("this-pc", 32))
        self.resize(500, 580)
        self.setModal(True)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 20, 20, 16)
        layout.setSpacing(14)

        hdr_frame = QFrame()
        hdr_frame.setStyleSheet("background: #1e232d; border: 1px solid #2b3342; border-radius: 8px; padding: 12px;")
        hdr_layout = QHBoxLayout(hdr_frame)
        hdr_layout.setSpacing(16)

        pc_icon = QLabel()
        pc_icon.setPixmap(get_win_icon("this-pc", 54).pixmap(54, 54))
        hdr_layout.addWidget(pc_icon)

        text_col = QVBoxLayout()
        text_col.setSpacing(4)
        hostname = os.uname().nodename
        name_lbl = QLabel(hostname)
        name_lbl.setFont(QFont("Segoe UI", 14, QFont.Bold))
        name_lbl.setStyleSheet("color: #ffffff;")
        text_col.addWidget(name_lbl)

        sub_lbl = QLabel("DevOS 2027 Pro · 64-bit Workstation")
        sub_lbl.setStyleSheet("color: #38bdf8; font-size: 12px; font-weight: 600;")
        text_col.addWidget(sub_lbl)
        hdr_layout.addLayout(text_col, 1)

        layout.addWidget(hdr_frame)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.NoFrame)
        scroll_content = QWidget()
        s_layout = QVBoxLayout(scroll_content)
        s_layout.setContentsMargins(0, 0, 0, 0)
        s_layout.setSpacing(14)

        cpu_name = "Intel / AMD Processor"
        try:
            with open("/proc/cpuinfo") as f:
                for line in f:
                    if "model name" in line:
                        cpu_name = line.split(":", 1)[1].strip()
                        break
        except Exception:
            pass

        ram_str = "16.0 GB (15.5 GB usable)"
        try:
            with open("/proc/meminfo") as f:
                for line in f:
                    if "MemTotal" in line:
                        kb = int(line.split()[1])
                        gb = kb / (1024 * 1024)
                        ram_str = f"{gb:.1f} GB ({gb * 0.96:.1f} GB usable)"
                        break
        except Exception:
            pass

        dev_spec = QFrame()
        dev_spec.setStyleSheet("background: #1a1d24; border: 1px solid #282f3a; border-radius: 8px; padding: 12px;")
        d_layout = QVBoxLayout(dev_spec)
        d_layout.setSpacing(8)

        d_title = QLabel("Device specifications")
        d_title.setFont(QFont("Segoe UI", 11, QFont.Bold))
        d_title.setStyleSheet("color: #f8fafc;")
        d_layout.addWidget(d_title)

        d_grid = QGridLayout()
        d_grid.setHorizontalSpacing(16)
        d_grid.setVerticalSpacing(6)

        d_grid.addWidget(self._make_label("Device name"), 0, 0)
        d_grid.addWidget(self._make_val(hostname), 0, 1)

        d_grid.addWidget(self._make_label("Processor"), 1, 0)
        d_grid.addWidget(self._make_val(cpu_name), 1, 1)

        d_grid.addWidget(self._make_label("Installed RAM"), 2, 0)
        d_grid.addWidget(self._make_val(ram_str), 2, 1)

        d_grid.addWidget(self._make_label("Device ID"), 3, 0)
        d_grid.addWidget(self._make_val("A81B17F5-5113-495D-92F1-53B62E940B27"), 3, 1)

        d_grid.addWidget(self._make_label("Product ID"), 4, 0)
        d_grid.addWidget(self._make_val("00330-80000-00000-AAOEM"), 4, 1)

        d_grid.addWidget(self._make_label("System type"), 5, 0)
        d_grid.addWidget(self._make_val("64-bit operating system, x64-based processor"), 5, 1)

        d_grid.addWidget(self._make_label("Pen and touch"), 6, 0)
        d_grid.addWidget(self._make_val("No pen or touch input is available for this display"), 6, 1)

        d_layout.addLayout(d_grid)
        s_layout.addWidget(dev_spec)

        win_spec = QFrame()
        win_spec.setStyleSheet("background: #1a1d24; border: 1px solid #282f3a; border-radius: 8px; padding: 12px;")
        w_layout = QVBoxLayout(win_spec)
        w_layout.setSpacing(8)

        w_title = QLabel("Windows specifications")
        w_title.setFont(QFont("Segoe UI", 11, QFont.Bold))
        w_title.setStyleSheet("color: #f8fafc;")
        w_layout.addWidget(w_title)

        w_grid = QGridLayout()
        w_grid.setHorizontalSpacing(16)
        w_grid.setVerticalSpacing(6)

        w_grid.addWidget(self._make_label("Edition"), 0, 0)
        w_grid.addWidget(self._make_val("DevOS 2027 Pro"), 0, 1)

        w_grid.addWidget(self._make_label("Version"), 1, 0)
        w_grid.addWidget(self._make_val("24H2"), 1, 1)

        w_grid.addWidget(self._make_label("Installed on"), 2, 0)
        w_grid.addWidget(self._make_val("10/18/2026"), 2, 1)

        w_grid.addWidget(self._make_label("OS build"), 3, 0)
        w_grid.addWidget(self._make_val("26100.1742"), 3, 1)

        w_grid.addWidget(self._make_label("Experience"), 4, 0)
        w_grid.addWidget(self._make_val("DevOS Feature Experience Pack 1000.26100.1000.0"), 4, 1)

        w_layout.addLayout(w_grid)
        s_layout.addWidget(win_spec)

        scroll.setWidget(scroll_content)
        layout.addWidget(scroll, 1)

        btn_bar = QHBoxLayout()
        btn_dev_mgr = QPushButton("Device Manager")
        btn_dev_mgr.setObjectName("dialogBtn")
        btn_dev_mgr.clicked.connect(self._open_device_manager)
        btn_bar.addWidget(btn_dev_mgr)

        btn_taskman = QPushButton("Task Manager")
        btn_taskman.setObjectName("dialogBtn")
        btn_taskman.clicked.connect(self._open_taskman)
        btn_bar.addWidget(btn_taskman)

        btn_storage = QPushButton("Storage Doctor")
        btn_storage.setObjectName("dialogBtn")
        btn_storage.clicked.connect(self._open_storage)
        btn_bar.addWidget(btn_storage)

        btn_bar.addStretch(1)

        btn_ok = QPushButton("OK")
        btn_ok.setObjectName("dialogBtnPrimary")
        btn_ok.clicked.connect(self.accept)
        btn_bar.addWidget(btn_ok)

        layout.addLayout(btn_bar)

    def _open_device_manager(self):
        for cmd in [["python3", "/usr/local/share/devos/components/settings/hardware_manager.py"], ["kinfocenter"]]:
            try:
                subprocess.Popen(cmd)
                return
            except OSError:
                pass

    def _open_taskman(self):
        for cmd in [["/usr/local/bin/devos-taskman"], ["python3", "/usr/local/share/devos/components/taskman/taskman.py"]]:
            try:
                subprocess.Popen(cmd)
                return
            except OSError:
                pass

    def _open_storage(self):
        for cmd in [["/usr/local/bin/devos-disk-gui"], ["python3", "/usr/local/share/devos/components/settings/disk_doctor_gui.py"]]:
            try:
                subprocess.Popen(cmd)
                return
            except OSError:
                pass

    def _make_label(self, text):
        lbl = QLabel(text)
        lbl.setStyleSheet("color: #94a3b8; font-size: 12px;")
        return lbl

    def _make_val(self, text):
        lbl = QLabel(text)
        lbl.setStyleSheet("color: #f1f5f9; font-size: 12px;")
        lbl.setTextInteractionFlags(Qt.TextSelectableByMouse)
        return lbl


class WindowsFileExplorer(QMainWindow):
    """Full-featured Windows 10/11 File Explorer for DevOS."""

    def __init__(self, initial_path=""):
        super().__init__()
        self.setWindowTitle("This PC")
        self.setWindowIcon(get_win_icon("this-pc", 32))
        self.resize(1140, 700)
        self._history = []
        self._future = []
        self._current_path = ""
        self._clipboard = {"action": None, "paths": []}
        self._view_mode = "details"
        self._drives = []
        self._side_btns = {}
        self._pinned_folders = self.load_pinned_folders()

        self._setup_ui()
        self.navigate_to(initial_path, add_to_history=False)

    def _setup_ui(self):
        root = QWidget()
        self.setCentralWidget(root)
        main_layout = QVBoxLayout(root)
        main_layout.setContentsMargins(0, 0, 0, 0)
        main_layout.setSpacing(0)

        # 1. Top Navigation & Address Toolbar
