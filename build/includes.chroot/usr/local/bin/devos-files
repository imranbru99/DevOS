    p.end()
    icon = QIcon(pix)
    _ICON_CACHE[key] = icon
    return icon


def format_bytes(num):
    if num is None:
        return ""
    val = float(num)
    if val >= 1024 ** 3:
        gb = val / (1024 ** 3)
        return f"{gb:.0f} GB" if gb >= 10 else f"{gb:.1f} GB"
    if val >= 1024 ** 2:
        return f"{val / (1024 ** 2):.1f} MB"
    if val >= 1024:
        return f"{val / 1024:.0f} KB"
    return f"{val:.0f} bytes"


def parse_filter_string(filter_str):
    """Parse filter string such as 'Images (*.png *.jpg);;All Files (*.*)' into [(label, [patterns])]."""
    res = []
    if not filter_str:
        return [("All Files (*.*)", ["*.*"])]
    parts = [p.strip() for p in filter_str.split(";;") if p.strip()]
    for p in parts:
        m = re.search(r"\(([^)]+)\)", p)
        if m:
            pats = [x.strip() for x in re.split(r"[\s,;]+", m.group(1)) if x.strip()]
            res.append((p, pats))
        else:
            res.append((p, ["*.*"]))
    return res or [("All Files (*.*)", ["*.*"])]


def get_file_type_description(path):
    if os.path.isdir(path):
        return "File folder"
    ext = os.path.splitext(path)[1].lower()
    ext_map = {
        ".env": "Environment Configuration",
        ".gitignore": "Git Ignore File",
        ".dockerignore": "Docker Ignore File",
        ".editorconfig": "EditorConfig File",
        ".yml": "YAML Document",
        ".yaml": "YAML Document",
        ".conf": "Configuration File",
        ".ini": "Configuration File",
        ".txt": "Text Document",
        ".pdf": "PDF Document",
        ".py": "Python Source File",
        ".sh": "Shell Script",
        ".desktop": "Desktop Shortcut",
        ".png": "PNG Image",
        ".jpg": "JPEG Image",
        ".jpeg": "JPEG Image",
        ".gif": "GIF Image",
        ".svg": "Scalable Vector Graphic",
        ".webp": "WebP Image",
        ".mp3": "MP3 Audio",
        ".wav": "WAV Audio",
        ".flac": "FLAC Audio",
        ".mp4": "MP4 Video",
        ".mkv": "MKV Video",
        ".avi": "AVI Video",
        ".zip": "Compressed (zipped) Folder",
        ".tar": "TAR Archive",
        ".gz": "GZ Archive",
        ".xz": "XZ Archive",
        ".7z": "7-Zip Archive",
        ".deb": "Debian Package",
        ".iso": "Disk Image File",
        ".html": "HTML Document",
        ".css": "CSS Stylesheet",
        ".js": "JavaScript File",
        ".json": "JSON File",
        ".md": "Markdown Document",
        ".doc": "Microsoft Word Document",
        ".docx": "Microsoft Word Document",
        ".xls": "Microsoft Excel Worksheet",
        ".xlsx": "Microsoft Excel Worksheet",
        ".ppt": "PowerPoint Presentation",
        ".pptx": "PowerPoint Presentation",
    }
    if ext in ext_map:
        return ext_map[ext]
    mime, _ = mimetypes.guess_type(path)
    if mime:
        return mime.capitalize()
    return f"{ext[1:].upper()} File" if ext else "File"


def get_icon_for_file(path, is_dir=False):
    if is_dir:
        return get_win_icon("folder", 32)
    ext = os.path.splitext(path)[1].lower()
    if ext in [".py", ".sh", ".c", ".cpp", ".h", ".js", ".html", ".css", ".json"]:
        return get_win_icon("file-code", 32)
    if ext in [".png", ".jpg", ".jpeg", ".gif", ".svg", ".webp", ".ico"]:
        return get_win_icon("file-image", 32)
    if ext == ".pdf":
        return get_win_icon("file-pdf", 32)
    if ext in [".zip", ".tar", ".gz", ".xz", ".7z", ".rar", ".iso"]:
        return get_win_icon("file-archive", 32)
    if ext in [".mp4", ".mkv", ".avi", ".webm", ".mov"]:
        return get_win_icon("folder-videos", 32)
    if ext in [".mp3", ".wav", ".flac", ".ogg", ".aac"]:
        return get_win_icon("folder-music", 32)
    return get_win_icon("file-doc", 32)


def is_recycle_bin_path(path: str) -> bool:
    """Check if given path represents the Recycle Bin or an item within it."""
    if not path:
        return False
    if str(path).strip() in ("trash:/", "trash:", "trash", "Recycle Bin"):
        return True
    try:
        norm = os.path.normpath(os.path.abspath(os.path.expanduser(str(path))))
        trash_files = os.path.normpath(os.path.expanduser("~/.local/share/Trash/files"))
        trash_root = os.path.normpath(os.path.expanduser("~/.local/share/Trash"))
        return norm == trash_files or norm == trash_root or norm.startswith(trash_files + os.sep)
    except Exception:
        return False


def get_trash_info(trash_file_path: str):
    """Parse FreeDesktop trashinfo for a file in ~/.local/share/Trash/files/."""
    try:
        base = os.path.basename(trash_file_path)
        info_dir = os.path.expanduser("~/.local/share/Trash/info")
        info_path = os.path.join(info_dir, f"{base}.trashinfo")
        orig_path = None
        del_date = None
        if os.path.exists(info_path):
            with open(info_path, "r", encoding="utf-8", errors="replace") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("Path="):
                        orig_path = unquote(line[5:])
                    elif line.startswith("DeletionDate="):
                        del_date = line[13:]

        # If orig_path itself points inside trash (from legacy re-trash bugs), trace backwards
        visited = set()
        while orig_path and is_recycle_bin_path(orig_path) and orig_path not in visited:
            visited.add(orig_path)
            prev_base = os.path.basename(orig_path)
            prev_info = os.path.join(info_dir, f"{prev_base}.trashinfo")
            if os.path.exists(prev_info):
                next_orig = None
                with open(prev_info, "r", encoding="utf-8", errors="replace") as f:
                    for line in f:
                        line = line.strip()
                        if line.startswith("Path="):
                            next_orig = unquote(line[5:])
                if next_orig:
                    orig_path = next_orig
                    continue
            clean_base = re.sub(r"\s+\(\d+\)(\.[^.]+)?$", r"\1", prev_base)
            clean_info = os.path.join(info_dir, f"{clean_base}.trashinfo")
            if os.path.exists(clean_info):
                with open(clean_info, "r", encoding="utf-8", errors="replace") as f:
                    for line in f:
                        line = line.strip()
                        if line.startswith("Path="):
                            next_orig = unquote(line[5:])
                if next_orig and not is_recycle_bin_path(next_orig):
                    orig_path = next_orig
                    break
            break

        return orig_path, del_date
    except Exception:
        return None, None


SKIP_PREFIX = ("loop", "zram", "ram", "nbd", "sr", "fd")
SKIP_FS = {"swap", "squashfs"}


def _stat_mount(path):
    try:
        st = os.statvfs(path)
    except OSError:
        return None
    total = st.f_blocks * st.f_frsize
    free = st.f_bavail * st.f_frsize
    if total <= 0:
        return None
    return total, free


def list_drives():
    """Detect all system drives and partitions, assigning Windows drive letters (C:, D:, E:...)."""
    found = []

    def _walk(nodes):
        for node in nodes:
            name = node.get("name") or ""
            if name.startswith(SKIP_PREFIX):
                continue
            children = node.get("children") or []
            if children and node.get("type") == "disk":
                _walk(children)
                continue
            fstype = (node.get("fstype") or "").lower()
            mount = node.get("mountpoint") or ""
            if fstype in SKIP_FS:
                continue
            # Hide EFI boot partitions (< 1GB FAT mounted at /boot/efi or named EFI)
            if mount == "/boot/efi" or (fstype in {"vfat", "fat"} and int(node.get("size") or 0) < 1024 ** 3):
                continue
            if not fstype and not mount:
                if node.get("type") in {"part", "disk"} and int(node.get("size") or 0) >= 1024 ** 3:
                    pass
                else:
                    continue
            found.append(node)

    try:
        raw = subprocess.check_output(
            ["lsblk", "-J", "-b", "-o", "NAME,PATH,SIZE,FSTYPE,LABEL,TYPE,MOUNTPOINT,TRAN"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
        _walk(json.loads(raw).get("blockdevices") or [])
    except Exception:
        found = []

    drives = []
    seen_devices = set()

    # Find root / system partition for C:
    root_stat = _stat_mount("/")
    root_total, root_free = root_stat if root_stat else (0, 0)
    root_drive = {
        "letter": "C",
        "title": "DevOS (C:)",
        "label": "DevOS",
        "path": "",
        "mount": "/",
        "total": root_total,
        "free": root_free,
        "removable": False,
        "is_system": True,
    }

    # Next letters for secondary drives
    available_letters = [chr(c) for c in range(ord("D"), ord("Z") + 1)]

    for node in found:
        path = node.get("path") or ""
        mount = node.get("mountpoint") or ""
        total = int(node.get("size") or 0)
        label = (node.get("label") or "").strip()
        removable = (node.get("tran") or "") == "usb"

        # Check if this node is the root device (e.g. nvme0n1p2)
        if mount == "/" or (label == "DevOS" and not root_drive["path"]):
            root_drive["path"] = path
            if label:
                root_drive["title"] = f"{label} (C:)"
            seen_devices.add(path)
            continue

        if path in seen_devices:
            continue
        seen_devices.add(path)

        free = None
        if mount:
            usage = _stat_mount(mount)
            if usage:
                total, free = usage

        letter = available_letters.pop(0) if available_letters else "Z"
        display_label = label or ("Local Disk" if not removable else "USB Drive")
        title = f"{display_label} ({letter}:)"

        drives.append({
            "letter": letter,
            "title": title,
            "label": display_label,
            "path": path,
            "mount": mount,
            "total": total,
            "free": free,
            "removable": removable,
            "is_system": False,
            "fstype": (node.get("fstype") or "").lower(),
        })

    # Always put C: at the beginning
    drives.insert(0, root_drive)
    return drives


def open_file_with_default(path):
    """Open file using xdg-open."""
    if os.path.exists(path):
        subprocess.Popen(["xdg-open", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def open_pc_properties():
    """Open system properties (kinfocenter or settings)."""
    for cmd in [["kinfocenter"], ["systemsettings"], ["gnome-control-center"]]:
        try:
            subprocess.Popen(cmd)
            return
        except OSError:
            pass


def open_in_terminal(path):
    """Open terminal in target directory."""
    target = path if os.path.isdir(path) else os.path.dirname(path)
    for term in [["konsole", "--workdir", target], ["gnome-terminal", "--working-directory", target], ["x-terminal-emulator"]]:
        try:
            subprocess.Popen(term)
            return
        except OSError:
            pass


def open_in_new_window(path=""):
    """Launch another DevOS File Explorer window opened to path."""
    launcher = sys.argv[0] if (sys.argv and os.path.exists(sys.argv[0])) else "/usr/local/bin/devos-files"
    args = [sys.executable or "python3", launcher]
    if path:
        args.append(path)
    try:
        subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


ARCHIVE_EXTENSIONS = (
    ".zip", ".tar.gz", ".tgz", ".tar.bz2", ".tbz2",
    ".tar.xz", ".txz", ".tar", ".gz", ".bz2", ".xz",
    ".7z", ".rar", ".zst"
)


def is_archive_file(path: str) -> bool:
    if not path or os.path.isdir(path):
        return False
    lower = path.lower()
    return any(lower.endswith(ext) for ext in ARCHIVE_EXTENSIONS)


def get_archive_stem(path: str) -> str:
    name = os.path.basename(path)
    for ext in (".tar.gz", ".tar.bz2", ".tar.xz", ".tar.zst"):
        if name.lower().endswith(ext):
            return name[:-len(ext)]
    return os.path.splitext(name)[0]


def extract_archive(archive_path: str, destination_dir: str):
    os.makedirs(destination_dir, exist_ok=True)
    lower = archive_path.lower()

    if lower.endswith(".zip"):
        import zipfile
        with zipfile.ZipFile(archive_path, 'r') as zf:
            zf.extractall(destination_dir)
        return

    if any(lower.endswith(ext) for ext in (".tar.gz", ".tgz", ".tar.bz2", ".tbz2", ".tar.xz", ".txz", ".tar")):
        import tarfile
        with tarfile.open(archive_path, 'r:*') as tf:
            tf.extractall(destination_dir)
        return

    if lower.endswith(".gz") and not lower.endswith(".tar.gz"):
        import gzip
        stem = os.path.splitext(os.path.basename(archive_path))[0]
        out_file = os.path.join(destination_dir, stem)
        with gzip.open(archive_path, 'rb') as f_in:
            with open(out_file, 'wb') as f_out:
                shutil.copyfileobj(f_in, f_out)
        return

    if lower.endswith((".7z", ".rar")) and shutil.which("7z"):
        subprocess.check_call(["7z", "x", "-y", f"-o{destination_dir}", archive_path],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return

    try:
        shutil.unpack_archive(archive_path, destination_dir)
        return
    except Exception:
        pass

    if shutil.which("tar") and (".tar" in lower or lower.endswith(".tgz")):
        subprocess.check_call(["tar", "-xf", archive_path, "-C", destination_dir])
        return

    if shutil.which("unzip") and lower.endswith(".zip"):
        subprocess.check_call(["unzip", "-q", "-o", archive_path, "-d", destination_dir])
        return

    if shutil.which("7z"):
        subprocess.check_call(["7z", "x", "-y", f"-o{destination_dir}", archive_path],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return

    raise RuntimeError("No compatible extractor found for this archive format.")


def create_archive_path(parent_dir: str, name: str, ext: str) -> str:
    target = os.path.join(parent_dir, f"{name}{ext}")
    idx = 2
    while os.path.exists(target):
        target = os.path.join(parent_dir, f"{name} ({idx}){ext}")
        idx += 1
    return target


def compress_paths(paths: list, archive_type: str = "zip", destination_path: str = None) -> str:
    if not paths:
        return ""
    first = os.path.abspath(paths[0])
    parent_dir = os.path.dirname(first)
    if len(paths) == 1:
        if os.path.isfile(first):
            base = os.path.splitext(os.path.basename(first))[0] or "archive"
        else:
            base = os.path.basename(first.rstrip("/\\")) or "archive"
    else:
        parent_base = os.path.basename(parent_dir.rstrip("/\\"))
        if parent_base and parent_base not in ("/", "\\", "."):
            base = parent_base
        else:
            stem = os.path.splitext(os.path.basename(first))[0] if os.path.isfile(first) else os.path.basename(first.rstrip("/\\"))
            base = f"{stem}_files"

    ext = ".7z" if archive_type == "7z" else ".zip"
    out_path = destination_path or create_archive_path(parent_dir, base, ext)

    if archive_type == "7z" and shutil.which("7z"):
        cmd = ["7z", "a", "-t7z", "-y", out_path] + [os.path.basename(os.path.abspath(p)) for p in paths]
        subprocess.check_call(cmd, cwd=parent_dir, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return out_path

    if shutil.which("7z"):
        cmd = ["7z", "a", "-tzip", "-y", out_path] + [os.path.basename(os.path.abspath(p)) for p in paths]
        subprocess.check_call(cmd, cwd=parent_dir, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return out_path

    import zipfile
    with zipfile.ZipFile(out_path, "w", zipfile.ZIP_DEFLATED) as zf:
        for p in paths:
            abs_p = os.path.abspath(p)
            if os.path.isdir(abs_p):
                base_dir = os.path.dirname(abs_p)
                for root, _, files in os.walk(abs_p):
                    for f in files:
                        full = os.path.join(root, f)
                        rel = os.path.relpath(full, base_dir)
                        zf.write(full, rel)
            else:
                zf.write(abs_p, os.path.basename(abs_p))
    return out_path


class ExtractDialog(QDialog):
    """Windows 11-style 'Extract Compressed (Zipped) Folders' dialog."""
    def __init__(self, archive_path, parent=None):
        super().__init__(parent)
        self.archive_path = archive_path
        stem = get_archive_stem(archive_path)
        parent_dir = os.path.dirname(archive_path)
        default_dest = os.path.join(parent_dir, stem)

        self.setWindowTitle("Extract Compressed (Zipped) Folders")
        self.setWindowIcon(get_win_icon("file-archive", 32))
        self.resize(520, 220)
        self.setStyleSheet("""
            QDialog {
                background: #202020;
                color: #ffffff;
                font-family: 'Segoe UI', 'Noto Sans', sans-serif;
            }
            QLabel {
                color: #ffffff;
            }
            QLineEdit {
                background: #2d2d2d;
                color: #ffffff;
                border: 1px solid #454545;
                border-radius: 4px;
                padding: 6px 10px;
                font-size: 13px;
            }
            QLineEdit:focus {
                border: 1px solid #0078d4;
            }
            QPushButton {
                background: #2d2d2d;
                color: #ffffff;
                border: 1px solid #454545;
                border-radius: 4px;
                padding: 6px 16px;
                font-size: 13px;
            }
            QPushButton:hover {
                background: #383838;
                border-color: #555555;
            }
            QPushButton#primary {
                background: #0078d4;
                border: 1px solid #0078d4;
                color: #ffffff;
                font-weight: 600;
            }
            QPushButton#primary:hover {
                background: #106ebe;
            }
            QCheckBox {
                color: #cccccc;
                spacing: 8px;
            }
        """)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 20, 20, 20)
        layout.setSpacing(14)

        header = QLabel("Select a Destination and Extract Files")
        header.setStyleSheet("font-size: 15px; font-weight: 600; color: #ffffff;")
        layout.addWidget(header)

        sub = QLabel("Files will be extracted to this folder:")
        sub.setStyleSheet("color: #9e9e9e; font-size: 12.5px;")
        layout.addWidget(sub)

        path_box = QHBoxLayout()
        path_box.setSpacing(8)
        self.dest_edit = QLineEdit(default_dest)
        path_box.addWidget(self.dest_edit, 1)

        browse_btn = QPushButton("Browse…")
        browse_btn.clicked.connect(self._browse)
        path_box.addWidget(browse_btn)
        layout.addLayout(path_box)

        self.cb_show = QCheckBox("Show extracted files when complete")
        self.cb_show.setChecked(True)
        layout.addWidget(self.cb_show)

        layout.addStretch(1)

        btn_row = QHBoxLayout()
        btn_row.addStretch(1)
        btn_row.setSpacing(10)

        self.extract_btn = QPushButton("Extract")
        self.extract_btn.setObjectName("primary")
        self.extract_btn.clicked.connect(self.accept)
        btn_row.addWidget(self.extract_btn)

        cancel_btn = QPushButton("Cancel")
        cancel_btn.clicked.connect(self.reject)
        btn_row.addWidget(cancel_btn)

        layout.addLayout(btn_row)

    def _browse(self):
        curr = self.dest_edit.text() or os.path.dirname(self.archive_path)
        folder = QFileDialog.getExistingDirectory(self, "Select Destination Folder", curr)
        if folder:
            self.dest_edit.setText(folder)

    def destination(self) -> str:
        return self.dest_edit.text().strip()

    def show_when_done(self) -> bool:
        return self.cb_show.isChecked()


class CompressDialog(QDialog):
    """Windows 11 / 7-Zip style 'Add to Archive' dialog."""
    def __init__(self, target_paths: list, parent=None):
        super().__init__(parent)
        self.target_paths = target_paths
        first = os.path.abspath(target_paths[0])
        self.parent_dir = os.path.dirname(first)
        base = os.path.basename(first.rstrip("/\\"))
        if len(target_paths) > 1:
            base = base + "_files"
        self.default_name = base

        self.setWindowTitle("Add to Archive")
        self.setWindowIcon(get_win_icon("file-archive", 32))
        self.resize(480, 230)
        self.setStyleSheet("""
            QDialog {
                background: #202020;
                color: #ffffff;
                font-family: 'Segoe UI', 'Noto Sans', sans-serif;
            }
            QLabel { color: #ffffff; }
            QLineEdit, QComboBox {
                background: #2d2d2d;
                border: 1px solid #404040;
                border-radius: 4px;
                padding: 6px 10px;
                color: #ffffff;
            }
            QPushButton {
                background: #333333;
                border: 1px solid #404040;
                border-radius: 4px;
                padding: 6px 16px;
                color: #ffffff;
            }
            QPushButton:hover { background: #404040; }
            QPushButton#primaryBtn {
                background: #0078d4;
                border-color: #0078d4;
            }
            QPushButton#primaryBtn:hover { background: #106ebe; }
        """)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 20, 20, 20)
        layout.setSpacing(14)

        lbl = QLabel("Create a compressed archive from selected item(s):")
        layout.addWidget(lbl)

        # Name row
        name_layout = QHBoxLayout()
        name_layout.addWidget(QLabel("Archive name:"))
        self.name_edit = QLineEdit(f"{self.default_name}.zip")
        name_layout.addWidget(self.name_edit)
        layout.addLayout(name_layout)

        # Format row
        fmt_layout = QHBoxLayout()
        fmt_layout.addWidget(QLabel("Archive format:"))
        self.fmt_combo = QComboBox()
        self.fmt_combo.addItems(["ZIP (.zip)", "7-Zip (.7z)"])
        self.fmt_combo.currentIndexChanged.connect(self._on_format_changed)
        fmt_layout.addWidget(self.fmt_combo)
        layout.addLayout(fmt_layout)

        layout.addStretch()

        # Buttons
        btn_layout = QHBoxLayout()
        btn_layout.addStretch()
        self.ok_btn = QPushButton("OK")
        self.ok_btn.setObjectName("primaryBtn")
        self.ok_btn.clicked.connect(self.accept)
        cancel_btn = QPushButton("Cancel")
        cancel_btn.clicked.connect(self.reject)
        btn_layout.addWidget(self.ok_btn)
        btn_layout.addWidget(cancel_btn)
        layout.addLayout(btn_layout)

    def _on_format_changed(self, idx):
        cur = self.name_edit.text()
        stem = os.path.splitext(cur)[0]
        ext = ".7z" if idx == 1 else ".zip"
        self.name_edit.setText(f"{stem}{ext}")

    def get_result(self):
        name = self.name_edit.text().strip() or f"{self.default_name}.zip"
        fmt = "7z" if self.fmt_combo.currentIndex() == 1 else "zip"
        if not name.lower().endswith(".zip") and not name.lower().endswith(".7z"):
            name += (".7z" if fmt == "7z" else ".zip")
        out_path = os.path.join(self.parent_dir, name)
        return fmt, out_path


class DriveCard(QFrame):
    """Windows-style Drive Card with Windows disk icon, drive letter, and storage bar."""

    def __init__(self, drive, on_open, on_context=None):
        super().__init__()
        self.drive = drive
        self.on_open = on_open
        self.on_context = on_context
        self.setObjectName("driveCard")
        self.setCursor(Qt.PointingHandCursor)
        self.setFocusPolicy(Qt.ClickFocus)
        self.setMinimumHeight(86)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)

        row = QHBoxLayout(self)
        row.setContentsMargins(14, 12, 14, 12)
        row.setSpacing(14)

        # Drive Icon
        icon_type = "drive-c" if drive["is_system"] else ("drive-usb" if drive["removable"] else "drive-fixed")
        icon_label = QLabel()
        icon_label.setPixmap(get_win_icon(icon_type, 44).pixmap(44, 44))
        icon_label.setFixedSize(44, 44)
        row.addWidget(icon_label, 0, Qt.AlignVCenter)

        # Drive Info
        text_layout = QVBoxLayout()
        text_layout.setSpacing(5)

        title = QLabel(drive["title"])
        title.setObjectName("driveTitle")
        title.setFont(QFont("Inter", 11, QFont.DemiBold))
        text_layout.addWidget(title)

        bar = QProgressBar()
        bar.setTextVisible(False)
        bar.setFixedHeight(8)
        bar.setObjectName("driveBar")

        total = drive["total"] or 0
        free = drive["free"]
        if total > 0 and free is not None:
            used = max(0, min(100, int(round((total - free) * 100 / total))))
            bar.setValue(used)
            # Red color if disk >= 90% full
            if used >= 90:
                bar.setObjectName("driveBarFull")
            space_text = f"{format_bytes(free)} free of {format_bytes(total)}"
        elif total > 0:
            bar.setValue(0)
            if not drive.get("fstype"):
                space_text = f"{format_bytes(total)}  ·  Unformatted (Double-click to setup)"
            else:
                space_text = f"{format_bytes(total)}  ·  Not mounted (Double-click to open)"
        else:
            bar.setValue(0)
            space_text = "Drive ready"

        space = QLabel(space_text)
        space.setObjectName("driveSpace")

        text_layout.addWidget(bar)
        text_layout.addWidget(space)
        row.addLayout(text_layout, 1)

    def mouseDoubleClickEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.on_open(self.drive)
        super().mouseDoubleClickEvent(event)

    def mousePressEvent(self, event):
        if event.button() == Qt.RightButton and self.on_context:
            self.on_context(self.drive, event.globalPos())
            event.accept()
            return
        super().mousePressEvent(event)


class FolderTile(QFrame):
    """Windows 11-style premium Folder Card for user standard folders."""

    def __init__(self, name, path, icon_name, on_open, on_context=None):
        super().__init__()
        self.name = name
        self.path = path
        self.on_open = on_open
        self.on_context = on_context
        self.setObjectName("folderTile")
        self.setCursor(Qt.PointingHandCursor)
        self.setFocusPolicy(Qt.ClickFocus)
        self.setMinimumHeight(66)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)

        layout = QHBoxLayout(self)
        layout.setContentsMargins(14, 10, 14, 10)
        layout.setSpacing(12)

        # 42x42 Vibrant Windows 11 Folder Icon
        icon_label = QLabel()
        icon_label.setPixmap(get_win_icon(icon_name, 42).pixmap(42, 42))
        icon_label.setFixedSize(42, 42)
        icon_label.setAlignment(Qt.AlignCenter)
        layout.addWidget(icon_label, 0, Qt.AlignVCenter)

        # Text Column (Title + Item count / info)
        text_layout = QVBoxLayout()
        text_layout.setSpacing(3)
        text_layout.setAlignment(Qt.AlignVCenter)

        title = QLabel(name)
        title.setObjectName("folderTileTitle")
        title.setFont(QFont("Inter", 11, QFont.DemiBold))

        # Dynamic Item Count / Subtitle
        try:
            if os.path.isdir(path):
                cnt = len(os.listdir(path))
                sub_text = f"{cnt} {'item' if cnt == 1 else 'items'}"
            else:
                sub_text = "Personal folder"
        except Exception:
            sub_text = "Personal folder"

        subtitle = QLabel(sub_text)
        subtitle.setObjectName("folderTileSub")
        subtitle.setFont(QFont("Inter", 9))

        text_layout.addWidget(title)
        text_layout.addWidget(subtitle)
        layout.addLayout(text_layout, 1)

    def mouseDoubleClickEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.on_open(self.path)
        super().mouseDoubleClickEvent(event)

    def mousePressEvent(self, event):
        if event.button() == Qt.RightButton and self.on_context:
            self.on_context(self.path, event.globalPos())
            event.accept()
            return
        super().mousePressEvent(event)


class PathLineEdit(QLineEdit):
    """Path editor that handles Escape and focus out to return to breadcrumbs."""

    def __init__(self, parent_bar, parent=None):
        super().__init__(parent)
        self.parent_bar = parent_bar

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape:
            self.parent_bar.restore_crumbs()
            event.accept()
            return
        super().keyPressEvent(event)

    def focusOutEvent(self, event):
        super().focusOutEvent(event)
        if QApplication.activePopupWidget():
            return
        self.parent_bar.restore_crumbs()


class BreadcrumbBar(QWidget):
    """Windows-style clickable Breadcrumb Address Bar."""

    path_changed = pyqtSignal(str)

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setObjectName("breadcrumbBar")
        self.setFixedHeight(34)
        self._current_path = ""
        self._current_label = "This PC"

        self.layout = QHBoxLayout(self)
        self.layout.setContentsMargins(6, 2, 4, 2)
        self.layout.setSpacing(2)

        # Icon at beginning of address bar
        self.icon_label = QLabel()
        self.icon_label.setFixedSize(20, 20)
        self.layout.addWidget(self.icon_label)

        # Breadcrumbs container with click-to-edit empty space
        self.crumbs_container = QWidget()
        self.crumbs_container.setCursor(Qt.IBeamCursor)
        self.crumbs_container.mousePressEvent = self._on_container_mouse_press
        self.crumbs_container_layout = QHBoxLayout(self.crumbs_container)
        self.crumbs_container_layout.setContentsMargins(0, 0, 0, 0)
        self.crumbs_container_layout.setSpacing(2)

        self.crumbs_widget = QWidget()
        self.crumbs_layout = QHBoxLayout(self.crumbs_widget)
        self.crumbs_layout.setContentsMargins(0, 0, 0, 0)
        self.crumbs_layout.setSpacing(2)
        self.crumbs_container_layout.addWidget(self.crumbs_widget)
        self.crumbs_container_layout.addStretch(1)

        self.layout.addWidget(self.crumbs_container, 1)

        # Direct text editor (hidden by default)
        self.path_edit = PathLineEdit(self)
        self.path_edit.setObjectName("pathEdit")
        self.path_edit.returnPressed.connect(self._on_edit_submitted)
        self.path_edit.hide()
        self.layout.addWidget(self.path_edit, 1)

        # Quick copy address button at right end of address bar
        self.btn_copy_addr = QToolButton()
        self.btn_copy_addr.setObjectName("crumbCopyBtn")
        self.btn_copy_addr.setIcon(get_win_icon("copy-path", 16))
        self.btn_copy_addr.setIconSize(QSize(16, 16))
        self.btn_copy_addr.setCursor(Qt.PointingHandCursor)
        self.btn_copy_addr.setToolTip("Copy address")
        self.btn_copy_addr.clicked.connect(self._on_copy_addr_clicked)
        self.layout.addWidget(self.btn_copy_addr)

    def _on_container_mouse_press(self, event):
        if event.button() == Qt.LeftButton:
            self.switch_to_edit()
        elif event.button() == Qt.RightButton:
            self._show_address_context_menu(event.globalPos())

    def switch_to_edit(self):
        self.crumbs_container.hide()
        self.path_edit.show()
        self.path_edit.setFocus()
        self.path_edit.selectAll()

    def restore_crumbs(self):
        self.path_edit.hide()
        self.crumbs_container.show()

    def _on_copy_addr_clicked(self):
        self._copy_address(self._current_path or "This PC")

    def _copy_address(self, path):
        if is_recycle_bin_path(path):
            target = "Recycle Bin"
        else:
            target = path if path else (self._current_path or "This PC")
        QApplication.clipboard().setText(target)
        win = self.window()
        if win and hasattr(win, "status"):
            win.status.showMessage(f"Copied address: {target}", 3000)

    def _show_address_context_menu(self, global_pos, target_path=None):
        target = target_path if target_path is not None else (self._current_path or "This PC")
        menu = QMenu(self)
        act_copy = menu.addAction(get_win_icon("copy-path", 16), "Copy address")
        act_copy.triggered.connect(lambda: self._copy_address(target))
        act_copy_text = menu.addAction("Copy address as text")
        act_copy_text.triggered.connect(lambda: self._copy_address(target))
        menu.addSeparator()
        act_edit = menu.addAction("Edit address")
        act_edit.triggered.connect(self.switch_to_edit)
        menu.exec_(global_pos)

    def _show_crumb_context_menu(self, path, global_pos):
        menu = QMenu(self)
        label = "This PC" if not path else ("Recycle Bin" if is_recycle_bin_path(path) else os.path.basename(path))
        icon_name = "this-pc" if not path else ("recycle-bin" if is_recycle_bin_path(path) else "folder")
        act_open = menu.addAction(get_win_icon(icon_name, 16), f"Open '{label}'")
        act_open.triggered.connect(lambda: self.path_changed.emit(path))
        if path and not is_recycle_bin_path(path):
            act_new_win = menu.addAction("Open in new window")
            act_new_win.triggered.connect(lambda: open_in_new_window(path))
            act_term = menu.addAction("Open in Terminal")
            act_term.triggered.connect(lambda: open_in_terminal(path))
            menu.addSeparator()
        act_copy = menu.addAction(get_win_icon("copy-path", 16), "Copy address")
        act_copy.triggered.connect(lambda: self._copy_address(path or "This PC"))
        menu.addSeparator()
        act_edit = menu.addAction("Edit address")
        act_edit.triggered.connect(self.switch_to_edit)
        menu.exec_(global_pos)

    def set_location(self, path, label=""):
        self._current_path = path
        self._current_label = label or path
        self.path_edit.hide()
        self.crumbs_container.show()

        # Update address bar icon
        if not path or path == "This PC":
            self.icon_label.setPixmap(get_win_icon("this-pc", 18).pixmap(18, 18))
            self.path_edit.setText("This PC")
        elif is_recycle_bin_path(path):
            self.icon_label.setPixmap(get_win_icon("recycle-bin", 18).pixmap(18, 18))
            self.path_edit.setText("Recycle Bin")
        elif path == "/":
            self.icon_label.setPixmap(get_win_icon("drive-c", 18).pixmap(18, 18))
            self.path_edit.setText(path)
        else:
            self.icon_label.setPixmap(get_win_icon("folder", 18).pixmap(18, 18))
            self.path_edit.setText(path)

        # Rebuild breadcrumbs
        while self.crumbs_layout.count():
            item = self.crumbs_layout.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

        # Always start with 'This PC'
        this_pc_btn = QPushButton("This PC")
        this_pc_btn.setObjectName("crumbBtn")
        this_pc_btn.setCursor(Qt.PointingHandCursor)
        this_pc_btn.clicked.connect(lambda: self.path_changed.emit(""))
        this_pc_btn.setContextMenuPolicy(Qt.CustomContextMenu)
        this_pc_btn.customContextMenuRequested.connect(lambda pos, b=this_pc_btn: self._show_crumb_context_menu("", b.mapToGlobal(pos)))
        self.crumbs_layout.addWidget(this_pc_btn)

        if not path or path == "This PC":
            return

        sep = QLabel("›")
        sep.setObjectName("crumbSep")
        self.crumbs_layout.addWidget(sep)

        # Recycle Bin clean breadcrumb
        if is_recycle_bin_path(path):
            bin_btn = QPushButton("Recycle Bin")
            bin_btn.setObjectName("crumbBtn")
            bin_btn.setCursor(Qt.PointingHandCursor)
            trash_path = os.path.expanduser("~/.local/share/Trash/files")
            bin_btn.clicked.connect(lambda _=False, p=trash_path: self.path_changed.emit(p))
            bin_btn.setContextMenuPolicy(Qt.CustomContextMenu)
            bin_btn.customContextMenuRequested.connect(lambda pos, b=bin_btn: self._show_crumb_context_menu(trash_path, b.mapToGlobal(pos)))
            self.crumbs_layout.addWidget(bin_btn)
            return

        home = os.path.expanduser("~")

        # Check if path belongs to a secondary drive (e.g. D:, E:...)
        matched_drive = None
        try:
            for d in list_drives():
                d_mount = d.get("mount") or ""
                if not d.get("is_system") and d_mount and os.path.isdir(d_mount):
                    if path == d_mount or path.startswith(d_mount.rstrip("/") + "/"):
                        matched_drive = d
                        break
        except Exception:
            matched_drive = None

        if matched_drive:
            d_mount = matched_drive["mount"]
            d_title = matched_drive["title"]
            rel = os.path.relpath(path, d_mount)
            base_btn = QPushButton(d_title)
            base_btn.setObjectName("crumbBtn")
            base_btn.clicked.connect(lambda _=False, p=d_mount: self.path_changed.emit(p))
            base_btn.setContextMenuPolicy(Qt.CustomContextMenu)
            base_btn.customContextMenuRequested.connect(lambda pos, p=d_mount, b=base_btn: self._show_crumb_context_menu(p, b.mapToGlobal(pos)))
            self.crumbs_layout.addWidget(base_btn)

            if rel and rel != ".":
                parts = rel.split(os.sep)
                curr = d_mount
                for part in parts:
                    sep = QLabel("›")
                    sep.setObjectName("crumbSep")
                    self.crumbs_layout.addWidget(sep)
                    curr = os.path.join(curr, part)
                    btn = QPushButton(part)
                    btn.setObjectName("crumbBtn")
                    btn.clicked.connect(lambda _=False, p=curr: self.path_changed.emit(p))
                    btn.setContextMenuPolicy(Qt.CustomContextMenu)
                    btn.customContextMenuRequested.connect(lambda pos, p=curr, b=btn: self._show_crumb_context_menu(p, b.mapToGlobal(pos)))
                    self.crumbs_layout.addWidget(btn)
        # Home directory shortcut friendly formatting
        elif path.startswith(home):
            rel = os.path.relpath(path, home)
            base_btn = QPushButton(os.path.basename(home))
            base_btn.setObjectName("crumbBtn")
            base_btn.clicked.connect(lambda _=False, p=home: self.path_changed.emit(p))
            base_btn.setContextMenuPolicy(Qt.CustomContextMenu)
            base_btn.customContextMenuRequested.connect(lambda pos, p=home, b=base_btn: self._show_crumb_context_menu(p, b.mapToGlobal(pos)))
            self.crumbs_layout.addWidget(base_btn)

            if rel and rel != ".":
                parts = rel.split(os.sep)
                curr = home
                for part in parts:
                    sep = QLabel("›")
                    sep.setObjectName("crumbSep")
                    self.crumbs_layout.addWidget(sep)
                    curr = os.path.join(curr, part)
                    btn = QPushButton(part)
                    btn.setObjectName("crumbBtn")
                    btn.clicked.connect(lambda _=False, p=curr: self.path_changed.emit(p))
                    btn.setContextMenuPolicy(Qt.CustomContextMenu)
                    btn.customContextMenuRequested.connect(lambda pos, p=curr, b=btn: self._show_crumb_context_menu(p, b.mapToGlobal(pos)))
                    self.crumbs_layout.addWidget(btn)
        else:
            parts = [p for p in path.split(os.sep) if p]
            curr = "/"
            c_btn = QPushButton("Local Disk (C:)")
            c_btn.setObjectName("crumbBtn")
            c_btn.clicked.connect(lambda _=False: self.path_changed.emit("/"))
            c_btn.setContextMenuPolicy(Qt.CustomContextMenu)
            c_btn.customContextMenuRequested.connect(lambda pos, b=c_btn: self._show_crumb_context_menu("/", b.mapToGlobal(pos)))
            self.crumbs_layout.addWidget(c_btn)

            for part in parts:
                sep = QLabel("›")
                sep.setObjectName("crumbSep")
                self.crumbs_layout.addWidget(sep)
                curr = os.path.join(curr, part)
                btn = QPushButton(part)
                btn.setObjectName("crumbBtn")
                btn.clicked.connect(lambda _=False, p=curr: self.path_changed.emit(p))
                btn.setContextMenuPolicy(Qt.CustomContextMenu)
                btn.customContextMenuRequested.connect(lambda pos, p=curr, b=btn: self._show_crumb_context_menu(p, b.mapToGlobal(pos)))
                self.crumbs_layout.addWidget(btn)

    def mouseDoubleClickEvent(self, event):
        self.switch_to_edit()

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.switch_to_edit()
        elif event.button() == Qt.RightButton:
            self._show_address_context_menu(event.globalPos())
        super().mousePressEvent(event)

    def _on_edit_submitted(self):
        text = self.path_edit.text().strip()
        if text == "This PC" or not text:
            self.path_changed.emit("")
        elif text.lower() in ("recycle bin", "recycle-bin", "trash", "trash:", "trash:/"):
            self.path_changed.emit(os.path.expanduser("~/.local/share/Trash/files"))
        else:
            # Check secondary Windows drive letters (D:, E:, etc.)
            matched_target = None
            try:
                for d in list_drives():
                    letter = d.get("letter", "")
                    d_mount = d.get("mount", "")
                    if letter and d_mount and os.path.isdir(d_mount):
                        prefix = f"{letter.upper()}:"
                        if text.upper().startswith(prefix + "\\") or text.upper() == prefix or text.upper().startswith(prefix + "/"):
                            rem = text[len(prefix):].lstrip("\\/").replace("\\", "/")
                            matched_target = os.path.join(d_mount, rem) if rem else d_mount
                            break
            except Exception:
                matched_target = None

            if matched_target:
                target = matched_target
            # Handle Windows-style C:\ paths
            elif text.upper().startswith("C:\\") or text.upper() == "C:":
                rem = text[3:].replace("\\", "/") if text.upper().startswith("C:\\") else ""
                target = "/" + rem
            elif text.startswith("~"):
                target = os.path.expanduser(text)
            else:
                target = text
            self.path_changed.emit(target)


class ExplorerTableItem(QTableWidgetItem):
    """Custom table item ensuring folders always sort above files."""

    def __lt__(self, other):
        is_dir_self = bool(self.data(Qt.UserRole + 1))
        is_dir_other = bool(other.data(Qt.UserRole + 1))
        if is_dir_self != is_dir_other:
            table = self.tableWidget()
            order = table.horizontalHeader().sortIndicatorOrder() if table else Qt.AscendingOrder
            if order == Qt.AscendingOrder:
                return is_dir_self and not is_dir_other
            else:
                return not is_dir_self and is_dir_other

        val_self = self.data(Qt.UserRole)
        val_other = other.data(Qt.UserRole)
        if isinstance(val_self, (int, float)) and isinstance(val_other, (int, float)):
            return val_self < val_other
        return self.text().lower() < other.text().lower()


class ExplorerTableWidget(QTableWidget):
    """Table widget supporting native OS drag-out, drop-in, and rubber-band marquee selection."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setDragEnabled(True)
        self.setAcceptDrops(True)
        self.setDropIndicatorShown(True)
        self.setSelectionBehavior(QAbstractItemView.SelectRows)
        self.setSelectionMode(QAbstractItemView.ExtendedSelection)
        self.setDefaultDropAction(Qt.CopyAction)

        self._drag_start_pos = None
        self._drag_item_was_selected = False
        self._rubber_origin = None
        self._rubber_band = QRubberBand(QRubberBand.Rectangle, self.viewport())

    def _is_on_item_content(self, pos):
        item = self.itemAt(pos)
        if not item:
            return False
        if item.column() == 0:
            index = self.model().index(item.row(), 0)
            rect = self.visualRect(index)
            text_w = self.fontMetrics().horizontalAdvance(item.text())
            content_w = 40 + text_w + 20
            return (rect.left() <= pos.x() <= rect.left() + content_w)
        return False

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            pos = event.pos()
            item = self.itemAt(pos)
            on_content = self._is_on_item_content(pos)

            if not on_content or item is None:
                # Clicked empty space or blank area of cell -> start marquee selection box
                if not (event.modifiers() & (Qt.ControlModifier | Qt.ShiftModifier)):
                    self.clearSelection()
                self._rubber_origin = pos
                self._rubber_band.setGeometry(QRect(pos, QSize()))
                self._rubber_band.show()
                self._drag_start_pos = None
                self._drag_item_was_selected = False
                return
            else:
                self._drag_start_pos = pos
                self._drag_item_was_selected = bool(item and item.isSelected())

                if self._drag_item_was_selected and not (event.modifiers() & (Qt.ControlModifier | Qt.ShiftModifier)):
                    self._rubber_origin = None
                    return
                else:
                    self._rubber_origin = pos
                    self._rubber_band.setGeometry(QRect(pos, QSize()))

        super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        pos = event.pos()

        # 1. Marquee rubber band selection
        if self._rubber_origin is not None and (event.buttons() & Qt.LeftButton):
            if (pos - self._rubber_origin).manhattanLength() >= 3:
                self._rubber_band.show()
                rect = QRect(self._rubber_origin, pos).normalized()
                self._rubber_band.setGeometry(rect)

                selection = QItemSelection()
                col_max = max(0, self.columnCount() - 1)
                viewport_w = self.viewport().width()

                for row in range(self.rowCount()):
                    row_rect = self.visualRect(self.model().index(row, 0))
                    row_rect.setWidth(viewport_w)
                    if rect.intersects(row_rect):
                        top_left = self.model().index(row, 0)
                        bottom_right = self.model().index(row, col_max)
                        selection.select(top_left, bottom_right)

                flags = QItemSelectionModel.ClearAndSelect
                if event.modifiers() & Qt.ControlModifier:
                    flags = QItemSelectionModel.Select
                self.selectionModel().select(selection, flags)
                return

        # 2. File drag to external app (Chrome) or another folder
        if (event.buttons() & Qt.LeftButton) and self._drag_start_pos is not None:
            if (pos - self._drag_start_pos).manhattanLength() >= QApplication.startDragDistance():
                if self._drag_item_was_selected:
                    self.start_file_drag()
                    self._drag_start_pos = None
                    return

        super().mouseMoveEvent(event)

    def mouseReleaseEvent(self, event):
        if self._rubber_origin is not None:
            self._rubber_band.hide()
            self._rubber_origin = None

        if event.button() == Qt.LeftButton and self._drag_start_pos is not None:
            item = self.itemAt(self._drag_start_pos)
            if item is not None and self._drag_item_was_selected and not (event.modifiers() & (Qt.ControlModifier | Qt.ShiftModifier)):
                selected_rows = self.selectionModel().selectedRows()
                if len(selected_rows) > 1:
                    self.clearSelection()
                    self.selectRow(item.row())
            self._drag_start_pos = None
            self._drag_item_was_selected = False

        super().mouseReleaseEvent(event)

    def startDrag(self, supportedActions):
        self.start_file_drag()

    def start_file_drag(self):
        window = self.window()
        if not hasattr(window, "get_selected_paths"):
            return
        paths = window.get_selected_paths()
        if not paths:
            return
        valid_paths = [os.path.abspath(p) for p in paths if p and os.path.exists(p)]
        if not valid_paths:
            return

        drag = QDrag(self)
        mime = QMimeData()
        urls = [QUrl.fromLocalFile(p) for p in valid_paths]
        mime.setUrls(urls)
        mime.setText("\n".join(valid_paths))
        drag.setMimeData(mime)

        selected = self.selectedItems()
        if selected:
            for it in selected:
                if it.column() == 0 and not it.icon().isNull():
                    drag.setPixmap(it.icon().pixmap(32, 32))
                    drag.setHotSpot(QPoint(16, 16))
                    break

        self._drag_start_pos = None
        drag.exec_(Qt.CopyAction | Qt.MoveAction)

    def dragEnterEvent(self, event):
        if event.mimeData().hasUrls():
            event.acceptProposedAction()
        else:
            super().dragEnterEvent(event)

    def dragMoveEvent(self, event):
        if event.mimeData().hasUrls():
            event.acceptProposedAction()
        else:
            super().dragMoveEvent(event)

    def dropEvent(self, event):
        if event.mimeData().hasUrls():
            window = self.window()
            target_dir = getattr(window, "_current_path", "")
            item = self.itemAt(event.pos())
            if item:
                row = item.row()
                row_item = self.item(row, 0)
                if row_item:
                    p = row_item.data(Qt.UserRole)
                    if p and os.path.isdir(p):
                        target_dir = p

            if target_dir and os.path.isdir(target_dir):
                for url in event.mimeData().urls():
                    src = url.toLocalFile()
                    if src and os.path.exists(src):
                        try:
                            dst = os.path.join(target_dir, os.path.basename(src))
                            if os.path.abspath(src) != os.path.abspath(dst):
                                if os.path.isdir(src):
                                    shutil.copytree(src, dst, dirs_exist_ok=True)
                                else:
                                    shutil.copy2(src, dst)
                        except Exception as err:
                            print(f"Error copying dropped item: {err}")
                if hasattr(window, "refresh"):
                    window.refresh()
                event.acceptProposedAction()
                return
        super().dropEvent(event)


class ExplorerListWidget(QListWidget):
    """Icon list widget supporting native OS drag-out, drop-in, and rubber-band marquee selection."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setDragEnabled(True)
        self.setAcceptDrops(True)
        self.setDropIndicatorShown(True)
        self.setSelectionMode(QAbstractItemView.ExtendedSelection)
        self.setDefaultDropAction(Qt.CopyAction)

        self._drag_start_pos = None
        self._drag_item_was_selected = False
        self._rubber_origin = None
        self._rubber_band = QRubberBand(QRubberBand.Rectangle, self.viewport())

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            pos = event.pos()
            item = self.itemAt(pos)

            if item is None:
                if not (event.modifiers() & (Qt.ControlModifier | Qt.ShiftModifier)):
                    self.clearSelection()
                self._rubber_origin = pos
                self._rubber_band.setGeometry(QRect(pos, QSize()))
                self._rubber_band.show()
                self._drag_start_pos = None
                self._drag_item_was_selected = False
                return
            else:
                self._drag_start_pos = pos
                self._drag_item_was_selected = bool(item and item.isSelected())
                if self._drag_item_was_selected and not (event.modifiers() & (Qt.ControlModifier | Qt.ShiftModifier)):
                    self._rubber_origin = None
                    return
                else:
                    self._rubber_origin = pos
                    self._rubber_band.setGeometry(QRect(pos, QSize()))

        super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        pos = event.pos()

        if self._rubber_origin is not None and (event.buttons() & Qt.LeftButton):
            if (pos - self._rubber_origin).manhattanLength() >= 3:
                self._rubber_band.show()
                rect = QRect(self._rubber_origin, pos).normalized()
                self._rubber_band.setGeometry(rect)

                if not (event.modifiers() & Qt.ControlModifier):
                    self.clearSelection()

                for idx in range(self.count()):
                    it = self.item(idx)
                    item_rect = self.visualItemRect(it)
                    if rect.intersects(item_rect):
                        it.setSelected(True)
                return

        if (event.buttons() & Qt.LeftButton) and self._drag_start_pos is not None:
            if (pos - self._drag_start_pos).manhattanLength() >= QApplication.startDragDistance():
                if self._drag_item_was_selected:
                    self.start_file_drag()
                    self._drag_start_pos = None
                    return

        super().mouseMoveEvent(event)

    def mouseReleaseEvent(self, event):
        if self._rubber_origin is not None:
            self._rubber_band.hide()
            self._rubber_origin = None

        if event.button() == Qt.LeftButton and self._drag_start_pos is not None:
            item = self.itemAt(self._drag_start_pos)
            if item is not None and self._drag_item_was_selected and not (event.modifiers() & (Qt.ControlModifier | Qt.ShiftModifier)):
                if len(self.selectedItems()) > 1:
                    self.clearSelection()
                    item.setSelected(True)
            self._drag_start_pos = None
            self._drag_item_was_selected = False

        super().mouseReleaseEvent(event)

    def startDrag(self, supportedActions):
        self.start_file_drag()

    def start_file_drag(self):
        window = self.window()
        if not hasattr(window, "get_selected_paths"):
            return
        paths = window.get_selected_paths()
        if not paths:
            return
        valid_paths = [os.path.abspath(p) for p in paths if p and os.path.exists(p)]
        if not valid_paths:
            return

        drag = QDrag(self)
        mime = QMimeData()
        urls = [QUrl.fromLocalFile(p) for p in valid_paths]
        mime.setUrls(urls)
        mime.setText("\n".join(valid_paths))
        drag.setMimeData(mime)

        selected = self.selectedItems()
        if selected and not selected[0].icon().isNull():
            drag.setPixmap(selected[0].icon().pixmap(32, 32))
            drag.setHotSpot(QPoint(16, 16))

        self._drag_start_pos = None
        drag.exec_(Qt.CopyAction | Qt.MoveAction)

    def dragEnterEvent(self, event):
        if event.mimeData().hasUrls():
            event.acceptProposedAction()
        else:
            super().dragEnterEvent(event)

    def dragMoveEvent(self, event):
        if event.mimeData().hasUrls():
            event.acceptProposedAction()
        else:
            super().dragMoveEvent(event)

    def dropEvent(self, event):
        if event.mimeData().hasUrls():
            window = self.window()
            target_dir = getattr(window, "_current_path", "")
            item = self.itemAt(event.pos())
            if item:
                p = item.data(Qt.UserRole)
                if p and os.path.isdir(p):
                    target_dir = p

            if target_dir and os.path.isdir(target_dir):
                for url in event.mimeData().urls():
                    src = url.toLocalFile()
                    if src and os.path.exists(src):
                        try:
                            dst = os.path.join(target_dir, os.path.basename(src))
                            if os.path.abspath(src) != os.path.abspath(dst):
                                if os.path.isdir(src):
                                    shutil.copytree(src, dst, dirs_exist_ok=True)
                                else:
                                    shutil.copy2(src, dst)
                        except Exception as err:
                            print(f"Error copying dropped item: {err}")
                if hasattr(window, "refresh"):
                    window.refresh()
                event.acceptProposedAction()
                return
        super().dropEvent(event)


class FolderSizeThread(QThread):
    progress = pyqtSignal(int, int, int)
    finished = pyqtSignal(int, int, int)

    def __init__(self, path):
        super().__init__()
        self.path = path
        self._stopped = False

    def stop(self):
        self._stopped = True

    def run(self):
        total_size = 0
        file_count = 0
        dir_count = 0
        try:
            for root, dirs, files in os.walk(self.path):
                if self._stopped:
                    break
                dir_count += len(dirs)
                for f in files:
                    if self._stopped:
                        break
                    fp = os.path.join(root, f)
                    try:
                        total_size += os.path.getsize(fp)
                        file_count += 1
                    except OSError:
                        pass
                if file_count % 150 == 0:
                    self.progress.emit(total_size, file_count, dir_count)
        except OSError:
            pass
        self.finished.emit(total_size, file_count, dir_count)


class DrivePieWidget(QWidget):
    def __init__(self, used, free, parent=None):
        super().__init__(parent)
        self.used = max(0, int(used or 0))
        self.free = max(0, int(free or 0))
        self.setFixedSize(130, 130)

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        total = self.used + self.free
        if total <= 0:
            return
        rect = QRectF(10, 10, 110, 110)
        used_angle = int(round((self.used / total) * 360 * 16))
        free_angle = 360 * 16 - used_angle

        p.setPen(Qt.NoPen)
        p.setBrush(QColor("#0078d4"))
        p.drawPie(rect, 90 * 16, -used_angle)

        p.setBrush(QColor("#475569"))
        p.drawPie(rect, 90 * 16 - used_angle, -free_angle)

        p.setBrush(QColor("#20242f"))
        p.drawEllipse(QPointF(65, 65), 32, 32)


class WindowsFolderPropertiesDialog(QDialog):
    def __init__(self, path, parent=None):
        super().__init__(parent)
        self.path = os.path.abspath(path)
        self.folder_name = os.path.basename(self.path) or self.path
        self.setWindowTitle(f"{self.folder_name} Properties")
        self.setWindowIcon(get_win_icon("folder", 32))
        self.resize(390, 520)
        self.setModal(True)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(14, 14, 14, 14)
        layout.setSpacing(12)

        tabs = QTabWidget()
        tabs.setObjectName("propTabs")
        layout.addWidget(tabs, 1)

        # Tab 1: General
        gen_tab = QWidget()
        gen_layout = QVBoxLayout(gen_tab)
        gen_layout.setContentsMargins(14, 16, 14, 16)
        gen_layout.setSpacing(12)

        top_row = QHBoxLayout()
        top_row.setSpacing(12)
        icon_lbl = QLabel()
        icon_lbl.setPixmap(get_win_icon("folder", 48).pixmap(48, 48))
        icon_lbl.setFixedSize(48, 48)
        top_row.addWidget(icon_lbl)

        self.name_edit = QLineEdit(self.folder_name)
        self.name_edit.setObjectName("propNameEdit")
        self.name_edit.setFont(QFont("Segoe UI", 12, QFont.Bold))
        top_row.addWidget(self.name_edit, 1)
        gen_layout.addLayout(top_row)

        gen_layout.addWidget(self._make_line())

        grid = QGridLayout()
        grid.setHorizontalSpacing(16)
        grid.setVerticalSpacing(8)

        grid.addWidget(self._make_label("Type of file:"), 0, 0)
        grid.addWidget(self._make_value_label("File folder"), 0, 1)

        if is_recycle_bin_path(self.path):
            orig_path, _ = get_trash_info(self.path)
            loc_label = "Original location:" if orig_path else "Location:"
            loc_disp = orig_path or "Recycle Bin"
            grid.addWidget(self._make_label(loc_label), 1, 0)
            grid.addWidget(self._make_value_label(loc_disp), 1, 1)
        else:
            loc = os.path.dirname(self.path)
            win_loc = loc.replace("/", "\\")
            if win_loc.startswith("\\home\\"):
                win_loc = "C:\\Users" + win_loc[5:]
            elif win_loc == "":
                win_loc = "C:\\"
            else:
                win_loc = "C:" + win_loc
            grid.addWidget(self._make_label("Location:"), 1, 0)
            grid.addWidget(self._make_value_label(win_loc), 1, 1)

        self.size_val = self._make_value_label("Calculating...")
        grid.addWidget(self._make_label("Size:"), 2, 0)
        grid.addWidget(self.size_val, 2, 1)

        self.size_disk_val = self._make_value_label("Calculating...")
        grid.addWidget(self._make_label("Size on disk:"), 3, 0)
        grid.addWidget(self.size_disk_val, 3, 1)

        self.contains_val = self._make_value_label("Calculating...")
        grid.addWidget(self._make_label("Contains:"), 4, 0)
        grid.addWidget(self.contains_val, 4, 1)

        gen_layout.addLayout(grid)
        gen_layout.addWidget(self._make_line())

        time_grid = QGridLayout()
        time_grid.setHorizontalSpacing(16)
        time_grid.setVerticalSpacing(8)
        try:
            st = os.stat(self.path)
            ctime_str = datetime.datetime.fromtimestamp(st.st_ctime).strftime("%A, %B %d, %Y, %I:%M:%S %p")
            mtime_str = datetime.datetime.fromtimestamp(st.st_mtime).strftime("%A, %B %d, %Y, %I:%M:%S %p")
            atime_str = datetime.datetime.fromtimestamp(st.st_atime).strftime("%A, %B %d, %Y")
        except OSError:
            ctime_str = mtime_str = atime_str = "Unknown"

        time_grid.addWidget(self._make_label("Created:"), 0, 0)
        time_grid.addWidget(self._make_value_label(ctime_str), 0, 1)
        time_grid.addWidget(self._make_label("Modified:"), 1, 0)
        time_grid.addWidget(self._make_value_label(mtime_str), 1, 1)
        time_grid.addWidget(self._make_label("Accessed:"), 2, 0)
        time_grid.addWidget(self._make_value_label(atime_str), 2, 1)
        gen_layout.addLayout(time_grid)

        gen_layout.addWidget(self._make_line())

        attr_box = QHBoxLayout()
        attr_box.addWidget(self._make_label("Attributes:"))
        self.cb_readonly = QCheckBox("Read-only (Only applies to files in folder)")
        self.cb_readonly.setObjectName("propCheck")
        self.cb_hidden = QCheckBox("Hidden")
        self.cb_hidden.setObjectName("propCheck")
        self.cb_hidden.setChecked(os.path.basename(self.path).startswith("."))
        attr_box.addWidget(self.cb_readonly)
        attr_box.addWidget(self.cb_hidden)
        attr_box.addStretch(1)
        gen_layout.addLayout(attr_box)

        gen_layout.addStretch(1)
        tabs.addTab(gen_tab, "General")

        # Tab 2: Sharing
        sharing_tab = QWidget()
        sh_layout = QVBoxLayout(sharing_tab)
        sh_layout.setContentsMargins(14, 16, 14, 16)
        sh_layout.setSpacing(12)

        sh_hdr = QLabel("Network File and Folder Sharing")
        sh_hdr.setFont(QFont("Segoe UI", 10, QFont.Bold))
        sh_layout.addWidget(sh_hdr)

        sh_desc = QLabel(f"{self.folder_name}\nNot Shared")
        sh_desc.setObjectName("propMuted")
        sh_layout.addWidget(sh_desc)

        btn_share = QPushButton("Share...")
        btn_share.setObjectName("dialogBtn")
        btn_share.setFixedWidth(100)
        btn_share.clicked.connect(lambda: QMessageBox.information(self, "Sharing", f"Sharing configuration for '{self.folder_name}' is managed by DevOS Network."))
        sh_layout.addWidget(btn_share)

        sh_layout.addWidget(self._make_line())

        adv_hdr = QLabel("Advanced Sharing")
        adv_hdr.setFont(QFont("Segoe UI", 10, QFont.Bold))
        sh_layout.addWidget(adv_hdr)

        adv_desc = QLabel(f"Network Path: \\\\{os.uname().nodename.upper()}\\{self.folder_name}")
        adv_desc.setObjectName("propMuted")
        sh_layout.addWidget(adv_desc)

        btn_adv = QPushButton("Advanced Sharing...")
        btn_adv.setObjectName("dialogBtn")
        btn_adv.setFixedWidth(150)
        sh_layout.addWidget(btn_adv)
        sh_layout.addStretch(1)
        tabs.addTab(sharing_tab, "Sharing")

        # Bottom Buttons
        btn_row = QHBoxLayout()
        btn_row.addStretch(1)

        btn_ok = QPushButton("OK")
        btn_ok.setObjectName("dialogBtnPrimary")
        btn_ok.setDefault(True)
        btn_ok.clicked.connect(self._on_ok_clicked)
        btn_row.addWidget(btn_ok)

        btn_cancel = QPushButton("Cancel")
        btn_cancel.setObjectName("dialogBtn")
        btn_cancel.clicked.connect(self.reject)
        btn_row.addWidget(btn_cancel)

        btn_apply = QPushButton("Apply")
        btn_apply.setObjectName("dialogBtn")
        btn_apply.setEnabled(False)
        btn_row.addWidget(btn_apply)

        layout.addLayout(btn_row)

        self._thread = FolderSizeThread(self.path)
        self._thread.progress.connect(self._on_size_update)
        self._thread.finished.connect(self._on_size_update)
        self._thread.start()

    def _on_size_update(self, total_size, file_count, dir_count):
        size_str = f"{format_bytes(total_size)} ({total_size:,} bytes)"
        disk_size = ((total_size + 4095) // 4096) * 4096 if total_size > 0 else 0
        disk_str = f"{format_bytes(disk_size)} ({disk_size:,} bytes)"
        contains_str = f"{file_count:,} Files, {dir_count:,} Folders"

        self.size_val.setText(size_str)
        self.size_disk_val.setText(disk_str)
        self.contains_val.setText(contains_str)

    def closeEvent(self, event):
        if hasattr(self, "_thread") and self._thread.isRunning():
            self._thread.stop()
            self._thread.wait(200)
        super().closeEvent(event)

    def reject(self):
        if hasattr(self, "_thread") and self._thread.isRunning():
            self._thread.stop()
            self._thread.wait(200)
        super().reject()

    def _on_ok_clicked(self):
        new_name = self.name_edit.text().strip()
        if new_name and new_name != self.folder_name:
            new_path = os.path.join(os.path.dirname(self.path), new_name)
            try:
                os.rename(self.path, new_path)
            except OSError as err:
                QMessageBox.critical(self, "Error", f"Failed to rename folder: {err.strerror}")
                return
        self.accept()

    def _make_line(self):
        line = QFrame()
        line.setFrameShape(QFrame.HLine)
        line.setStyleSheet("background: #2b3240; max-height: 1px;")
        return line

    def _make_label(self, text):
        lbl = QLabel(text)
        lbl.setStyleSheet("color: #94a3b8; font-size: 12px;")
        return lbl

    def _make_value_label(self, text):
        lbl = QLabel(text)
        lbl.setStyleSheet("color: #f1f5f9; font-size: 12px;")
        lbl.setTextInteractionFlags(Qt.TextSelectableByMouse)
        return lbl


class WindowsFilePropertiesDialog(QDialog):
    def __init__(self, path, parent=None):
        super().__init__(parent)
        self.path = os.path.abspath(path)
        self.file_name = os.path.basename(self.path)
        self.setWindowTitle(f"{self.file_name} Properties")
        self.setWindowIcon(get_icon_for_file(self.path, False))
        self.resize(390, 500)
        self.setModal(True)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(14, 14, 14, 14)
        layout.setSpacing(12)

        tabs = QTabWidget()
        tabs.setObjectName("propTabs")
        layout.addWidget(tabs, 1)

        gen_tab = QWidget()
        gen_layout = QVBoxLayout(gen_tab)
        gen_layout.setContentsMargins(14, 16, 14, 16)
        gen_layout.setSpacing(12)

        top_row = QHBoxLayout()
        top_row.setSpacing(12)
        icon_lbl = QLabel()
        icon_lbl.setPixmap(get_icon_for_file(self.path, False).pixmap(48, 48))
        icon_lbl.setFixedSize(48, 48)
        top_row.addWidget(icon_lbl)

        self.name_edit = QLineEdit(self.file_name)
        self.name_edit.setObjectName("propNameEdit")
        self.name_edit.setFont(QFont("Segoe UI", 12, QFont.Bold))
        top_row.addWidget(self.name_edit, 1)
        gen_layout.addLayout(top_row)

        gen_layout.addWidget(self._make_line())

        grid = QGridLayout()
        grid.setHorizontalSpacing(16)
        grid.setVerticalSpacing(8)

        grid.addWidget(self._make_label("Type of file:"), 0, 0)
        grid.addWidget(self._make_value_label(get_file_type_description(self.path)), 0, 1)

        grid.addWidget(self._make_label("Opens with:"), 1, 0)
        opens_row = QHBoxLayout()
        opens_lbl = self._make_value_label("Default Application")
        opens_row.addWidget(opens_lbl)
        btn_change = QPushButton("Change...")
        btn_change.setObjectName("dialogBtn")
        btn_change.setFixedWidth(75)
        opens_row.addWidget(btn_change)
        grid.addLayout(opens_row, 1, 1)

        gen_layout.addLayout(grid)
        gen_layout.addWidget(self._make_line())

        grid2 = QGridLayout()
        grid2.setHorizontalSpacing(16)
        grid2.setVerticalSpacing(8)

        if is_recycle_bin_path(self.path):
            orig_path, _ = get_trash_info(self.path)
            loc_label = "Original location:" if orig_path else "Location:"
            loc_disp = orig_path or "Recycle Bin"
            grid2.addWidget(self._make_label(loc_label), 0, 0)
            grid2.addWidget(self._make_value_label(loc_disp), 0, 1)
        else:
            loc = os.path.dirname(self.path)
            win_loc = loc.replace("/", "\\")
            if win_loc.startswith("\\home\\"):
                win_loc = "C:\\Users" + win_loc[5:]
            elif win_loc == "":
                win_loc = "C:\\"
            else:
                win_loc = "C:" + win_loc
            grid2.addWidget(self._make_label("Location:"), 0, 0)
            grid2.addWidget(self._make_value_label(win_loc), 0, 1)

        try:
            st = os.stat(self.path)
            size = st.st_size
            disk_size = ((size + 4095) // 4096) * 4096 if size > 0 else 0
            size_str = f"{format_bytes(size)} ({size:,} bytes)"
            disk_str = f"{format_bytes(disk_size)} ({disk_size:,} bytes)"
            ctime_str = datetime.datetime.fromtimestamp(st.st_ctime).strftime("%A, %B %d, %Y, %I:%M:%S %p")
            mtime_str = datetime.datetime.fromtimestamp(st.st_mtime).strftime("%A, %B %d, %Y, %I:%M:%S %p")
            atime_str = datetime.datetime.fromtimestamp(st.st_atime).strftime("%A, %B %d, %Y")
        except OSError:
            size_str = disk_str = ctime_str = mtime_str = atime_str = "Unknown"

        grid2.addWidget(self._make_label("Size:"), 1, 0)
        grid2.addWidget(self._make_value_label(size_str), 1, 1)

        grid2.addWidget(self._make_label("Size on disk:"), 2, 0)
        grid2.addWidget(self._make_value_label(disk_str), 2, 1)

        gen_layout.addLayout(grid2)
        gen_layout.addWidget(self._make_line())

        grid3 = QGridLayout()
        grid3.setHorizontalSpacing(16)
        grid3.setVerticalSpacing(8)

        grid3.addWidget(self._make_label("Created:"), 0, 0)
        grid3.addWidget(self._make_value_label(ctime_str), 0, 1)

        grid3.addWidget(self._make_label("Modified:"), 1, 0)
        grid3.addWidget(self._make_value_label(mtime_str), 1, 1)

        grid3.addWidget(self._make_label("Accessed:"), 2, 0)
        grid3.addWidget(self._make_value_label(atime_str), 2, 1)

        gen_layout.addLayout(grid3)
        gen_layout.addWidget(self._make_line())

        attr_box = QHBoxLayout()
        attr_box.addWidget(self._make_label("Attributes:"))
        self.cb_readonly = QCheckBox("Read-only")
        self.cb_readonly.setObjectName("propCheck")
        self.cb_hidden = QCheckBox("Hidden")
        self.cb_hidden.setObjectName("propCheck")
        self.cb_hidden.setChecked(self.file_name.startswith("."))
        attr_box.addWidget(self.cb_readonly)
        attr_box.addWidget(self.cb_hidden)
        attr_box.addStretch(1)
        gen_layout.addLayout(attr_box)

        gen_layout.addStretch(1)
        tabs.addTab(gen_tab, "General")

        btn_row = QHBoxLayout()
        btn_row.addStretch(1)
        btn_ok = QPushButton("OK")
        btn_ok.setObjectName("dialogBtnPrimary")
        btn_ok.clicked.connect(self._on_ok_clicked)
        btn_row.addWidget(btn_ok)
        btn_cancel = QPushButton("Cancel")
        btn_cancel.setObjectName("dialogBtn")
        btn_cancel.clicked.connect(self.reject)
        btn_row.addWidget(btn_cancel)
        btn_apply = QPushButton("Apply")
        btn_apply.setObjectName("dialogBtn")
        btn_apply.setEnabled(False)
        btn_row.addWidget(btn_apply)

        layout.addLayout(btn_row)

    def _on_ok_clicked(self):
        new_name = self.name_edit.text().strip()
        if new_name and new_name != self.file_name:
            new_path = os.path.join(os.path.dirname(self.path), new_name)
            try:
                os.rename(self.path, new_path)
            except OSError as err:
                QMessageBox.critical(self, "Error", f"Failed to rename file: {err.strerror}")
                return
        self.accept()

    def _make_line(self):
        line = QFrame()
        line.setFrameShape(QFrame.HLine)
        line.setStyleSheet("background: #2b3240; max-height: 1px;")
        return line

    def _make_label(self, text):
        lbl = QLabel(text)
        lbl.setStyleSheet("color: #94a3b8; font-size: 12px;")
        return lbl

    def _make_value_label(self, text):
        lbl = QLabel(text)
        lbl.setStyleSheet("color: #f1f5f9; font-size: 12px;")
        lbl.setTextInteractionFlags(Qt.TextSelectableByMouse)
        return lbl


class WindowsDrivePropertiesDialog(QDialog):
    def __init__(self, drive, parent=None):
        super().__init__(parent)
        self.drive = drive
        self.setWindowTitle(f"{drive.get('title', 'Local Disk')} Properties")
        icon_type = "drive-c" if drive.get("is_system") else ("drive-usb" if drive.get("removable") else "drive-fixed")
        self.setWindowIcon(get_win_icon(icon_type, 32))
        self.resize(390, 530)
        self.setModal(True)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(14, 14, 14, 14)
        layout.setSpacing(12)

        tabs = QTabWidget()
        tabs.setObjectName("propTabs")
        layout.addWidget(tabs, 1)

        # Tab 1: General
        gen_tab = QWidget()
        gen_layout = QVBoxLayout(gen_tab)
        gen_layout.setContentsMargins(14, 16, 14, 16)
        gen_layout.setSpacing(10)

        top_row = QHBoxLayout()
        top_row.setSpacing(12)
        icon_lbl = QLabel()
        icon_lbl.setPixmap(get_win_icon(icon_type, 48).pixmap(48, 48))
        icon_lbl.setFixedSize(48, 48)
        top_row.addWidget(icon_lbl)

        label_text = drive.get("label") or "Local Disk"
        self.label_edit = QLineEdit(label_text)
        self.label_edit.setObjectName("propNameEdit")
        self.label_edit.setFont(QFont("Segoe UI", 12, QFont.Bold))
        top_row.addWidget(self.label_edit, 1)
        gen_layout.addLayout(top_row)

        gen_layout.addWidget(self._make_line())

        grid = QGridLayout()
        grid.setHorizontalSpacing(16)
        grid.setVerticalSpacing(8)

        grid.addWidget(self._make_label("Type:"), 0, 0)
        grid.addWidget(self._make_value_label("Local Disk"), 0, 1)

        grid.addWidget(self._make_label("File system:"), 1, 0)
        grid.addWidget(self._make_value_label("NTFS (DevOS High Performance)"), 1, 1)

        gen_layout.addLayout(grid)
        gen_layout.addWidget(self._make_line())

        total = drive.get("total") or 0
        free = drive.get("free")
        if free is None:
            free = 0
        used = max(0, total - free)

        space_grid = QGridLayout()
        space_grid.setHorizontalSpacing(12)
        space_grid.setVerticalSpacing(8)

        swatch_used = QLabel()
        swatch_used.setFixedSize(14, 14)
