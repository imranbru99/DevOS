        space_grid.addWidget(swatch_used, 0, 0)
        space_grid.addWidget(self._make_label("Used space:"), 0, 1)
        space_grid.addWidget(self._make_value_label(f"{used:,} bytes"), 0, 2)
        space_grid.addWidget(self._make_value_label(format_bytes(used)), 0, 3)

        swatch_free = QLabel()
        swatch_free.setFixedSize(14, 14)
        swatch_free.setStyleSheet("background: #475569; border-radius: 2px;")
        space_grid.addWidget(swatch_free, 1, 0)
        space_grid.addWidget(self._make_label("Free space:"), 1, 1)
        space_grid.addWidget(self._make_value_label(f"{free:,} bytes"), 1, 2)
        space_grid.addWidget(self._make_value_label(format_bytes(free)), 1, 3)

        gen_layout.addLayout(space_grid)
        gen_layout.addWidget(self._make_line())

        cap_grid = QGridLayout()
        cap_grid.setHorizontalSpacing(12)
        cap_grid.addWidget(self._make_label("Capacity:"), 0, 0)
        cap_grid.addWidget(self._make_value_label(f"{total:,} bytes"), 0, 1)
        cap_grid.addWidget(self._make_value_label(format_bytes(total)), 0, 2)
        gen_layout.addLayout(cap_grid)

        mid_row = QHBoxLayout()
        pie = DrivePieWidget(used, free)
        mid_row.addWidget(pie)

        btn_cleanup = QPushButton("Disk Cleanup")
        btn_cleanup.setObjectName("dialogBtn")
        btn_cleanup.setFixedHeight(32)
        btn_cleanup.clicked.connect(self._open_disk_cleanup)
        mid_row.addSpacing(14)
        mid_row.addWidget(btn_cleanup, 0, Qt.AlignVCenter)
        mid_row.addStretch(1)
        gen_layout.addLayout(mid_row)

        gen_layout.addStretch(1)
        tabs.addTab(gen_tab, "General")

