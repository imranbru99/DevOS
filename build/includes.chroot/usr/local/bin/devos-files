            self.status_selected_info.setText("Compression failed")
        finally:
            QApplication.restoreOverrideCursor()

    def action_compress_dialog(self, paths=None):
        target_paths = paths or self.get_selected_paths()
        if not target_paths:
            return
        dlg = CompressDialog(target_paths, self)
        if dlg.exec_() == QDialog.Accepted:
            fmt, out_path = dlg.get_result()
            try:
                QApplication.setOverrideCursor(Qt.WaitCursor)
                self.status_selected_info.setText(f"Creating {os.path.basename(out_path)}…")
                compress_paths(target_paths, fmt, out_path)
                self.refresh()
                self.status_selected_info.setText(f"Created {os.path.basename(out_path)}")
            except Exception as err:
                QMessageBox.critical(self, "Compression Error", f"Failed to create archive:\n{err}")
                self.status_selected_info.setText("Compression failed")
            finally:
                QApplication.restoreOverrideCursor()

    def action_new_folder(self):
        if not self._current_path or not os.path.isdir(self._current_path):
            return
        base_name = "New folder"
        target = os.path.join(self._current_path, base_name)
        counter = 2
        while os.path.exists(target):
            target = os.path.join(self._current_path, f"{base_name} ({counter})")
            counter += 1
        try:
            os.makedirs(target, exist_ok=True)
            self.refresh()
        except OSError as err:
            QMessageBox.critical(self, "Error", f"Failed to create folder: {err.strerror}")

    def action_cut(self):
        paths = self.get_selected_paths()
        if paths:
            self._set_clipboard("cut", paths)

    def action_copy(self):
        paths = self.get_selected_paths()
        if paths:
            self._set_clipboard("copy", paths)

    def action_copy_path(self, target_path=None):
        """Windows 11 Copy as path / Copy path (Ctrl+Shift+C)."""
        if target_path:
            paths = [target_path]
        else:
            paths = self.get_selected_paths()
            if not paths:
                if self._current_path and self._current_path not in ("This PC", "computer:/", "computer:", "thispc"):
                    paths = [self._current_path]
                else:
                    paths = ["This PC"]

        if not paths:
            return

        text = "\n".join(paths)
        QApplication.clipboard().setText(text)

        if len(paths) == 1:
            self.status.showMessage(f"Copied path to clipboard: {paths[0]}", 3000)
        else:
            self.status.showMessage(f"Copied {len(paths)} paths to clipboard", 3000)

    def action_paste(self):
        if not self._clipboard["paths"] or not self._current_path:
            return
        action = self._clipboard["action"]
        for src in self._clipboard["paths"]:
            if not os.path.exists(src):
                continue
            dest = os.path.join(self._current_path, os.path.basename(src))
            try:
                if action == "cut":
                    shutil.move(src, dest)
                else:
                    if os.path.isdir(src):
                        shutil.copytree(src, dest)
                    else:
                        shutil.copy2(src, dest)
            except Exception as err:
                QMessageBox.critical(self, "Paste Error", str(err))
        if action == "cut":
            self._clipboard = {"action": None, "paths": []}
        self.refresh()

    def action_rename(self):
        paths = self.get_selected_paths()
        if len(paths) != 1:
            return
        target = paths[0]
        old_name = os.path.basename(target)
        dlg = QDialog(self)
        dlg.setWindowTitle("Rename")
        layout = QVBoxLayout(dlg)
        layout.addWidget(QLabel(f"Rename '{old_name}' to:"))
        edit = QLineEdit(old_name)
        layout.addWidget(edit)
        btns = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        btns.accepted.connect(dlg.accept)
        btns.rejected.connect(dlg.reject)
        layout.addWidget(btns)
        if dlg.exec_() == QDialog.Accepted:
            new_name = edit.text().strip()
            if new_name and new_name != old_name:
                try:
                    os.rename(target, os.path.join(os.path.dirname(target), new_name))
                    self.refresh()
                except OSError as err:
                    QMessageBox.critical(self, "Error", f"Failed to rename: {err.strerror}")

    def action_delete(self):
        if self.is_in_recycle_bin():
            self.action_delete_permanently()
            return

        paths = self.get_selected_paths()
        if not paths:
            return
        self._trash_paths(paths)

    def _delete_paths(self, paths):
        if not paths:
            return
        if self.is_in_recycle_bin():
            self.action_delete_permanently()
            return
        self._trash_paths(paths)

    def _trash_paths(self, paths):
        trash_files = os.path.expanduser("~/.local/share/Trash/files")
        trash_info = os.path.expanduser("~/.local/share/Trash/info")
        try:
            os.makedirs(trash_files, exist_ok=True)
            os.makedirs(trash_info, exist_ok=True)
        except OSError:
            pass

        errors = []
        for p in paths:
            if not os.path.exists(p):
                continue
            deleted = False

            # 1. Try system trash command if available
            for cmd in (["gio", "trash"], ["kioclient5", "move", p, "trash:/"]):
                if shutil.which(cmd[0]):
                    try:
                        res = subprocess.run(cmd + ([p] if cmd[0] == "gio" else []),
                                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        if res.returncode == 0 and not os.path.exists(p):
                            deleted = True
                            break
                    except Exception:
                        pass

            # 2. FreeDesktop Trash standard move
            if not deleted and os.path.exists(p):
                try:
                    base = os.path.basename(p)
                    stem, ext = os.path.splitext(base)
                    dst = os.path.join(trash_files, base)
                    counter = 2
                    while os.path.exists(dst):
                        dst = os.path.join(trash_files, f"{stem} ({counter}){ext}")
                        counter += 1

                    # Write .trashinfo file
                    now_str = datetime.datetime.now().strftime("%Y-%m-%dT%H:%M:%S")
                    info_content = f"[Trash Info]\nPath={os.path.abspath(p)}\nDeletionDate={now_str}\n"
                    info_path = os.path.join(trash_info, f"{os.path.basename(dst)}.trashinfo")
                    try:
                        with open(info_path, "w", encoding="utf-8") as f:
                            f.write(info_content)
                    except Exception:
                        pass

                    shutil.move(p, dst)
                    deleted = True
                except Exception as exc:
                    # 3. Direct remove fallback
                    try:
                        if os.path.isdir(p):
                            shutil.rmtree(p)
                        else:
                            os.remove(p)
                        deleted = True
                    except Exception as err:
                        errors.append(f"{os.path.basename(p)}: {err}")

        self.refresh()
        if errors:
            QMessageBox.critical(self, "Delete Error", "Could not delete:\n" + "\n".join(errors))

    def show_properties(self, target_path=None):
        """Open authentic Windows Properties dialog based on target type."""
        if target_path:
            target = target_path
        else:
            paths = self.get_selected_paths()
            target = paths[0] if paths else self._current_path

        if not target or target in ("This PC", "computer:/", "computer:", "thispc"):
            self.show_system_properties()
            return

        # Check if target is a drive
        for drive in self._drives:
            if drive.get("mount") == target or (target == "/" and drive.get("is_system")):
                self.show_drive_properties(drive)
                return

        if not os.path.exists(target):
            return

        if os.path.isdir(target):
            dlg = WindowsFolderPropertiesDialog(target, self)
            dlg.exec_()
        else:
            dlg = WindowsFilePropertiesDialog(target, self)
            dlg.exec_()

    def show_drive_properties(self, drive):
        dlg = WindowsDrivePropertiesDialog(drive, self)
        dlg.exec_()

    def show_system_properties(self):
        dlg = WindowsSystemPropertiesDialog(self)
        dlg.exec_()

    def _open_manage(self):
        for cmd in [["/usr/local/bin/devos-disk-gui"], ["python3", "/usr/local/share/devos/components/settings/hardware_manager.py"], ["kinfocenter"]]:
            try:
                subprocess.Popen(cmd)
                return
            except OSError:
                pass

    def _set_clipboard(self, action, paths):
        paths = list(paths)
        self._clipboard = {"action": action, "paths": paths}
        if paths:
            mime_data = QMimeData()
            mime_data.setUrls([QUrl.fromLocalFile(p) for p in paths])
            mime_data.setText("\n".join(paths))
            QApplication.clipboard().setMimeData(mime_data)
            action_name = "Copied" if action == "copy" else "Cut"
            self.status.showMessage(f"{action_name} {len(paths)} item(s)", 2000)


