        btn_ok.setObjectName("dialogBtnPrimary")
        btn_ok.clicked.connect(self.accept)
        btn_row.addWidget(btn_ok)
        btn_cancel = QPushButton("Cancel")
        btn_cancel.setObjectName("dialogBtn")
        btn_cancel.clicked.connect(self.reject)
        btn_row.addWidget(btn_cancel)
        btn_apply = QPushButton("Apply")
        btn_apply.setObjectName("dialogBtn")
        btn_apply.setEnabled(False)
        btn_row.addWidget(btn_apply)

        layout.addLayout(btn_row)

    def _open_disk_cleanup(self):
        for cmd in [["/usr/local/bin/devos-disk-gui"], ["python3", "/usr/local/share/devos/components/settings/disk_doctor_gui.py"]]:
            try:
                subprocess.Popen(cmd)
                return
            except OSError:
                pass

    def _make_line(self):
        line = QFrame()
        line.setFrameShape(QFrame.HLine)
        line.setStyleSheet("background: #2b3240; max-height: 1px;")
        return line

    def _make_label(self, text):
        lbl = QLabel(text)
        lbl.setStyleSheet("color: #94a3b8; font-size: 12px;")
        return lbl

    def _make_value_label(self, text):
        lbl = QLabel(text)
        lbl.setStyleSheet("color: #f1f5f9; font-size: 12px;")
        lbl.setTextInteractionFlags(Qt.TextSelectableByMouse)
        return lbl


class WindowsSystemPropertiesDialog(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("System Properties")
        self.setWindowIcon(get_win_icon("this-pc", 32))
        self.resize(500, 580)
        self.setModal(True)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 20, 20, 16)
        layout.setSpacing(14)

        hdr_frame = QFrame()
        hdr_frame.setStyleSheet("background: #1e232d; border: 1px solid #2b3342; border-radius: 8px; padding: 12px;")
        hdr_layout = QHBoxLayout(hdr_frame)
        hdr_layout.setSpacing(16)

        pc_icon = QLabel()
        pc_icon.setPixmap(get_win_icon("this-pc", 54).pixmap(54, 54))
        hdr_layout.addWidget(pc_icon)

        text_col = QVBoxLayout()
        text_col.setSpacing(4)
        hostname = os.uname().nodename
        name_lbl = QLabel(hostname)
        name_lbl.setFont(QFont("Segoe UI", 14, QFont.Bold))
        name_lbl.setStyleSheet("color: #ffffff;")
        text_col.addWidget(name_lbl)

        sub_lbl = QLabel("DevOS 26.04 LTS Pro · 64-bit Workstation")
        sub_lbl.setStyleSheet("color: #38bdf8; font-size: 12px; font-weight: 600;")
        text_col.addWidget(sub_lbl)
        hdr_layout.addLayout(text_col, 1)

        layout.addWidget(hdr_frame)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.NoFrame)
        scroll_content = QWidget()
        s_layout = QVBoxLayout(scroll_content)
        s_layout.setContentsMargins(0, 0, 0, 0)
        s_layout.setSpacing(14)

        cpu_name = "Intel / AMD Processor"
        try:
            with open("/proc/cpuinfo") as f:
                for line in f:
                    if "model name" in line:
                        cpu_name = line.split(":", 1)[1].strip()
                        break
        except Exception:
            pass

        ram_str = "16.0 GB (15.5 GB usable)"
        try:
            with open("/proc/meminfo") as f:
                for line in f:
                    if "MemTotal" in line:
                        kb = int(line.split()[1])
                        gb = kb / (1024 * 1024)
                        ram_str = f"{gb:.1f} GB ({gb * 0.96:.1f} GB usable)"
                        break
        except Exception:
            pass

        dev_spec = QFrame()
        dev_spec.setStyleSheet("background: #1a1d24; border: 1px solid #282f3a; border-radius: 8px; padding: 12px;")
        d_layout = QVBoxLayout(dev_spec)
        d_layout.setSpacing(8)

        d_title = QLabel("Device specifications")
        d_title.setFont(QFont("Segoe UI", 11, QFont.Bold))
        d_title.setStyleSheet("color: #f8fafc;")
        d_layout.addWidget(d_title)

        d_grid = QGridLayout()
        d_grid.setHorizontalSpacing(16)
        d_grid.setVerticalSpacing(6)

        d_grid.addWidget(self._make_label("Device name"), 0, 0)
        d_grid.addWidget(self._make_val(hostname), 0, 1)

        d_grid.addWidget(self._make_label("Processor"), 1, 0)
        d_grid.addWidget(self._make_val(cpu_name), 1, 1)

        d_grid.addWidget(self._make_label("Installed RAM"), 2, 0)
        d_grid.addWidget(self._make_val(ram_str), 2, 1)

        d_grid.addWidget(self._make_label("Device ID"), 3, 0)
        d_grid.addWidget(self._make_val("A81B17F5-5113-495D-92F1-53B62E940B27"), 3, 1)

        d_grid.addWidget(self._make_label("Product ID"), 4, 0)
        d_grid.addWidget(self._make_val("00330-80000-00000-AAOEM"), 4, 1)

        d_grid.addWidget(self._make_label("System type"), 5, 0)
        d_grid.addWidget(self._make_val("64-bit operating system, x64-based processor"), 5, 1)

        d_grid.addWidget(self._make_label("Pen and touch"), 6, 0)
        d_grid.addWidget(self._make_val("No pen or touch input is available for this display"), 6, 1)

        d_layout.addLayout(d_grid)
        s_layout.addWidget(dev_spec)

        win_spec = QFrame()
        win_spec.setStyleSheet("background: #1a1d24; border: 1px solid #282f3a; border-radius: 8px; padding: 12px;")
        w_layout = QVBoxLayout(win_spec)
        w_layout.setSpacing(8)

        w_title = QLabel("Windows specifications")
        w_title.setFont(QFont("Segoe UI", 11, QFont.Bold))
        w_title.setStyleSheet("color: #f8fafc;")
        w_layout.addWidget(w_title)

        w_grid = QGridLayout()
        w_grid.setHorizontalSpacing(16)
        w_grid.setVerticalSpacing(6)

        w_grid.addWidget(self._make_label("Edition"), 0, 0)
        w_grid.addWidget(self._make_val("DevOS 26.04 LTS Pro"), 0, 1)

        w_grid.addWidget(self._make_label("Version"), 1, 0)
        w_grid.addWidget(self._make_val("26H2 (26.04 LTS)"), 1, 1)

        w_grid.addWidget(self._make_label("Installed on"), 2, 0)
        w_grid.addWidget(self._make_val("10/18/2026"), 2, 1)

        w_grid.addWidget(self._make_label("OS build"), 3, 0)
        w_grid.addWidget(self._make_val("26100.1742"), 3, 1)

        w_grid.addWidget(self._make_label("Experience"), 4, 0)
        w_grid.addWidget(self._make_val("DevOS Feature Experience Pack 1000.26100.1000.0"), 4, 1)

        w_layout.addLayout(w_grid)
        s_layout.addWidget(win_spec)

        scroll.setWidget(scroll_content)
        layout.addWidget(scroll, 1)

        btn_bar = QHBoxLayout()
        btn_dev_mgr = QPushButton("Device Manager")
        btn_dev_mgr.setObjectName("dialogBtn")
        btn_dev_mgr.clicked.connect(self._open_device_manager)
        btn_bar.addWidget(btn_dev_mgr)

        btn_taskman = QPushButton("Task Manager")
        btn_taskman.setObjectName("dialogBtn")
        btn_taskman.clicked.connect(self._open_taskman)
        btn_bar.addWidget(btn_taskman)

        btn_storage = QPushButton("Storage Doctor")
        btn_storage.setObjectName("dialogBtn")
        btn_storage.clicked.connect(self._open_storage)
        btn_bar.addWidget(btn_storage)

        btn_bar.addStretch(1)

        btn_ok = QPushButton("OK")
        btn_ok.setObjectName("dialogBtnPrimary")
        btn_ok.clicked.connect(self.accept)
        btn_bar.addWidget(btn_ok)

        layout.addLayout(btn_bar)

    def _open_device_manager(self):
        for cmd in [["python3", "/usr/local/share/devos/components/settings/hardware_manager.py"], ["kinfocenter"]]:
            try:
                subprocess.Popen(cmd)
                return
            except OSError:
                pass

    def _open_taskman(self):
        for cmd in [["/usr/local/bin/devos-taskman"], ["python3", "/usr/local/share/devos/components/taskman/taskman.py"]]:
            try:
                subprocess.Popen(cmd)
                return
            except OSError:
                pass

    def _open_storage(self):
        for cmd in [["/usr/local/bin/devos-disk-gui"], ["python3", "/usr/local/share/devos/components/settings/disk_doctor_gui.py"]]:
            try:
                subprocess.Popen(cmd)
                return
            except OSError:
                pass

    def _make_label(self, text):
        lbl = QLabel(text)
        lbl.setStyleSheet("color: #94a3b8; font-size: 12px;")
        return lbl

    def _make_val(self, text):
        lbl = QLabel(text)
        lbl.setStyleSheet("color: #f1f5f9; font-size: 12px;")
        lbl.setTextInteractionFlags(Qt.TextSelectableByMouse)
        return lbl


class WindowsFolderOptionsDialog(QDialog):
    """Authentic Windows 11 Folder Options Dialog matching Microsoft Windows 11 design."""

    def __init__(self, explorer):
        super().__init__(explorer)
        self.explorer = explorer
        self.setWindowTitle("Folder Options")
        self.setWindowIcon(get_win_icon("folder-options", 24))
        self.resize(520, 580)
        self.setMinimumSize(480, 520)
        self._setup_dialog_ui()

    def _setup_dialog_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(14, 14, 14, 14)
        layout.setSpacing(12)

        self.tabs = QTabWidget()
        self.tabs.setObjectName("optionsTabs")

        # Tab 1: General
        tab_general = QWidget()
        l_gen = QVBoxLayout(tab_general)
        l_gen.setContentsMargins(14, 14, 14, 14)
        l_gen.setSpacing(12)

        row_open_to = QHBoxLayout()
        row_open_to.addWidget(QLabel("Open File Explorer to:"))
        self.combo_open_to = QComboBox()
        self.combo_open_to.addItems(["Home", "This PC"])
        if self.explorer._settings.get("open_to", "Home") == "This PC":
            self.combo_open_to.setCurrentIndex(1)
        row_open_to.addWidget(self.combo_open_to, 1)
        l_gen.addLayout(row_open_to)

        grp_browse = QGroupBox("Browse folders")
        l_browse = QVBoxLayout(grp_browse)
        self.rb_same_window = QRadioButton("Open each folder in the same window")
        self.rb_new_window = QRadioButton("Open each folder in its own window")
        if self.explorer._settings.get("new_window", False):
            self.rb_new_window.setChecked(True)
        else:
            self.rb_same_window.setChecked(True)
        l_browse.addWidget(self.rb_same_window)
        l_browse.addWidget(self.rb_new_window)
        l_gen.addWidget(grp_browse)

        grp_click = QGroupBox("Click items as follows")
        l_click = QVBoxLayout(grp_click)
        self.rb_single_click = QRadioButton("Single-click to open an item (point to select)")
        self.rb_double_click = QRadioButton("Double-click to open an item (single-click to select)")
        if self.explorer._settings.get("single_click", False):
            self.rb_single_click.setChecked(True)
        else:
            self.rb_double_click.setChecked(True)

        sub_layout = QVBoxLayout()
        sub_layout.setContentsMargins(24, 2, 0, 4)
        self.rb_underline_browser = QRadioButton("Underline icon titles consistent with my browser")
        self.rb_underline_hover = QRadioButton("Underline icon titles only when I point at them")
        self.rb_underline_browser.setChecked(True)
        sub_layout.addWidget(self.rb_underline_browser)
        sub_layout.addWidget(self.rb_underline_hover)

        l_click.addWidget(self.rb_single_click)
        l_click.addLayout(sub_layout)
        l_click.addWidget(self.rb_double_click)
        l_gen.addWidget(grp_click)

        grp_privacy = QGroupBox("Privacy")
        l_privacy = QVBoxLayout(grp_privacy)
        self.cb_recent_files = QCheckBox("Show recently used files")
        self.cb_recent_files.setChecked(self.explorer._settings.get("recent_files", True))
        self.cb_freq_folders = QCheckBox("Show frequently used folders")
        self.cb_freq_folders.setChecked(self.explorer._settings.get("freq_folders", True))
        self.cb_office_files = QCheckBox("Show files from Office.com")
        self.cb_office_files.setChecked(self.explorer._settings.get("office_files", True))

        clear_row = QHBoxLayout()
        clear_row.addWidget(QLabel("Clear File Explorer history"))
        clear_row.addStretch(1)
        btn_clear = QPushButton("Clear")
        btn_clear.clicked.connect(self._clear_history)
        clear_row.addWidget(btn_clear)

        l_privacy.addWidget(self.cb_recent_files)
        l_privacy.addWidget(self.cb_freq_folders)
        l_privacy.addWidget(self.cb_office_files)
        l_privacy.addLayout(clear_row)
        l_gen.addWidget(grp_privacy)
        l_gen.addStretch(1)
        self.tabs.addTab(tab_general, "General")

        # Tab 2: View
        tab_view = QWidget()
        l_view = QVBoxLayout(tab_view)
        l_view.setContentsMargins(14, 14, 14, 14)
        l_view.setSpacing(10)

        grp_fviews = QGroupBox("Folder views")
        l_fviews = QVBoxLayout(grp_fviews)
        l_fviews.addWidget(QLabel("You can apply this view (such as Details or Large Icons) to all folders."))
        row_fv_btns = QHBoxLayout()
        btn_apply_folders = QPushButton("Apply to Folders")
        btn_apply_folders.clicked.connect(self._apply_to_folders)
        btn_reset_folders = QPushButton("Reset Folders")
        btn_reset_folders.clicked.connect(self._reset_folders)
        row_fv_btns.addWidget(btn_apply_folders)
        row_fv_btns.addWidget(btn_reset_folders)
        row_fv_btns.addStretch(1)
        l_fviews.addLayout(row_fv_btns)
        l_view.addWidget(grp_fviews)

        l_view.addWidget(QLabel("Advanced settings:"))
        self.tree_advanced = QTreeWidget()
        self.tree_advanced.setHeaderHidden(True)
        self.tree_advanced.setObjectName("advancedSettingsTree")

        root_item = QTreeWidgetItem(self.tree_advanced, ["Files and Folders"])
        root_item.setIcon(0, get_win_icon("folder", 16))
        root_item.setExpanded(True)

        self.adv_checks = {}
        settings_defs = [
            ("always_icons", "Always show icons, never thumbnails", False),
            ("always_menus", "Always show menus", False),
            ("icon_on_thumbnails", "Display file icon on thumbnails", False),
            ("folder_tips_size", "Display file size information in folder tips", False),
            ("path_in_title", "Display the full path in the title bar", False),
            ("hide_empty_drives", "Hide empty drives", False),
            ("hide_extensions", "Hide extensions for known file types", not self.explorer._settings.get("extensions", True)),
            ("hide_merge_conflicts", "Hide folder merge conflicts", True),
            ("hide_system_files", "Hide protected operating system files (Recommended)", True),
            ("separate_process", "Launch folder windows in a separate process", False),
            ("restore_windows", "Restore previous folder windows at logon", True),
            ("show_drive_letters", "Show drive letters", False),
            ("show_ntfs_color", "Show encrypted or compressed NTFS files in color", True),
            ("show_popup_desc", "Show popup description for folder and desktop items", False),
            ("preview_handlers", "Show preview handlers in preview pane", self.explorer._settings.get("preview", False)),
            ("status_bar", "Show status bar", self.explorer._settings.get("status_bar", True)),
            ("use_checkboxes", "Use check boxes to select items", self.explorer._settings.get("use_checkboxes", True)),
            ("use_sharing_wizard", "Use Sharing Wizard (Recommended)", False),
        ]

        hidden_group = QTreeWidgetItem(root_item, ["Hidden files and folders"])
        hidden_group.setIcon(0, get_win_icon("folder", 16))
        hidden_group.setExpanded(True)

        self.item_dont_show_hidden = QTreeWidgetItem(hidden_group, ["Don't show hidden files, folders, or drives"])
        self.item_show_hidden = QTreeWidgetItem(hidden_group, ["Show hidden files, folders, and drives"])
        is_hidden_checked = bool(self.explorer._show_hidden)
        self.item_dont_show_hidden.setCheckState(0, Qt.Unchecked if is_hidden_checked else Qt.Checked)
        self.item_show_hidden.setCheckState(0, Qt.Checked if is_hidden_checked else Qt.Unchecked)

        def on_tree_item_clicked(item, col):
            if item == self.item_dont_show_hidden:
                self.item_dont_show_hidden.setCheckState(0, Qt.Checked)
                self.item_show_hidden.setCheckState(0, Qt.Unchecked)
            elif item == self.item_show_hidden:
                self.item_show_hidden.setCheckState(0, Qt.Checked)
                self.item_dont_show_hidden.setCheckState(0, Qt.Unchecked)

        self.tree_advanced.itemClicked.connect(on_tree_item_clicked)

        for key, text, default_val in settings_defs:
            val = self.explorer._settings.get(key, default_val)
            item = QTreeWidgetItem(root_item, [text])
            item.setCheckState(0, Qt.Checked if val else Qt.Unchecked)
            self.adv_checks[key] = item

        l_view.addWidget(self.tree_advanced, 1)
        self.tabs.addTab(tab_view, "View")

        # Tab 3: Search
        tab_search = QWidget()
        l_search = QVBoxLayout(tab_search)
        l_search.setContentsMargins(14, 14, 14, 14)
        l_search.setSpacing(12)

        grp_search_how = QGroupBox("How to search")
        l_sh = QVBoxLayout(grp_search_how)
        self.cb_search_no_index = QCheckBox("Don't use the index when searching in file folders for system files (searches might take longer)")
        self.cb_search_no_index.setChecked(self.explorer._settings.get("search_no_index", True))
        l_sh.addWidget(self.cb_search_no_index)
        l_search.addWidget(grp_search_how)

        grp_search_loc = QGroupBox("When searching non-indexed locations")
        l_sl = QVBoxLayout(grp_search_loc)
        self.cb_include_system = QCheckBox("Include system directories")
        self.cb_include_system.setChecked(self.explorer._settings.get("search_include_system", True))
        self.cb_include_zip = QCheckBox("Include compressed files (ZIP, CAB...)")
        self.cb_include_zip.setChecked(self.explorer._settings.get("search_include_zip", True))
        self.cb_search_contents = QCheckBox("Always search file names and contents (this might take several minutes)")
        self.cb_search_contents.setChecked(self.explorer._settings.get("search_contents", False))
        l_sl.addWidget(self.cb_include_system)
        l_sl.addWidget(self.cb_include_zip)
        l_sl.addWidget(self.cb_search_contents)
        l_search.addWidget(grp_search_loc)
        l_search.addStretch(1)
        self.tabs.addTab(tab_search, "Search")

        layout.addWidget(self.tabs)

        bottom_row = QHBoxLayout()
        btn_defaults = QPushButton("Restore Defaults")
        btn_defaults.clicked.connect(self._restore_defaults)
        bottom_row.addWidget(btn_defaults)
        bottom_row.addStretch(1)

        btn_ok = QPushButton("OK")
        btn_ok.setDefault(True)
        btn_ok.clicked.connect(self._accept)
        btn_cancel = QPushButton("Cancel")
        btn_cancel.clicked.connect(self.reject)
        btn_apply = QPushButton("Apply")
        btn_apply.clicked.connect(self._apply)

        bottom_row.addWidget(btn_ok)
        bottom_row.addWidget(btn_cancel)
        bottom_row.addWidget(btn_apply)
        layout.addLayout(bottom_row)

    def _clear_history(self):
        self.explorer._history.clear()
        self.explorer._future.clear()
        self.explorer.btn_back.setEnabled(False)
        self.explorer.btn_forward.setEnabled(False)
        QMessageBox.information(self, "Clear History", "File Explorer history has been cleared.")

    def _apply_to_folders(self):
        self.explorer._settings["view_mode"] = self.explorer._view_mode
        self.explorer.save_settings()
        QMessageBox.information(self, "Folder Views", f"Current view mode ({self.explorer._view_mode}) applied as default for all folders.")

    def _reset_folders(self):
        self.explorer._settings.pop("folder_sort", None)
        self.explorer._settings["view_mode"] = "details"
        self.explorer.set_view_mode("details")
        self.explorer.save_settings()
        self.explorer.refresh()
        QMessageBox.information(self, "Folder Views", "All folder views have been reset to default.")

    def _restore_defaults(self):
        self.combo_open_to.setCurrentIndex(0)
        self.rb_same_window.setChecked(True)
        self.rb_double_click.setChecked(True)
        self.cb_recent_files.setChecked(True)
        self.cb_freq_folders.setChecked(True)
        self.cb_office_files.setChecked(True)
        self.item_dont_show_hidden.setCheckState(0, Qt.Checked)
        self.item_show_hidden.setCheckState(0, Qt.Unchecked)
        for key, item in self.adv_checks.items():
            if key in ("hide_extensions", "hide_merge_conflicts", "hide_system_files", "restore_windows", "show_ntfs_color", "status_bar", "use_checkboxes", "preview_handlers"):
                item.setCheckState(0, Qt.Checked)
            else:
                item.setCheckState(0, Qt.Unchecked)
        self.cb_search_no_index.setChecked(True)
        self.cb_include_system.setChecked(True)
        self.cb_include_zip.setChecked(True)
        self.cb_search_contents.setChecked(False)

    def _apply(self):
        s = self.explorer._settings
        s["open_to"] = self.combo_open_to.currentText()
        s["new_window"] = self.rb_new_window.isChecked()
        s["single_click"] = self.rb_single_click.isChecked()
        s["recent_files"] = self.cb_recent_files.isChecked()
        s["freq_folders"] = self.cb_freq_folders.isChecked()
        s["office_files"] = self.cb_office_files.isChecked()

        show_hidden = (self.item_show_hidden.checkState(0) == Qt.Checked)
        self.explorer._show_hidden = show_hidden
        s["show_hidden"] = show_hidden
        if hasattr(self.explorer, "act_show_hidden"):
            self.explorer.act_show_hidden.setChecked(show_hidden)
        if hasattr(self.explorer, "btn_hidden"):
            self.explorer.btn_hidden.setChecked(show_hidden)

        for key, item in self.adv_checks.items():
            s[key] = (item.checkState(0) == Qt.Checked)

        s["extensions"] = not s.get("hide_extensions", False)
        if hasattr(self.explorer, "act_show_ext"):
            self.explorer.act_show_ext.setChecked(s["extensions"])

        has_preview = bool(s.get("preview_handlers", False))
        s["preview"] = has_preview
        if hasattr(self.explorer, "preview"):
            self.explorer.preview.setVisible(has_preview)
        if hasattr(self.explorer, "preview_button"):
            self.explorer.preview_button.setChecked(has_preview)

        show_status = bool(s.get("status_bar", True))
        s["status_bar"] = show_status
        if hasattr(self.explorer, "status"):
            self.explorer.status.setVisible(show_status)

        s["search_no_index"] = self.cb_search_no_index.isChecked()
        s["search_include_system"] = self.cb_include_system.isChecked()
        s["search_include_zip"] = self.cb_include_zip.isChecked()
        s["search_contents"] = self.cb_search_contents.isChecked()

        self.explorer.save_settings()
        self.explorer._apply_appearance()
        self.explorer.refresh()

    def _accept(self):
        self._apply()
        self.accept()




class WindowsFileExplorer(QMainWindow):
    """Full-featured Windows 10/11 File Explorer for DevOS."""

    def __init__(self, initial_path="", picker_mode=False, picker_options=None):
        super().__init__()
        self._picker_mode = picker_mode
        self._picker_options = picker_options or {}
        self._picker_accepted = False
        self.selected_files = []
        self._current_filter_patterns = []

        if self._picker_mode:
            title = self._picker_options.get("title")
            if not title:
                if self._picker_options.get("save"):
                    title = "Save As"
                elif self._picker_options.get("directory"):
                    title = "Select Folder"
                else:
                    title = "Open"
            self.setWindowTitle(title)
            self.setWindowIcon(get_win_icon("folder", 32))
            self.resize(980, 620)
        else:
            self.setWindowTitle("This PC")
            self.setWindowIcon(get_win_icon("this-pc", 32))
            self.resize(1140, 700)

        self._history = []
        self._future = []
        self._current_path = ""
        self._clipboard = {"action": None, "paths": []}
        self._view_mode = "details"
        self._drives = []
        self._side_btns = {}
        self._pinned_folders = self.load_pinned_folders()
        self._settings = self.load_settings()
        self._show_hidden = bool(self._settings.get("show_hidden", False))

        self._loading_folder = False
        self._watcher = QFileSystemWatcher(self)
        self._refresh_timer = QTimer(self)
        self._refresh_timer.setSingleShot(True)
        self._refresh_timer.setInterval(250)
        self._refresh_timer.timeout.connect(self.refresh)
        self._watcher.directoryChanged.connect(lambda _: self._refresh_timer.start())
        self._thumbnail_timer = QTimer(self)
        self._thumbnail_timer.setInterval(15)
        self._thumbnail_timer.timeout.connect(self._load_next_thumbnail)
        self._thumbnail_queue = []
        self._active_tab = 0
        self._setup_ui()
        self._apply_appearance()
        self.reload_drives()
        self.table_view.horizontalHeader().sortIndicatorChanged.connect(self._remember_sort)
        if (not initial_path or self._picker_options.get("resume")) and self._settings.get("restore_folder", True):
            remembered = self._settings.get("last_folder", "")
            if os.path.isdir(remembered):
                initial_path = remembered
        if self._picker_mode and not initial_path:
            dl = os.path.expanduser("~/Downloads")
            initial_path = dl if os.path.isdir(dl) else os.path.expanduser("~")
        saved_view = self._settings.get("view_mode")
        self.navigate_to(initial_path, add_to_history=False)
        if saved_view == "icons":
            self.toggle_view_mode()
        screen = QApplication.primaryScreen()
        if screen:
            area = screen.availableGeometry()
            self.resize(min(self.width(), area.width() - 40), min(self.height(), area.height() - 60))

    def _setup_ui(self):
        root = QWidget()
        self.setCentralWidget(root)
        main_layout = QVBoxLayout(root)
        main_layout.setContentsMargins(0, 0, 0, 0)
        main_layout.setSpacing(0)
        # 0. Modern Top Tab Strip (acrylic dark tabs directly at window top)
        if not self._picker_mode:
            self.tab_container = QWidget()
            self.tab_container.setObjectName("tabContainer")
            tab_row = QHBoxLayout(self.tab_container)
            tab_row.setContentsMargins(12, 6, 12, 0)
            tab_row.setSpacing(6)

            self.folder_tabs = QTabBar()
            self.folder_tabs.setObjectName("windowTabs")
            self.folder_tabs.setExpanding(False)
            self.folder_tabs.setTabsClosable(True)
            self.folder_tabs.setUsesScrollButtons(True)
            self.folder_tabs.addTab(get_win_icon("this-pc", 16), "This PC")
            self.folder_tabs.setTabData(0, {"path": "", "history": [], "future": []})
            self.folder_tabs.currentChanged.connect(self._switch_tab)
            self.folder_tabs.tabCloseRequested.connect(self._close_tab)
            tab_row.addWidget(self.folder_tabs)

            self.btn_add_tab = QToolButton()
            self.btn_add_tab.setText("+")
            self.btn_add_tab.setObjectName("addTabBtn")
            self.btn_add_tab.setToolTip("New tab (Ctrl+T)")
            self.btn_add_tab.clicked.connect(lambda: self._new_tab(self._current_path))
            tab_row.addWidget(self.btn_add_tab)
            tab_row.addStretch(1)

            main_layout.addWidget(self.tab_container)

        # 1. Top Navigation & Address Toolbar
        nav_toolbar = QWidget()
        nav_toolbar.setObjectName("navToolbar")
        nav_layout = QHBoxLayout(nav_toolbar)
        nav_layout.setContentsMargins(10, 8, 10, 6)
        nav_layout.setSpacing(6)

        # Navigation Buttons: Back, Forward, Up, Refresh
        self.btn_back = QToolButton()
        self.btn_back.setText("←")
        self.btn_back.setObjectName("navBtn")
        self.btn_back.setToolTip("Back (Alt+Left)")
        self.btn_back.setEnabled(False)
        self.btn_back.clicked.connect(self.go_back)

        self.btn_forward = QToolButton()
        self.btn_forward.setText("→")
        self.btn_forward.setObjectName("navBtn")
        self.btn_forward.setToolTip("Forward (Alt+Right)")
        self.btn_forward.setEnabled(False)
        self.btn_forward.clicked.connect(self.go_forward)

        self.btn_up = QToolButton()
        self.btn_up.setText("↑")
        self.btn_up.setObjectName("navBtn")
        self.btn_up.setToolTip("Up to parent (Alt+Up)")
        self.btn_up.clicked.connect(self.go_up)

        self.btn_refresh = QToolButton()
        self.btn_refresh.setText("↻")
        self.btn_refresh.setObjectName("navBtn")
        self.btn_refresh.setToolTip("Refresh (F5)")
        self.btn_refresh.clicked.connect(self.refresh)

        nav_layout.addWidget(self.btn_back)
        nav_layout.addWidget(self.btn_forward)
        nav_layout.addWidget(self.btn_up)
        nav_layout.addWidget(self.btn_refresh)

        # Breadcrumb Address Bar
        self.address_bar = BreadcrumbBar()
        self.address_bar.path_changed.connect(self.navigate_to)
        nav_layout.addWidget(self.address_bar, 1)

        # Search Box
        self.search_box = QLineEdit()
        self.search_box.setObjectName("searchBox")
        self.search_box.setPlaceholderText("Search This PC")
        self.search_box.setFixedWidth(240)
        self.search_box.textChanged.connect(self._on_search_text_changed)
        nav_layout.addWidget(self.search_box)

        main_layout.addWidget(nav_toolbar)

        # 2. Command Ribbon (Windows 11 Fluent)
        cmd_bar = QWidget()
        cmd_bar.setObjectName("commandBar")
        cmd_layout = QHBoxLayout(cmd_bar)
        cmd_layout.setContentsMargins(10, 4, 10, 4)
        cmd_layout.setSpacing(4)

        # "+ New ˇ" Dropdown Button
        self.btn_new = QPushButton("  New  ")
        self.btn_new.setIcon(get_win_icon("new", 18))
        self.btn_new.setObjectName("newBtn")
        self.btn_new.setToolTip("Create new item")
        new_menu = QMenu(self.btn_new)
        act_new_folder = new_menu.addAction(get_win_icon("folder", 16), "Folder\tCtrl+Shift+N")
        act_new_folder.triggered.connect(self.action_new_folder)
        act_new_txt = new_menu.addAction(get_win_icon("file-doc", 16), "Text Document (.txt)")
        act_new_txt.triggered.connect(self.action_new_text_document)
        act_new_md = new_menu.addAction(get_win_icon("file-code", 16), "Markdown Document (.md)")
        act_new_md.triggered.connect(self.action_new_markdown_document)
        act_new_zip = new_menu.addAction(get_win_icon("file-archive", 16), "Compressed (zipped) Folder")
        act_new_zip.triggered.connect(self.action_compress_zip)
        self.btn_new.setMenu(new_menu)
        cmd_layout.addWidget(self.btn_new)

        self.btn_new_folder = self.btn_new  # Alias for backward compatibility & tests

        cmd_layout.addSpacing(6)

        # Action Icon Buttons
        self.btn_cut = QPushButton()
        self.btn_copy = QPushButton()
        self.btn_paste = QPushButton()
        self.btn_rename = QPushButton()
        self.btn_copy_path = QPushButton()
        self.btn_share = QPushButton()
        self.btn_delete = QPushButton()

        action_defs = [
            (self.btn_cut, "cut", "Cut (Ctrl+X)", self.action_cut),
            (self.btn_copy, "copy", "Copy (Ctrl+C)", self.action_copy),
            (self.btn_paste, "paste", "Paste (Ctrl+V)", self.action_paste),
            (self.btn_rename, "rename", "Rename (F2)", self.action_rename),
            (self.btn_copy_path, "copy-path", "Copy path (Ctrl+Shift+C)", self.action_copy_path),
            (self.btn_share, "share", "Share", self.action_share),
            (self.btn_delete, "delete", "Delete (Delete)", self.action_delete),
        ]
        for btn, name, tip, cb in action_defs:
            btn.setIcon(get_win_icon(name, 18))
            btn.setObjectName("cmdIconBtn")
            btn.setToolTip(tip)
            btn.setFixedSize(34, 30)
            btn.setIconSize(QSize(18, 18))
            btn.clicked.connect(cb)
            cmd_layout.addWidget(btn)

        # Archive buttons
        self.btn_extract = QPushButton("Extract all")
