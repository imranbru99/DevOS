        QWidget,
    )
except ImportError:
    os.execvp("/usr/bin/dolphin", ["/usr/bin/dolphin", "computer:/"])


# Cache for rendered Windows icons
_ICON_CACHE = {}


def get_win_icon(name, size=32):
    """Generate or retrieve a pixel-perfect Windows 11 style icon."""
    key = (name, size)
    if key in _ICON_CACHE:
        return _ICON_CACHE[key]

    pix = QPixmap(size, size)
    pix.fill(Qt.transparent)
    p = QPainter(pix)
    p.setRenderHint(QPainter.Antialiasing)
    s = size / 64.0

    if name == "this-pc":
        # Windows 11 This PC monitor icon
        p.setBrush(QColor("#1e293b"))
        p.setPen(QPen(QColor("#475569"), 2 * s))
        p.drawRoundedRect(QRectF(8 * s, 8 * s, 48 * s, 34 * s), 4 * s, 4 * s)
        grad = QLinearGradient(10 * s, 10 * s, 54 * s, 40 * s)
        grad.setColorAt(0, QColor("#0284c7"))
        grad.setColorAt(1, QColor("#0369a1"))
        p.setBrush(grad)
        p.setPen(Qt.NoPen)
        p.drawRoundedRect(QRectF(11 * s, 11 * s, 42 * s, 28 * s), 2 * s, 2 * s)
        # Screen glow
        p.setBrush(QColor(255, 255, 255, 50))
        p.drawEllipse(QPointF(38 * s, 28 * s), 12 * s, 8 * s)
        # Stand
        p.setBrush(QColor("#64748b"))
        p.drawRect(QRectF(28 * s, 42 * s, 8 * s, 8 * s))
        p.drawRoundedRect(QRectF(20 * s, 50 * s, 24 * s, 4 * s), 2 * s, 2 * s)

    elif name == "drive-c":
        # Windows system drive: Metallic hard drive + Windows logo
        grad = QLinearGradient(8 * s, 10 * s, 56 * s, 54 * s)
        grad.setColorAt(0, QColor("#f1f5f9"))
        grad.setColorAt(1, QColor("#94a3b8"))
        p.setBrush(grad)
        p.setPen(QPen(QColor("#475569"), 1.8 * s))
        p.drawRoundedRect(QRectF(8 * s, 12 * s, 48 * s, 40 * s), 5 * s, 5 * s)
        p.setBrush(QColor("#ffffff"))
        p.setPen(Qt.NoPen)
        p.drawRoundedRect(QRectF(12 * s, 16 * s, 40 * s, 25 * s), 3 * s, 3 * s)
        p.setBrush(QColor("#cbd5e1"))
        p.drawEllipse(QPointF(32 * s, 28 * s), 10 * s, 10 * s)
        p.setBrush(QColor("#64748b"))
        p.drawEllipse(QPointF(32 * s, 28 * s), 3 * s, 3 * s)
        # Drive LED
        p.setBrush(QColor("#22c55e"))
        p.drawEllipse(QPointF(47 * s, 46 * s), 2.5 * s, 2.5 * s)
        # Windows 4-square blue badge
        bx, by, bw = 34 * s, 30 * s, 22 * s
        p.setBrush(QColor("#0078d4"))
        p.setPen(QPen(QColor("#ffffff"), 1.5 * s))
        p.drawRoundedRect(QRectF(bx, by, bw, bw), 3 * s, 3 * s)
        p.setBrush(QColor("#ffffff"))
        p.setPen(Qt.NoPen)
        gw = bw / 2 - 2 * s
        p.drawRect(QRectF(bx + 1.5 * s, by + 1.5 * s, gw, gw))
        p.drawRect(QRectF(bx + gw + 3 * s, by + 1.5 * s, gw, gw))
        p.drawRect(QRectF(bx + 1.5 * s, by + gw + 3 * s, gw, gw))
        p.drawRect(QRectF(bx + gw + 3 * s, by + gw + 3 * s, gw, gw))

    elif name == "drive-fixed":
        # Secondary fixed hard drive (D:, E:, etc.)
        grad = QLinearGradient(8 * s, 10 * s, 56 * s, 54 * s)
        grad.setColorAt(0, QColor("#f1f5f9"))
        grad.setColorAt(1, QColor("#94a3b8"))
        p.setBrush(grad)
        p.setPen(QPen(QColor("#475569"), 1.8 * s))
        p.drawRoundedRect(QRectF(8 * s, 12 * s, 48 * s, 40 * s), 5 * s, 5 * s)
        p.setBrush(QColor("#ffffff"))
        p.setPen(Qt.NoPen)
        p.drawRoundedRect(QRectF(12 * s, 16 * s, 40 * s, 28 * s), 3 * s, 3 * s)
        p.setBrush(QColor("#cbd5e1"))
        p.drawEllipse(QPointF(32 * s, 30 * s), 11 * s, 11 * s)
        p.setBrush(QColor("#64748b"))
        p.drawEllipse(QPointF(32 * s, 30 * s), 3.5 * s, 3.5 * s)
        # LED & power pins
        p.setBrush(QColor("#0284c7"))
        p.drawEllipse(QPointF(47 * s, 46 * s), 2.5 * s, 2.5 * s)
        p.setBrush(QColor("#475569"))
        p.drawRect(QRectF(14 * s, 46 * s, 10 * s, 3 * s))

    elif name == "drive-usb":
        # USB Flash drive
        p.setBrush(QColor("#e2e8f0"))
        p.setPen(QPen(QColor("#64748b"), 1.5 * s))
        p.drawRoundedRect(QRectF(22 * s, 8 * s, 20 * s, 14 * s), 2 * s, 2 * s)
        p.setBrush(QColor("#334155"))
        p.drawRect(QRectF(26 * s, 11 * s, 4 * s, 4 * s))
        p.drawRect(QRectF(34 * s, 11 * s, 4 * s, 4 * s))
        # USB Body
        grad = QLinearGradient(16 * s, 20 * s, 48 * s, 58 * s)
        grad.setColorAt(0, QColor("#0284c7"))
        grad.setColorAt(1, QColor("#0369a1"))
        p.setBrush(grad)
        p.setPen(QPen(QColor("#0284c7"), 1.5 * s))
        p.drawRoundedRect(QRectF(16 * s, 20 * s, 32 * s, 38 * s), 6 * s, 6 * s)
        p.setBrush(QColor("#38bdf8"))
        p.setPen(Qt.NoPen)
        p.drawEllipse(QPointF(32 * s, 48 * s), 3 * s, 3 * s)

    elif name == "folder":
        # Standard Windows 11 folder
        p.setBrush(QColor("#f59e0b"))
        p.setPen(Qt.NoPen)
        p.drawRoundedRect(QRectF(6 * s, 10 * s, 24 * s, 12 * s), 3 * s, 3 * s)
        p.setBrush(QColor("#d97706"))
        p.drawRoundedRect(QRectF(6 * s, 14 * s, 52 * s, 40 * s), 4 * s, 4 * s)
        p.setBrush(QColor("#ffffff"))
        p.drawRoundedRect(QRectF(11 * s, 16 * s, 42 * s, 20 * s), 2 * s, 2 * s)
        grad = QLinearGradient(0, 22 * s, 0, 56 * s)
        grad.setColorAt(0, QColor("#fbbf24"))
        grad.setColorAt(1, QColor("#f59e0b"))
        p.setBrush(grad)
        p.drawRoundedRect(QRectF(6 * s, 22 * s, 52 * s, 34 * s), 4 * s, 4 * s)

    elif name == "folder-desktop":
        # Folder with desktop monitor overlay
        p.setBrush(QColor("#f59e0b"))
        p.setPen(Qt.NoPen)
        p.drawRoundedRect(QRectF(6 * s, 10 * s, 24 * s, 12 * s), 3 * s, 3 * s)
        grad = QLinearGradient(0, 14 * s, 0, 56 * s)
        grad.setColorAt(0, QColor("#fbbf24"))
        grad.setColorAt(1, QColor("#f59e0b"))
        p.setBrush(grad)
        p.drawRoundedRect(QRectF(6 * s, 14 * s, 52 * s, 42 * s), 4 * s, 4 * s)
        # Desktop monitor badge
        p.setBrush(QColor("#0284c7"))
        p.setPen(QPen(QColor("#ffffff"), 1.5 * s))
        p.drawRoundedRect(QRectF(18 * s, 24 * s, 28 * s, 19 * s), 2 * s, 2 * s)
        p.setBrush(QColor("#ffffff"))
        p.drawRect(QRectF(29 * s, 43 * s, 6 * s, 4 * s))
        p.drawRect(QRectF(25 * s, 47 * s, 14 * s, 2 * s))

    elif name == "folder-documents":
        # Folder with document sheet overlay
        p.setBrush(QColor("#f59e0b"))
        p.setPen(Qt.NoPen)
        p.drawRoundedRect(QRectF(6 * s, 10 * s, 24 * s, 12 * s), 3 * s, 3 * s)
        grad = QLinearGradient(0, 14 * s, 0, 56 * s)
        grad.setColorAt(0, QColor("#fbbf24"))
        grad.setColorAt(1, QColor("#f59e0b"))
        p.setBrush(grad)
        p.drawRoundedRect(QRectF(6 * s, 14 * s, 52 * s, 42 * s), 4 * s, 4 * s)
        # Document sheet
        p.setBrush(QColor("#ffffff"))
        p.setPen(QPen(QColor("#cbd5e1"), 1 * s))
        p.drawRoundedRect(QRectF(20 * s, 22 * s, 24 * s, 28 * s), 2 * s, 2 * s)
        p.setBrush(QColor("#0284c7"))
        p.setPen(Qt.NoPen)
        p.drawRect(QRectF(24 * s, 27 * s, 16 * s, 2.5 * s))
        p.drawRect(QRectF(24 * s, 32 * s, 16 * s, 2.5 * s))
        p.drawRect(QRectF(24 * s, 37 * s, 10 * s, 2.5 * s))

    elif name == "folder-downloads":
        # Folder with blue arrow down
        p.setBrush(QColor("#f59e0b"))
        p.setPen(Qt.NoPen)
        p.drawRoundedRect(QRectF(6 * s, 10 * s, 24 * s, 12 * s), 3 * s, 3 * s)
        grad = QLinearGradient(0, 14 * s, 0, 56 * s)
        grad.setColorAt(0, QColor("#fbbf24"))
        grad.setColorAt(1, QColor("#f59e0b"))
        p.setBrush(grad)
        p.drawRoundedRect(QRectF(6 * s, 14 * s, 52 * s, 42 * s), 4 * s, 4 * s)
        # Circle badge with down arrow
        p.setBrush(QColor("#0284c7"))
        p.setPen(QPen(QColor("#ffffff"), 1.5 * s))
        p.drawEllipse(QPointF(32 * s, 36 * s), 13 * s, 13 * s)
        p.setBrush(QColor("#ffffff"))
        p.setPen(Qt.NoPen)
        arrow = QPolygonF([
            QPointF(32 * s, 43 * s),
            QPointF(25 * s, 35 * s),
            QPointF(29 * s, 35 * s),
            QPointF(29 * s, 28 * s),
            QPointF(35 * s, 28 * s),
            QPointF(35 * s, 35 * s),
            QPointF(39 * s, 35 * s),
        ])
        p.drawPolygon(arrow)

    elif name == "folder-music":
        # Folder with musical note
        p.setBrush(QColor("#f59e0b"))
        p.setPen(Qt.NoPen)
        p.drawRoundedRect(QRectF(6 * s, 10 * s, 24 * s, 12 * s), 3 * s, 3 * s)
        grad = QLinearGradient(0, 14 * s, 0, 56 * s)
        grad.setColorAt(0, QColor("#fbbf24"))
        grad.setColorAt(1, QColor("#f59e0b"))
        p.setBrush(grad)
        p.drawRoundedRect(QRectF(6 * s, 14 * s, 52 * s, 42 * s), 4 * s, 4 * s)
        # Music badge
        p.setBrush(QColor("#ec4899"))
        p.setPen(QPen(QColor("#ffffff"), 1.5 * s))
        p.drawEllipse(QPointF(32 * s, 36 * s), 13 * s, 13 * s)
        p.setBrush(QColor("#ffffff"))
        p.setPen(Qt.NoPen)
        p.drawEllipse(QPointF(27 * s, 40 * s), 3 * s, 2.5 * s)
        p.drawEllipse(QPointF(37 * s, 37 * s), 3 * s, 2.5 * s)
        p.drawRect(QRectF(29 * s, 29 * s, 2 * s, 11 * s))
        p.drawRect(QRectF(39 * s, 26 * s, 2 * s, 11 * s))
        p.drawRect(QRectF(29 * s, 26 * s, 12 * s, 3 * s))

    elif name == "folder-pictures":
        # Folder with landscape photo
        p.setBrush(QColor("#f59e0b"))
        p.setPen(Qt.NoPen)
        p.drawRoundedRect(QRectF(6 * s, 10 * s, 24 * s, 12 * s), 3 * s, 3 * s)
        grad = QLinearGradient(0, 14 * s, 0, 56 * s)
        grad.setColorAt(0, QColor("#fbbf24"))
        grad.setColorAt(1, QColor("#f59e0b"))
        p.setBrush(grad)
        p.drawRoundedRect(QRectF(6 * s, 14 * s, 52 * s, 42 * s), 4 * s, 4 * s)
        # Photo badge
        p.setBrush(QColor("#10b981"))
        p.setPen(QPen(QColor("#ffffff"), 1.5 * s))
        p.drawRoundedRect(QRectF(19 * s, 23 * s, 26 * s, 22 * s), 2 * s, 2 * s)
        # Mountain / sun
        p.setBrush(QColor("#fbbf24"))
        p.setPen(Qt.NoPen)
        p.drawEllipse(QPointF(25 * s, 28 * s), 2.5 * s, 2.5 * s)
        p.setBrush(QColor("#ffffff"))
        mountain = QPolygonF([
            QPointF(20 * s, 43 * s),
            QPointF(28 * s, 33 * s),
            QPointF(36 * s, 43 * s),
        ])
        p.drawPolygon(mountain)

    elif name == "folder-videos":
        # Folder with film reel
        p.setBrush(QColor("#f59e0b"))
        p.setPen(Qt.NoPen)
        p.drawRoundedRect(QRectF(6 * s, 10 * s, 24 * s, 12 * s), 3 * s, 3 * s)
        grad = QLinearGradient(0, 14 * s, 0, 56 * s)
        grad.setColorAt(0, QColor("#fbbf24"))
        grad.setColorAt(1, QColor("#f59e0b"))
        p.setBrush(grad)
        p.drawRoundedRect(QRectF(6 * s, 14 * s, 52 * s, 42 * s), 4 * s, 4 * s)
        # Film badge
        p.setBrush(QColor("#8b5cf6"))
        p.setPen(QPen(QColor("#ffffff"), 1.5 * s))
        p.drawRoundedRect(QRectF(18 * s, 24 * s, 28 * s, 20 * s), 3 * s, 3 * s)
        p.setBrush(QColor("#ffffff"))
        p.setPen(Qt.NoPen)
        play = QPolygonF([
            QPointF(28 * s, 29 * s),
            QPointF(38 * s, 34 * s),
            QPointF(28 * s, 39 * s),
        ])
        p.drawPolygon(play)

    elif name == "file-doc":
        # Document sheet with folded corner
        p.setBrush(QColor("#ffffff"))
        p.setPen(QPen(QColor("#cbd5e1"), 1.5 * s))
        path = QPainterPath()
        path.moveTo(14 * s, 10 * s)
        path.lineTo(38 * s, 10 * s)
        path.lineTo(50 * s, 22 * s)
        path.lineTo(50 * s, 54 * s)
        path.lineTo(14 * s, 54 * s)
        path.closeSubpath()
        p.drawPath(path)
        # Folded triangle
        p.setBrush(QColor("#e2e8f0"))
        fold = QPolygonF([
            QPointF(38 * s, 10 * s),
            QPointF(38 * s, 22 * s),
            QPointF(50 * s, 22 * s),
        ])
        p.drawPolygon(fold)
        # Text lines
        p.setBrush(QColor("#94a3b8"))
        p.setPen(Qt.NoPen)
        p.drawRect(QRectF(20 * s, 26 * s, 24 * s, 2.5 * s))
        p.drawRect(QRectF(20 * s, 32 * s, 24 * s, 2.5 * s))
        p.drawRect(QRectF(20 * s, 38 * s, 18 * s, 2.5 * s))
        p.drawRect(QRectF(20 * s, 44 * s, 21 * s, 2.5 * s))

    elif name == "file-code":
        # Code document
        p.setBrush(QColor("#0284c7"))
        p.setPen(QPen(QColor("#38bdf8"), 1 * s))
        p.drawRoundedRect(QRectF(14 * s, 10 * s, 36 * s, 44 * s), 4 * s, 4 * s)
        p.setFont(QFont("Monospace", int(14 * s), QFont.Bold))
        p.setPen(QColor("#ffffff"))
        p.drawText(QRectF(14 * s, 12 * s, 36 * s, 40 * s), Qt.AlignCenter, "</>")

    elif name == "file-pdf":
        p.setBrush(QColor("#ffffff"))
        p.setPen(QPen(QColor("#cbd5e1"), 1.5 * s))
        p.drawRoundedRect(QRectF(14 * s, 10 * s, 36 * s, 44 * s), 3 * s, 3 * s)
        p.setBrush(QColor("#ef4444"))
        p.setPen(Qt.NoPen)
        p.drawRoundedRect(QRectF(14 * s, 22 * s, 36 * s, 20 * s), 2 * s, 2 * s)
        p.setFont(QFont("Inter", int(9 * s), QFont.Bold))
        p.setPen(QColor("#ffffff"))
        p.drawText(QRectF(14 * s, 22 * s, 36 * s, 20 * s), Qt.AlignCenter, "PDF")

    elif name == "file-image":
        p.setBrush(QColor("#ffffff"))
        p.setPen(QPen(QColor("#cbd5e1"), 1.5 * s))
        p.drawRoundedRect(QRectF(14 * s, 10 * s, 36 * s, 44 * s), 3 * s, 3 * s)
        p.setBrush(QColor("#065f46"))
        p.setPen(Qt.NoPen)
        p.drawRoundedRect(QRectF(17 * s, 16 * s, 30 * s, 32 * s), 2 * s, 2 * s)
        p.setBrush(QColor("#34d399"))
        mountain = QPolygonF([
            QPointF(17 * s, 48 * s),
            QPointF(28 * s, 32 * s),
            QPointF(38 * s, 44 * s),
            QPointF(47 * s, 36 * s),
            QPointF(47 * s, 48 * s),
        ])
        p.drawPolygon(mountain)

    elif name == "file-archive":
        # Zip file
        p.setBrush(QColor("#fbbf24"))
        p.setPen(QPen(QColor("#d97706"), 1.5 * s))
        p.drawRoundedRect(QRectF(14 * s, 10 * s, 36 * s, 44 * s), 3 * s, 3 * s)
        # Zipper track
        p.setBrush(QColor("#475569"))
        p.setPen(Qt.NoPen)
        p.drawRect(QRectF(29 * s, 12 * s, 6 * s, 28 * s))
        p.setBrush(QColor("#f8fafc"))
        for y in range(14, 38, 4):
            p.drawRect(QRectF(30 * s, y * s, 4 * s, 2 * s))
        p.setBrush(QColor("#e2e8f0"))
        p.drawRoundedRect(QRectF(28 * s, 38 * s, 8 * s, 10 * s), 2 * s, 2 * s)

    elif name == "network":
        # Network workgroup
        p.setBrush(QColor("#0284c7"))
        p.setPen(QPen(QColor("#38bdf8"), 2 * s))
        p.drawEllipse(QPointF(32 * s, 26 * s), 16 * s, 16 * s)
        p.setPen(QPen(QColor("#ffffff"), 1.5 * s))
        p.drawLine(QPointF(16 * s, 26 * s), QPointF(48 * s, 26 * s))
        p.drawEllipse(QPointF(32 * s, 26 * s), 8 * s, 16 * s)
        p.setBrush(QColor("#64748b"))
        p.drawRect(QRectF(22 * s, 46 * s, 20 * s, 6 * s))

    elif name == "recycle-bin":
        # Recycle Bin
        p.setBrush(QColor("#0284c7"))
        p.setPen(QPen(QColor("#38bdf8"), 1.5 * s))
        p.drawRoundedRect(QRectF(16 * s, 14 * s, 32 * s, 40 * s), 4 * s, 4 * s)
        p.setBrush(QColor("#38bdf8"))
        p.drawRoundedRect(QRectF(12 * s, 10 * s, 40 * s, 5 * s), 2 * s, 2 * s)
        p.drawRect(QRectF(28 * s, 7 * s, 8 * s, 3 * s))
        # White recycling arrows
        p.setPen(QPen(QColor("#ffffff"), 2 * s))
        p.drawLine(QPointF(24 * s, 24 * s), QPointF(24 * s, 46 * s))
        p.drawLine(QPointF(32 * s, 24 * s), QPointF(32 * s, 46 * s))
        p.drawLine(QPointF(40 * s, 24 * s), QPointF(40 * s, 46 * s))

    else:
        # Fallback to system icon or clean generic document
        sys_icon = QIcon.fromTheme(name)
        if not sys_icon.isNull():
            p.end()
            _ICON_CACHE[key] = sys_icon
            return sys_icon
        p.setBrush(QColor("#ffffff"))
        p.setPen(QPen(QColor("#94a3b8"), 1.5 * s))
        p.drawRoundedRect(QRectF(14 * s, 10 * s, 36 * s, 44 * s), 3 * s, 3 * s)

    p.end()
    icon = QIcon(pix)
    _ICON_CACHE[key] = icon
    return icon


def format_bytes(num):
    if num is None:
        return ""
    val = float(num)
    if val >= 1024 ** 3:
        gb = val / (1024 ** 3)
        return f"{gb:.0f} GB" if gb >= 10 else f"{gb:.1f} GB"
    if val >= 1024 ** 2:
        return f"{val / (1024 ** 2):.1f} MB"
    if val >= 1024:
        return f"{val / 1024:.0f} KB"
    return f"{val:.0f} bytes"


def get_file_type_description(path):
    if os.path.isdir(path):
        return "File folder"
    ext = os.path.splitext(path)[1].lower()
    ext_map = {
        ".txt": "Text Document",
        ".pdf": "PDF Document",
        ".py": "Python Source File",
        ".sh": "Shell Script",
        ".desktop": "Desktop Shortcut",
        ".png": "PNG Image",
        ".jpg": "JPEG Image",
        ".jpeg": "JPEG Image",
        ".gif": "GIF Image",
        ".svg": "Scalable Vector Graphic",
        ".webp": "WebP Image",
        ".mp3": "MP3 Audio",
        ".wav": "WAV Audio",
        ".flac": "FLAC Audio",
        ".mp4": "MP4 Video",
        ".mkv": "MKV Video",
        ".avi": "AVI Video",
        ".zip": "Compressed (zipped) Folder",
        ".tar": "TAR Archive",
        ".gz": "GZ Archive",
        ".xz": "XZ Archive",
        ".7z": "7-Zip Archive",
        ".deb": "Debian Package",
        ".iso": "Disk Image File",
        ".html": "HTML Document",
        ".css": "CSS Stylesheet",
        ".js": "JavaScript File",
        ".json": "JSON File",
        ".md": "Markdown Document",
        ".doc": "Microsoft Word Document",
        ".docx": "Microsoft Word Document",
        ".xls": "Microsoft Excel Worksheet",
        ".xlsx": "Microsoft Excel Worksheet",
        ".ppt": "PowerPoint Presentation",
        ".pptx": "PowerPoint Presentation",
    }
    if ext in ext_map:
        return ext_map[ext]
    mime, _ = mimetypes.guess_type(path)
    if mime:
        return mime.capitalize()
    return f"{ext[1:].upper()} File" if ext else "File"


def get_icon_for_file(path, is_dir=False):
    if is_dir:
        return get_win_icon("folder", 32)
    ext = os.path.splitext(path)[1].lower()
    if ext in [".py", ".sh", ".c", ".cpp", ".h", ".js", ".html", ".css", ".json"]:
        return get_win_icon("file-code", 32)
    if ext in [".png", ".jpg", ".jpeg", ".gif", ".svg", ".webp", ".ico"]:
        return get_win_icon("file-image", 32)
    if ext == ".pdf":
        return get_win_icon("file-pdf", 32)
    if ext in [".zip", ".tar", ".gz", ".xz", ".7z", ".rar", ".iso"]:
        return get_win_icon("file-archive", 32)
    if ext in [".mp4", ".mkv", ".avi", ".webm", ".mov"]:
        return get_win_icon("folder-videos", 32)
    if ext in [".mp3", ".wav", ".flac", ".ogg", ".aac"]:
        return get_win_icon("folder-music", 32)
    return get_win_icon("file-doc", 32)


SKIP_PREFIX = ("loop", "zram", "ram", "nbd", "sr", "fd")
SKIP_FS = {"swap", "squashfs"}


def _stat_mount(path):
    try:
        st = os.statvfs(path)
    except OSError:
        return None
    total = st.f_blocks * st.f_frsize
    free = st.f_bavail * st.f_frsize
    if total <= 0:
        return None
    return total, free


def list_drives():
    """Detect all system drives and partitions, assigning Windows drive letters (C:, D:, E:...)."""
    found = []

    def _walk(nodes):
        for node in nodes:
            name = node.get("name") or ""
            if name.startswith(SKIP_PREFIX):
                continue
            children = node.get("children") or []
            if children and node.get("type") == "disk":
                _walk(children)
                continue
            fstype = (node.get("fstype") or "").lower()
            mount = node.get("mountpoint") or ""
            if fstype in SKIP_FS:
                continue
            # Hide EFI boot partitions (< 1GB FAT mounted at /boot/efi or named EFI)
            if mount == "/boot/efi" or (fstype in {"vfat", "fat"} and int(node.get("size") or 0) < 1024 ** 3):
                continue
            if not fstype and not mount:
                continue
            found.append(node)

    try:
        raw = subprocess.check_output(
            ["lsblk", "-J", "-b", "-o", "NAME,PATH,SIZE,FSTYPE,LABEL,TYPE,MOUNTPOINT,TRAN"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
        _walk(json.loads(raw).get("blockdevices") or [])
    except Exception:
        found = []

    drives = []
    seen_devices = set()

    # Find root / system partition for C:
    root_stat = _stat_mount("/")
    root_total, root_free = root_stat if root_stat else (0, 0)
    root_drive = {
        "letter": "C",
        "title": "DevOS (C:)",
        "label": "DevOS",
        "path": "",
        "mount": "/",
        "total": root_total,
        "free": root_free,
        "removable": False,
        "is_system": True,
    }

    # Next letters for secondary drives
    available_letters = [chr(c) for c in range(ord("D"), ord("Z") + 1)]

    for node in found:
        path = node.get("path") or ""
        mount = node.get("mountpoint") or ""
        total = int(node.get("size") or 0)
        label = (node.get("label") or "").strip()
        removable = (node.get("tran") or "") == "usb"

        # Check if this node is the root device (e.g. nvme0n1p2)
        if mount == "/" or (label == "DevOS" and not root_drive["path"]):
            root_drive["path"] = path
            if label:
                root_drive["title"] = f"{label} (C:)"
            seen_devices.add(path)
            continue

        if path in seen_devices:
            continue
        seen_devices.add(path)

        free = None
        if mount:
            usage = _stat_mount(mount)
            if usage:
                total, free = usage

        letter = available_letters.pop(0) if available_letters else "Z"
        display_label = label or ("Local Disk" if not removable else "USB Drive")
        title = f"{display_label} ({letter}:)"

        drives.append({
            "letter": letter,
            "title": title,
            "label": display_label,
            "path": path,
            "mount": mount,
            "total": total,
            "free": free,
            "removable": removable,
            "is_system": False,
        })

    # Always put C: at the beginning
    drives.insert(0, root_drive)
    return drives


def open_file_with_default(path):
    """Open file using xdg-open."""
    if os.path.exists(path):
        subprocess.Popen(["xdg-open", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def open_pc_properties():
    """Open system properties (kinfocenter or settings)."""
    for cmd in [["kinfocenter"], ["systemsettings"], ["gnome-control-center"]]:
        try:
            subprocess.Popen(cmd)
            return
        except OSError:
            pass


def open_in_terminal(path):
    """Open terminal in target directory."""
    target = path if os.path.isdir(path) else os.path.dirname(path)
    for term in [["konsole", "--workdir", target], ["gnome-terminal", "--working-directory", target], ["x-terminal-emulator"]]:
        try:
            subprocess.Popen(term)
            return
        except OSError:
            pass


def open_in_new_window(path=""):
    """Launch another DevOS File Explorer window opened to path."""
    launcher = sys.argv[0] if (sys.argv and os.path.exists(sys.argv[0])) else "/usr/local/bin/devos-files"
    args = [sys.executable or "python3", launcher]
    if path:
        args.append(path)
    try:
        subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


class DriveCard(QFrame):
    """Windows-style Drive Card with Windows disk icon, drive letter, and storage bar."""

    def __init__(self, drive, on_open, on_context=None):
        super().__init__()
        self.drive = drive
        self.on_open = on_open
        self.on_context = on_context
        self.setObjectName("driveCard")
        self.setCursor(Qt.PointingHandCursor)
        self.setMinimumHeight(86)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)

        row = QHBoxLayout(self)
        row.setContentsMargins(14, 12, 14, 12)
        row.setSpacing(14)

        # Drive Icon
        icon_type = "drive-c" if drive["is_system"] else ("drive-usb" if drive["removable"] else "drive-fixed")
        icon_label = QLabel()
        icon_label.setPixmap(get_win_icon(icon_type, 44).pixmap(44, 44))
        icon_label.setFixedSize(44, 44)
        row.addWidget(icon_label, 0, Qt.AlignVCenter)

        # Drive Info
        text_layout = QVBoxLayout()
        text_layout.setSpacing(5)

        title = QLabel(drive["title"])
        title.setObjectName("driveTitle")
        title.setFont(QFont("Inter", 11, QFont.DemiBold))
        text_layout.addWidget(title)

        bar = QProgressBar()
        bar.setTextVisible(False)
        bar.setFixedHeight(8)
        bar.setObjectName("driveBar")

        total = drive["total"] or 0
        free = drive["free"]
        if total > 0 and free is not None:
            used = max(0, min(100, int(round((total - free) * 100 / total))))
            bar.setValue(used)
            # Red color if disk >= 90% full
            if used >= 90:
                bar.setObjectName("driveBarFull")
            space_text = f"{format_bytes(free)} free of {format_bytes(total)}"
        elif total > 0:
            bar.setValue(0)
            space_text = f"{format_bytes(total)}  ·  Not mounted (Double-click to open)"
        else:
            bar.setValue(0)
            space_text = "Drive ready"

        space = QLabel(space_text)
        space.setObjectName("driveSpace")

        text_layout.addWidget(bar)
        text_layout.addWidget(space)
        row.addLayout(text_layout, 1)

    def mouseDoubleClickEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.on_open(self.drive)
        super().mouseDoubleClickEvent(event)

    def mousePressEvent(self, event):
        if event.button() == Qt.RightButton and self.on_context:
            self.on_context(self.drive, event.globalPos())
            event.accept()
            return
        super().mousePressEvent(event)


