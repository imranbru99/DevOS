        cmd_layout.addWidget(self.btn_compress)
        cmd_layout.addWidget(self.btn_empty_trash)
        cmd_layout.addWidget(self.btn_restore_all)
        cmd_layout.addWidget(self.btn_restore_selected)
        cmd_layout.addWidget(self.btn_delete_permanently)
        cmd_layout.addSpacing(10)
        cmd_layout.addWidget(self.btn_view)
        cmd_layout.addWidget(self.btn_terminal)
