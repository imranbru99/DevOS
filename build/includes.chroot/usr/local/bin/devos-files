            # Auto-calculate comfortable button width to prevent truncation of 'Select Folder'
            fm = QFontMetrics(self.font())
            btn_w = max(130, fm.horizontalAdvance(action_text) + 36, fm.horizontalAdvance("Cancel") + 36)
            self.btn_picker_action.setFixedWidth(btn_w)
            self.btn_picker_cancel.setFixedWidth(btn_w)

