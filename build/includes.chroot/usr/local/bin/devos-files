    def load_settings(self):
        try:
            if os.path.exists(self.SETTINGS_FILE):
                with open(self.SETTINGS_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    if isinstance(data, dict):
                        return data
        except Exception:
            pass
        return {}

    def save_settings(self):
        temporary = None
        try:
            os.makedirs(self.CONFIG_DIR, exist_ok=True)
            self._settings.update(show_hidden=self._show_hidden, view_mode=self._view_mode)
            encoded = json.dumps(self._settings, indent=2)
            if os.path.isfile(self.SETTINGS_FILE) and Path(self.SETTINGS_FILE).read_text() == encoded:
                return
            with tempfile.NamedTemporaryFile(mode="w", dir=self.CONFIG_DIR, delete=False, encoding="utf-8") as f:
                temporary = f.name
                f.write(encoded)
            os.replace(temporary, self.SETTINGS_FILE)
        except OSError:
            if temporary and os.path.exists(temporary):
                os.unlink(temporary)

    def _remember_sort(self, column, order):
        if self._loading_folder or not self._current_path:
            return
        self._settings.setdefault("folder_sort", {})[self._current_path] = [column, int(order)]
        self.save_settings()
        self._sync_icon_order()

    def _sync_icon_order(self):
        items = {}
        while self.list_view.count():
            item = self.list_view.takeItem(0)
            items[item.data(Qt.UserRole)] = item
        for row in range(self.table_view.rowCount()):
            item = items.get(self.table_view.item(row, 0).data(Qt.UserRole))
            if item is not None:
                self.list_view.addItem(item)

    def _load_next_thumbnail(self):
        if not self._settings.get("thumbnails", True) or not self._thumbnail_queue:
            self._thumbnail_timer.stop()
            return
        item = self._thumbnail_queue.pop(0)
        path = item.data(Qt.UserRole)
        if Path(path).suffix.lower() not in (".png", ".jpg", ".jpeg", ".webp", ".bmp"):
            return
        reader = QImageReader(path)
        size = reader.size()
        if size.isValid() and size.width() * size.height() <= 40000000:
            size.scale(128, 88, Qt.KeepAspectRatio)
            reader.setScaledSize(size)
            reader.setAutoTransform(True)
            image = reader.read()
            if not image.isNull():
                item.setIcon(QIcon(QPixmap.fromImage(image)))

    def toggle_hidden_files(self):
        self._show_hidden = not self._show_hidden
        if hasattr(self, "btn_hidden"):
            self.btn_hidden.setChecked(self._show_hidden)
        self.save_settings()
        self.refresh()

    def load_pinned_folders(self):
        try:
            if os.path.exists(self.PINNED_FILE):
                with open(self.PINNED_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    if isinstance(data, list):
                        return [p for p in data if isinstance(p, str) and os.path.isdir(p)]
        except Exception:
            pass
        return []

    def save_pinned_folders(self):
        try:
            os.makedirs(self.CONFIG_DIR, exist_ok=True)
            with open(self.PINNED_FILE, "w", encoding="utf-8") as f:
                json.dump(self._pinned_folders, f, indent=2)
        except Exception:
            pass

    def pin_to_quick_access(self, path, name=None):
        if path and path not in self._pinned_folders and os.path.isdir(path):
            self._pinned_folders.append(path)
            self.save_pinned_folders()
            self._rebuild_sidebar()

    def unpin_from_quick_access(self, path):
        if path in self._pinned_folders:
            self._pinned_folders.remove(path)
            self.save_pinned_folders()
            self._rebuild_sidebar()

    def _rebuild_sidebar(self):
        """Populate Quick Access with pinned items, and This PC with personal drives."""
        self._side_btns = {"": self.this_pc_btn}

        while self.qa_sidebar_layout.count():
            item = self.qa_sidebar_layout.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

        while self.this_pc_items_layout.count():
            item = self.this_pc_items_layout.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

        home = os.path.expanduser("~")
        std_folders = [
            ("Desktop", os.path.join(home, "Desktop"), "folder-desktop"),
            ("Downloads", os.path.join(home, "Downloads"), "folder-downloads"),
            ("Documents", os.path.join(home, "Documents"), "folder-documents"),
            ("Pictures", os.path.join(home, "Pictures"), "folder-pictures"),
            ("Music", os.path.join(home, "Music"), "folder-music"),
            ("Videos", os.path.join(home, "Videos"), "folder-videos"),
        ]

        # 1. Quick access standard folders
        for name, path, icon_name in std_folders:
            btn = QPushButton(name)
            btn.setIcon(get_win_icon(icon_name, 20))
            btn.setIconSize(QSize(20, 20))
            btn.setObjectName("sideBtn")
            btn.setCursor(Qt.PointingHandCursor)
            btn.clicked.connect(lambda _=False, p=path: self.navigate_to(p))
            btn.setContextMenuPolicy(Qt.CustomContextMenu)
            btn.customContextMenuRequested.connect(lambda pos, p=path, b=btn: self._show_sidebar_folder_context_menu(p, False, b.mapToGlobal(pos)))
            self.qa_sidebar_layout.addWidget(btn)
            self._side_btns[path] = btn

        # Pinned folders under Quick access
        for path in self._pinned_folders:
            if not os.path.exists(path):
                continue
            name = os.path.basename(path) or path
            btn = QPushButton(f"📌 {name}")
            btn.setIcon(get_win_icon("folder", 20))
            btn.setIconSize(QSize(20, 20))
            btn.setObjectName("sideBtn")
            btn.setCursor(Qt.PointingHandCursor)
            btn.clicked.connect(lambda _=False, p=path: self.navigate_to(p))
            btn.setContextMenuPolicy(Qt.CustomContextMenu)
            btn.customContextMenuRequested.connect(lambda pos, p=path, b=btn: self._show_sidebar_folder_context_menu(p, True, b.mapToGlobal(pos)))
            self.qa_sidebar_layout.addWidget(btn)
            self._side_btns[path] = btn

        # 2. This PC Drives (Directly under This PC button, indented tree - no duplicate folders!)
        for drive in self._drives:
            btn = QPushButton(drive["title"])
            icon_type = "drive-c" if drive["is_system"] else ("drive-usb" if drive["removable"] else "drive-fixed")
            btn.setIcon(get_win_icon(icon_type, 18))
            btn.setIconSize(QSize(18, 18))
            btn.setObjectName("sideBtn")
            btn.setCursor(Qt.PointingHandCursor)
            btn.clicked.connect(lambda _=False, d=drive: self.open_drive(d))
            btn.setContextMenuPolicy(Qt.CustomContextMenu)
            btn.customContextMenuRequested.connect(lambda pos, d=drive, b=btn: self._show_drive_context_menu(d, b.mapToGlobal(pos)))
            self.this_pc_items_layout.addWidget(btn)
            if drive.get("mount"):
                self._side_btns[drive["mount"]] = btn

    def reload_folders(self):
        """Fetch and populate user standard folders in This PC view."""
        while self.folders_grid.count():
            item = self.folders_grid.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

        home = os.path.expanduser("~")
        quick_folders = [
            ("Desktop", os.path.join(home, "Desktop"), "folder-desktop"),
            ("Downloads", os.path.join(home, "Downloads"), "folder-downloads"),
            ("Documents", os.path.join(home, "Documents"), "folder-documents"),
            ("Pictures", os.path.join(home, "Pictures"), "folder-pictures"),
            ("Music", os.path.join(home, "Music"), "folder-music"),
            ("Videos", os.path.join(home, "Videos"), "folder-videos"),
        ]

        columns = 3
        for idx, (name, path, icon_name) in enumerate(quick_folders):
            tile = FolderTile(name, path, icon_name, on_open=self.navigate_to, on_context=self._show_folder_tile_context_menu)
            self.folders_grid.addWidget(tile, idx // columns, idx % columns)

    def reload_drives(self):
        """Fetch and populate drives and folders."""
        self.reload_folders()

        while self.drives_grid.count():
            item = self.drives_grid.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

        self._drives = list_drives()
        self.drives_heading.setText(f"Devices and drives ({len(self._drives)})")

        self._rebuild_sidebar()

        # Place drive cards in 2-column or 3-column grid
        columns = 2
        for idx, drive in enumerate(self._drives):
            card = DriveCard(drive, on_open=self.open_drive, on_context=self._show_drive_context_menu)
            self.drives_grid.addWidget(card, idx // columns, idx % columns)

    def open_drive(self, drive):
        """Open a drive; mounts it automatically if unmounted."""
        mount = drive.get("mount") or ""
        dev_path = drive.get("path") or ""

        # Validate that mount is actually an existing directory (never a raw device node like /dev/sda2)
        if not mount or not os.path.isdir(mount):
            mount = ""
            if dev_path:
                try:
                    out = subprocess.check_output(
                        ["findmnt", "-n", "-o", "TARGET", "-S", dev_path],
                        text=True,
                        stderr=subprocess.DEVNULL,
                    ).strip()
                    if out:
                        for line in out.splitlines():
                            target = line.strip()
                            if os.path.isdir(target):
                                mount = target
                                drive["mount"] = mount
                                break
                except Exception:
                    pass

        # If still unmounted, invoke udisksctl
        if not mount and dev_path:
            try:
                out = subprocess.check_output(
                    ["udisksctl", "mount", "-b", dev_path],
                    text=True,
                    stderr=subprocess.STDOUT,
                )
                if " at " in out:
                    cand = out.split(" at ")[-1].strip().rstrip(".")
                    if os.path.isdir(cand):
                        mount = cand
                        drive["mount"] = mount
            except Exception:
                pass

            if not mount:
                try:
                    out = subprocess.check_output(
                        ["findmnt", "-n", "-o", "TARGET", "-S", dev_path],
                        text=True,
                        stderr=subprocess.DEVNULL,
                    ).strip()
                    if out:
                        for line in out.splitlines():
                            target = line.strip()
                            if os.path.isdir(target):
                                mount = target
                                drive["mount"] = mount
                                break
                except Exception:
                    pass

        if mount and os.path.isdir(mount):
            self.navigate_to(mount, label=drive.get("title", ""))
            self._side_btns[mount] = self._side_btns.get(drive.get("mount"), self.this_pc_btn)
        elif not drive.get("fstype") and dev_path:
            self._handle_unformatted_drive(drive)

    def _handle_unformatted_drive(self, drive):
        """Prompt user when opening an unformatted drive."""
        try:
            msg = QMessageBox(self)
            msg.setWindowTitle("DevOS - Storage Setup")
            msg.setIcon(QMessageBox.Information)
            msg.setText(f"Drive {drive.get('title', '')} ({drive.get('path', '')}) is not formatted yet.")
            msg.setInformativeText("Would you like to open Storage & Boot Doctor to format this drive for use?")
            open_btn = msg.addButton("Open Storage Doctor", QMessageBox.AcceptRole)
            cancel_btn = msg.addButton("Cancel", QMessageBox.RejectRole)
            msg.setDefaultButton(open_btn)
            msg.exec_()
            if msg.clickedButton() == open_btn:
                subprocess.Popen(["devos-disk-gui"])
        except Exception:
            pass

    def is_in_recycle_bin(self):
        return is_recycle_bin_path(self._current_path)

    def _update_command_bar(self):
        in_trash = self.is_in_recycle_bin()
        selected_paths = self.get_selected_paths()
        count = len(selected_paths)

        if in_trash:
            # Hide standard file manipulation buttons
            self.btn_new_folder.setVisible(False)
            self.btn_cut.setVisible(False)
            self.btn_copy.setVisible(False)
            self.btn_paste.setVisible(False)
            self.btn_rename.setVisible(False)
            self.btn_delete.setVisible(False)
            self.btn_terminal.setVisible(False)
            self.btn_extract.setVisible(False)
            self.btn_compress.setVisible(False)

            # Show Recycle Bin buttons
            self.btn_empty_trash.setVisible(True)
            self.btn_restore_all.setVisible(True)
            self.btn_restore_selected.setVisible(True)
            self.btn_delete_permanently.setVisible(True)

            # Enable/disable based on selection and contents
            self.btn_restore_selected.setEnabled(count > 0)
            self.btn_delete_permanently.setEnabled(count > 0)

            trash_files_dir = os.path.expanduser("~/.local/share/Trash/files")
            has_any = os.path.exists(trash_files_dir) and bool(os.listdir(trash_files_dir))
            self.btn_empty_trash.setEnabled(has_any)
            self.btn_restore_all.setEnabled(has_any)
        else:
            # Show standard buttons
            is_this_pc = (not self._current_path or self._current_path == "This PC")
            self.btn_new_folder.setVisible(not is_this_pc)
            self.btn_new_folder.setEnabled(not is_this_pc)
            self.btn_cut.setVisible(True)
            self.btn_cut.setEnabled(count > 0)
            self.btn_copy.setVisible(True)
            self.btn_copy.setEnabled(count > 0)
            self.btn_paste.setVisible(True)
            self.btn_paste.setEnabled(bool(self._clipboard.get("paths")))
            self.btn_rename.setVisible(True)
            self.btn_rename.setEnabled(count == 1)
            if hasattr(self, "btn_share"):
                self.btn_share.setVisible(True)
                self.btn_share.setEnabled(count > 0)
            self.btn_delete.setVisible(True)
            self.btn_delete.setEnabled(count > 0)
            self.btn_terminal.setVisible(not is_this_pc)

            has_archive = bool(count == 1 and is_archive_file(selected_paths[0])) if count == 1 else False
            self.btn_extract.setVisible(has_archive)
            self.btn_compress.setVisible(count >= 1)

            # Hide Recycle Bin buttons
            self.btn_empty_trash.setVisible(False)
            self.btn_restore_all.setVisible(False)
            self.btn_restore_selected.setVisible(False)
            self.btn_delete_permanently.setVisible(False)

        if self._picker_mode:
            for button in (self.btn_cut, self.btn_copy, self.btn_paste, self.btn_copy_path,
                           self.btn_rename, getattr(self, "btn_share", None), self.btn_delete,
                           self.btn_terminal, self.btn_props, self.btn_extract, self.btn_compress):
                if button is not None:
                    if hasattr(button, "hide"):
                        button.hide()
                    elif hasattr(button, "setVisible"):
                        button.setVisible(False)

    def navigate_to(self, path, label="", add_to_history=True):
        """Navigate to 'This PC' (empty string) or any folder path."""
        # Clean path if passed as file:// or computer:/
        if path.startswith("file://"):
            path = path[7:]
        if path in ("computer:/", "computer:", "thispc"):
            path = ""

        if add_to_history and self._current_path != path:
            self._history.append(self._current_path)
            self._future.clear()
            self.btn_back.setEnabled(True)
            self.btn_forward.setEnabled(False)

        self._current_path = path
        if hasattr(self, "folder_tabs"):
            tab_name = os.path.basename(path) or "This PC"
            in_trash_preview = is_recycle_bin_path(path)
            tab_icon = get_win_icon("this-pc" if not path else ("recycle-bin" if in_trash_preview else "folder"), 16)
            self.folder_tabs.setTabText(self.folder_tabs.currentIndex(), tab_name)
            self.folder_tabs.setTabIcon(self.folder_tabs.currentIndex(), tab_icon)
            self.folder_tabs.setTabToolTip(self.folder_tabs.currentIndex(), path or "This PC")
        if os.path.isdir(path):
            self._settings["last_folder"] = path
            self.save_settings()

        # Update sidebar highlights
        in_trash = self.is_in_recycle_bin()
        trash_path = os.path.expanduser("~/.local/share/Trash/files")
        for p, btn in self._side_btns.items():
            is_sel = (p == path) or (in_trash and p == trash_path)
            btn.setObjectName("sideBtnSelected" if is_sel else "sideBtn")
            btn.setStyle(btn.style())

        self.address_bar.set_location(path, label)
        self.search_box.clear()

        if not path or path == "This PC":
            self.setWindowTitle("This PC")
            self.setWindowIcon(get_win_icon("this-pc", 32))
            self.search_box.setPlaceholderText("Search This PC")
            self.reload_drives()
            self.content_stack.setCurrentIndex(0)
            self.btn_up.setEnabled(False)
            self.btn_new_folder.setEnabled(False)
            self.status_items_count.setText(f"{len(self._drives)} drives, 6 folders")
            self.status_selected_info.setText("")
        elif in_trash:
            self.setWindowTitle("Recycle Bin - File Explorer")
            self.setWindowIcon(get_win_icon("recycle-bin", 32))
            self.search_box.setPlaceholderText("Search Recycle Bin")
            self.content_stack.setCurrentIndex(1)
            self.btn_up.setEnabled(True)
            self._load_folder_contents(path)
        else:
            folder_name = os.path.basename(path) or path
            self.setWindowTitle(f"{folder_name} - File Explorer")
            self.setWindowIcon(get_win_icon("folder", 32))
            self.search_box.setPlaceholderText(f"Search {folder_name}")
            self.content_stack.setCurrentIndex(1)
            self.btn_up.setEnabled(True)
            self._load_folder_contents(path)

        self._update_command_bar()
        watched = self._watcher.directories()
        if watched:
            self._watcher.removePaths(watched)
        if os.path.isdir(path):
            self._watcher.addPath(path)

    def go_back(self):
        if self._history:
            prev = self._history.pop()
            self._future.append(self._current_path)
            self.btn_forward.setEnabled(True)
            self.btn_back.setEnabled(bool(self._history))
            self.navigate_to(prev, add_to_history=False)

    def go_forward(self):
        if self._future:
            nxt = self._future.pop()
            self._history.append(self._current_path)
            self.btn_back.setEnabled(True)
            self.btn_forward.setEnabled(bool(self._future))
            self.navigate_to(nxt, add_to_history=False)

    def go_up(self):
        if not self._current_path:
            return
        if self.is_in_recycle_bin():
            self.navigate_to("")
            return
        parent = os.path.dirname(self._current_path)
        if not parent or parent == self._current_path:
            self.navigate_to("")
        else:
            self.navigate_to(parent)

    def refresh(self):
        query = self.search_box.text()
        selection = self.get_selected_paths()
        scroll = self.table_view.verticalScrollBar().value()
        self.navigate_to(self._current_path, add_to_history=False)
        self.search_box.setText(query)
        for path in selection:
            self._select_path(path)
        self.table_view.verticalScrollBar().setValue(scroll)

    def _load_folder_contents(self, path):
        """Populate table and list view with items in directory."""
        self._loading_folder = True
        self._thumbnail_timer.stop()
        self._thumbnail_queue = []
        self.table_view.setSortingEnabled(False)
        self.table_view.setRowCount(0)
        self.list_view.clear()

        in_trash = self.is_in_recycle_bin()
        if in_trash:
            self.table_view.setHorizontalHeaderLabels(["Name", "Original location", "Date deleted", "Size"])
        else:
            self.table_view.setHorizontalHeaderLabels(["Name", "Date modified", "Type", "Size"])

        try:
            entries = os.listdir(path)
        except OSError as err:
            self.status_items_count.setText(f"Unable to access: {err.strerror}")
            self._loading_folder = False
            return

        # Separate folders and files
        dirs = []
        files = []
        for entry in entries:
            if entry in [".", ".."]:
                continue
            if not self._show_hidden and entry.startswith("."):
                continue
            full_path = os.path.join(path, entry)
            if os.path.isdir(full_path):
                dirs.append(entry)
            else:
                if self._picker_mode:
                    if self._picker_options.get("directory"):
                        continue
                    if self._current_filter_patterns:
                        matched = False
                        for pat in self._current_filter_patterns:
                            if pat in ("*", "*.*", "") or fnmatch.fnmatch(entry.lower(), pat.lower()):
                                matched = True
                                break
                        if not matched:
                            continue
                files.append(entry)

        dirs.sort(key=str.lower)
        files.sort(key=str.lower)
        all_items = dirs + files

        self.table_view.setRowCount(len(all_items))

        for row, entry in enumerate(all_items):
            full_path = os.path.join(path, entry)
            is_dir = os.path.isdir(full_path)

            try:
                st = os.stat(full_path)
                mtime = datetime.datetime.fromtimestamp(st.st_mtime).strftime("%Y-%m-%d  %I:%M %p")
                size_str = "" if is_dir else format_bytes(st.st_size)
                size_val = -1 if is_dir else st.st_size
            except OSError:
                mtime = ""
                size_str = ""
                size_val = -1

            item_type = get_file_type_description(full_path)
            icon = get_icon_for_file(full_path, is_dir)

            if in_trash:
                orig_loc, del_date = get_trash_info(full_path)
                col1_text = orig_loc or "Unknown"
                col1_val = col1_text.lower()
                if del_date:
                    try:
                        dt = datetime.datetime.fromisoformat(del_date)
                        col2_text = dt.strftime("%Y-%m-%d  %I:%M %p")
                        col2_val = dt.timestamp()
                    except Exception:
                        col2_text = del_date
                        col2_val = 0
                else:
                    col2_text = mtime
                    col2_val = st.st_mtime if "st" in locals() else 0
            else:
                col1_text = mtime
                col1_val = st.st_mtime if "st" in locals() else 0
                col2_text = item_type
                col2_val = item_type

            # Name Column
            display_name = entry if is_dir or self._settings.get("extensions", True) else os.path.splitext(entry)[0]
            name_item = ExplorerTableItem(display_name)
            name_item.setIcon(icon)
            name_item.setData(Qt.UserRole, full_path)
            name_item.setData(Qt.UserRole + 1, is_dir)
            self.table_view.setItem(row, 0, name_item)

            # Col 1 (Date modified or Original location)
            item1 = ExplorerTableItem(col1_text)
            item1.setData(Qt.UserRole, col1_val)
            item1.setData(Qt.UserRole + 1, is_dir)
            self.table_view.setItem(row, 1, item1)

            # Col 2 (Type or Date deleted)
            item2 = ExplorerTableItem(col2_text)
            item2.setData(Qt.UserRole, col2_val)
            item2.setData(Qt.UserRole + 1, is_dir)
            self.table_view.setItem(row, 2, item2)

            # Size Column
            size_item = ExplorerTableItem(size_str)
            size_item.setData(Qt.UserRole, size_val)
            size_item.setData(Qt.UserRole + 1, is_dir)
            size_item.setTextAlignment(Qt.AlignRight | Qt.AlignVCenter)
            self.table_view.setItem(row, 3, size_item)

            # Also populate Icon list view
            display_name = entry if is_dir or self._settings.get("extensions", True) else os.path.splitext(entry)[0]
            list_item = QListWidgetItem(icon, display_name)
            list_item.setToolTip(entry + "\n" + mtime + "\n" + size_str)
            list_item.setData(Qt.UserRole, full_path)
            list_item.setData(Qt.UserRole + 1, is_dir)
            self.list_view.addItem(list_item)
            if not is_dir and len(self._thumbnail_queue) < 500:
                self._thumbnail_queue.append(list_item)

            if entry.startswith("."):
                muted_col = QColor("#94a3b8")
                name_item.setForeground(muted_col)
                item1.setForeground(muted_col)
                item2.setForeground(muted_col)
                size_item.setForeground(muted_col)
                list_item.setForeground(muted_col)

        self.table_view.setSortingEnabled(True)
        newest = self._settings.get("newest_first", True) and os.path.basename(path).lower() in ("screenshots", "downloads", "pictures")
        column, order = self._settings.get("folder_sort", {}).get(path, [1 if newest else 0, int(Qt.DescendingOrder if newest else Qt.AscendingOrder)])
        if column not in (0, 1, 2, 3) or order not in (0, 1):
            column, order = 0, 0
        self.table_view.sortItems(column, Qt.SortOrder(order))
        self._sync_icon_order()
        self._loading_folder = False
        if self._view_mode == "icons":
            self._thumbnail_timer.start()
        self.status_items_count.setText(f"{len(all_items)} items")
        self.status_selected_info.setText("")

    def _prompt_trash_item_action(self, target):
        name = os.path.basename(target)
        orig_path, _ = get_trash_info(target)
        loc_str = orig_path if orig_path else "Unknown"
        msg = f"Item: {name}\nOriginal location: {loc_str}\n\nDo you want to restore this item to its original location?"
        reply = QMessageBox.question(
            self,
            "Restore Item",
            msg,
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.Yes
        )
        if reply == QMessageBox.Yes:
            self._restore_paths([target])

    def _on_table_item_double_clicked(self, item):
        row = item.row()
        name_item = self.table_view.item(row, 0)
        target = name_item.data(Qt.UserRole)
        is_dir = name_item.data(Qt.UserRole + 1)
        if self.is_in_recycle_bin():
            self._prompt_trash_item_action(target)
            return
        if is_dir:
            if self._settings.get("new_window", False) and not self._picker_mode:
                open_in_new_window(target)
            else:
                self.navigate_to(target)
        else:
            if self._picker_mode:
                self._on_picker_accept_paths([target])
            else:
                open_file_with_default(target)

    def _on_list_item_double_clicked(self, item):
        target = item.data(Qt.UserRole)
        is_dir = item.data(Qt.UserRole + 1)
        if self.is_in_recycle_bin():
            self._prompt_trash_item_action(target)
            return
        if is_dir:
            if self._settings.get("new_window", False) and not self._picker_mode:
                open_in_new_window(target)
            else:
                self.navigate_to(target)
        else:
            if self._picker_mode:
                self._on_picker_accept_paths([target])
            else:
                open_file_with_default(target)

    def _render_preview(self, paths):
        if not hasattr(self, "preview_empty"):
            return
        if not paths:
            self.preview_empty.show()
            self.preview_content.hide()
            return

        self.preview_empty.hide()
        self.preview_content.show()
        self.preview_image.clear()
        self.preview_image.hide()
        self.preview_text.clear()
        self.preview_text.hide()
        self.preview_metadata.clear()

        if len(paths) > 1:
            self.preview_name.setText(f"{len(paths)} items selected")
            self.preview_type_badge.setText("Multiple items")
            total_sz = 0
            for p in paths:
                try:
                    total_sz += os.path.getsize(p)
                except OSError:
                    pass
            self.preview_metadata.setText(f"Total size: {format_bytes(total_sz)}\nItems count: {len(paths)}")
            return

        path = Path(paths[0])
        self.preview_name.setText(path.name)
        try:
            st = path.stat()
            file_desc = get_file_type_description(str(path))
            self.preview_type_badge.setText(file_desc)
            mtime_str = datetime.datetime.fromtimestamp(st.st_mtime).strftime("%d %b %Y, %I:%M %p")
            ctime_str = datetime.datetime.fromtimestamp(st.st_ctime).strftime("%d %b %Y, %I:%M %p")
            self.preview_metadata.setText(
                f"Size: {format_bytes(st.st_size)}\n"
                f"Modified: {mtime_str}\n"
                f"Created: {ctime_str}\n"
                f"Folder: {path.parent}"
            )

            if path.is_dir():
                self.preview_image.setPixmap(get_win_icon("folder", 64).pixmap(64, 64))
                self.preview_image.show()
                return

            ext = path.suffix.lower()
            if ext in (".png", ".jpg", ".jpeg", ".webp", ".bmp", ".ico", ".svg"):
                reader = QImageReader(str(path))
                size = reader.size()
                if size.isValid() and size.width() * size.height() <= 50000000:
                    size.scale(280, 240, Qt.KeepAspectRatio)
                    reader.setScaledSize(size)
                    reader.setAutoTransform(True)
                    image = reader.read()
                    if not image.isNull():
                        self.preview_image.setPixmap(QPixmap.fromImage(image))
                        self.preview_image.show()
                        return

            if ext in (".txt", ".md", ".py", ".js", ".json", ".css", ".html", ".csv", ".yaml", ".yml", ".sh", ".log", ".c", ".cpp", ".h", ".rs", ".go", ".xml", ".ini", ".conf", ".sql"):
                with path.open("rb") as f:
                    data = f.read(32769)
                self.preview_text.setPlainText(data[:32768].decode("utf-8", errors="replace") + ("\n[Preview limited to 32 KiB]" if len(data) > 32768 else ""))
                self.preview_text.show()
            else:
                icon_type = get_icon_name_for_file(str(path))
                self.preview_image.setPixmap(get_win_icon(icon_type, 64).pixmap(64, 64))
                self.preview_image.show()

        except OSError:
            self.preview_metadata.setText("This file is no longer accessible")

    def _new_tab(self, path=""):
        self._save_tab()
        self.folder_tabs.blockSignals(True)
        tab_name = os.path.basename(path) or "This PC"
        tab_icon = get_win_icon("this-pc" if not path else "folder", 16)
        index = self.folder_tabs.addTab(tab_icon, tab_name)
        self.folder_tabs.setTabData(index, {"path": path, "history": [], "future": []})
        self.folder_tabs.blockSignals(False)
        self.folder_tabs.setCurrentIndex(index)

    def _save_tab(self):
        if hasattr(self, "folder_tabs") and self._active_tab >= 0:
            self.folder_tabs.setTabData(self._active_tab, {"path": self._current_path, "history": list(self._history), "future": list(self._future)})

    def _switch_tab(self, index):
        if index < 0:
            return
        self._save_tab()
        self._active_tab = index
        state = self.folder_tabs.tabData(index)
        self._history = list(state["history"])
        self._future = list(state["future"])
        self.navigate_to(state["path"], add_to_history=False)
        self.btn_back.setEnabled(bool(self._history))
        self.btn_forward.setEnabled(bool(self._future))

    def _close_tab(self, index):
        if self.folder_tabs.count() == 1:
            self.close()
            return
        self._save_tab()
        self.folder_tabs.blockSignals(True)
        self.folder_tabs.removeTab(index)
        self._active_tab = -1
        current = self.folder_tabs.currentIndex()
        self.folder_tabs.blockSignals(False)
        self._switch_tab(current)

    def toggle_preview(self):
        self.preview.setVisible(not self.preview.isVisible())
        self._settings["preview"] = not self.preview.isHidden()
        self.preview_button.setChecked(self._settings["preview"])
        self.save_settings()
        self._on_selection_changed()

    def _on_selection_changed(self):
        selected_paths = self.get_selected_paths()
        if hasattr(self, "preview") and not self.preview.isHidden():
            self._render_preview(selected_paths)
        count = len(selected_paths)
        if count == 0:
            self.status_selected_info.setText("")
        elif count == 1:
            p = selected_paths[0]
            try:
                st = os.stat(p)
                info = format_bytes(st.st_size) if not os.path.isdir(p) else "Folder"
                self.status_selected_info.setText(f"1 item selected  {info}")
            except OSError:
                self.status_selected_info.setText("1 item selected")
        else:
            self.status_selected_info.setText(f"{count} items selected")

        if self._picker_mode:
            is_dir_mode = bool(self._picker_options.get("directory"))
            valid = [p for p in selected_paths if (os.path.isdir(p) if is_dir_mode else not os.path.isdir(p))]
            if valid:
                names = [os.path.basename(p) for p in valid]
                if self._picker_options.get("multiple"):
                    text = " ".join(f'"{n}"' if " " in n else n for n in names)
                else:
                    text = names[0]
                self.picker_name_edit.setText(text)

        self._update_command_bar()

    def _on_picker_filter_changed(self, index):
        self._current_filter_patterns = self.picker_filter_combo.currentData() or []
        if self._current_path:
            self._load_folder_contents(self._current_path)

    def _on_picker_accept(self):
        text = self.picker_name_edit.text().strip()
        is_save = bool(self._picker_options.get("save"))
        is_dir = bool(self._picker_options.get("directory"))

        if is_dir:
            if text:
                cand = text if os.path.isabs(text) else os.path.join(self._current_path or os.path.expanduser("~"), text)
                if os.path.isdir(cand):
                    self._on_picker_accept_paths([cand])
                    return
            if self._current_path and os.path.isdir(self._current_path):
                self._on_picker_accept_paths([self._current_path])
                return

        if not text:
            paths = self.get_selected_paths()
            valid = [p for p in paths if (os.path.isdir(p) if is_dir else not os.path.isdir(p))]
            if valid:
                self._on_picker_accept_paths(valid)
            return

        try:
            tokens = shlex.split(text)
        except Exception:
            tokens = [text]

        base_dir = self._current_path if (self._current_path and os.path.isdir(self._current_path)) else os.path.expanduser("~")
        resolved = []
        for tok in tokens:
            p = tok if os.path.isabs(tok) else os.path.join(base_dir, tok)
            if os.path.isdir(p) and not is_save and not is_dir:
                self.navigate_to(p)
                return
            resolved.append(p)

        if is_save:
            chosen = resolved[0]
            if self._current_filter_patterns and not os.path.splitext(chosen)[1]:
                first_pat = self._current_filter_patterns[0]
                if first_pat.startswith("*."):
                    chosen += first_pat[1:]
            self._on_picker_accept_paths([chosen])
        else:
            existing = [p for p in resolved if os.path.exists(p)]
            if existing:
                self._on_picker_accept_paths(existing)
            elif len(resolved) == 1 and not os.path.exists(resolved[0]):
                if self._current_filter_patterns:
                    for pat in self._current_filter_patterns:
                        if pat.startswith("*."):
                            cand = resolved[0] + pat[1:]
                            if os.path.exists(cand):
                                self._on_picker_accept_paths([cand])
                                return

    def _on_picker_accept_paths(self, paths):
        self.selected_files = [os.path.abspath(p) for p in paths]
        self._picker_accepted = True
        out_file = self._picker_options.get("output")
        if out_file:
            try:
                with open(out_file, "w", encoding="utf-8") as f:
                    json.dump(self.selected_files, f)
            except Exception:
                pass
        for p in self.selected_files:
            print(Path(p).as_uri(), flush=True)
        self.close()
        QApplication.instance().exit(0)

    def _on_picker_cancel(self):
        self._picker_accepted = False
        self.selected_files = []
        self.close()
        QApplication.instance().exit(1)

    def _on_search_text_changed(self, text):
        normalize = (lambda value: value) if self._settings.get("case_sensitive", False) else str.casefold
        query = normalize(text.strip())
        if self.content_stack.currentIndex() == 0:
            return
        for row in range(self.table_view.rowCount()):
            name = normalize(os.path.basename(self.table_view.item(row, 0).data(Qt.UserRole)))
            match = (fnmatch.fnmatchcase(name, query) if self._settings.get("wildcards", False) else query in name) if query else True
            self.table_view.setRowHidden(row, not match)
        for idx in range(self.list_view.count()):
            item = self.list_view.item(idx)
            name = normalize(os.path.basename(item.data(Qt.UserRole)))
            match = (fnmatch.fnmatchcase(name, query) if self._settings.get("wildcards", False) else query in name) if query else True
            item.setHidden(not match)

    def get_selected_paths(self):
        if self._view_mode == "details":
            rows = set(item.row() for item in self.table_view.selectedItems())
            return [self.table_view.item(r, 0).data(Qt.UserRole) for r in rows]
        else:
            return [item.data(Qt.UserRole) for item in self.list_view.selectedItems()]

    def toggle_view_mode(self):
        if self._view_mode == "details":
            self.set_view_mode("icons")
        else:
            self.set_view_mode("details")

    def set_view_mode(self, mode, icon_size=None):
        if mode == "details":
            self._view_mode = "details"
            self.list_view.hide()
            self.table_view.show()
            self.btn_view.setText("View: Details")
        else:
            self._view_mode = "icons"
            self.table_view.hide()
            self.list_view.show()
            if icon_size:
                self.list_view.setIconSize(QSize(icon_size, int(icon_size * 0.75)))
                self.list_view.setGridSize(QSize(icon_size + 34, icon_size + 42))
            self.btn_view.setText("View: Icons")
            self._thumbnail_timer.start()
        self.save_settings()

    def action_new_markdown_document(self):
        if not self._current_path or not os.path.exists(self._current_path):
            return
        base_name = "New Document.md"
        idx = 2
        suggested_name = base_name
        while os.path.exists(os.path.join(self._current_path, suggested_name)):
            suggested_name = f"New Document ({idx}).md"
            idx += 1
        dlg = QDialog(self)
        dlg.setWindowTitle("New Markdown Document")
        dlg.setMinimumWidth(320)
        layout = QVBoxLayout(dlg)
        layout.addWidget(QLabel("File name:"))
        edit = QLineEdit(suggested_name)
        if "." in suggested_name:
            edit.setSelection(0, suggested_name.rfind("."))
        else:
            edit.selectAll()
        layout.addWidget(edit)
        btns = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        btns.accepted.connect(dlg.accept)
        btns.rejected.connect(dlg.reject)
        layout.addWidget(btns)
        if dlg.exec_() != QDialog.Accepted:
            return
        name = edit.text().strip()
        if not name:
            return
        target = os.path.join(self._current_path, name)
        try:
            with open(target, "w", encoding="utf-8") as f:
                f.write("# " + os.path.splitext(name)[0] + "\n\n")
            self.refresh()
            self._select_path(target)
        except OSError as err:
            QMessageBox.critical(self, "Error", f"Failed to create file: {err.strerror}")

    def action_share(self):
        paths = self.get_selected_paths()
        if not paths:
            return
        try:
            subprocess.Popen(["kde-open5", paths[0]])
        except Exception:
            self.action_copy_path(paths[0])
            if hasattr(self, "status"):
                self.status.showMessage(f"Copied {len(paths)} path(s) to share", 3000)

    def action_undo(self):
        if hasattr(self, "status"):
            self.status.showMessage("Undo not available", 2500)

    def action_invert_selection(self):
        view = self.table_view if self._view_mode == "details" else self.list_view
        sel_model = view.selectionModel()
        for row in range(view.model().rowCount()):
            idx = view.model().index(row, 0)
            sel_model.select(idx, QItemSelectionModel.Toggle | QItemSelectionModel.Rows)

    def action_map_network_drive(self):
        self.navigate_to("network:/")

    def action_disconnect_network_drive(self):
        if hasattr(self, "status"):
            self.status.showMessage("No disconnected network drives", 2500)

    def action_add_network_location(self):
        self.navigate_to("network:/")

    def toggle_compact_view(self, checked):
        self._settings["compact"] = checked
        self.save_settings()
        self.table_view.verticalHeader().setDefaultSectionSize(28 if checked else 40)

    def toggle_extensions(self, checked):
        self._settings["extensions"] = checked
        self.save_settings()
        self.refresh()

    def toggle_checkboxes(self, checked):
        self._settings["use_checkboxes"] = checked
        self.save_settings()
        self.refresh()

    def show_folder_options(self):
        dlg = WindowsFolderOptionsDialog(self)
        dlg.exec_()

    def action_extract_dialog(self, target=None):
        if not target:
            paths = self.get_selected_paths()
            if paths and is_archive_file(paths[0]):
                target = paths[0]
        if not target or not os.path.exists(target):
            return

        dlg = ExtractDialog(target, self)
        if dlg.exec_() == QDialog.Accepted:
            dest = dlg.destination()
            if not dest:
                return
            show_done = dlg.show_when_done()
            self._do_extract(target, dest, show_done)

    def action_extract_here(self, target=None):
        if not target:
            paths = self.get_selected_paths()
            if paths and is_archive_file(paths[0]):
                target = paths[0]
        if not target or not os.path.exists(target):
            return
        dest = os.path.dirname(target)
        self._do_extract(target, dest, show_done=False)

    def action_extract_to_subfolder(self, target=None):
        if not target:
            paths = self.get_selected_paths()
            if paths and is_archive_file(paths[0]):
                target = paths[0]
        if not target or not os.path.exists(target):
            return
        stem = get_archive_stem(target)
        dest = os.path.join(os.path.dirname(target), stem)
        self._do_extract(target, dest, show_done=False)

    def _do_extract(self, target, dest, show_done=False):
        try:
            QApplication.setOverrideCursor(Qt.WaitCursor)
            self.status_selected_info.setText("Extracting archive…")
            extract_archive(target, dest)
            self.refresh()
            self.status_selected_info.setText(f"Extracted to {os.path.basename(dest)}")
            if show_done and os.path.isdir(dest):
                self.navigate_to(dest)
        except Exception as exc:
            QMessageBox.critical(self, "Extraction Error", f"Failed to extract {os.path.basename(target)}:\n{exc}")
        finally:
            QApplication.restoreOverrideCursor()

    def action_compress_zip(self, paths=None):
        target_paths = paths or self.get_selected_paths()
        if not target_paths:
            return
        try:
            QApplication.setOverrideCursor(Qt.WaitCursor)
            self.status_selected_info.setText("Compressing to ZIP…")
            out_file = compress_paths(target_paths, "zip")
            self.refresh()
            self.status_selected_info.setText(f"Created {os.path.basename(out_file)}")
        except Exception as err:
            QMessageBox.critical(self, "Compression Error", f"Failed to create ZIP:\n{err}")
            self.status_selected_info.setText("Compression failed")
        finally:
            QApplication.restoreOverrideCursor()

    def action_compress_7z(self, paths=None):
        target_paths = paths or self.get_selected_paths()
        if not target_paths:
            return
        try:
            QApplication.setOverrideCursor(Qt.WaitCursor)
            self.status_selected_info.setText("Compressing to 7-Zip…")
            out_file = compress_paths(target_paths, "7z")
            self.refresh()
            self.status_selected_info.setText(f"Created {os.path.basename(out_file)}")
        except Exception as err:
            QMessageBox.critical(self, "Compression Error", f"Failed to create 7z:\n{err}")
            self.status_selected_info.setText("Compression failed")
        finally:
            QApplication.restoreOverrideCursor()

    def action_compress_dialog(self, paths=None):
        target_paths = paths or self.get_selected_paths()
        if not target_paths:
            return
        dlg = CompressDialog(target_paths, self)
        if dlg.exec_() == QDialog.Accepted:
            fmt, out_path = dlg.get_result()
            try:
                QApplication.setOverrideCursor(Qt.WaitCursor)
                self.status_selected_info.setText(f"Creating {os.path.basename(out_path)}…")
                compress_paths(target_paths, fmt, out_path)
                self.refresh()
                self.status_selected_info.setText(f"Created {os.path.basename(out_path)}")
            except Exception as err:
                QMessageBox.critical(self, "Compression Error", f"Failed to create archive:\n{err}")
                self.status_selected_info.setText("Compression failed")
            finally:
                QApplication.restoreOverrideCursor()

    def _select_path(self, target_path):
        if not target_path:
            return
        for row in range(self.table_view.rowCount()):
            item = self.table_view.item(row, 0)
            if item and item.data(Qt.UserRole) == target_path:
                self.table_view.setCurrentItem(item)
                self.table_view.scrollToItem(item)
                break
        for idx in range(self.list_view.count()):
            l_item = self.list_view.item(idx)
            if l_item and l_item.data(Qt.UserRole) == target_path:
                self.list_view.setCurrentItem(l_item)
                self.list_view.scrollToItem(l_item)
                break

    def action_new_folder(self):
        if not self._current_path or not os.path.isdir(self._current_path):
            return
        base_name = "New folder"
        counter = 2
        suggested_name = base_name
        while os.path.exists(os.path.join(self._current_path, suggested_name)):
            suggested_name = f"{base_name} ({counter})"
            counter += 1

        dlg = QDialog(self)
        dlg.setWindowTitle("New Folder")
        dlg.setMinimumWidth(320)
        layout = QVBoxLayout(dlg)
        layout.addWidget(QLabel("Folder name:"))
        edit = QLineEdit(suggested_name)
        edit.selectAll()
        layout.addWidget(edit)
        btns = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        btns.accepted.connect(dlg.accept)
        btns.rejected.connect(dlg.reject)
        layout.addWidget(btns)

        if dlg.exec_() != QDialog.Accepted:
            return

        folder_name = edit.text().strip()
        if not folder_name:
            return

        target = os.path.join(self._current_path, folder_name)
        if os.path.exists(target):
            QMessageBox.warning(self, "Error", f"An item named '{folder_name}' already exists.")
            return

        try:
            os.makedirs(target, exist_ok=False)
            self.refresh()
            self._select_path(target)
        except OSError as err:
            QMessageBox.critical(self, "Error", f"Failed to create folder: {err.strerror}")

    def action_cut(self):
        paths = self.get_selected_paths()
        if paths:
            self._set_clipboard("cut", paths)

    def action_copy(self):
        paths = self.get_selected_paths()
        if paths:
            self._set_clipboard("copy", paths)

    def action_copy_path(self, target_path=None):
        """Windows 11 Copy as path / Copy path (Ctrl+Shift+C)."""
        if target_path:
            paths = [target_path]
        else:
            paths = self.get_selected_paths()
            if not paths:
                if self._current_path and self._current_path not in ("This PC", "computer:/", "computer:", "thispc"):
                    paths = [self._current_path]
                else:
                    paths = ["This PC"]

        if not paths:
            return

        text = "\n".join(paths)
        QApplication.clipboard().setText(text)

        if len(paths) == 1:
            self.status.showMessage(f"Copied path to clipboard: {paths[0]}", 3000)
        else:
            self.status.showMessage(f"Copied {len(paths)} paths to clipboard", 3000)

    def action_paste(self):
        if not self._clipboard["paths"] or not self._current_path:
            return
        action = self._clipboard["action"]
        for src in self._clipboard["paths"]:
            if not os.path.exists(src):
                continue
            dest = os.path.join(self._current_path, os.path.basename(src))
            try:
                if action == "cut":
                    shutil.move(src, dest)
                else:
                    if os.path.isdir(src):
                        shutil.copytree(src, dest)
                    else:
                        shutil.copy2(src, dest)
            except Exception as err:
                QMessageBox.critical(self, "Paste Error", str(err))
        if action == "cut":
            self._clipboard = {"action": None, "paths": []}
        self.refresh()

    def action_rename(self):
        paths = self.get_selected_paths()
        if len(paths) != 1:
            return
        target = paths[0]
        old_name = os.path.basename(target)
        dlg = QDialog(self)
        dlg.setWindowTitle("Rename")
        layout = QVBoxLayout(dlg)
        layout.addWidget(QLabel(f"Rename '{old_name}' to:"))
        edit = QLineEdit(old_name)
        layout.addWidget(edit)
        btns = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        btns.accepted.connect(dlg.accept)
        btns.rejected.connect(dlg.reject)
        layout.addWidget(btns)
        if dlg.exec_() == QDialog.Accepted:
            new_name = edit.text().strip()
            if new_name and new_name != old_name:
                try:
                    os.rename(target, os.path.join(os.path.dirname(target), new_name))
                    self.refresh()
                except OSError as err:
                    QMessageBox.critical(self, "Error", f"Failed to rename: {err.strerror}")

    def action_delete(self):
        if self.is_in_recycle_bin():
            self.action_delete_permanently()
            return

        paths = self.get_selected_paths()
        if not paths:
            return
        self._trash_paths(paths)

    def _delete_paths(self, paths):
        if not paths:
            return
        if self.is_in_recycle_bin():
            self.action_delete_permanently()
            return
        self._trash_paths(paths)

    def _trash_paths(self, paths):
        trash_files = os.path.expanduser("~/.local/share/Trash/files")
        trash_info = os.path.expanduser("~/.local/share/Trash/info")
        try:
            os.makedirs(trash_files, exist_ok=True)
            os.makedirs(trash_info, exist_ok=True)
        except OSError:
            pass

        errors = []
        for p in paths:
            if not os.path.exists(p):
                continue
            deleted = False

            # 1. Try system trash command if available
            for cmd in (["gio", "trash"], ["kioclient5", "move", p, "trash:/"]):
                if shutil.which(cmd[0]):
                    try:
                        res = subprocess.run(cmd + ([p] if cmd[0] == "gio" else []),
                                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        if res.returncode == 0 and not os.path.exists(p):
                            deleted = True
                            break
                    except Exception:
                        pass

            # 2. FreeDesktop Trash standard move
            if not deleted and os.path.exists(p):
                try:
                    base = os.path.basename(p)
                    stem, ext = os.path.splitext(base)
                    dst = os.path.join(trash_files, base)
                    counter = 2
                    while os.path.exists(dst):
                        dst = os.path.join(trash_files, f"{stem} ({counter}){ext}")
                        counter += 1

                    # Write .trashinfo file
                    now_str = datetime.datetime.now().strftime("%Y-%m-%dT%H:%M:%S")
                    info_content = f"[Trash Info]\nPath={os.path.abspath(p)}\nDeletionDate={now_str}\n"
                    info_path = os.path.join(trash_info, f"{os.path.basename(dst)}.trashinfo")
                    try:
                        with open(info_path, "w", encoding="utf-8") as f:
                            f.write(info_content)
                    except Exception:
                        pass

                    shutil.move(p, dst)
                    deleted = True
                except Exception as exc:
                    # 3. Direct remove fallback
                    try:
                        if os.path.isdir(p):
                            shutil.rmtree(p)
                        else:
                            os.remove(p)
                        deleted = True
                    except Exception as err:
                        errors.append(f"{os.path.basename(p)}: {err}")

        self.refresh()
        if errors:
            QMessageBox.critical(self, "Delete Error", "Could not delete:\n" + "\n".join(errors))

    def show_properties(self, target_path=None):
        """Open authentic Windows Properties dialog based on target type."""
        if target_path:
            target = target_path
        else:
            paths = self.get_selected_paths()
            target = paths[0] if paths else self._current_path

        if not target or target in ("This PC", "computer:/", "computer:", "thispc"):
            self.show_system_properties()
            return

        # Check if target is a drive
        for drive in self._drives:
            if drive.get("mount") == target or (target == "/" and drive.get("is_system")):
                self.show_drive_properties(drive)
                return

        if not os.path.exists(target):
            return

        if os.path.isdir(target):
            dlg = WindowsFolderPropertiesDialog(target, self)
            dlg.exec_()
        else:
            dlg = WindowsFilePropertiesDialog(target, self)
            dlg.exec_()

    def show_drive_properties(self, drive):
        dlg = WindowsDrivePropertiesDialog(drive, self)
        dlg.exec_()

    def show_system_properties(self):
        dlg = WindowsSystemPropertiesDialog(self)
        dlg.exec_()

    def _open_manage(self):
        for cmd in [["/usr/local/bin/devos-disk-gui"], ["python3", "/usr/local/share/devos/components/settings/hardware_manager.py"], ["kinfocenter"]]:
            try:
                subprocess.Popen(cmd)
                return
            except OSError:
                pass

    def _set_clipboard(self, action, paths):
        paths = list(paths)
        self._clipboard = {"action": action, "paths": paths}
        if paths:
            mime_data = QMimeData()
            mime_data.setUrls([QUrl.fromLocalFile(p) for p in paths])
            mime_data.setText("\n".join(paths))
            QApplication.clipboard().setMimeData(mime_data)
            action_name = "Copied" if action == "copy" else "Cut"
            self.status.showMessage(f"{action_name} {len(paths)} item(s)", 2000)


    def action_rename_path(self, target):
        if not os.path.exists(target):
            return
        old_name = os.path.basename(target)
        dlg = QDialog(self)
        dlg.setWindowTitle("Rename")
        dlg.setWindowIcon(get_win_icon("folder" if os.path.isdir(target) else "file-doc", 24))
        dlg.resize(320, 120)
        layout = QVBoxLayout(dlg)
        layout.addWidget(QLabel(f"Rename '{old_name}' to:"))
        edit = QLineEdit(old_name)
        layout.addWidget(edit)
        btns = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        btns.accepted.connect(dlg.accept)
        btns.rejected.connect(dlg.reject)
        layout.addWidget(btns)
        if dlg.exec_() == QDialog.Accepted:
            new_name = edit.text().strip()
            if new_name and new_name != old_name:
                try:
                    os.rename(target, os.path.join(os.path.dirname(target), new_name))
                    self.refresh()
                except OSError as err:
                    QMessageBox.critical(self, "Error", f"Failed to rename: {err.strerror}")

    def action_rename_drive(self, drive):
        QMessageBox.information(self, "Rename Drive", f"Drive labels for {drive.get('title')} can be edited in Drive Properties or DevOS Disk Doctor.")

