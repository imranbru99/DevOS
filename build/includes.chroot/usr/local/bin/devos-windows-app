#!/bin/sh
# Prefer an explicitly configured or local development component directory.
if [ -n "${DEVOS_COMPONENTS_DIR:-}" ] && [ -f "$DEVOS_COMPONENTS_DIR/cloudpc/cloudpc.py" ]; then
    component="$DEVOS_COMPONENTS_DIR/cloudpc/cloudpc.py"
elif [ -f "$HOME/project/dev-os/components/cloudpc/cloudpc.py" ]; then
    component="$HOME/project/dev-os/components/cloudpc/cloudpc.py"
else
    component=/usr/local/share/devos/components/cloudpc/cloudpc.py
fi
# The normal shortcut opens only the actual Windows App browser window.
# The local reminder is optional and never claims to track the remote session.
if [ "${1:-}" = "--reminder" ]; then
    shift
    exec /usr/bin/python3 "$component" "$@"
fi
exec /usr/bin/python3 "$(dirname "$component")/browser_launch.py" "$@"
