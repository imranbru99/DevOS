#!/bin/bash
# Prefer an explicitly configured or local development component directory.
if [ -n "${DEVOS_COMPONENTS_DIR:-}" ] && [ -f "$DEVOS_COMPONENTS_DIR/cloudpc/cloudpc.py" ]; then
    component="$DEVOS_COMPONENTS_DIR/cloudpc/cloudpc.py"
elif [ -f "$HOME/project/dev-os/components/cloudpc/cloudpc.py" ]; then
    component="$HOME/project/dev-os/components/cloudpc/cloudpc.py"
else
    component=/usr/local/share/devos/components/cloudpc/cloudpc.py
fi
# Normal menu click → Microsoft Windows App (Cloud PC web PWA / app window).
# Never default to xdg-open or the unofficial Flatpak — that opens a plain
# Chrome tab and Cloud PC login / remote apps fail to stay in Windows App.
if [ "${1:-}" = "--reminder" ]; then
    shift
    exec -a "$(basename "$0")" /usr/bin/python3 "$component" "$@"
fi
if [ "${1:-}" = "--install-client" ] || [ "${1:-}" = "--native-client" ]; then
    client="$(dirname "$component")/linux_client.py"
    if [ -f "$client" ]; then
        exec -a "$(basename "$0")" /usr/bin/python3 "$client" "$@"
    fi
fi
exec -a "$(basename "$0")" /usr/bin/python3 "$(dirname "$component")/browser_launch.py" "$@"
