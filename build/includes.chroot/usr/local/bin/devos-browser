#!/bin/bash
# Chrome is optional. Falkon is the built-in browser: it uses the web engine
# already in the desktop, so it is smaller and opens when Chrome does not.
# Google picks the search language from the browser, not from the public IP.
# Ask the network which country this connection is in, then send that language.
set -u

search_language() {
    cache="${XDG_CONFIG_HOME:-$HOME/.config}/devos/accept-lang"
    if [ -s "$cache" ]; then
        cat "$cache"
        return
    fi

    loc=""
    if command -v curl >/dev/null 2>&1; then
        loc=$(curl -4 -fsS --max-time 4 https://1.1.1.1/cdn-cgi/trace 2>/dev/null \
            | sed -n 's/^loc=//p' | tr -d '\r')
    fi

    case "$loc" in
        BD) lang="bn-BD,bn,en-US,en" ;;
        IN) lang="hi-IN,hi,en-IN,en-US,en" ;;
        PK) lang="ur-PK,ur,en-GB,en" ;;
        NP) lang="ne-NP,ne,en-US,en" ;;
        GB|IE) lang="en-GB,en-US,en" ;;
        *) lang="en-US,en" ;;
    esac

    if [ -n "$loc" ]; then
        mkdir -p "$(dirname "$cache")"
        printf '%s\n' "$lang" > "$cache"
    fi
    printf '%s\n' "$lang"
}

tell() {
    echo "$1" >&2
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title "Browser" --error "$1" >/dev/null 2>&1 || true
    fi
}

# Falkon is the built-in browser. Chrome flags are not passed through.
open_falkon() {
    [ -x /usr/bin/falkon ] || return 1
    falkon_args=()
    for arg in "$@"; do
        case "$arg" in
            --incognito|--private) falkon_args+=(--private-browsing) ;;
            --accept-lang=*|--disable-gpu) ;;
            *) falkon_args+=("$arg") ;;
        esac
    done
    exec /usr/bin/falkon "${falkon_args[@]}"
}

chrome=""
for bin in /usr/bin/google-chrome-stable /usr/bin/google-chrome /opt/google/chrome/google-chrome; do
    if [ -x "$bin" ]; then
        chrome=$bin
        break
    fi
done

if [ -z "$chrome" ]; then
    open_falkon "$@" || tell "No browser is installed yet. Open Terminal and run: sudo devos-install-chrome"
    exit 1
fi

lang=$(search_language)
args=(--accept-lang="$lang")
# A virtual display (the test VM, and some other virtual PCs) makes Chrome's
# graphics process quit immediately, so the window never appears. Draw in
# software there. A normal graphics card is left alone, and the sandbox stays on.
for uevent in /sys/class/drm/card*/device/uevent; do
    [ -r "$uevent" ] || continue
    if grep -Eq 'virtio|qxl|bochs|vmwgfx' "$uevent"; then
        args+=(--disable-gpu)
        break
    fi
done

# On 1366x768 screens, adjust device scale factor so all bookmark bar folders
# and tabs fit cleanly without overflowing into the '>>' menu (matching Windows standard proportions)
screen_w=$(xrandr --current 2>/dev/null | sed -n 's/.*current \([0-9]*\) x .*/\1/p' || echo "1920")
if [ -n "$screen_w" ] && [ "$screen_w" -le 1366 ]; then
    args+=(--force-device-scale-factor=0.90)
fi

log=$(mktemp)
"$chrome" "${args[@]}" "$@" >"$log" 2>&1 &
pid=$!
sleep 2
if kill -0 "$pid" 2>/dev/null; then
    wait "$pid" || true
    rm -f "$log"
    exit 0
fi
wait "$pid"
code=$?
rm -f "$log"
if [ "$code" -ne 0 ]; then
    open_falkon "$@" || tell "Chrome did not open, and the built-in browser is missing."
fi
exit "$code"
