#!/bin/bash
# Optional Google Chrome launcher, including DevOS profile and Guest support.
# Google picks the search language from the browser, not from the public IP.
# Ask the network which country this connection is in, then send that language.
set -u

search_language() {
    cache="${XDG_CONFIG_HOME:-$HOME/.config}/devos/accept-lang"
    if [ -s "$cache" ]; then
        cat "$cache"
        return
    fi

    loc=""
    if command -v curl >/dev/null 2>&1; then
        loc=$(curl -4 -fsS --max-time 4 https://1.1.1.1/cdn-cgi/trace 2>/dev/null \
            | sed -n 's/^loc=//p' | tr -d '\r')
    fi

    # Primary OS language is English — never put a secondary language first.
    # Regional hints stay after en-US so search UI stays English.
    case "$loc" in
        BD) lang="en-US,en,bn-BD,bn" ;;
        IN) lang="en-IN,en-US,en,hi-IN,hi" ;;
        PK) lang="en-GB,en-US,en,ur-PK,ur" ;;
        NP) lang="en-US,en,ne-NP,ne" ;;
        GB|IE) lang="en-GB,en-US,en" ;;
        *) lang="en-US,en" ;;
    esac

    if [ -n "$loc" ]; then
        mkdir -p "$(dirname "$cache")"
        printf '%s\n' "$lang" > "$cache"
    fi
    printf '%s\n' "$lang"
}

tell() {
    echo "$1" >&2
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title "Browser" --error "$1" >/dev/null 2>&1 || true
    fi
}

chrome=""
for bin in /usr/bin/google-chrome-stable /usr/bin/google-chrome /opt/google/chrome/google-chrome; do
    if [ -x "$bin" ]; then
        chrome=$bin
        break
    fi
done

if [ -z "$chrome" ]; then
    tell "Google Chrome is not installed. Choose Google Chrome in DevOS Features, or open DevOS Browser."
    exit 1
fi

for arg in "$@"; do
    case "$arg" in
        --version|-v|-version|--help|-h|-help)
            exec "$chrome" "$@"
            ;;
    esac
done

cleanup_stale_chrome_lock() {
    local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/google-chrome"
    local lock="$config_dir/SingletonLock"
    [ -L "$lock" ] || return 0

    local target target_pid state
    target=$(readlink "$lock" 2>/dev/null || true)
    target_pid="${target##*-}"

    if [ -n "$target_pid" ] && [ "$target_pid" -gt 0 ] 2>/dev/null; then
        if [ ! -d "/proc/$target_pid" ]; then
            rm -f "$config_dir/SingletonLock" "$config_dir/SingletonSocket" "$config_dir/SingletonCookie"
            return 0
        fi
        state=$(awk '/^State:/ {print $2}' "/proc/$target_pid/status" 2>/dev/null || true)
        if [ "$state" = "Z" ] || [ "$state" = "D" ]; then
            pkill -P "$target_pid" 2>/dev/null || true
            kill -9 "$target_pid" 2>/dev/null || true
            rm -f "$config_dir/SingletonLock" "$config_dir/SingletonSocket" "$config_dir/SingletonCookie"
            return 0
        fi
    fi
}

cleanup_stale_chrome_lock

# Isolate Chromium from conflicting GTK/Qt desktop modules (such as colorreload-gtk-module)
# that cause segmentation faults on dynamic theme and palette switches under KDE Plasma.
# Clear every variant: settings.ini gtk-modules=…, GTK_MODULES, and GTK3_MODULES.
unset GTK_MODULES GTK3_MODULES LOADED_GTK_MODULES
export GTK_MODULES=""
export GTK3_MODULES=""
export QT_QPA_PLATFORMTHEME=""
# Belts-and-braces: drop crashy modules from the user GTK settings before launch.
for gtk_ini in \
    "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini" \
    "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0/settings.ini"
do
    if [ -f "$gtk_ini" ] && grep -qiE '^gtk-modules=' "$gtk_ini"; then
        sed -i '/^gtk-modules=/Id;/^gtk-module=/Id' "$gtk_ini" 2>/dev/null || true
    fi
done

lang=$(search_language)
# Under Wayland on KDE Plasma, Chromium native Wayland backend has an upstream bug
# where xdg_popup menus (bookmark folders, profile switcher, extension bubbles)
# instantly dismiss upon click. Forcing --ozone-platform=x11 routes through XWayland,
# making all bookmark dropdowns, profile switchers, and menus 100% stable.
args=(--accept-lang="$lang" --ozone-platform=x11)

# Prefer /dev/shm; only spill to /tmp when shm is nearly empty (avoids filling
# the 25–35% /tmp tmpfs under many Chrome windows).
shm_free_kb=$(df -k /dev/shm 2>/dev/null | awk 'NR==2 {print $4}')
if [ -n "${shm_free_kb:-}" ] && [ "$shm_free_kb" -lt 262144 ]; then
    args+=(--disable-dev-shm-usage)
fi

ram_gb=$(awk '/^MemTotal:/ {printf "%d", $2/1048576}' /proc/meminfo 2>/dev/null || echo 8)
# Shared disk cache budget across all windows (not 50-tab single-window bloat).
disk_cache=$(( ram_gb * 48 * 1024 * 1024 ))
[ "$disk_cache" -gt $((384 * 1024 * 1024)) ] && disk_cache=$((384 * 1024 * 1024))
[ "$disk_cache" -lt $((96 * 1024 * 1024)) ] && disk_cache=$((96 * 1024 * 1024))
# Chrome manages process isolation and background timers. The managed
# Memory Saver policy releases memory from idle tabs across profiles.
args+=("--disk-cache-size=${disk_cache}")

# A virtual display (the test VM, and some other virtual PCs) makes Chrome's
# graphics process quit immediately, so the window never appears. Draw in
# software there. A normal graphics card is left alone, and the sandbox stays on.
for uevent in /sys/class/drm/card*/device/uevent; do
    [ -r "$uevent" ] || continue
    if grep -Eq 'virtio|qxl|bochs|vmwgfx' "$uevent"; then
        args+=(--disable-gpu)
        break
    fi
done


# Sync profile badged icons & desktop launchers
sync_script="/usr/local/share/devos/components/browser/chrome_profiles.py"
user_sync_script="$HOME/.local/share/devos/components/browser/chrome_profiles.py"
if [ -f "$sync_script" ]; then
    python3 "$sync_script" sync >/dev/null 2>&1 &
elif [ -f "$user_sync_script" ]; then
    python3 "$user_sync_script" sync >/dev/null 2>&1 &
fi

# Windows-like profiles: each Chrome user gets its own WM class (chrome-<slug>)
# so Plasma shows a separate avatar icon in the footer — never one grouped blob.
is_guest=0
prof_dir=""
has_class=0
for arg in "$@"; do
    case "$arg" in
        --guest) is_guest=1 ;;
        --profile-directory=*) prof_dir="${arg#--profile-directory=}" ;;
        --class=*) has_class=1 ;;
    esac
done

# Resolve Chrome --class from the profile *display name* (same slug as
# chrome_profiles.py). Directory keys like "Default" must not become
# chrome-default when the user named that profile "Work".
chrome_class_for_profile() {
    local key="${1:-}"
    local script="/usr/local/share/devos/components/browser/chrome_profiles.py"
    local user_script="$HOME/.local/share/devos/components/browser/chrome_profiles.py"
    local py=""
    if [ -f "$script" ]; then
        py="$script"
    elif [ -f "$user_script" ]; then
        py="$user_script"
    fi
    if [ -n "$py" ]; then
        python3 "$py" class-for "${key}" 2>/dev/null && return 0
    fi
    local fallback
    fallback=$(printf '%s' "${key:-Default}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/^-*//;s/-*$//')
    printf 'chrome-%s\n' "${fallback:-chrome}"
}

if [ "$is_guest" -eq 1 ]; then
    # Ephemeral guest session: automatically removed on close
    guest_tmp=$(mktemp -d /tmp/devos-chrome-guest.XXXXXX)
    cleanup() {
        rm -rf "$guest_tmp"
    }
    trap cleanup EXIT INT TERM HUP
    "$chrome" "${args[@]}" --class="chrome-guest" --user-data-dir="$guest_tmp" --no-first-run --no-default-browser-check "$@" &
    cpid=$!
    trap 'kill "$cpid" 2>/dev/null; cleanup; exit 0' INT TERM HUP
    wait "$cpid"
    code=$?
    if [ "$code" -ne 0 ]; then
        tell "Google Chrome Guest stopped with exit code $code."
    fi
    exit "$code"
fi

if [ "$has_class" -eq 0 ]; then
    if [ -z "$prof_dir" ]; then
        # Bare Start-menu / URL launch → last-used (or Default) profile class.
        prof_dir=$(python3 - <<'PY' 2>/dev/null || true
import json, os
path = os.path.expanduser("~/.config/google-chrome/Local State")
try:
    with open(path, encoding="utf-8") as fh:
        data = json.load(fh)
    last = (data.get("profile") or {}).get("last_used") or ""
    print(last or "Default")
except Exception:
    print("Default")
PY
)
        [ -z "$prof_dir" ] && prof_dir="Default"
        args+=(--profile-directory="${prof_dir}")
    fi
    class_name=$(chrome_class_for_profile "$prof_dir")
    [ -n "$class_name" ] && args+=(--class="${class_name}")
fi

log=$(mktemp)
trap 'rm -f "$log"' EXIT
"$chrome" "${args[@]}" "$@" >"$log" 2>&1
code=$?
if [ "$code" -ne 0 ]; then
    tail -n 8 "$log" >&2
    tell "Google Chrome did not open. Open DevOS Browser or check Chrome from Terminal."
fi
exit "$code"
