#!/bin/bash
# Choose, download and remove DevOS AI models; show or share the local AI API.
# No args → GUI (Start menu). Subcommands → CLI (scripts / pkexec).
COMPONENTS="/usr/local/share/devos/components"
CLI="${COMPONENTS}/ai-core/models_cli.py"
GUI="${COMPONENTS}/ai-core/models_gui.py"
case "${1:-}" in
    ""|--gui)
        exec -a "devos-ai-models" /usr/bin/python3 "$GUI"
        ;;
    *)
        exec -a "$(basename "$0")" /usr/bin/python3 "$CLI" "$@"
        ;;
esac
