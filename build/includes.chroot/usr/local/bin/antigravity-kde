#!/usr/bin/env bash
# Antigravity IDE — second Google account, normal window.
# A mount sandbox hid the main profile but also broke the display, so the
# click turned into a black Antigravity window with the same icon.
# This launch keeps your real screen and session. It only gives the process
# a home where the main profile and the main login are not present.
set -euo pipefail

IDE_BIN=""
if [ -x "${HOME}/.local/lib/antigravity-ide/antigravity-ide" ]; then
    IDE_BIN="${HOME}/.local/lib/antigravity-ide/antigravity-ide"
elif [ -x "${HOME}/.local/lib/antigravity-ide/bin/antigravity-ide" ]; then
    IDE_BIN="${HOME}/.local/lib/antigravity-ide/bin/antigravity-ide"
elif [ -x "/usr/local/share/devos/antigravity-ide/bin/antigravity-ide" ]; then
    IDE_BIN="/usr/local/share/devos/antigravity-ide/bin/antigravity-ide"
elif [ -x "/opt/antigravity/antigravity" ]; then
    IDE_BIN="/opt/antigravity/antigravity"
fi

if [ -z "$IDE_BIN" ]; then
    msg='Antigravity IDE is not installed yet. Open DevOS Features, install Google Antigravity, then try again.'
    echo "Error: $msg" >&2
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title "Antigravity IDE" --error "$msg" >/dev/null 2>&1 || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send -a "DevOS" -i "dialog-error" "Antigravity IDE" "$msg" || true
    fi
    exit 1
fi

REAL_HOME="$HOME"
DATA_DIR="${REAL_HOME}/.config/Antigravity-KDE"
EXT_DIR="${REAL_HOME}/.antigravity-kde/extensions"
IDE_HOME="${REAL_HOME}/.local/share/devos/antigravity-ide-home"
HOST_KDE_GEMINI="${REAL_HOME}/.gemini/antigravity-kde"
mkdir -p "$DATA_DIR" "$EXT_DIR" "$HOST_KDE_GEMINI" \
    "$IDE_HOME/.config" "$IDE_HOME/.gemini" "$IDE_HOME/.local/share/keyrings" \
    "${REAL_HOME}/.cache/antigravity-kde/tmp"

if [ -z "$(ls -A "$EXT_DIR" 2>/dev/null || true)" ]; then
    for candidate in \
        "${REAL_HOME}/.antigravity/extensions" \
        "${REAL_HOME}/.config/Antigravity/extensions"
    do
        if [ -d "$candidate" ] && [ -n "$(ls -A "$candidate" 2>/dev/null || true)" ]; then
            EXT_DIR="$candidate"
            break
        fi
    done
fi

link_children() {
    local source="$1" dest="$2" skip="${3:-}"
    mkdir -p "$dest"
    local item base
    for item in "$source"/*; do
        [ -e "$item" ] || [ -L "$item" ] || continue
        base="$(basename "$item")"
        [ "$base" = "$skip" ] && continue
        ln -sfn "$item" "$dest/$base"
    done
}

# Projects, ssh keys, and the desktop stay reachable. The main Antigravity
# profile and its Gemini login do not.
shopt -s dotglob nullglob
for item in "$REAL_HOME"/*; do
    base="$(basename "$item")"
    case "$base" in
        .|..|.config|.gemini|.local|.cache|.Xauthority) continue ;;
    esac
    ln -sfn "$item" "$IDE_HOME/$base"
done
shopt -u dotglob nullglob

link_children "$REAL_HOME/.config" "$IDE_HOME/.config" "Antigravity"
ln -sfn "$DATA_DIR" "$IDE_HOME/.config/Antigravity"
ln -sfn "$HOST_KDE_GEMINI" "$IDE_HOME/.gemini/antigravity-kde"
if [ -e "$REAL_HOME/.gemini/skills" ]; then
    ln -sfn "$REAL_HOME/.gemini/skills" "$IDE_HOME/.gemini/skills"
fi
if [ -d "$REAL_HOME/.agents/skills" ]; then
    ln -sfn "$REAL_HOME/.agents/skills" "$IDE_HOME/.gemini/skills"
fi

mkdir -p "$IDE_HOME/.local"
if [ -d "$REAL_HOME/.local" ]; then
    link_children "$REAL_HOME/.local" "$IDE_HOME/.local" "share"
    link_children "$REAL_HOME/.local/share" "$IDE_HOME/.local/share" "keyrings"
fi
mkdir -p "$IDE_HOME/.local/share/keyrings"

if [ -n "${XAUTHORITY:-}" ] && [ -e "$XAUTHORITY" ]; then
    ln -sfn "$XAUTHORITY" "$IDE_HOME/.Xauthority"
elif [ -e "$REAL_HOME/.Xauthority" ]; then
    ln -sfn "$REAL_HOME/.Xauthority" "$IDE_HOME/.Xauthority"
fi

unset ELECTRON_RUN_AS_NODE
export DONT_PROMPT_WSL_INSTALL=1
export GEMINI_APP_DATA_DIR="antigravity-kde"
# Store this account in the private Gemini folder, not the shared keyring.
export SSH_CLIENT="127.0.0.1 34567 22"
export SSH_CONNECTION="127.0.0.1 34567 127.0.0.1 22"
export SSH_TTY="/dev/pts/0"
export HOME="$IDE_HOME"
unset XDG_CONFIG_HOME XDG_DATA_HOME XDG_CACHE_HOME
export TMPDIR="${REAL_HOME}/.cache/antigravity-kde/tmp"

exec "$IDE_BIN" \
    --ozone-platform=x11 \
    --no-sandbox \
    --password-store=basic \
    --user-data-dir="${DATA_DIR}" \
    --extensions-dir="${EXT_DIR}" \
    --class=antigravity-ide \
    --name=antigravity-ide \
    "$@"
