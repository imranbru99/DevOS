#!/usr/bin/env bash
# Antigravity IDE — second independent instance (own Google account + projects).
# Isolated from Google Antigravity (main) via separate data dirs and WM class.
set -euo pipefail

IDE_BIN=""
if [ -x "${HOME}/.local/lib/antigravity-ide/antigravity-ide" ]; then
    IDE_BIN="${HOME}/.local/lib/antigravity-ide/antigravity-ide"
elif [ -x "${HOME}/.local/lib/antigravity-ide/bin/antigravity-ide" ]; then
    IDE_BIN="${HOME}/.local/lib/antigravity-ide/bin/antigravity-ide"
elif [ -x "/usr/local/share/devos/antigravity-ide/bin/antigravity-ide" ]; then
    IDE_BIN="/usr/local/share/devos/antigravity-ide/bin/antigravity-ide"
elif [ -x "/opt/antigravity/antigravity" ]; then
    IDE_BIN="/opt/antigravity/antigravity"
fi

if [ -z "$IDE_BIN" ]; then
    msg='Antigravity IDE is not installed yet. Open DevOS Features, install Google Antigravity (or Antigravity IDE), then try again.'
    echo "Error: $msg" >&2
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title "Antigravity IDE" --error "$msg" >/dev/null 2>&1 || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send -a "DevOS" -i "dialog-error" "Antigravity IDE" "$msg" || true
    fi
    exit 1
fi

unset ELECTRON_RUN_AS_NODE
export DONT_PROMPT_WSL_INSTALL=1
export GEMINI_APP_DATA_DIR="antigravity-kde"
# Separate keyring / auth from the main Antigravity instance.
export SSH_CLIENT="127.0.0.1 0 0"

DATA_DIR="${HOME}/.config/Antigravity-KDE"
EXT_DIR="${HOME}/.antigravity-kde/extensions"
mkdir -p "$DATA_DIR" "$EXT_DIR"

# Prefer this IDE's own extensions; fall back to shared only if empty.
if [ -z "$(ls -A "$EXT_DIR" 2>/dev/null || true)" ]; then
    for candidate in \
        "${HOME}/.antigravity/extensions" \
        "${HOME}/.config/Antigravity/extensions"
    do
        if [ -d "$candidate" ] && [ -n "$(ls -A "$candidate" 2>/dev/null || true)" ]; then
            EXT_DIR="$candidate"
            break
        fi
    done
fi

rm -f "${HOME}/.gemini/cache/antigravity-keyring-unavailable"

exec "$IDE_BIN" \
    --ozone-platform=x11 \
    --no-sandbox \
    --password-store=basic \
    --user-data-dir="${DATA_DIR}" \
    --extensions-dir="${EXT_DIR}" \
    --class=antigravity-ide \
    --name=antigravity-ide \
    "$@"
