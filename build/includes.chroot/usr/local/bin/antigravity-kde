#!/usr/bin/env bash
# Antigravity Studio (KDE Edition) - isolated AI agent instance with shared extensions.
# Profile/data stay separate; extensions reuse the primary Antigravity install when present
# (old/shared extensions dir) instead of an empty per-KDE extensions tree.
set -e

IDE_BIN=""
if [ -x "$HOME/.local/lib/antigravity-ide/antigravity-ide" ]; then
    IDE_BIN="$HOME/.local/lib/antigravity-ide/antigravity-ide"
elif [ -x "$HOME/.local/lib/antigravity-ide/bin/antigravity-ide" ]; then
    IDE_BIN="$HOME/.local/lib/antigravity-ide/bin/antigravity-ide"
elif [ -x "/usr/local/share/devos/antigravity-ide/bin/antigravity-ide" ]; then
    IDE_BIN="/usr/local/share/devos/antigravity-ide/bin/antigravity-ide"
elif [ -x "/opt/antigravity/antigravity" ]; then
    IDE_BIN="/opt/antigravity/antigravity"
fi

if [ -z "$IDE_BIN" ]; then
    echo "Error: Antigravity IDE binary not found." >&2
    exit 1
fi

unset ELECTRON_RUN_AS_NODE
export DONT_PROMPT_WSL_INSTALL=1
export GEMINI_APP_DATA_DIR="antigravity-kde"
# Bypass host GNOME Keyring in language server to ensure full auth/session segregation
export SSH_CLIENT="127.0.0.1 0 0"

# Prefer the primary Antigravity extensions (shared / "old") when available.
# Fall back to the KDE-specific dir only when nothing else exists.
SHARED_EXT=""
for candidate in \
    "${HOME}/.antigravity/extensions" \
    "${HOME}/.config/Antigravity/extensions" \
    "${HOME}/.vscode/extensions"
do
    if [ -d "$candidate" ]; then
        SHARED_EXT="$candidate"
        break
    fi
done

KDE_EXT="${HOME}/.antigravity-kde/extensions"
mkdir -p "$KDE_EXT"
if [ -n "$SHARED_EXT" ]; then
    EXT_DIR="$SHARED_EXT"
else
    EXT_DIR="$KDE_EXT"
fi

# Remove any stale timeout marker from previous tests
rm -f "$HOME/.gemini/cache/antigravity-keyring-unavailable"

exec "$IDE_BIN" \
    --ozone-platform=x11 \
    --no-sandbox \
    --password-store=basic \
    --user-data-dir="${HOME}/.config/Antigravity-KDE" \
    --extensions-dir="${EXT_DIR}" \
    --class=antigravity-ide \
    --name=antigravity-ide \
    "$@"
