#!/usr/bin/env bash
# Antigravity IDE — second app, second Google account.
# Google Antigravity keeps ~/.config/Antigravity and ~/.gemini. This launcher
# must not see those directories, or the running app takes the click and the
# taskbar stays on the same icon.
set -euo pipefail

IDE_BIN=""
if [ -x "${HOME}/.local/lib/antigravity-ide/antigravity-ide" ]; then
    IDE_BIN="${HOME}/.local/lib/antigravity-ide/antigravity-ide"
elif [ -x "${HOME}/.local/lib/antigravity-ide/bin/antigravity-ide" ]; then
    IDE_BIN="${HOME}/.local/lib/antigravity-ide/bin/antigravity-ide"
elif [ -x "/usr/local/share/devos/antigravity-ide/bin/antigravity-ide" ]; then
    IDE_BIN="/usr/local/share/devos/antigravity-ide/bin/antigravity-ide"
elif [ -x "/opt/antigravity/antigravity" ]; then
    IDE_BIN="/opt/antigravity/antigravity"
fi

if [ -z "$IDE_BIN" ]; then
    msg='Antigravity IDE is not installed yet. Open DevOS Features, install Google Antigravity, then try again.'
    echo "Error: $msg" >&2
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title "Antigravity IDE" --error "$msg" >/dev/null 2>&1 || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send -a "DevOS" -i "dialog-error" "Antigravity IDE" "$msg" || true
    fi
    exit 1
fi

fail_isolated() {
    msg='Antigravity IDE needs its own window, and this system could not hide the main Antigravity profile. Install bubblewrap, then open Antigravity IDE again: sudo apt-get install -y bubblewrap'
    echo "Error: $msg" >&2
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title "Antigravity IDE" --error "$msg" >/dev/null 2>&1 || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send -a "DevOS" -i "dialog-error" "Antigravity IDE" "$msg" || true
    fi
    exit 1
}

unset ELECTRON_RUN_AS_NODE
export DONT_PROMPT_WSL_INSTALL=1
# Pipeline slot and chats: ~/.gemini/antigravity-kde on the real home.
export GEMINI_APP_DATA_DIR="antigravity-kde"
# File token inside the private ~/.gemini, not the shared desktop keyring.
export SSH_CLIENT="127.0.0.1 34567 22"
export SSH_CONNECTION="127.0.0.1 34567 127.0.0.1 22"
export SSH_TTY="/dev/pts/0"

DATA_DIR="${HOME}/.config/Antigravity-KDE"
MAIN_CONFIG="${HOME}/.config/Antigravity"
EXT_DIR="${HOME}/.antigravity-kde/extensions"
PRIVATE_GEMINI="${HOME}/.gemini-profiles/antigravity-kde-root"
HOST_KDE_GEMINI="${HOME}/.gemini/antigravity-kde"
mkdir -p "$DATA_DIR" "$EXT_DIR" "$PRIVATE_GEMINI/antigravity-kde" "$HOST_KDE_GEMINI" "$MAIN_CONFIG"

if [ -z "$(ls -A "$EXT_DIR" 2>/dev/null || true)" ]; then
    for candidate in \
        "${HOME}/.antigravity/extensions" \
        "${HOME}/.config/Antigravity/extensions"
    do
        if [ -d "$candidate" ] && [ -n "$(ls -A "$candidate" 2>/dev/null || true)" ]; then
            EXT_DIR="$candidate"
            break
        fi
    done
fi

ARGS=(
    --ozone-platform=x11
    --no-sandbox
    --password-store=basic
    --user-data-dir="${DATA_DIR}"
    --extensions-dir="${EXT_DIR}"
    --class=antigravity-ide
    --name=antigravity-ide
)

# Inside the sandbox:
#   ~/.config/Antigravity  -> this IDE's own folder (main lock is invisible)
#   ~/.gemini              -> this IDE's own tree
#   ~/.gemini/antigravity-kde stays the host folder the pipeline already reads
HOST_KDE_MIRROR="${HOME}/.gemini-profiles/antigravity-kde-host"
mkdir -p "$HOST_KDE_MIRROR"

if command -v bwrap >/dev/null 2>&1 && bwrap --dev-bind / / \
    --bind "$DATA_DIR" "$MAIN_CONFIG" \
    --bind "$PRIVATE_GEMINI" "${HOME}/.gemini" \
    --bind "$HOST_KDE_GEMINI" "${HOME}/.gemini/antigravity-kde" \
    -- true >/dev/null 2>&1; then
    exec bwrap --die-with-parent --dev-bind / / \
        --bind "$DATA_DIR" "$MAIN_CONFIG" \
        --bind "$PRIVATE_GEMINI" "${HOME}/.gemini" \
        --bind "$HOST_KDE_GEMINI" "${HOME}/.gemini/antigravity-kde" \
        -- "$IDE_BIN" "${ARGS[@]}" "$@"
fi

if unshare --user --mount --map-root-user true >/dev/null 2>&1; then
    exec unshare --user --mount --map-root-user bash -c '
        mount --bind "$5" "$6"
        mount --bind "$1" "$2"
        mount --bind "$3" "$4"
        mkdir -p "$4/antigravity-kde"
        mount --bind "$6" "$4/antigravity-kde"
        shift 6
        exec "$@"
    ' _ "$DATA_DIR" "$MAIN_CONFIG" "$PRIVATE_GEMINI" "${HOME}/.gemini" "$HOST_KDE_GEMINI" "$HOST_KDE_MIRROR" "$IDE_BIN" "${ARGS[@]}" "$@"
fi

fail_isolated
