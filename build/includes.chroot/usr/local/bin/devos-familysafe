#!/bin/bash
# DevOS familysafe launcher — process title is the app id, not python3.
export DEVOS_DESKTOP_FILE=devos-familysafe
# Default to the window when no subcommand is given (desktop may also pass "gui").
if [ $# -eq 0 ]; then
  set -- gui
fi
exec -a "devos-familysafe" /usr/bin/python3 /usr/local/share/devos/components/familysafe/familysafe.py "$@"
