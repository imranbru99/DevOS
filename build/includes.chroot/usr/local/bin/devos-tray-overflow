#!/usr/bin/env python3
"""Keep StatusNotifier / tray icons under Plasma Status & Notifications (^).

Open windows stay on the center taskbar. This only manages the system tray.
The speaker (org.kde.plasma.volume) belongs in that popup, not beside the clock.

Plasma 6 reads the live hide-list from the private system tray containment
([Containments][N][General], plugin=org.kde.plasma.private.systemtray), not
from the panel applet's [Configuration][General]. A finished applet section
must not mask an empty containment section — that left the speaker on the bar.

Do not use plasmashell writeConfig() for hiddenItems — it breaks KConfig
StringList matching so icons stay on the panel. Write appletsrc only, and
restart plasmashell only when the hide-set actually gains new Ids.
"""
from __future__ import annotations

import os
import re
import subprocess
import sys
import time
from pathlib import Path

APPLETRC = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / (
    "plasma-org.kde.plasma.desktop-appletsrc"
)

ALWAYS_HIDE = (
    # Plasma status plasmoids — default category is "Always Shown" on the
    # panel. Put them under Status & Notifications (^) like Windows tray.
    "org.kde.plasma.battery",
    "org.kde.plasma.bluetooth",
    "org.kde.plasma.brightness",
    "org.kde.plasma.brightnesscontrol",
    "org.kde.plasma.clipboard",
    "org.kde.plasma.devicenotifier",
    "org.kde.plasma.keyboardlayout",
    "org.kde.plasma.manage-inputmethod",
    "org.kde.plasma.mediacontroller",
    "org.kde.plasma.networkmanagement",
    "org.kde.plasma.nightcolorcontrol",
    "org.kde.plasma.notifications",
    "org.kde.plasma.printmanager",
    "org.kde.plasma.cameraindicator",
    "org.kde.plasma.volume",
    # PulseAudio draws this while any app is recording. Status is Active, so
    # it sticks beside the clock unless it is listed here. Voice and voice
    # typing should only show it under Status & Notifications (^).
    "microphone",
    "Microphone",
    # Hands-free listener. Qt's tray icon reports Active, which pins it too.
    "devos-voice",
    "DevOS Optimizer",
    "devos-optimizer",
    "DevOS Sound",
    "devos-sound",
    "Sound",
    "DevOS Display",
    "devos-display",
    "Display",
    "Brightness",
)

EXTRA_ITEMS = (
    "org.kde.plasma.battery",
    "org.kde.plasma.bluetooth",
    "org.kde.plasma.brightness",
    "org.kde.plasma.brightnesscontrol",
    "org.kde.plasma.clipboard",
    "org.kde.plasma.devicenotifier",
    "org.kde.plasma.keyboardlayout",
    "org.kde.plasma.manage-inputmethod",
    "org.kde.plasma.mediacontroller",
    "org.kde.plasma.networkmanagement",
    "org.kde.plasma.nightcolorcontrol",
    "org.kde.plasma.notifications",
    "org.kde.plasma.printmanager",
    "org.kde.plasma.cameraindicator",
    "org.kde.plasma.volume",
)


def _run(cmd: list[str], timeout: float = 5.0) -> str:
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        if out.returncode == 0:
            return (out.stdout or "").strip()
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        pass
    return ""


def registered_tray_ids() -> list[str]:
    ids: list[str] = []
    bus = _run(["busctl", "--user", "list"])
    if not bus:
        return ids
    for ln in bus.splitlines():
        if "StatusNotifierItem" not in ln:
            continue
        service = ln.split()[0]
        for iface in ("org.kde.StatusNotifierItem", "org.freedesktop.StatusNotifierItem"):
            raw = _run(
                ["busctl", "--user", "get-property", service, "/StatusNotifierItem", iface, "Id"]
            )
            if not raw:
                continue
            m = re.search(r'"([^"]+)"', raw)
            if m and m.group(1).strip():
                ids.append(m.group(1).strip())
                break
    return ids


def desired_hidden_set() -> set[str]:
    return set(ALWAYS_HIDE) | set(registered_tray_ids())


def parse_list(value: str) -> set[str]:
    return {x.strip() for x in value.split(",") if x.strip()}


def _sections(lines: list[str]) -> list[tuple[str, int, int]]:
    """Return list of (header, start_idx, end_idx_exclusive)."""
    headers: list[tuple[str, int]] = []
    for i, line in enumerate(lines):
        if line.startswith("[") and line.rstrip().endswith("]"):
            headers.append((line.strip(), i))
    out: list[tuple[str, int, int]] = []
    for i, (hdr, start) in enumerate(headers):
        end = headers[i + 1][1] if i + 1 < len(headers) else len(lines)
        out.append((hdr, start, end))
    return out


def find_tray_applet_headers(lines: list[str]) -> list[str]:
    """Applet headers like [Containments][3][Applets][7] for systemtray."""
    found: list[str] = []
    for hdr, start, end in _sections(lines):
        body = "".join(lines[start:end])
        if "plugin=org.kde.plasma.systemtray" not in body:
            continue
        if re.fullmatch(r"\[Containments\]\[\d+\]\[Applets\]\[\d+\]", hdr):
            found.append(hdr)
    return found


def find_systray_containment_headers(lines: list[str]) -> list[str]:
    """Live tray containments Plasma 6 actually reads.

    The panel applet only stores SystrayContainmentId. Volume, network and the
    other status plasmoids follow [Containments][that id][General].
    """
    found: list[str] = []
    seen: set[str] = set()
    sections = _sections(lines)
    for hdr, start, end in sections:
        if not re.fullmatch(r"\[Containments\]\[\d+\]", hdr):
            continue
        body = "".join(lines[start:end])
        if "plugin=org.kde.plasma.private.systemtray" in body and hdr not in seen:
            found.append(hdr)
            seen.add(hdr)
    for line in lines:
        match = re.match(r"SystrayContainmentId=(\d+)\s*$", line.strip())
        if not match:
            continue
        hdr = f"[Containments][{match.group(1)}]"
        if hdr in seen:
            continue
        if any(section == hdr for section, _, _ in sections):
            found.append(hdr)
            seen.add(hdr)
    return found


def policy_section_headers(lines: list[str]) -> list[str]:
    """Every group that can pin the speaker beside the clock."""
    headers: list[str] = []
    for applet_hdr in find_tray_applet_headers(lines):
        headers.append(applet_hdr + "[Configuration][General]")
        headers.append(applet_hdr + "[General]")
    for containment in find_systray_containment_headers(lines):
        headers.append(containment + "[General]")
    return headers


def find_tray_general_locs(lines: list[str]) -> list[tuple[int, int]]:
    """All systemtray General sections (applet + private containment)."""
    wanted = set(policy_section_headers(lines))
    return [(start, end) for hdr, start, end in _sections(lines) if hdr in wanted]


def find_tray_general(lines: list[str]) -> tuple[int, int] | None:
    """Best General section for reading/writing tray visibility policy."""
    locs = find_tray_general_locs(lines)
    if not locs:
        return None
    # The private containment is the one Plasma 6 shows on the panel.
    for start, end in locs:
        if re.search(r"\[Containments\]\[\d+\]\[General\]", lines[start]):
            return start, end
    for start, end in locs:
        if "[Configuration][General]" in lines[start]:
            return start, end
    return locs[0]


def _read_section_policy(lines: list[str], start: int, end: int) -> tuple[set[str], bool, str]:
    hidden: set[str] = set()
    show_all = False
    shown = ""
    for line in lines[start + 1 : end]:
        if line.startswith("hiddenItems="):
            hidden |= parse_list(line.split("=", 1)[1])
        elif line.startswith("showAllItems="):
            if line.split("=", 1)[1].strip().lower() in ("true", "1", "yes"):
                show_all = True
        elif line.startswith("shownItems="):
            val = line.split("=", 1)[1].strip()
            if val:
                shown = val
    return hidden, show_all, shown


def read_policy(lines: list[str]) -> tuple[set[str], bool, str]:
    """Union of every tray section. Prefer policies_satisfied for apply checks."""
    locs = find_tray_general_locs(lines)
    if not locs:
        return set(), True, ""
    hidden: set[str] = set()
    show_all = False
    shown = ""
    for start, end in locs:
        section_hidden, section_show_all, section_shown = _read_section_policy(lines, start, end)
        hidden |= section_hidden
        show_all = show_all or section_show_all
        if section_shown:
            shown = section_shown
    return hidden, show_all, shown


def policies_satisfied(lines: list[str], want: set[str]) -> bool:
    """True only when every live tray section hides the full set.

    A complete panel-applet copy must not hide an incomplete containment.
    That is the Plasma 6 path, and it is what leaves the speaker beside the clock.
    """
    headers = policy_section_headers(lines)
    if not headers:
        return False
    existing = {hdr: (start, end) for hdr, start, end in _sections(lines)}
    for header in headers:
        if header not in existing:
            return False
        start, end = existing[header]
        hidden, show_all, shown = _read_section_policy(lines, start, end)
        if show_all or shown or not want.issubset(hidden):
            return False
    return True


def _policy_body(hidden: set[str]) -> list[str]:
    hidden_csv = ",".join(sorted(hidden))
    extra = ",".join(EXTRA_ITEMS)
    return [
        "showAllItems=false\n",
        f"extraItems={extra}\n",
        f"hiddenItems={hidden_csv}\n",
        f"knownItems={extra}\n",
        "pin=false\n",
        "shownItems=\n",
    ]


def _insert_missing_section(lines: list[str], header: str, body: list[str]) -> list[str]:
    """Insert header+body after the closest parent section that already exists."""
    parts = re.findall(r"\[[^\]]+\]", header)
    existing = {hdr: (start, end) for hdr, start, end in _sections(lines)}
    for size in range(len(parts) - 1, 0, -1):
        parent = "".join(parts[:size])
        if parent not in existing:
            continue
        end = existing[parent][1]
        return lines[:end] + [header + "\n"] + body + lines[end:]
    return lines


def write_policy(lines: list[str], hidden: set[str]) -> list[str]:
    body = _policy_body(hidden)
    headers = policy_section_headers(lines)
    if not headers:
        # Insert Configuration/General after systemtray applet section
        for hdr, start, end in _sections(lines):
            chunk = "".join(lines[start:end])
            if "plugin=org.kde.plasma.systemtray" in chunk and re.fullmatch(
                r"\[Containments\]\[\d+\]\[Applets\]\[\d+\]", hdr
            ):
                general = hdr + "[Configuration][General]\n"
                return lines[:end] + [general] + body + lines[end:]
        return lines

    existing = {hdr: (start, end) for hdr, start, end in _sections(lines)}
    present = sorted(
        ((existing[header][0], existing[header][1]) for header in headers if header in existing),
        reverse=True,
    )
    for start, end in present:
        header = lines[start]
        lines = (
            lines[:start]
            + [header if header.endswith("\n") else header + "\n"]
            + body
            + lines[end:]
        )
    for header in headers:
        if any(section == header for section, _, _ in _sections(lines)):
            continue
        lines = _insert_missing_section(lines, header, body)
    return lines


def plasmashell_up() -> bool:
    return "up" in _run(
        [
            "qdbus6",
            "org.kde.plasmashell",
            "/PlasmaShell",
            "org.kde.PlasmaShell.evaluateScript",
            'print("up")',
        ]
    )


def restart_plasmashell() -> None:
    subprocess.run(
        ["systemctl", "--user", "restart", "plasma-plasmashell.service"],
        capture_output=True,
        text=True,
        timeout=30,
    )
    for _ in range(25):
        if plasmashell_up():
            return
        time.sleep(0.4)


def once(restart_if_changed: bool = True) -> int:
    try:
        if not APPLETRC.is_file():
            print("DevOS: no plasma appletsrc yet.")
            return 0
        raw = APPLETRC.read_text(encoding="utf-8", errors="replace")
        lines = raw.splitlines(keepends=True)
        want = desired_hidden_set()
        if policies_satisfied(lines, want):
            print("DevOS: tray overflow policy already applied.")
            return 0
        have, _, _ = read_policy(lines)
        new_lines = write_policy(lines, have | want)
        new_raw = "".join(new_lines)
        if new_raw != raw:
            APPLETRC.write_text(new_raw, encoding="utf-8")
        if restart_if_changed and (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
            restart_plasmashell()
            print("DevOS: tray icons moved under Status & Notifications (^).")
        else:
            print("DevOS: tray overflow config updated (restart plasmashell to apply).")
    except Exception as exc:
        print(f"DevOS: tray overflow update skipped: {exc}", file=sys.stderr)
        return 1
    return 0


def watch(interval: float = 25.0) -> int:
    once(restart_if_changed=True)
    seen = set(registered_tray_ids())
    while True:
        try:
            ids = set(registered_tray_ids())
            if ids - seen:
                once(restart_if_changed=True)
                seen |= ids
        except Exception as exc:
            print(f"DevOS: tray overflow watch tick failed: {exc}", file=sys.stderr)
        time.sleep(interval)


def main(argv: list[str] | None = None) -> int:
    if not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        return 0
    args = list(sys.argv[1:] if argv is None else argv)
    if args and args[0] == "--watch":
        return watch()
    if args and args[0] == "--write-only":
        return once(restart_if_changed=False)
    return once(restart_if_changed=True)


if __name__ == "__main__":
    raise SystemExit(main())
