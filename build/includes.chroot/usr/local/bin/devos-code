#!/bin/bash
# DevOS Code — modern VS Code (or Codium), never the old Kate welcome screen.
set -u

AI_DIR="/usr/local/share/devos/components/ai-core"
if [ -f "${AI_DIR}/server.py" ]; then
    if ! ss -ltn 2>/dev/null | grep -q ':11434'; then
        (cd "${AI_DIR}" && python3 server.py >/var/tmp/devos-ai-core.log 2>&1 &)
        sleep 0.4
    fi
fi

launch_editor() {
    local bin="$1"
    shift
    # Keep the DevOS Code taskbar identity while using the real editor binary.
    case "$bin" in
        code|code-oss|codium)
            exec "$bin" --no-sandbox "$@" 2>/dev/null || exec "$bin" "$@"
            ;;
        *)
            exec "$bin" "$@"
            ;;
    esac
}

for candidate in code codium code-oss; do
    if command -v "$candidate" >/dev/null 2>&1; then
        launch_editor "$candidate" "$@"
    fi
done

# Kate is a stock KDE editor — never present it as DevOS Code.
setup="/usr/local/share/devos/components/code/code_setup.py"
if [ -f "$setup" ]; then
    exec -a "$(basename "$0")" /usr/bin/python3 "$setup" "$@"
fi

echo "DevOS Code needs Visual Studio Code. Install it with: sudo devos-install-code" >&2
exit 1
