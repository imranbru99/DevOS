#!/bin/bash
# Open the code editor and make sure the local DevOS model is listening.
set -u

AI_DIR="/usr/local/share/devos/components/ai-core"
if [ -f "${AI_DIR}/server.py" ]; then
    if ! ss -ltn 2>/dev/null | grep -q ':11434'; then
        (cd "${AI_DIR}" && python3 server.py >/var/tmp/devos-ai-core.log 2>&1 &)
        sleep 0.4
    fi
fi

if command -v code >/dev/null 2>&1; then
    exec code "$@"
fi

if command -v kate >/dev/null 2>&1; then
    exec kate "$@"
fi

echo "DevOS Code needs Kate. It is installed with the desktop package set." >&2
exit 1
