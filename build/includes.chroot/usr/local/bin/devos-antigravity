#!/bin/bash
# DevOS Antigravity Agent Launcher
# Launches the Antigravity Autonomous Code Agent experience
set -euo pipefail

# Ensure AI backend or bridge is accessible
AI_DIR="/usr/local/share/devos/components/ai-core"
if [ -f "${AI_DIR}/server.py" ] && ! ss -ltn 2>/dev/null | grep -q ':11434'; then
    (cd "${AI_DIR}" && python3 server.py >/var/tmp/devos-ai-core.log 2>&1 &)
    sleep 0.5
fi

# If agy binary exists natively, invoke it; otherwise open Antigravity Agent GUI
if command -v agy >/dev/null 2>&1; then
    if [ $# -gt 0 ] && [ "$1" = "--cli" ]; then
        shift
        exec agy "$@"
    fi
fi

# Launch the visual Antigravity Agent app
exec /usr/bin/python3 /usr/local/share/devos/components/code-agent/agent_gui.py "$@"
