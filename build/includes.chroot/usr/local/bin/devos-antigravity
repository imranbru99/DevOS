#!/usr/bin/env bash
# Google Antigravity (main) — primary account / projects / Gemini profile.
# Fully isolated from Antigravity IDE (antigravity-kde).
set -euo pipefail
unset ELECTRON_RUN_AS_NODE
export GTK_MODULES=""
export DONT_PROMPT_WSL_INSTALL=1
export GEMINI_APP_DATA_DIR="antigravity"
# Bypass host GNOME Keyring so logins stay in this profile only.
export SSH_CLIENT="127.0.0.1 0 0"

binary=/opt/antigravity/antigravity
if [[ ! -x "$binary" ]]; then
    msg='Google Antigravity is not installed yet. Open DevOS Features, install Google Antigravity, then try again.'
    printf '%s\n' "$msg" >&2
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title "Google Antigravity" --error "$msg" >/dev/null 2>&1 || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send -a "DevOS" -i "dialog-error" "Google Antigravity" "$msg" || true
    fi
    exit 127
fi

DATA_DIR="${HOME}/.config/Antigravity"
EXT_DIR="${HOME}/.antigravity/extensions"
mkdir -p "$DATA_DIR" "$EXT_DIR"

# DevOS disables KWallet; force basic store so the KDE keyring toast stays off.
argv_json="${DATA_DIR}/argv.json"
if [ ! -f "$argv_json" ] || ! grep -q '"password-store"[[:space:]]*:[[:space:]]*"basic"' "$argv_json" 2>/dev/null; then
    printf '%s\n' '{ "password-store": "basic" }' > "$argv_json"
fi
export ELECTRON_PASSWORD_STORE=basic
rm -f "${HOME}/.gemini/cache/antigravity-keyring-unavailable"

flags=(
    --ozone-platform=x11
    --enable-gpu-rasterization
    --enable-zero-copy
    --password-store=basic
    --user-data-dir="${DATA_DIR}"
    --extensions-dir="${EXT_DIR}"
    --class=antigravity
    --name=antigravity
)
if [[ "${1:-}" == --software-rendering ]]; then
    flags+=(--disable-gpu)
    shift
fi
exec "$binary" "${flags[@]}" "$@"
