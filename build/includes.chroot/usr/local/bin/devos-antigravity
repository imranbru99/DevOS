#!/usr/bin/env bash
# Use the verified XWayland path for the Antigravity desktop hub.
# Keep the vendor sandbox, profile, credentials and GPU acceleration intact.
set -euo pipefail
binary=/opt/antigravity/antigravity
if [[ ! -x "$binary" ]]; then
    printf '%s\n' 'Antigravity is not installed at /opt/antigravity/antigravity.' >&2
    exit 127
fi
flags=(--ozone-platform=x11)
if [[ "${1:-}" == --software-rendering ]]; then
    flags+=(--disable-gpu)
    shift
fi
exec "$binary" "${flags[@]}" "$@"
