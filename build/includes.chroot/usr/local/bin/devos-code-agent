#!/bin/bash
# DevOS AI Code Agent: a coding agent on the local DevOS AI model.
#   devos-code-agent [folder]        open the window
#   devos-code-agent --cli "task"    run in this terminal with y/n approvals
# Redirects to devos-ai-code-agent
if command -v devos-ai-code-agent >/dev/null 2>&1; then
    exec devos-ai-code-agent "$@"
fi
HERE="$(dirname "$0")"
if [ -x "${HERE}/devos-ai-code-agent" ]; then
    exec "${HERE}/devos-ai-code-agent" "$@"
fi
exec /usr/local/bin/devos-ai-code-agent "$@"
