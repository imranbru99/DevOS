#!/usr/bin/env bash
# Upload, download, Open, and Open Folder dialogs use File Explorer.
# Safe to re-run. Does not need a reboot.
set -euo pipefail

CONF='[preferred]
# Secret stays empty: default=kde would otherwise load KWallet and exit 255.
default=kde
org.freedesktop.impl.portal.FileChooser=devos;kde;gtk;
org.freedesktop.impl.portal.Settings=kde;gtk;
org.freedesktop.impl.portal.Secret=
'

echo "== File dialogs use File Explorer =="
mkdir -p "${HOME}/.config/xdg-desktop-portal"
printf '%s\n' "$CONF" > "${HOME}/.config/xdg-desktop-portal/portals.conf"
printf '%s\n' "$CONF" > "${HOME}/.config/xdg-desktop-portal/kde-portals.conf"
cp -f "${HOME}/.config/xdg-desktop-portal/portals.conf" \
  "${HOME}/.config/xdg-desktop-portal.conf" 2>/dev/null || true

if [ "$(id -u)" -eq 0 ]; then
  mkdir -p /etc/xdg/xdg-desktop-portal
  printf '%s\n' "$CONF" > /etc/xdg/xdg-desktop-portal/portals.conf
  printf '%s\n' "$CONF" > /etc/xdg/xdg-desktop-portal/kde-portals.conf
else
  sudo mkdir -p /etc/xdg/xdg-desktop-portal
  printf '%s\n' "$CONF" | sudo tee /etc/xdg/xdg-desktop-portal/portals.conf >/dev/null
  printf '%s\n' "$CONF" | sudo tee /etc/xdg/xdg-desktop-portal/kde-portals.conf >/dev/null
fi

echo "== Start the File Explorer dialog service =="
systemctl --user unmask devos-portal-filechooser.service 2>/dev/null || true
systemctl --user daemon-reload 2>/dev/null || true
systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS XAUTHORITY 2>/dev/null || true
systemctl --user enable devos-portal-filechooser.service 2>/dev/null || true
systemctl --user restart devos-portal-filechooser.service 2>/dev/null || true
systemctl --user restart xdg-desktop-portal.service 2>/dev/null || true
sleep 1

if [ -x /usr/local/bin/devos-files ]; then
  echo "  File Explorer: /usr/local/bin/devos-files"
else
  echo "  File Explorer program is missing at /usr/local/bin/devos-files"
fi
if systemctl --user is-active --quiet devos-portal-filechooser.service; then
  echo "  Dialog service: running"
else
  echo "  Dialog service did not stay running. Check: journalctl --user -u devos-portal-filechooser -n 30 --no-pager"
fi

echo
echo "Close the app that showed the old Open window, then try Upload or Open Folder again."
echo "The window should be File Explorer, with This PC in the address bar."
