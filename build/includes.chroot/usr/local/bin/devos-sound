        l_in.addWidget(self.mic_test_level)
        self.usb_check = QProcess(self)
        self.usb_check.finished.connect(self._usb_check_finished)
        self.usb_check.errorOccurred.connect(self._usb_check_error)
        self.btn_check_usb = QPushButton("Check USB microphone")
