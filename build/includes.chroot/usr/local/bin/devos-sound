        self.source_button_group = QButtonGroup(self)
        self.source_layout = QVBoxLayout()
        self.source_layout.setSpacing(8)
        l_in.addLayout(self.source_layout)

        # Input volume slider row
        row_in_vol = QHBoxLayout()
        row_in_vol.setSpacing(12)

        self.btn_source_mute = QPushButton()
