    def _start_mic_test(self):
        self.btn_test_mic.setEnabled(False)
        self.mic_test_level.setValue(0)
        self._tested_input_label = self._active_input_label
        self.mic_test_status.setText(f"Speak now into {self._tested_input_label}…")
        self.mic_test.start("/usr/bin/python3", [
            "/usr/local/share/devos/components/audio/microphone_test.py",
            self._active_input_name,
        ])

    def _mic_test_error(self, error):
        if error == QProcess.FailedToStart:
            self._mic_test_finished(1)

    def _mic_test_finished(self, code, _status=None):
        self.btn_test_mic.setEnabled(True)
        output = bytes(self.mic_test.readAllStandardOutput()).strip()
        if code != 0 or not output.isdigit():
            self.mic_test_status.setText("The input could not be opened. Check the connection and close other apps using the microphone.")
            return
        level = int(output)
        self.mic_test_level.setValue(level)
        self.mic_test_status.setText(f"Sound detected on {self._tested_input_label}." if level else
                                     f"No signal on {self._tested_input_label}. Check mute or select another input above.")

    def _check_usb_mic(self):
        self.btn_check_usb.setEnabled(False)
        self.usb_status.setText("Checking the USB connection and recording inputs…")
        self.usb_check.start("/usr/local/bin/devos-audio-defaults", ["check-usb-input"])

    def _usb_check_error(self, error):
        if error == QProcess.FailedToStart:
            self._usb_check_finished(1)

    def _usb_check_finished(self, code, _status=None):
        self.btn_check_usb.setEnabled(True)
        message = bytes(self.usb_check.readAllStandardOutput()).decode("utf-8", errors="replace").strip()
        self.usb_status.setText(message if code == 0 and message else "Could not check USB audio. Try again after reconnecting the microphone.")

    def closeEvent(self, event):
        for process in (self.mic_test, self.usb_check):
            if process.state() != QProcess.NotRunning:
                process.kill()
                process.waitForFinished(1000)
        super().closeEvent(event)

    def refresh_audio_state(self):
        """Polls PipeWire state and refreshes UI widgets."""
        if self._updating:
            return

        self._updating = True
        try:
            state = AudioManager.get_audio_state()

            # Master volume & mute
            mv = state.get("master_volume", 50)
            muted = state.get("master_muted", False)
            self.slider_master.setValue(mv)
            self.lbl_master_pct.setText(f"{mv}%")
            if muted or mv == 0:
                self.btn_master_mute.setIcon(make_vector_sound_icon("volume-muted", 18))
            elif mv < 33:
                self.btn_master_mute.setIcon(make_vector_sound_icon("volume-low", 18))
            elif mv < 66:
                self.btn_master_mute.setIcon(make_vector_sound_icon("volume-medium", 18))
            else:
                self.btn_master_mute.setIcon(make_vector_sound_icon("volume-high", 18))

            # Sinks list
            # Clear old buttons
            while self.sink_layout.count():
                child = self.sink_layout.takeAt(0)
                if child.widget():
                    child.widget().deleteLater()

            def_sink = state.get("default_sink", "")
            for s in state.get("sinks", []):
                s_name = s.get("name", "")
                s_desc = s.get("desc", s_name)
                rb = QRadioButton(s_desc)
                if s_name == def_sink or len(state["sinks"]) == 1:
                    rb.setChecked(True)
                rb.toggled.connect(lambda checked, name=s_name: self._on_sink_selected(name, checked))
                self.sink_button_group.addButton(rb)
                self.sink_layout.addWidget(rb)

            if not state.get("sinks"):
                lbl_none = QLabel("No output devices detected")
                lbl_none.setStyleSheet("color: #64748b; font-style: italic;")
                self.sink_layout.addWidget(lbl_none)

            # Sources list (Inputs)
            while self.source_layout.count():
                child = self.source_layout.takeAt(0)
                if child.widget():
                    child.widget().deleteLater()

            def_source = state.get("default_source", "")
            self._active_input_name = def_source
            self._active_input_label = next((source["desc"] for source in state.get("sources", [])
                                             if source.get("name") == def_source and source.get("desc")), "the default input")
            for src in state.get("sources", []):
                src_name = src.get("name", "")
                src_desc = src.get("desc", src_name)
                rb = QRadioButton(src_desc)
                if src_name == def_source or len(state["sources"]) == 1:
                    rb.setChecked(True)
                rb.toggled.connect(lambda checked, name=src_name: self._on_source_selected(name, checked))
                self.source_button_group.addButton(rb)
                self.source_layout.addWidget(rb)

            if not state.get("sources"):
                lbl_none = QLabel("No microphone / recording devices detected")
                lbl_none.setStyleSheet("color: #64748b; font-style: italic;")
                self.source_layout.addWidget(lbl_none)

            # Apps volume mixer
            while self.apps_layout.count():
                child = self.apps_layout.takeAt(0)
                if child.widget():
                    child.widget().deleteLater()

            apps = state.get("apps", [])
            if not apps:
                lbl_no_apps = QLabel("No apps are currently playing audio.")
                lbl_no_apps.setStyleSheet("color: #64748b; font-style: italic; font-size: 12px; margin: 6px 0;")
                self.apps_layout.addWidget(lbl_no_apps)
            else:
                for app in apps:
                    row = QHBoxLayout()
                    app_id = app.get("id")
                    app_name = app.get("name", "Audio Stream")
                    app_vol = app.get("volume", 100)
                    app_mute = app.get("mute", False)

                    lbl_name = QLabel(app_name)
                    lbl_name.setStyleSheet("font-size: 13px; font-weight: 500; min-width: 140px;")
                    row.addWidget(lbl_name)

                    btn_app_mute = QPushButton()
                    btn_app_mute.setFixedSize(30, 26)
                    btn_app_mute.setIcon(make_vector_sound_icon("volume-muted" if app_mute else "volume-high", 14))
                    btn_app_mute.clicked.connect(lambda _, aid=app_id, m=app_mute: self._on_app_mute_toggle(aid, not m))
                    row.addWidget(btn_app_mute)

                    slider_app = QSlider(Qt.Horizontal)
                    slider_app.setRange(0, 100)
                    slider_app.setValue(app_vol)
                    slider_app.valueChanged.connect(lambda val, aid=app_id: AudioManager.set_app_volume(aid, val))
                    row.addWidget(slider_app, 1)

                    lbl_pct = QLabel(f"{app_vol}%")
                    lbl_pct.setStyleSheet("font-size: 12px; min-width: 38px;")
                    slider_app.valueChanged.connect(lambda val, l=lbl_pct: l.setText(f"{val}%"))
                    row.addWidget(lbl_pct)

                    self.apps_layout.addLayout(row)

        finally:
            self._updating = False

    def _on_master_slider_changed(self, value):
        if self._updating:
            return
        self.lbl_master_pct.setText(f"{value}%")
        AudioManager.set_master_volume(value)

    def _on_toggle_master_mute(self):
        AudioManager.toggle_master_mute()
        self.refresh_audio_state()

    def _on_sink_selected(self, name: str, checked: bool):
        if checked and not self._updating and AudioManager.set_default_sink(name):
            self._remember_device(name, output=True)

    def _on_source_slider_changed(self, value):
        if self._updating:
            return
        self.lbl_source_pct.setText(f"{value}%")
        AudioManager.set_source_volume(value)

    def _on_toggle_source_mute(self):
        # Toggle source mute
        state = AudioManager.get_audio_state()
        cur_mute = False
        for src in state.get("sources", []):
            if src.get("name") == state.get("default_source"):
                cur_mute = src.get("mute", False)
                break
        AudioManager.set_source_mute(not cur_mute)
        self.refresh_audio_state()

    def _on_source_selected(self, name: str, checked: bool):
        if checked and not self._updating and AudioManager.set_default_source(name):
            self._remember_device(name)
            self.refresh_audio_state()

    @staticmethod
    def _remember_device(name: str, output=False):
        sys.path.insert(0, "/usr/local/share/devos/components")
        try:
            from audio.mic_defaults import prefer_sink, prefer_source
            remember = prefer_sink if output else prefer_source
            remember(name, make_system_default=False)
        except (ImportError, OSError):
            pass
        finally:
            sys.path.pop(0)

    def _on_app_mute_toggle(self, app_id: str, new_mute: bool):
        AudioManager.set_app_mute(app_id, new_mute)
        self.refresh_audio_state()

    def _reset_all_apps(self):
        state = AudioManager.get_audio_state()
        for app in state.get("apps", []):
            AudioManager.set_app_volume(app["id"], 100)
            AudioManager.set_app_mute(app["id"], False)
        self.refresh_audio_state()

    def _open_advanced_mixer(self):
        for cmd in [["pavucontrol-qt"], ["pavucontrol"], ["kcmshell6", "kcm_pulseaudio"]]:
            if shutil.which(cmd[0]):
                subprocess.Popen(cmd)
                return


# ============================================================================
# WINDOWS 11 VOLUME FLYOUT (Taskbar Quick Popup)
# ============================================================================

class WindowsVolumeFlyout(QWidget):
    """Windows 11 Quick Volume & Device Flyout above System Tray."""

    def __init__(self, parent=None):
        super().__init__(parent, Qt.Tool | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint)
        self.setAttribute(Qt.WA_TranslucentBackground)
        self.setFixedSize(360, 200)

        self._setup_ui()
        self._updating = False
        self._was_active = False

    def changeEvent(self, event):
        from PyQt5.QtCore import QEvent
        if event.type() == QEvent.ActivationChange:
            if self.isActiveWindow():
                self._was_active = True
            elif self._was_active:
                self.hide()
                self._was_active = False
        super().changeEvent(event)

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape:
            self.hide()
        else:
            super().keyPressEvent(event)

    def _setup_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(12, 12, 12, 12)

        self.card = FluentCard(self)
        self.card.setStyleSheet("""
            FluentCard {
                background-color: rgba(36, 36, 36, 0.95);
                border: 1px solid rgba(255, 255, 255, 0.12);
                border-radius: 10px;
            }
            QLabel {
                color: #ffffff;
                font-family: 'Segoe UI', 'Inter', sans-serif;
            }
            QSlider::groove:horizontal {
                height: 4px;
                background: #475569;
                border-radius: 2px;
            }
            QSlider::sub-page:horizontal {
                background: #60cdff;
                border-radius: 2px;
            }
            QSlider::handle:horizontal {
                background: #ffffff;
                border: 2px solid #60cdff;
                width: 16px;
                margin-top: -6px;
                margin-bottom: -6px;
                border-radius: 8px;
            }
            QPushButton {
                background-color: #383838;
                color: #f1f5f9;
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 4px;
                padding: 5px 10px;
                font-size: 12px;
            }
            QPushButton:hover {
                background-color: #444444;
            }
        """)

        card_layout = QVBoxLayout(self.card)
        card_layout.setContentsMargins(16, 14, 16, 14)
        card_layout.setSpacing(12)

        # Header: Device Name
        row_top = QHBoxLayout()
        self.lbl_device = QLabel("Speakers (Built-in Audio)")
        self.lbl_device.setStyleSheet("font-size: 13px; font-weight: 600; color: #f1f5f9;")
        row_top.addWidget(self.lbl_device, 1)

        btn_chime = QPushButton()
        btn_chime.setFixedSize(28, 26)
        btn_chime.setIcon(make_vector_sound_icon("play", 12))
        btn_chime.setToolTip("Test sound")
        btn_chime.clicked.connect(AudioManager.play_chime)
        row_top.addWidget(btn_chime)
        card_layout.addLayout(row_top)

        # Volume slider row
        row_vol = QHBoxLayout()
        row_vol.setSpacing(10)

        self.btn_mute = QPushButton()
        self.btn_mute.setFixedSize(36, 32)
        self.btn_mute.setIcon(make_vector_sound_icon("volume-high", 18))
        self.btn_mute.clicked.connect(self._on_mute_clicked)
        row_vol.addWidget(self.btn_mute)

        self.slider = QSlider(Qt.Horizontal)
        self.slider.setRange(0, 100)
        self.slider.setValue(50)
        self.slider.valueChanged.connect(self._on_slider_changed)
        row_vol.addWidget(self.slider, 1)

        self.lbl_pct = QLabel("50%")
        self.lbl_pct.setStyleSheet("font-size: 13px; font-weight: 600; min-width: 38px;")
        row_vol.addWidget(self.lbl_pct)
        card_layout.addLayout(row_vol)

        # Bottom footer: Link to more sound settings
        row_foot = QHBoxLayout()
        btn_more = QPushButton("Sound settings")
        btn_more.setIcon(make_vector_sound_icon("settings", 14))
        btn_more.clicked.connect(self._open_full_settings)
        row_foot.addWidget(btn_more)
        row_foot.addStretch(1)
        card_layout.addLayout(row_foot)

        layout.addWidget(self.card)

    def refresh_data(self):
        self._updating = True
        try:
            state = AudioManager.get_audio_state()
            state = AudioManager.enforce_volume_protection(state)
            mv = state.get("master_volume", 50)
            muted = state.get("master_muted", False)
            self.slider.setValue(mv)
            self.lbl_pct.setText(f"{mv}%")
            if muted or mv == 0:
                self.btn_mute.setIcon(make_vector_sound_icon("volume-muted", 18))
            elif mv < 33:
                self.btn_mute.setIcon(make_vector_sound_icon("volume-low", 18))
            elif mv < 66:
                self.btn_mute.setIcon(make_vector_sound_icon("volume-medium", 18))
            else:
                self.btn_mute.setIcon(make_vector_sound_icon("volume-high", 18))

            # Current default sink name
            def_sink = state.get("default_sink", "")
            for s in state.get("sinks", []):
                if s.get("name") == def_sink:
                    self.lbl_device.setText(s.get("desc", s.get("name", "Default Audio")))
                    break
        finally:
            self._updating = False

    def _on_slider_changed(self, value):
        if self._updating:
            return
        self.lbl_pct.setText(f"{value}%")
        AudioManager.set_master_volume(value)

    def _on_mute_clicked(self):
        AudioManager.toggle_master_mute()
        self.refresh_data()

    def _open_full_settings(self):
        self.hide()
        DevOSSoundTray.instance().show_settings_window()


# ============================================================================
# SYSTEM TRAY CONTROLLER
# ============================================================================

class DevOSSoundTray(QObject):
    """System Tray Icon with quick flyout and menu."""

    _instance = None

    @classmethod
    def instance(cls):
        return cls._instance

    def __init__(self, app: QApplication):
        super().__init__()
        DevOSSoundTray._instance = self
        self.app = app
        self.tray = QSystemTrayIcon(self)
        self.flyout = WindowsVolumeFlyout()
        self.settings_window = None

        # Restore last known volume on tray daemon startup
        try:
            AudioManager.restore_tracked_state()
        except Exception:
            pass

        self._setup_tray()

        # Update timer
        self.timer = QTimer(self)
        self.timer.setInterval(1500)
        self.timer.timeout.connect(self.update_tray_icon)
        self.timer.start()

        self.update_tray_icon()

    def _setup_tray(self):
        menu = QMenu()
        menu.setStyleSheet("""
            QMenu {
                background-color: #2b2b2b;
                color: #ffffff;
                border: 1px solid rgba(255, 255, 255, 0.12);
                border-radius: 6px;
                padding: 4px;
            }
            QMenu::item {
                padding: 6px 20px;
                border-radius: 4px;
            }
            QMenu::item:selected {
                background-color: #0078d4;
            }
        """)

        act_settings = menu.addAction(make_vector_sound_icon("volume-high", 16), "Sound Settings")
        act_settings.triggered.connect(self.show_settings_window)

        act_mute = menu.addAction(make_vector_sound_icon("volume-muted", 16), "Mute / Unmute")
        act_mute.triggered.connect(self._toggle_mute)

        menu.addSeparator()

        act_quit = menu.addAction("Exit Sound Tray")
        act_quit.triggered.connect(self.app.quit)

        self.tray.setContextMenu(menu)
        self.tray.activated.connect(self._on_tray_activated)
        self.update_tray_icon()
        self.tray.show()

    def _on_tray_activated(self, reason):
        if reason in (QSystemTrayIcon.Trigger, QSystemTrayIcon.DoubleClick):
            # Left click -> Toggle flyout
            if self.flyout.isVisible():
                self.flyout.hide()
            else:
                self.flyout.refresh_data()
                # Position above tray or bottom right
                geo = self.tray.geometry()
                screen = QApplication.primaryScreen().availableGeometry()
                if geo.isValid() and geo.x() > 0:
                    x = max(10, min(geo.x() - self.flyout.width() // 2, screen.width() - self.flyout.width() - 10))
                    y = max(10, geo.y() - self.flyout.height() - 10)
                else:
                    x = screen.width() - self.flyout.width() - 20
                    y = screen.height() - self.flyout.height() - 50
                self.flyout.move(x, y)
                self.flyout.show()
                self.flyout.raise_()
                self.flyout.activateWindow()

    def _toggle_mute(self):
        AudioManager.toggle_master_mute()
        self.update_tray_icon()

    def update_tray_icon(self):
        state = AudioManager.get_audio_state()
        state = AudioManager.enforce_volume_protection(state)
        mv = state.get("master_volume", 50)
        muted = state.get("master_muted", False)

        if muted or mv == 0:
            theme_name = "audio-volume-muted"
            icon_name = "volume-muted"
        elif mv < 33:
            theme_name = "audio-volume-low"
            icon_name = "volume-low"
        elif mv < 66:
            theme_name = "audio-volume-medium"
            icon_name = "volume-medium"
        else:
            theme_name = "audio-volume-high"
            icon_name = "volume-high"

        self.tray.setIcon(QIcon.fromTheme(theme_name, make_vector_sound_icon(icon_name, 22, "#ffffff")))
        status_text = "Muted" if muted else f"Volume: {mv}%"
        self.tray.setToolTip(f"Sound - {status_text}")

    def show_settings_window(self):
        if not self.settings_window:
            self.settings_window = WindowsSoundSettingsWindow()
        self.settings_window.show()
        self.settings_window.raise_()
        self.settings_window.activateWindow()


# ============================================================================
# MAIN ENTRYPOINT & CLI
# ============================================================================

def main():
    parser = argparse.ArgumentParser(description="DevOS Windows 11 Sound Settings & Volume Hub")
    parser.add_argument("--tray", action="store_true", help="Launch as resident system tray icon")
    parser.add_argument("--volume", type=int, help="Set master volume level (0-100)")
    parser.add_argument("--mute", action="store_true", help="Mute master audio")
    parser.add_argument("--unmute", action="store_true", help="Unmute master audio")
    parser.add_argument("--toggle-mute", action="store_true", help="Toggle master audio mute")
    parser.add_argument("--status", action="store_true", help="Print audio status JSON and exit")
    parser.add_argument("--test", action="store_true", help="Play test sound chime and exit")
    parser.add_argument("--restore", "--restore-volume", dest="restore", action="store_true", help="Restore last tracked volume level")

    args = parser.parse_args()

    if args.status:
        print(json.dumps(AudioManager.get_audio_state(), indent=2))
        return

    if args.restore:
        state = AudioManager.restore_tracked_state()
        print(f"Restored master volume to {state.get('master_volume')}% (Muted: {state.get('master_muted')})")
        return

    if args.test:
        AudioManager.play_chime()
        return

    if args.volume is not None:
        AudioManager.set_master_volume(args.volume)
        print(f"Volume set to {args.volume}%")
        return

    if args.mute:
        AudioManager.set_master_mute(True)
        print("Audio muted")
        return

    if args.unmute:
        AudioManager.set_master_mute(False)
        print("Audio unmuted")
        return

    if args.toggle_mute:
        AudioManager.toggle_master_mute()
        print("Audio mute toggled")
        return

    # GUI Mode
    app = QApplication(sys.argv)
    # Stable StatusNotifier Id so Plasma can hide this under ^ (not the panel).
    app.setApplicationName("devos-sound")
    app.setApplicationDisplayName("Sound")
    if hasattr(app, "setDesktopFileName"):
        app.setDesktopFileName("devos-sound")
    # Dark-authored chrome → light/dark via shared adapter (was stuck dark).
    for components_dir in (
        os.path.expanduser("~/.local/share/devos/components"),
        "/usr/local/share/devos/components",
    ):
        if os.path.isfile(os.path.join(components_dir, "devos_appearance.py")):
            if components_dir not in sys.path:
                sys.path.insert(0, components_dir)
            try:
                from devos_appearance import install as install_appearance
                install_appearance(app)
            except Exception:
                pass
            break
    app.setQuitOnLastWindowClosed(not args.tray)

    if args.tray:
        tray_ctl = DevOSSoundTray(app)
        sys.exit(app.exec_())
    else:
        try:
            AudioManager.restore_tracked_state()
        except Exception:
            pass
        win = WindowsSoundSettingsWindow()
        try:
            from app_identity import show_window
            show_window(win, "devos-sound")
        except Exception:
            from PyQt5.QtCore import Qt
            win.setWindowFlags(
                Qt.Window | Qt.WindowTitleHint | Qt.WindowSystemMenuHint
                | Qt.WindowMinMaxButtonsHint | Qt.WindowCloseButtonHint
            )
            win.show()
        sys.exit(app.exec_())


if __name__ == "__main__":
    main()
