#!/usr/bin/env python3
"""
DevOS Sound Manager & Volume Controller (Windows 11 Fluent Sound Hub)
Provides:
  - Windows 11 System > Sound settings interface
  - Output & Input device selection (HDMI, Speakers, Headphones, Microphones)
  - Master volume slider, mute toggle, and audio test chime
  - Windows 11 Volume Mixer (per-application volume controls)
  - Resident System Tray icon with Windows 11 quick volume flyout
"""

import argparse
import json
import math
import os
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import time
from typing import Dict, List, Optional, Any

from PyQt5.QtCore import Qt, QProcess, QTimer, QSize, QPoint, pyqtSignal, QObject
from PyQt5.QtGui import (
    QColor, QIcon, QPainter, QPainterPath, QPen, QFont, QPalette, QBrush
)
from PyQt5.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout, QLabel,
    QSlider, QPushButton, QRadioButton, QButtonGroup, QFrame, QScrollArea,
    QSystemTrayIcon, QMenu, QAction, QDialog, QProgressBar, QSizePolicy
)


# ============================================================================
# VECTOR ICONS GENERATOR (Crisp Windows 11 Style)
# ============================================================================

def make_vector_sound_icon(name: str, size: int = 24, color: str = "#ffffff") -> QIcon:
    pix = QPixmap = None
    from PyQt5.QtGui import QPixmap
    pix = QPixmap(size, size)
    pix.fill(Qt.transparent)
    p = QPainter(pix)
    p.setRenderHint(QPainter.Antialiasing)

    qc = QColor(color)
    scale = size / 24.0

    if name in ("volume-high", "volume-medium", "volume-low", "volume-zero", "volume-muted"):
        # Speaker body
        body = QPainterPath()
        body.moveTo(4 * scale, 9 * scale)
        body.lineTo(8 * scale, 9 * scale)
        body.lineTo(13 * scale, 5 * scale)
        body.lineTo(13 * scale, 19 * scale)
        body.lineTo(8 * scale, 15 * scale)
        body.lineTo(4 * scale, 15 * scale)
        body.closeSubpath()
        p.fillPath(body, qc)

        p.setPen(QPen(qc, 1.8 * scale, Qt.SolidLine, Qt.RoundCap))
        if name == "volume-high":
            # 3 arcs
            p.drawArc(int(10 * scale), int(9 * scale), int(6 * scale), int(6 * scale), -45 * 16, 90 * 16)
            p.drawArc(int(9 * scale), int(6 * scale), int(11 * scale), int(12 * scale), -45 * 16, 90 * 16)
            p.drawArc(int(8 * scale), int(3 * scale), int(16 * scale), int(18 * scale), -45 * 16, 90 * 16)
        elif name == "volume-medium":
            p.drawArc(int(10 * scale), int(9 * scale), int(6 * scale), int(6 * scale), -45 * 16, 90 * 16)
            p.drawArc(int(9 * scale), int(6 * scale), int(11 * scale), int(12 * scale), -45 * 16, 90 * 16)
        elif name == "volume-low":
            p.drawArc(int(10 * scale), int(9 * scale), int(6 * scale), int(6 * scale), -45 * 16, 90 * 16)
        elif name == "volume-muted":
            p.setPen(QPen(QColor("#f87171"), 2.0 * scale, Qt.SolidLine, Qt.RoundCap))
            p.drawLine(int(16 * scale), int(8 * scale), int(21 * scale), int(16 * scale))
            p.drawLine(int(21 * scale), int(8 * scale), int(16 * scale), int(16 * scale))

    elif name == "mic":
        p.setPen(QPen(qc, 1.8 * scale, Qt.SolidLine, Qt.RoundCap))
        # Capsule
        p.drawRoundedRect(int(9 * scale), int(4 * scale), int(6 * scale), int(10 * scale), 3 * scale, 3 * scale)
        # Stand arc
        p.drawArc(int(7 * scale), int(7 * scale), int(10 * scale), int(10 * scale), -180 * 16, 180 * 16)
        # Vertical post
        p.drawLine(int(12 * scale), int(17 * scale), int(12 * scale), int(20 * scale))
        # Base
        p.drawLine(int(9 * scale), int(20 * scale), int(15 * scale), int(20 * scale))

    elif name == "mic-muted":
        p.setPen(QPen(qc, 1.8 * scale, Qt.SolidLine, Qt.RoundCap))
        p.drawRoundedRect(int(9 * scale), int(4 * scale), int(6 * scale), int(10 * scale), 3 * scale, 3 * scale)
        p.drawArc(int(7 * scale), int(7 * scale), int(10 * scale), int(10 * scale), -180 * 16, 180 * 16)
        p.drawLine(int(12 * scale), int(17 * scale), int(12 * scale), int(20 * scale))
        p.setPen(QPen(QColor("#f87171"), 2.0 * scale, Qt.SolidLine, Qt.RoundCap))
        p.drawLine(int(5 * scale), int(5 * scale), int(19 * scale), int(19 * scale))

    elif name == "play":
        path = QPainterPath()
        path.moveTo(8 * scale, 5 * scale)
        path.lineTo(19 * scale, 12 * scale)
        path.lineTo(8 * scale, 19 * scale)
        path.closeSubpath()
        p.fillPath(path, qc)

    elif name == "mixer":
        p.setPen(QPen(qc, 2.0 * scale, Qt.SolidLine, Qt.RoundCap))
        p.drawLine(int(6 * scale), int(4 * scale), int(6 * scale), int(20 * scale))
        p.drawLine(int(12 * scale), int(4 * scale), int(12 * scale), int(20 * scale))
        p.drawLine(int(18 * scale), int(4 * scale), int(18 * scale), int(20 * scale))
        p.setBrush(QBrush(qc))
        p.setPen(Qt.NoPen)
        p.drawEllipse(int(4 * scale), int(12 * scale), int(4 * scale), int(4 * scale))
        p.drawEllipse(int(10 * scale), int(7 * scale), int(4 * scale), int(4 * scale))
        p.drawEllipse(int(16 * scale), int(15 * scale), int(4 * scale), int(4 * scale))

    elif name == "settings":
        p.setPen(QPen(qc, 1.8 * scale))
        p.drawEllipse(int(8 * scale), int(8 * scale), int(8 * scale), int(8 * scale))
        for angle in range(0, 360, 45):
            rad = math.radians(angle)
            x1 = 12 * scale + 8 * scale * math.cos(rad)
            y1 = 12 * scale + 8 * scale * math.sin(rad)
            x2 = 12 * scale + 10.5 * scale * math.cos(rad)
            y2 = 12 * scale + 10.5 * scale * math.sin(rad)
            p.drawLine(int(x1), int(y1), int(x2), int(y2))

    p.end()
    return QIcon(pix)


# ============================================================================
# AUDIO BACKEND (PipeWire & PulseAudio via pactl / wpctl)
# ============================================================================

STATE_DIR = os.path.expanduser("~/.config/devos")
DEFAULT_STATE_FILE = os.path.join(STATE_DIR, "sound_state.json")


class AudioManager:
    """Communicates directly with PipeWire / PulseAudio with persistent volume tracking."""

    _last_checked_sink: str = ""
    _last_user_action_time: float = 0.0

    @classmethod
    def get_state_file_path(cls) -> str:
        return os.environ.get("DEVOS_AUDIO_STATE_FILE", DEFAULT_STATE_FILE)

    @classmethod
    def load_tracked_state(cls) -> Dict[str, Any]:
        """Loads persistent audio state from disk."""
        path = cls.get_state_file_path()
        default_state = {
            "master_volume": 40,
            "master_muted": False,
            "default_sink": "",
            "default_source": "",
            "source_volume": 100,
            "source_muted": False,
            "device_volumes": {},
            "device_mutes": {},
            "last_user_set_time": 0.0,
        }
        if not os.path.exists(path):
            return default_state
        try:
            with open(path, "r", encoding="utf-8") as f:
                data = json.load(f)
                if isinstance(data, dict):
                    default_state.update(data)
        except Exception:
            pass
        return default_state

    @classmethod
    def save_tracked_state(cls, updates: Dict[str, Any]) -> None:
        """Atomically saves persistent audio state to disk."""
        current = cls.load_tracked_state()
        current.update(updates)
        path = cls.get_state_file_path()
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            tmp_path = path + f".tmp.{os.getpid()}"
            with open(tmp_path, "w", encoding="utf-8") as f:
                json.dump(current, f, indent=2)
            os.replace(tmp_path, path)
        except Exception:
            pass

    @classmethod
    def restore_tracked_state(cls) -> Dict[str, Any]:
        """Restores the last known user volume preferences to current audio sink."""
        tracked = cls.load_tracked_state()
        state = cls.get_audio_state()
        cur_sink = state.get("default_sink", "")

        dev_vols = tracked.get("device_volumes", {})
        dev_mutes = tracked.get("device_mutes", {})

        target_vol = dev_vols.get(cur_sink, tracked.get("master_volume", 40))
        target_mute = dev_mutes.get(cur_sink, tracked.get("master_muted", False))

        cls.set_master_volume(target_vol, is_user_action=False)
        cls.set_master_mute(target_mute, is_user_action=False)
        cls._last_checked_sink = cur_sink

        tracked_source = tracked.get("default_source", "")
        if tracked_source:
            sources = state.get("sources", [])
            if any(s.get("name") == tracked_source for s in sources):
                cls.set_default_source(tracked_source)
        return cls.get_audio_state()

    @classmethod
    def enforce_volume_protection(cls, current_state: Dict[str, Any]) -> Dict[str, Any]:
        """
        Anti-jump watchdog & route synchronization:
        1. Protects against rogue apps / WirePlumber auto-spiking volume to 100%.
        2. Detects sink switch (headphones, HDMI, speakers) and applies tracked per-device volume.
        3. Persists legitimate volume adjustments (e.g. keyboard media keys or UI controls).
        """
        tracked = cls.load_tracked_state()
        cur_sink = current_state.get("default_sink", "")
        cur_vol = current_state.get("master_volume", 50)
        cur_muted = current_state.get("master_muted", False)

        tracked_vol = tracked.get("master_volume", 40)
        dev_vols = tracked.get("device_volumes", {})
        sink_tracked_vol = dev_vols.get(cur_sink, tracked_vol)
        last_user_time = max(tracked.get("last_user_set_time", 0.0), cls._last_user_action_time)
        now = time.time()

        # Case 1: Active output sink changed (headphones plugged/unplugged, HDMI connected)
        if cur_sink and cur_sink != cls._last_checked_sink:
            cls._last_checked_sink = cur_sink
            target_vol = dev_vols.get(cur_sink, tracked_vol)
            cls.set_master_volume(target_vol, is_user_action=False)
            current_state["master_volume"] = target_vol
            return current_state

        # Case 2: Rogue 100% Volume Jump detected!
        # If master jumped to 100%, but user preference is < 95%, and user didn't explicitly request 100% in the last 3.5s
        if cur_vol == 100 and sink_tracked_vol < 95 and (now - last_user_time) > 3.5:
            # Auto-clamp back to user preference
            cls.set_master_volume(sink_tracked_vol, is_user_action=False)
            current_state["master_volume"] = sink_tracked_vol
            return current_state

        # Case 3: Legitimate external volume change (keyboard Fn keys, pactl, etc.)
        # Ignore 0-1% idle glitches, and ignore 100% unless user explicitly set it
        if 1 < cur_vol < 100 and cur_vol != sink_tracked_vol and (now - last_user_time) > 1.0:
            dev_vols[cur_sink] = cur_vol
            cls.save_tracked_state({
                "master_volume": cur_vol,
                "device_volumes": dev_vols,
            })

        # Track external mute changes
        if cur_muted != tracked.get("master_muted", False) and (now - last_user_time) > 1.0:
            dev_mutes = tracked.get("device_mutes", {})
            dev_mutes[cur_sink] = cur_muted
            cls.save_tracked_state({
                "master_muted": cur_muted,
                "device_mutes": dev_mutes,
            })

        return current_state

    @staticmethod
    def get_audio_state() -> Dict[str, Any]:
        """Collects all sinks (outputs), sources (inputs), and running apps."""
        state = {
            "sinks": [],
            "sources": [],
            "apps": [],
            "default_sink": "",
            "default_source": "",
            "master_volume": 50,
            "master_muted": False,
        }

        # Query defaults
        try:
            info_out = subprocess.check_output(["pactl", "info"], text=True, stderr=subprocess.DEVNULL)
            for line in info_out.splitlines():
                if "Default Sink:" in line:
                    state["default_sink"] = line.split("Default Sink:")[1].strip()
                elif "Default Source:" in line:
                    state["default_source"] = line.split("Default Source:")[1].strip()
        except Exception:
            pass

        # Query sinks
        try:
            sinks_out = subprocess.check_output(["pactl", "list", "sinks"], text=True, stderr=subprocess.DEVNULL)
            current = {}
            for line in sinks_out.splitlines():
                line = line.strip()
                if line.startswith("Sink #"):
                    if current:
                        state["sinks"].append(current)
                    current = {"id": line.split("#")[1].strip()}
                elif line.startswith("Name:"):
                    current["name"] = line.split("Name:")[1].strip()
                elif line.startswith("Description:"):
                    current["desc"] = line.split("Description:")[1].strip()
                elif line.startswith("Volume:") and "volume" not in current:
                    m = re.search(r"(\d+)%", line)
                    current["volume"] = int(m.group(1)) if m else 50
                elif line.startswith("Mute:"):
                    current["mute"] = "yes" in line.lower()
            if current:
                state["sinks"].append(current)
        except Exception:
            pass

        # Identify master volume
        for s in state["sinks"]:
            if s.get("name") == state["default_sink"] or (not state["default_sink"] and not state.get("found_def")):
                state["master_volume"] = s.get("volume", 50)
                state["master_muted"] = s.get("mute", False)
                state["found_def"] = True
                break

        # Query sources (inputs)
        try:
            sources_out = subprocess.check_output(["pactl", "list", "sources"], text=True, stderr=subprocess.DEVNULL)
            current = {}
            for line in sources_out.splitlines():
                line = line.strip()
                if line.startswith("Source #"):
                    if current and not current.get("name", "").endswith(".monitor"):
                        state["sources"].append(current)
                    current = {"id": line.split("#")[1].strip()}
                elif line.startswith("Name:"):
                    current["name"] = line.split("Name:")[1].strip()
                elif line.startswith("Description:"):
                    current["desc"] = line.split("Description:")[1].strip()
                elif line.startswith("Volume:") and "volume" not in current:
                    m = re.search(r"(\d+)%", line)
                    current["volume"] = int(m.group(1)) if m else 50
                elif line.startswith("Mute:"):
                    current["mute"] = "yes" in line.lower()
            if current and not current.get("name", "").endswith(".monitor"):
                state["sources"].append(current)
        except Exception:
            pass

        # Query active apps (sink-inputs)
        try:
            apps_out = subprocess.check_output(["pactl", "list", "sink-inputs"], text=True, stderr=subprocess.DEVNULL)
            current = {}
            for line in apps_out.splitlines():
                line = line.strip()
                if line.startswith("Sink Input #"):
                    if current:
                        state["apps"].append(current)
                    current = {"id": line.split("#")[1].strip()}
                elif line.startswith("application.name ="):
                    current["name"] = line.split("=")[1].strip(" \"")
                elif line.startswith("application.process.binary ="):
                    current["binary"] = line.split("=")[1].strip(" \"")
                elif line.startswith("Volume:") and "volume" not in current:
                    m = re.search(r"(\d+)%", line)
                    current["volume"] = int(m.group(1)) if m else 100
                elif line.startswith("Mute:"):
                    current["mute"] = "yes" in line.lower()
            if current:
                state["apps"].append(current)
        except Exception:
            pass

        return state

    @classmethod
    def set_master_volume(cls, percent: int, is_user_action: bool = True):
        percent = max(0, min(100, int(percent)))
        try:
            subprocess.run(["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{percent}%"], check=False)
        except Exception:
            pass

        if is_user_action:
            cls._last_user_action_time = time.time()
            tracked = cls.load_tracked_state()
            dev_vols = tracked.get("device_volumes", {})
            state = cls.get_audio_state()
            sink_name = state.get("default_sink", "")
            if sink_name:
                dev_vols[sink_name] = percent
            updates = {
                "master_volume": percent,
                "device_volumes": dev_vols,
                "last_user_set_time": cls._last_user_action_time,
            }
            # Auto-unmute if user increases volume from 0 while muted
            if percent > 0 and state.get("master_muted"):
                updates["master_muted"] = False
                try:
                    subprocess.run(["pactl", "set-sink-mute", "@DEFAULT_SINK@", "0"], check=False)
                except Exception:
                    pass
            cls.save_tracked_state(updates)

    @classmethod
    def set_master_mute(cls, mute: bool, is_user_action: bool = True):
        val = "1" if mute else "0"
        try:
            subprocess.run(["pactl", "set-sink-mute", "@DEFAULT_SINK@", val], check=False)
        except Exception:
            pass

        if not mute:
            state = cls.get_audio_state()
            if state.get("master_volume", 0) == 0:
                tracked = cls.load_tracked_state()
                restore_vol = tracked.get("master_volume", 40)
                if restore_vol > 0:
                    cls.set_master_volume(restore_vol, is_user_action=False)

        if is_user_action:
            cls._last_user_action_time = time.time()
            tracked = cls.load_tracked_state()
            dev_mutes = tracked.get("device_mutes", {})
            state = cls.get_audio_state()
            sink_name = state.get("default_sink", "")
            if sink_name:
                dev_mutes[sink_name] = mute
            cls.save_tracked_state({
                "master_muted": mute,
                "device_mutes": dev_mutes,
                "last_user_set_time": cls._last_user_action_time,
            })

    @classmethod
    def toggle_master_mute(cls):
        state = cls.get_audio_state()
        new_mute = not state.get("master_muted", False)
        cls.set_master_mute(new_mute, is_user_action=True)

    @classmethod
    def set_default_sink(cls, sink_name: str):
        try:
            subprocess.run(["pactl", "set-default-sink", sink_name], check=True, timeout=4)
        except (OSError, subprocess.SubprocessError):
            return False
        cls._last_checked_sink = sink_name
        tracked = cls.load_tracked_state()
        dev_vols = tracked.get("device_volumes", {})
        target_vol = dev_vols.get(sink_name, tracked.get("master_volume", 40))
        cls.set_master_volume(target_vol, is_user_action=False)
        return True

    @classmethod
    def set_default_source(cls, source_name: str):
        try:
            subprocess.run(["pactl", "set-default-source", source_name], check=True, timeout=4)
        except (OSError, subprocess.SubprocessError):
            return False
        if source_name:
            cls.save_tracked_state({"default_source": source_name})
        return True

    @classmethod
    def set_source_volume(cls, percent: int):
        percent = max(0, min(100, percent))
        try:
            subprocess.run(["pactl", "set-source-volume", "@DEFAULT_SOURCE@", f"{percent}%"], check=False)
        except Exception:
            pass
        cls.save_tracked_state({"source_volume": percent})

    @classmethod
    def set_source_mute(cls, mute: bool):
        val = "1" if mute else "0"
        try:
            subprocess.run(["pactl", "set-source-mute", "@DEFAULT_SOURCE@", val], check=False)
        except Exception:
            pass
        cls.save_tracked_state({"source_muted": mute})

    @staticmethod
    def set_app_volume(app_id: str, percent: int):
        percent = max(0, min(100, percent))
        try:
            subprocess.run(["pactl", "set-sink-input-volume", app_id, f"{percent}%"], check=False)
        except Exception:
            pass

    @staticmethod
    def set_app_mute(app_id: str, mute: bool):
        val = "1" if mute else "0"
        try:
            subprocess.run(["pactl", "set-sink-input-mute", app_id, val], check=False)
        except Exception:
            pass

    @staticmethod
    def play_chime():
        """Generates and plays a pleasant 2-tone Windows test chime."""
        try:
            # Check if system sound exists
            system_wav = "/usr/share/sounds/alsa/Front_Center.wav"
            if os.path.exists(system_wav):
                subprocess.Popen(["paplay", system_wav])
                return
        except Exception:
            pass

        # Synthesize chime
        sample_rate = 44100
        tones = [(523.25, 0.12), (783.99, 0.20)]  # C5 -> G5
        frames = bytearray()
        for freq, dur in tones:
            num_samples = int(sample_rate * dur)
            for i in range(num_samples):
                t = i / sample_rate
                envelope = math.exp(-3.5 * (i / num_samples))
                val = int(32767.0 * 0.45 * envelope * math.sin(2.0 * math.pi * freq * t))
                frames.extend(struct.pack('<h', val))
                frames.extend(struct.pack('<h', val))

        tmp = tempfile.NamedTemporaryFile(suffix='.wav', delete=False)
        tmp_name = tmp.name
        tmp.close()
        import wave
        with wave.open(tmp_name, 'wb') as wf:
            wf.setnchannels(2)
            wf.setsampwidth(2)
            wf.setframerate(sample_rate)
            wf.writeframes(frames)
        subprocess.Popen(["paplay", tmp_name])


# ============================================================================
# FLUENT UI CARD WIDGET
# ============================================================================

class FluentCard(QFrame):
    """Windows 11 rounded fluent card."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setStyleSheet("""
            FluentCard {
                background-color: #2b2b2b;
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 8px;
            }
        """)


# ============================================================================
# WINDOWS 11 SOUND SETTINGS WINDOW
# ============================================================================

class WindowsSoundSettingsWindow(QMainWindow):
    """Full Windows 11 System > Sound Settings Application."""

    def __init__(self):
        super().__init__()
        self.setWindowTitle("Sound - DevOS Settings")
        self.resize(760, 680)
        self.setMinimumSize(600, 500)
        self.setWindowIcon(make_vector_sound_icon("volume-high", 32, "#60cdff"))

        self._updating = False
        self._setup_ui()

        # Polling timer for real-time external changes
        self.timer = QTimer(self)
        self.timer.setInterval(1200)
        self.timer.timeout.connect(self.refresh_audio_state)
        self.timer.start()

        self.refresh_audio_state()

    def _setup_ui(self):
        self.setStyleSheet("""
            QMainWindow {
                background-color: #202020;
                color: #ffffff;
            }
            QLabel {
                color: #ffffff;
                font-family: 'Segoe UI', 'Inter', sans-serif;
            }
            QRadioButton {
                color: #f1f5f9;
                font-size: 13px;
                spacing: 8px;
            }
            QRadioButton::indicator {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border: 2px solid #64748b;
                background-color: transparent;
            }
            QRadioButton::indicator:checked {
                border-color: #60cdff;
                background-color: #60cdff;
            }
            QSlider::groove:horizontal {
                height: 4px;
                background: #475569;
                border-radius: 2px;
            }
            QSlider::sub-page:horizontal {
                background: #60cdff;
                border-radius: 2px;
            }
            QSlider::handle:horizontal {
                background: #ffffff;
                border: 2px solid #60cdff;
                width: 16px;
                margin-top: -6px;
                margin-bottom: -6px;
                border-radius: 8px;
            }
            QSlider::handle:horizontal:hover {
                background: #60cdff;
                border-color: #ffffff;
            }
            QPushButton {
                background-color: #383838;
                color: #f1f5f9;
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 4px;
                padding: 6px 14px;
                font-size: 12px;
            }
            QPushButton:hover {
                background-color: #444444;
