#!/usr/bin/env python3
"""DevOS XDG Desktop Portal FileChooser Backend.

Implements org.freedesktop.impl.portal.FileChooser to seamlessly integrate
the DevOS File Explorer as the system file picker dialog for web browsers
(Chrome, Firefox) and desktop applications.
"""

import json
import mimetypes
import os
import pathlib
import re
import shutil
import subprocess
import sys
import threading
import time
import uuid
from collections import defaultdict
from urllib.parse import unquote, urlparse

# session-env-launch: Chrome's download button must open a real window.
# The installer looks for this marker before it replaces an older copy.

try:
    import dbus
    import dbus.mainloop.glib
    import dbus.service
    from gi.repository import GLib
except ImportError as e:
    sys.stderr.write(f"[devos-portal-filechooser] Missing D-Bus dependencies: {e}\n")
    sys.exit(1)


def uri_to_path(uri):
    """Turn a file:// URI from Chrome into a local path."""
    text = str(uri or "").strip()
    if not text:
        return ""
    if text.startswith("file:"):
        parsed = urlparse(text)
        path = unquote(parsed.path or "")
        if parsed.netloc and parsed.netloc != "localhost":
            path = f"//{parsed.netloc}{path}"
        return path
    return os.path.expanduser(text)


def devos_files_bin():
    candidates = [
        "/usr/local/bin/devos-files",
        shutil.which("devos-files") or "",
        os.path.expanduser("~/.local/bin/devos-files"),
    ]
    for c in candidates:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return "/usr/local/bin/devos-files"


# A systemd user service often has no screen. Copy the screen from the desktop
# that is already showing windows, and never copy the rest of that process.
_DISPLAY_KEYS = (
    "DISPLAY",
    "WAYLAND_DISPLAY",
    "XAUTHORITY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "XDG_CURRENT_DESKTOP",
    "XDG_SESSION_TYPE",
    "QT_QPA_PLATFORM",
    "HOME",
    "USER",
    "LANG",
    "XDG_DATA_DIRS",
    "XDG_CONFIG_HOME",
)
_PREFERRED_COMMS = {
    "plasmashell",
    "kwin_wayland",
    "kwin_x11",
    "Xorg",
    "Xwayland",
    "gnome-shell",
}


def decode_environ(raw):
    env = {}
    for item in raw.split(b"\0"):
        if not item or b"=" not in item:
            continue
        key, value = item.split(b"=", 1)
        try:
            env[key.decode("utf-8")] = value.decode("utf-8")
        except UnicodeError:
            continue
    return env


def iter_process_environments():
    try:
        names = os.listdir("/proc")
    except OSError:
        return
    for name in names:
        if not name.isdigit():
            continue
        base = os.path.join("/proc", name)
        try:
            with open(os.path.join(base, "comm"), "rb") as handle:
                comm = handle.read().split(b"\0", 1)[0].decode("utf-8", "replace").strip()
            with open(os.path.join(base, "environ"), "rb") as handle:
                env = decode_environ(handle.read())
        except OSError:
            continue
        yield comm, env


def session_environment(base=None, processes=None):
    """Environment that can put a window on the screen the user is looking at."""
    env = dict(os.environ if base is None else base)
    if processes is None:
        processes = iter_process_environments()
    chosen = None
    for comm, penv in processes:
        if not (penv.get("DISPLAY") or penv.get("WAYLAND_DISPLAY")):
            continue
        chosen = penv
        if comm in _PREFERRED_COMMS:
            break
    if chosen:
        for key in _DISPLAY_KEYS:
            if not env.get(key) and chosen.get(key):
                env[key] = chosen[key]
    if not env.get("DISPLAY") and not env.get("WAYLAND_DISPLAY"):
        runtime = env.get("XDG_RUNTIME_DIR") or ""
        if runtime and os.path.exists(os.path.join(runtime, "wayland-0")):
            env["WAYLAND_DISPLAY"] = "wayland-0"
        else:
            env["DISPLAY"] = ":0"
    env["PATH"] = "/usr/local/bin:/usr/bin:/bin:" + env.get("PATH", "")
    return env


def launch_explorer(paths, select=False, env=None, popen=None, wait=0.4, sleeper=None, binary=None, log_path=None):
    """Open File Explorer. False means the window process died before it could show."""
    binary = binary or devos_files_bin()
    paths = [p for p in paths if p]
    if not paths or not binary or not os.path.isfile(binary):
        return False
    if select:
        cmd = [binary]
        for path in paths:
            cmd.extend(["--select", path])
    else:
        cmd = [binary, paths[0]]
    env = session_environment() if env is None else env
    if log_path is None:
        log_path = os.path.expanduser("~/.cache/devos/file-explorer-launch.log")
    try:
        os.makedirs(os.path.dirname(log_path), exist_ok=True)
        log_handle = open(log_path, "ab", buffering=0)
    except OSError:
        log_handle = open(os.devnull, "ab")
    popen = popen or subprocess.Popen
    sleeper = sleeper or time.sleep

    def once(argv):
        try:
            proc = popen(
                argv,
                env=env,
                stdout=log_handle,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
        except OSError as err:
            try:
                log_handle.write(f"[devos-portal-filechooser] launch failed: {err}\n".encode())
            except Exception:
                pass
            return None
        if wait:
            sleeper(wait)
        if proc.poll() is not None:
            try:
                log_handle.write(
                    f"[devos-portal-filechooser] exited {proc.poll()}: {argv!r}\n".encode()
                )
            except Exception:
                pass
            return None
        try:
            log_handle.write(f"[devos-portal-filechooser] opened: {argv!r}\n".encode())
        except Exception:
            pass
        return proc

    try:
        # A scope is a normal desktop app. A window started inside this service
        # often never appears, and Chrome treats a plain success as "already open".
        if once(["systemd-run", "--user", "--scope", "--quiet", "--collect", "--"] + cmd):
            return True
        return once(cmd) is not None
    finally:
        try:
            log_handle.close()
        except Exception:
            pass


def open_in_explorer(paths, select=False):
    """Open File Explorer on these paths. Chrome's download button lands here."""
    return launch_explorer(paths, select=select)


def prefer_devos_for_folders():
    """Make folder opens use File Explorer, including after Dolphin claimed them."""
    desktop = "/usr/share/applications/devos-thispc.desktop"
    if not os.path.isfile(desktop):
        return
    try:
        subprocess.run(
            ["xdg-mime", "default", "devos-thispc.desktop", "inode/directory"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def parse_portal_folder(folder_val):
    if not folder_val:
        return ""
    if isinstance(folder_val, (bytes, bytearray)):
        return folder_val.rstrip(b"\x00").decode("utf-8", errors="replace")
    if isinstance(folder_val, (list, tuple)):
        try:
            return bytes(folder_val).rstrip(b"\x00").decode("utf-8", errors="replace")
        except Exception:
            pass
    return str(folder_val)


def clean_glob_pattern(pat):
    """Normalize regex character classes in globs like *.[pP][dD][fF] to clean *.pdf."""
    if not pat:
        return pat
    cleaned = re.sub(r"\[([a-zA-Z0-9])(?:[^\]])*\]", lambda m: m.group(1).lower(), pat)
    cleaned = cleaned.replace("?", "")
    return cleaned


def format_portal_filters_for_cli(filters_data):
    if not filters_data:
        return "All Files (*.*)"
    chunks = []
    for item in filters_data:
        try:
            name = clean_glob_pattern(str(item[0]))
            specs = item[1]
            globs = []
            for spec in specs:
                spec_type = int(spec[0])
                spec_val = str(spec[1])
                if spec_type == 0:  # glob pattern
                    globs.append(clean_glob_pattern(spec_val))
                elif spec_type == 1:  # mime type
                    exts = mimetypes.guess_all_extensions(spec_val)
                    if exts:
                        for ext in exts:
                            globs.append(f"*{ext}")
                    else:
                        mime_sub = spec_val.split("/")[-1]
                        globs.append(f"*.{mime_sub}")
            if not globs:
                globs = ["*.*"]
            chunks.append(f"{name} ({' '.join(globs)})")
        except Exception:
            continue
    if not chunks:
        chunks = ["All Files (*.*)"]
    return ";;".join(chunks)


class DevOSFileChooserPortal(dbus.service.Object):
    def __init__(self, bus):
        super().__init__(bus, "/org/freedesktop/portal/desktop")
        self.bus = bus
        self._active_processes = {}
        self._lock = threading.Lock()

    @dbus.service.method(
        "org.freedesktop.impl.portal.FileChooser",
        in_signature="osssa{sv}",
        out_signature="ua{sv}",
        async_callbacks=("ok_cb", "err_cb")
    )
    def OpenFile(self, handle, app_id, parent_window, title, options, ok_cb, err_cb):
        self._launch_picker(
            handle=handle,
            app_id=app_id,
            parent_window=parent_window,
            title=title,
            options=options,
            save_mode=False,
            ok_cb=ok_cb,
            err_cb=err_cb
        )

    @dbus.service.method(
        "org.freedesktop.impl.portal.FileChooser",
        in_signature="osssa{sv}",
        out_signature="ua{sv}",
        async_callbacks=("ok_cb", "err_cb")
    )
    def SaveFile(self, handle, app_id, parent_window, title, options, ok_cb, err_cb):
        self._launch_picker(
            handle=handle,
            app_id=app_id,
            parent_window=parent_window,
            title=title,
            options=options,
            save_mode=True,
            ok_cb=ok_cb,
            err_cb=err_cb
        )

    @dbus.service.method(
        "org.freedesktop.impl.portal.FileChooser",
        in_signature="osssa{sv}",
        out_signature="ua{sv}",
        async_callbacks=("ok_cb", "err_cb")
    )
    def OpenFolder(self, handle, app_id, parent_window, title, options, ok_cb, err_cb):
        """Folder pickers (Cursor Open Folder, upload folders) use this method."""
        self._launch_picker(
            handle=handle,
            app_id=app_id,
            parent_window=parent_window,
            title=title or "Select Folder",
            options=options,
            save_mode=False,
            force_directory=True,
            ok_cb=ok_cb,
            err_cb=err_cb
        )

    def _launch_picker(self, handle, app_id, parent_window, title, options, save_mode, ok_cb, err_cb, force_directory=False):
        t = threading.Thread(
            target=self._run_picker_worker,
            args=(handle, app_id, parent_window, title, options, save_mode, ok_cb, err_cb, force_directory),
            daemon=True
        )
        t.start()

    def _run_picker_worker(self, handle, app_id, parent_window, title, options, save_mode, ok_cb, err_cb, force_directory=False):
        tmp_id = uuid.uuid4().hex
        tmp_out = f"/tmp/devos_picker_{tmp_id}.json"

        dialog_title = str(title) if title else ("Save As" if save_mode else "Open File")
        multiple = False if force_directory else bool(options.get("multiple", False))
        directory = True if force_directory else bool(options.get("directory", False))
        current_name = clean_glob_pattern(str(options.get("current_name", "")))
        current_folder = parse_portal_folder(options.get("current_folder"))
        current_file = parse_portal_folder(options.get("current_file"))
        if current_file:
            if not current_name:
                current_name = os.path.basename(current_file)
            if not current_folder and os.path.exists(current_file):
                current_folder = os.path.dirname(current_file)
        filters_data = options.get("filters", [])

        cmd = [devos_files_bin(), "--picker", "--output", tmp_out, "--title", dialog_title]
        if save_mode:
            cmd.append("--save")
        else:
            cmd.append("--resume")
        if multiple:
            cmd.append("--multiple")
        if directory:
            cmd.append("--directory")
        if current_name:
            cmd.extend(["--name", current_name])
        if filters_data:
            filter_arg = format_portal_filters_for_cli(filters_data)
            cmd.extend(["--filter", filter_arg])

        target_folder = ""
        if current_folder and os.path.isdir(current_folder):
            target_folder = current_folder
        if target_folder:
            cmd.append(target_folder)

        env = session_environment()
        try:
            proc = subprocess.Popen(cmd, env=env)
            with self._lock:
                self._active_processes[str(handle)] = proc
            ret = proc.wait()
        except Exception as e:
            sys.stderr.write(f"[devos-portal-filechooser] Failed to spawn file chooser: {e}\n")
            ret = 1
        finally:
            with self._lock:
                self._active_processes.pop(str(handle), None)

        if ret == 0 and os.path.exists(tmp_out):
            try:
                with open(tmp_out, "r", encoding="utf-8") as f:
                    selected_paths = json.load(f)
                uris = [pathlib.Path(p).as_uri() for p in selected_paths if os.path.exists(p) or save_mode]
                if uris:
                    res_dict = dbus.Dictionary({"uris": dbus.Array(uris, signature="s")}, signature="sv")
                    GLib.idle_add(ok_cb, dbus.UInt32(0), res_dict)
                else:
                    GLib.idle_add(ok_cb, dbus.UInt32(1), dbus.Dictionary({}, signature="sv"))
            except Exception as e:
                sys.stderr.write(f"[devos-portal-filechooser] Error reading output: {e}\n")
                GLib.idle_add(ok_cb, dbus.UInt32(1), dbus.Dictionary({}, signature="sv"))
            finally:
                try:
                    os.remove(tmp_out)
                except OSError:
                    pass
        else:
            try:
                if os.path.exists(tmp_out):
                    os.remove(tmp_out)
            except OSError:
                pass
            GLib.idle_add(ok_cb, dbus.UInt32(1), dbus.Dictionary({}, signature="sv"))


class DevOSFileManager(dbus.service.Object):
    """org.freedesktop.FileManager1 — Chrome uses this to show a download in a folder."""

    def __init__(self, bus):
        super().__init__(bus, "/org/freedesktop/FileManager1")

    def _open_or_fail(self, paths, select):
        # Chrome keeps the click if this method returns success. A dead window
        # must be an error so Chrome can open the folder itself.
        if not open_in_explorer(paths, select=select):
            raise dbus.exceptions.DBusException("File Explorer did not open")

    @dbus.service.method("org.freedesktop.FileManager1", in_signature="ass", out_signature="")
    def ShowFolders(self, uris, startup_id):
        opened = False
        for uri in uris:
            path = uri_to_path(uri)
            if path:
                self._open_or_fail([path], select=False)
                opened = True
        if not opened:
            raise dbus.exceptions.DBusException("File Explorer did not open")

    @dbus.service.method("org.freedesktop.FileManager1", in_signature="ass", out_signature="")
    def ShowItems(self, uris, startup_id):
        groups = defaultdict(list)
        for uri in uris:
            path = uri_to_path(uri)
            if not path:
                continue
            if os.path.isdir(path):
                groups[path]
            else:
                groups[os.path.dirname(path) or "/"].append(path)
        if not groups:
            raise dbus.exceptions.DBusException("File Explorer did not open")
        for folder, files in groups.items():
            if files:
                self._open_or_fail(files, select=True)
            else:
                self._open_or_fail([folder], select=False)

    @dbus.service.method("org.freedesktop.FileManager1", in_signature="ass", out_signature="")
    def ShowItemProperties(self, uris, startup_id):
        self.ShowItems(uris, startup_id)


def main():
    try:
        import ctypes
        libc = ctypes.cdll.LoadLibrary("libc.so.6")
        libc.prctl(15, b"devos-portal-fc", 0, 0, 0)
    except Exception:
        pass

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    held = {"portal_name": None, "manager_name": None}

    def claim_bus_name(name):
        try:
            return dbus.service.BusName(name, bus, do_not_queue=True)
        except dbus.exceptions.NameExistsException:
            return None

    def claim_portal():
        if held["portal_name"] is not None:
            return False
        name = claim_bus_name("org.freedesktop.impl.portal.desktop.devos")
        if name is None:
            return True
        held["portal_name"] = name
        DevOSFileChooserPortal(bus)
        prefer_devos_for_folders()
        sys.stdout.write("[devos-portal-filechooser] Backend active on org.freedesktop.impl.portal.desktop.devos\n")
        sys.stdout.flush()
        return False

    def claim_file_manager():
        if held["manager_name"] is not None:
            return False
        name = claim_bus_name("org.freedesktop.FileManager1")
        if name is None:
            # Dolphin still owns folder opens. Try again after it quits.
            return True
        held["manager_name"] = name
        DevOSFileManager(bus)
        sys.stdout.write("[devos-portal-filechooser] File Explorer answers folder opens from Chrome\n")
        sys.stdout.flush()
        return False

    claim_portal()
    claim_file_manager()
    if held["portal_name"] is None and held["manager_name"] is None:
        # The running copy already answers both. Exiting here used to drop
        # the download-button call when only the dialog name was taken.
        return
    GLib.timeout_add_seconds(2, claim_portal)
    GLib.timeout_add_seconds(2, claim_file_manager)

    loop = GLib.MainLoop()
    try:
        loop.run()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
