#!/usr/bin/env bash
# Open Cursor after the silent keyring is answering /modules/kwalletd.
set -euo pipefail
if [ -x /usr/local/bin/devos-kwallet-compat ]; then
    /usr/local/bin/devos-kwallet-compat --prepare || true
fi
for bin in /usr/share/cursor/cursor /usr/bin/cursor /opt/cursor/cursor; do
    if [ -x "$bin" ] && [ "$bin" != "/usr/local/bin/devos-launch-cursor" ]; then
        exec "$bin" "$@"
    fi
done
printf '%s\n' "Cursor is not installed." >&2
exit 127
