#!/usr/bin/env bash
# Apply the Chrome footer-icon fix on a running DevOS. No reinstall.
# Each open Chrome window gets its own taskbar icon (profile letter or photo).
set -euo pipefail

BRANCH="${1:-main}"
RAW="https://raw.githubusercontent.com/imranbru99/DevOS/${BRANCH}"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc"
PROFILES=/usr/local/share/devos/components/browser/chrome_profiles.py

fetch() {
    local url="$1" dest="$2"
    curl -fsSL "$url" -o "$dest"
}

echo "== Chrome footer icons from ${BRANCH} =="
echo "Save your tabs first. Quit every Chrome window before you open Chrome again."

tmp="$(mktemp)"
fetch "${RAW}/components/browser/chrome_profiles.py" "$tmp" \
    || fetch "${RAW}/build/includes.chroot/usr/local/share/devos/components/browser/chrome_profiles.py" "$tmp"
grep -q 'apply_kwin_window_desktops' "$tmp"
grep -q 'Always a new context' "$tmp"
sudo install -m 0644 "$tmp" "$PROFILES"
rm -f "$tmp"

tmp="$(mktemp)"
fetch "${RAW}/build/includes.chroot/usr/local/bin/devos-browser" "$tmp"
grep -q 'CHROME_DESKTOP' "$tmp"
sudo install -m 0755 "$tmp" /usr/local/bin/devos-browser
if [ -f "${HOME}/.local/bin/devos-browser" ]; then
    install -m 0755 "$tmp" "${HOME}/.local/bin/devos-browser"
fi
rm -f "$tmp"

tmp="$(mktemp)"
fetch "${RAW}/build/includes.chroot/usr/local/share/devos/apply-ui.js" "$tmp"
grep -q 'groupingStrategy", 0' "$tmp"
sudo install -m 0644 "$tmp" /usr/local/share/devos/apply-ui.js
rm -f "$tmp"

tmp="$(mktemp)"
layout_dest=/usr/share/plasma/look-and-feel/org.devos.desktop/contents/layouts/org.kde.plasma.desktop-layout.js
fetch "${RAW}/build/includes.chroot/usr/share/plasma/look-and-feel/org.devos.desktop/contents/layouts/org.kde.plasma.desktop-layout.js" "$tmp"
grep -q 'groupingStrategy", 0' "$tmp"
sudo install -m 0644 "$tmp" "$layout_dest"
rm -f "$tmp"

rm -f "${HOME}/.local/share/icons/hicolor/48x48/apps"/chrome-*.png \
      "${HOME}/.local/share/icons/hicolor/128x128/apps"/chrome-*.png 2>/dev/null || true

export DISPLAY="${DISPLAY:-:0}"
export DEVOS_FORCE_PLASMA_RELOAD=1

echo "== Rebuild profile icons and turn grouping off =="
/usr/bin/python3 "$PROFILES" sync || true

/usr/bin/python3 - <<'PY'
import os
import re
from pathlib import Path

cfg = Path(os.path.expanduser("~/.config/plasma-org.kde.plasma.desktop-appletsrc"))
if not cfg.is_file():
    raise SystemExit(0)
text = cfg.read_text(encoding="utf-8", errors="replace")
parts = re.split(r"(?m)(?=^\[)", text)
tasks_keys = set()
for part in parts:
    header = part.split("\n", 1)[0].strip()
    match = re.match(r"^\[Containments\]\[(\d+)\]\[Applets\]\[(\d+)\]$", header)
    if not match:
        continue
    body = part.split("\n", 1)[1] if "\n" in part else ""
    if re.search(r"(?m)^plugin=org\.kde\.plasma\.(icontasks|taskmanager)\s*$", body):
        tasks_keys.add(f"{match.group(1)}:{match.group(2)}")
out = []
for part in parts:
    header = part.split("\n", 1)[0].strip()
    gen = re.match(
        r"^\[Containments\]\[(\d+)\]\[Applets\]\[(\d+)\]\[Configuration\]\[General\]$",
        header,
    )
    if gen and f"{gen.group(1)}:{gen.group(2)}" in tasks_keys:
        keys = {
            "groupingStrategy": "0",
            "groupPopups": "false",
            "onlyGroupWhenFull": "false",
            "separateLaunchers": "true",
            "hideActivatedLaunchers": "false",
            "launchInPlace": "true",
        }
        seen = set()
        rest = part.split("\n", 1)[1] if "\n" in part else ""
        lines = []
        for line in rest.splitlines(keepends=True):
            key = line.split("=", 1)[0].strip() if "=" in line and not line.startswith("[") else None
            if key in keys:
                lines.append(f"{key}={keys[key]}\n")
                seen.add(key)
            else:
                lines.append(line)
        for key, value in keys.items():
            if key not in seen:
                lines.append(f"{key}={value}\n")
        part = header + "\n" + "".join(lines)
        if not part.endswith("\n"):
            part += "\n"
    out.append(part)
cfg.write_text("".join(out), encoding="utf-8")
print("Wrote groupingStrategy=0 groupPopups=false")
PY

systemctl --user enable --now devos-browser-profiles.service 2>/dev/null || true
systemctl --user restart devos-browser-profiles.service 2>/dev/null \
    || (pkill -f 'chrome_profiles.py watch' 2>/dev/null || true
        nohup /usr/local/bin/devos-browser-profiles-daemon >/dev/null 2>&1 &)

# Do not restart plasmashell and do not reload Icon Tasks. Both remove the
# footer for a second or two. The profile photos are painted on the windows.
if [ -x /usr/local/bin/devos-tray-overflow ]; then
    /usr/local/bin/devos-tray-overflow --write-only >/dev/null 2>&1 || true
fi

echo
echo "== Chrome windows =="
wmctrl -lx 2>/dev/null | grep -iE 'chrome|google-chrome' || echo "(none open — that is what we want before you start Chrome again)"
echo
echo "== Taskbar =="
grep -E 'launchers=|groupingStrategy=|groupPopups=' "$CFG" 2>/dev/null | head -30 || true
echo
echo "Done. Now open Chrome from the Start menu."
echo "Each window should be its own footer icon, with that profile's letter or photo."
echo "If a window is still inside the old group, quit Chrome completely (every window) and open it once more."
