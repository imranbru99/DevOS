#!/usr/bin/env bash
# Split Google Antigravity (main) and Antigravity IDE (second) into two real apps.
# Safe to re-run. Needs network once + sudo.
set -euo pipefail

BRANCH="${1:-cursor/fix-antigravity-ide-chrome-default-6cbe}"
RAW="https://raw.githubusercontent.com/imranbru99/DevOS/${BRANCH}"

echo "== Install isolated launchers (branch: ${BRANCH}) =="
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

curl -fsSL "${RAW}/build/includes.chroot/usr/local/bin/devos-antigravity" -o "${TMP}/devos-antigravity"
curl -fsSL "${RAW}/build/includes.chroot/usr/local/bin/antigravity-kde" -o "${TMP}/antigravity-kde"
curl -fsSL "${RAW}/build/includes.chroot/usr/local/sbin/devos-install-antigravity-kde" -o "${TMP}/devos-install-antigravity-kde"

sudo install -m 0755 "${TMP}/devos-antigravity" /usr/local/bin/devos-antigravity
sudo install -m 0755 "${TMP}/antigravity-kde" /usr/local/bin/antigravity-kde
sudo install -m 0755 "${TMP}/devos-install-antigravity-kde" /usr/local/sbin/devos-install-antigravity-kde
sudo ln -sfn /usr/local/bin/antigravity-kde /usr/bin/antigravity-kde
sudo ln -sfn /usr/local/bin/devos-antigravity /usr/bin/devos-antigravity 2>/dev/null || true

# Desktop entries (menu) — unhide IDE tile
for f in antigravity.desktop antigravity-kde.desktop antigravity-ide.desktop devos-antigravity-studio.desktop; do
  url="${RAW}/build/includes.chroot/usr/share/applications/${f}"
  if curl -fsSL "$url" -o "${TMP}/${f}"; then
    # Live PC: show IDE entries even if ISO ships them Hidden.
    if [ "$f" = "devos-antigravity-studio.desktop" ] || [ "$f" = "antigravity-ide.desktop" ] || [ "$f" = "antigravity.desktop" ]; then
      sed -i \
        -e '/^Hidden=true$/d' \
        -e '/^NoDisplay=true$/d' \
        -e '/^X-DevOS-Hidden=true$/d' \
        "${TMP}/${f}" || true
    fi
    sudo install -m 0644 "${TMP}/${f}" "/usr/share/applications/${f}"
    echo "  ✔ /usr/share/applications/${f}"
  fi
done

# Visible user override for Antigravity IDE (second account)
mkdir -p "${HOME}/.local/share/applications"
cat > "${HOME}/.local/share/applications/antigravity-ide.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Antigravity IDE
GenericName=AI coding (second account)
Comment=Second Antigravity — separate Google account from Google Antigravity
Exec=/usr/local/bin/antigravity-kde %F
TryExec=/usr/local/lib/antigravity-ide/antigravity-ide
Icon=antigravity-kde
Terminal=false
Categories=Development;IDE;
MimeType=text/plain;inode/directory;
Keywords=antigravity;ide;studio;kde;second;
StartupNotify=true
StartupWMClass=antigravity-ide
EOF

# Build dedicated IDE binary tree (hardlinked + patched product.json)
echo "== Build dedicated Antigravity IDE binary =="
sudo /usr/local/sbin/devos-install-antigravity-kde

mkdir -p "${HOME}/.config/Antigravity" "${HOME}/.config/Antigravity-KDE"
mkdir -p "${HOME}/.gemini/antigravity" "${HOME}/.gemini/antigravity-kde"
printf '%s\n' '{ "password-store": "basic" }' > "${HOME}/.config/Antigravity/argv.json"
printf '%s\n' '{ "password-store": "basic" }' > "${HOME}/.config/Antigravity-KDE/argv.json"

echo "== Close every Antigravity window =="
pkill -f '/opt/antigravity/antigravity' 2>/dev/null || true
pkill -f '/usr/local/lib/antigravity-ide/antigravity-ide' 2>/dev/null || true
pkill -f 'Antigravity-KDE' 2>/dev/null || true
sleep 1
for d in "${HOME}/.config/Antigravity" "${HOME}/.config/Antigravity-KDE"; do
  rm -f "${d}/SingletonLock" "${d}/SingletonSocket" "${d}/SingletonCookie" 2>/dev/null || true
done
update-desktop-database "${HOME}/.local/share/applications" 2>/dev/null || true

echo
echo "Done. Open separately from the menu:"
echo "  1) Google Antigravity  →  main account"
echo "  2) Antigravity IDE    →  second account (sign in again once)"
echo
echo "They must be TWO taskbar icons. Verify:"
echo "  ps -ef | grep -E 'user-data-dir=.*(Antigravity|Antigravity-KDE)' | grep -v grep"
echo "  ls -la /usr/local/lib/antigravity-ide/antigravity-ide"
