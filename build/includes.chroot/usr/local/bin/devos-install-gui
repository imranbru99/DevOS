#!/bin/bash
# Open the disk installer on the live desktop.
# Calamares must run as root on X11 or the disk list never appears.
# Kill any lingering Ubuntu installer that might conflict or hold locks
killall -9 ubuntu-desktop-bootstrap subiquity curtin 2>/dev/null || true
rm -f /etc/xdg/autostart/ubuntu-desktop-bootstrap.desktop 2>/dev/null || true

if [ -z "${DISPLAY:-}" ]; then
    if [ -e /tmp/.X11-unix/X0 ]; then
        export DISPLAY=":0"
    elif [ -e /tmp/.X11-unix/X1 ]; then
        export DISPLAY=":1"
    else
        export DISPLAY=":0"
    fi
fi

export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}"
# DevOS colours (from /etc/xdg/kdeglobals) for parts stylesheet.qss cannot
# reach, e.g. the partition legend; Fusion keeps the tested layout.
export QT_QPA_PLATFORMTHEME=kde
export QT_STYLE_OVERRIDE=Fusion
# Keep the installer inside the usable desktop area so the Next/Back bar is
# not drawn under a Plasma panel or laptop overscan (branding uses noexpand).
export QT_SCALE_FACTOR_ROUNDING_POLICY="${QT_SCALE_FACTOR_ROUNDING_POLICY:-RoundPreferFloor}"
# Avoid fractional scaling that pushes the nav bar off short 1366x768 panels.
export QT_AUTO_SCREEN_SCALE_FACTOR="${QT_AUTO_SCREEN_SCALE_FACTOR:-0}"
export QT_ENABLE_HIGHDPI_SCALING="${QT_ENABLE_HIGHDPI_SCALING:-0}"

if [ -z "${XAUTHORITY:-}" ]; then
    if [ -n "${XDG_RUNTIME_DIR:-}" ] && compgen -G "${XDG_RUNTIME_DIR}/xauth*" >/dev/null 2>&1; then
        export XAUTHORITY=$(ls -1 "${XDG_RUNTIME_DIR}/xauth"* 2>/dev/null | head -n 1)
    elif [ -f "${HOME}/.Xauthority" ]; then
        export XAUTHORITY="${HOME}/.Xauthority"
    fi
fi

if ! grep -q 'branding: devos' /etc/calamares/settings.conf 2>/dev/null; then
    echo "DevOS installer configuration is missing. Ubuntu installation was not started." >&2
    exit 1
fi

exec 9>/tmp/devos-installer.lock
# Wait briefly for a previous launcher to release the lock (boot_ui safe-retry
# kills and relaunches quickly). Exit non-zero if still busy so the starter
# does not treat "already running" as a successful silent exit.
if ! flock -w 45 9; then
    echo "==> Another installer instance still holds the lock" >>/tmp/devos-calamares.log
    # If Calamares is already up, that is success for the live session.
    if pgrep -x calamares >/dev/null 2>&1; then
        exit 0
    fi
    exit 75
fi

sleep 1
xhost +si:localuser:root >/dev/null 2>&1 || true
xhost +local: >/dev/null 2>&1 || true
xhost + >/dev/null 2>&1 || true

# If the window still opens taller than the usable desktop (old configs,
# HiDPI, panels), shrink and center it so Next/Back stay visible.
clamp_installer_window() {
    command -v xdotool >/dev/null 2>&1 || return 0
    command -v xprop >/dev/null 2>&1 || return 0
    local tries=0 wid wa wx wy ww wh maxw maxh nw nh nx ny
    while [ "$tries" -lt 50 ]; do
        tries=$((tries + 1))
        sleep 0.2
        wid=$(xdotool search --onlyvisible --class calamares 2>/dev/null | head -n 1)
        [ -n "$wid" ] || continue
        wa=$(xprop -root _NET_WORKAREA 2>/dev/null | sed -n 's/.*= //p' | head -n 1 | tr -d ',')
        set -- $wa
        wx=${1:-0}; wy=${2:-0}; ww=${3:-0}; wh=${4:-0}
        if [ "${ww:-0}" -lt 640 ] || [ "${wh:-0}" -lt 480 ]; then
            # Fallback: full screen minus a modest panel/decoration margin.
            set -- $(xdpyinfo 2>/dev/null | awk '/dimensions/{print $2}' | tr 'x' ' ')
            ww=${1:-1280}; wh=${2:-720}; wx=0; wy=0
            wh=$((wh - 56))
        fi
        maxw=$((ww - 24))
        maxh=$((wh - 24))
        [ "$maxw" -gt 720 ] || maxw=$ww
        [ "$maxh" -gt 480 ] || maxh=$wh
        # Prefer a comfortable size, but never exceed the work area.
        nw=960; nh=580
        [ "$nw" -le "$maxw" ] || nw=$maxw
        [ "$nh" -le "$maxh" ] || nh=$maxh
        nx=$((wx + (ww - nw) / 2))
        ny=$((wy + (wh - nh) / 2))
        [ "$nx" -ge "$wx" ] || nx=$wx
        [ "$ny" -ge "$wy" ] || ny=$wy
        xdotool windowsize "$wid" "$nw" "$nh" 2>/dev/null || true
        xdotool windowmove "$wid" "$nx" "$ny" 2>/dev/null || true
        return 0
    done
}

apply_preferred_usertype() {
    # boot_ui Premium options write /run or /tmp; ship that into Calamares QML.
    local kind="" dest="/etc/calamares/branding/devos/preferred-usertype.js" src=""
    for src in /run/devos-preferred-usertype /tmp/devos-preferred-usertype; do
        if [ -f "$src" ]; then
            kind=$(tr -d '[:space:]' <"$src" | head -c 64)
            break
        fi
    done
    case "$kind" in
        normal|professional|student|developer|creator|gamer|business|family|islamic|premium) ;;
        *) kind="" ;;
    esac
    local body=".pragma library"$'\n'"var preferred = \"$kind\";"
    if [ "$(id -u)" -eq 0 ]; then
        printf '%s\n' "$body" >"$dest" || true
    else
        printf '%s\n' "$body" | sudo -n tee "$dest" >/dev/null || true
    fi
}

start_powerd() {
    # Localhost helper for Restart / Shut down buttons in the QML nav bar.
    if [ "$(id -u)" -eq 0 ]; then
        pkill -f '/usr/local/bin/devos-installer-powerd' >/dev/null 2>&1 || true
        /usr/local/bin/devos-installer-powerd >/tmp/devos-installer-powerd.log 2>&1 &
    else
        sudo -n pkill -f '/usr/local/bin/devos-installer-powerd' >/dev/null 2>&1 || true
        sudo -n /usr/local/bin/devos-installer-powerd >/tmp/devos-installer-powerd.log 2>&1 &
    fi
}

stop_powerd() {
    if [ "$(id -u)" -eq 0 ]; then
        /usr/local/bin/devos-installer-powerd stop >/dev/null 2>&1 || true
        pkill -f '/usr/local/bin/devos-installer-powerd' >/dev/null 2>&1 || true
    else
        sudo -n /usr/local/bin/devos-installer-powerd stop >/dev/null 2>&1 || true
        sudo -n pkill -f '/usr/local/bin/devos-installer-powerd' >/dev/null 2>&1 || true
    fi
}

run_calamares() {
    # Refresh hardware facts without formatting or mounting any drive.
    if [ "$(id -u)" -eq 0 ]; then
        /usr/local/sbin/devos-storage-probe || true
    else
        sudo -n /usr/local/sbin/devos-storage-probe || true
    fi
    apply_preferred_usertype
    start_powerd

    clamp_installer_window &
    local clamp_pid=$!

    if [ "$(id -u)" -eq 0 ]; then
        calamares "$@"
        local rc=$?
        kill "$clamp_pid" 2>/dev/null || true
        stop_powerd
        return $rc
    fi
    sudo -E -n \
        DISPLAY="${DISPLAY:-:0}" \
        XAUTHORITY="${XAUTHORITY:-}" \
        WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
        QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}" \
        QT_QPA_PLATFORMTHEME=kde \
        QT_STYLE_OVERRIDE=Fusion \
        QT_AUTO_SCREEN_SCALE_FACTOR="${QT_AUTO_SCREEN_SCALE_FACTOR:-0}" \
        QT_ENABLE_HIGHDPI_SCALING="${QT_ENABLE_HIGHDPI_SCALING:-0}" \
        QT_SCALE_FACTOR_ROUNDING_POLICY="${QT_SCALE_FACTOR_ROUNDING_POLICY:-RoundPreferFloor}" \
        calamares "$@"
    local rc=$?
    kill "$clamp_pid" 2>/dev/null || true
    stop_powerd
    return $rc
}

log=/tmp/devos-calamares.log
echo "==> $(date) installer start, kernel: $(uname -r), cmdline: $(cat /proc/cmdline)" >> "$log"
# A relaunch after a crash must not repeat the mode that just crashed.
fails=0
[ -f /run/devos-installer-safe-mode ] && fails=1

# Calamares manages mount changes for the partitions the user selects.
# Do not force-unmount unrelated drives or globally disable swap on launch.

# Ubuntu sudo may spam SELinux chcon noise on systems without labels; keep the
# installer log readable for real Calamares/Qt failures.
append_calamares_log() {
    local tmp pipe_rc
    tmp=$(mktemp /tmp/devos-calamares.XXXXXX)
    "$@" >"$tmp" 2>&1
    pipe_rc=$?
    grep -E -v -i 'chcon:|getfilecon' "$tmp" >>"$log" || true
    rm -f "$tmp"
    return "$pipe_rc"
}

while true; do
    started=$(date +%s)

    if [ "$fails" -eq 0 ]; then
        echo "==> Launching DevOS Installer (Hardware Mode)..." >> "$log"
        append_calamares_log run_calamares "$@"
        rc=$?
    elif [ "$fails" -eq 1 ]; then
        echo "==> Hardware graphics mode exited quickly. Relaunching in Universal Safe Software Mode..." >> "$log"
        export LIBGL_ALWAYS_SOFTWARE=1
        export QT_QUICK_BACKEND=software
        export QMLSCENE_DEVICE=softwarecontext
        append_calamares_log run_calamares -d "$@"
        rc=$?
    else
        echo "==> Launching Calamares in Safe Mode with verbose diagnostics..." >> "$log"
        export LIBGL_ALWAYS_SOFTWARE=1
        export QT_QUICK_BACKEND=software
        export QMLSCENE_DEVICE=softwarecontext
        xhost +local: >/dev/null 2>&1 || true
        xhost + >/dev/null 2>&1 || true
        append_calamares_log run_calamares -d "$@"
        rc=$?
    fi

    ended=$(date +%s)
    duration=$((ended - started))

    if [ "$rc" -eq 0 ] || { [ "$duration" -ge 8 ] && [ "$rc" -lt 128 ] && [ "$rc" -ne 139 ]; }; then
        # Exit code 0, or a long run ended by the user: finished or closed normally.
        echo "Calamares completed or closed normally (exit $rc)." >> "$log"
        break
    fi
    # Crash, abort, or a GPU/QML failure: every relaunch from now on is software rendering.
    echo "Calamares exited with $rc after ${duration}s; switching to safe graphics." >> "$log"
    touch /run/devos-installer-safe-mode 2>/dev/null || true

    fails=$((fails + 1))
    if [ "$fails" -ge 3 ]; then
        echo "Calamares failed to start after $fails attempts. See $log" >>"$log"
        
        # NEVER exit the session! Display recovery interface or interactive terminal.
        if command -v kdialog >/dev/null 2>&1; then
            choice=$(kdialog --title "DevOS Installer Recovery" \
                --menu "The graphical installer encountered a hardware display issue.\nHow would you like to proceed?" \
                safe "Retry with Safe Graphics (Software Rendering)" \
                term "Open Terminal / Shell" \
                part "Open Disk Partition Manager" \
                logs "View Installer Log" \
                reboot "Restart Computer" 2>/dev/null || echo "safe")
            case "$choice" in
                safe)
                    fails=1
                    continue
                    ;;
                term)
                    konsole 2>/dev/null || xterm 2>/dev/null || true
                    fails=1
                    continue
                    ;;
                part)
                    partitionmanager 2>/dev/null || gparted 2>/dev/null || true
                    fails=1
                    continue
                    ;;
                logs)
                    kdialog --textbox "$log" 800 600 2>/dev/null || true
                    fails=1
                    continue
                    ;;
                reboot)
                    systemctl reboot -f 2>/dev/null || reboot
                    ;;
                *)
                    fails=1
                    continue
                    ;;
            esac
        else
            # Fallback if kdialog is unavailable: provide interactive diagnostic console
            konsole -e bash -c '
echo "=========================================================="
echo "          DevOS Installer Recovery Console                "
echo "=========================================================="
echo "The installer encountered an issue starting on this hardware."
echo "Last lines from log (/tmp/devos-calamares.log):"
echo "----------------------------------------------------------"
tail -n 25 /tmp/devos-calamares.log 2>/dev/null || true
echo "----------------------------------------------------------"
echo "Quick Commands:"
echo "  sudo calamares -d     -> Run installer in debug mode"
echo "  sudo partitionmanager -> Check 500GB SSD / disks"
echo "=========================================================="
exec bash
' 2>/dev/null || konsole -e bash 2>/dev/null || xterm -e bash 2>/dev/null || sleep 10
            fails=1
        fi
    fi
    sleep 2
done


