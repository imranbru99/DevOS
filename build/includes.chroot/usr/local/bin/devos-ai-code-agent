#!/bin/bash
# DevOS AI Code Agent Launcher
# Launches the DevOS AI Code Agent experience
set -euo pipefail

# Ensure AI backend or bridge is accessible
AI_DIR="/usr/local/share/devos/components/ai-core"
if [ -f "${AI_DIR}/server.py" ] && ! ss -ltn 2>/dev/null | grep -q ':11434'; then
    (cd "${AI_DIR}" && python3 server.py >/var/tmp/devos-ai-core.log 2>&1 &)
    sleep 0.5
fi

# Prefer local repo components if executed from source checkout
REPO_COMPONENTS="$(dirname "$0")/../../../../../components/code-agent"
if [ -d "${REPO_COMPONENTS}" ]; then
    DIR="$(cd "${REPO_COMPONENTS}" && pwd)"
else
    DIR="/usr/local/share/devos/components/code-agent"
fi

if [ $# -gt 0 ] && [ "$1" = "--cli" ]; then
    shift
    exec /usr/bin/python3 "${DIR}/code_agent.py" "$@"
fi

# Launch the visual DevOS AI Code Agent app
exec /usr/bin/python3 "${DIR}/agent_gui.py" "$@"
