#!/bin/bash
# DevOS AI Code Agent Launcher
# Launches the DevOS AI Code Agent experience
set -euo pipefail

# Ensure AI backend is accessible
AI_DIRS=(
    "${HOME:-}/project/dev-os/components/ai-core"
    "/usr/local/share/devos/components/ai-core"
)
if ! ss -ltn 2>/dev/null | grep -q ':11434'; then
    for AD in "${AI_DIRS[@]}"; do
        if [ -f "${AD}/server.py" ]; then
            (cd "${AD}" && python3 server.py >/var/tmp/devos-ai-core.log 2>&1 &)
            break
        fi
    done
fi

# Prefer local repo components if executed from source checkout or development environment
REPO_COMPONENTS="$(dirname "$0")/../../../../../components/code-agent"
if [ -d "${REPO_COMPONENTS}" ]; then
    DIR="$(cd "${REPO_COMPONENTS}" && pwd)"
elif [ -n "${DEVOS_COMPONENTS_DIR:-}" ] && [ -d "${DEVOS_COMPONENTS_DIR}/code-agent" ]; then
    DIR="${DEVOS_COMPONENTS_DIR}/code-agent"
elif [ -d "${HOME:-}/project/dev-os/components/code-agent" ]; then
    DIR="${HOME:-}/project/dev-os/components/code-agent"
else
    DIR="/usr/local/share/devos/components/code-agent"
fi

if [ $# -gt 0 ] && [ "$1" = "--cli" ]; then
    exec /usr/bin/python3 "${DIR}/code_agent.py" "$@"
fi

# Keep startup failures visible instead of silently disappearing from the desktop.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/devos"
mkdir -p "$STATE_DIR"
LOG_FILE="$STATE_DIR/code-agent.log"
umask 077
if /usr/bin/python3 "${DIR}/agent_gui.py" "$@" >>"$LOG_FILE" 2>&1; then
    exit 0
else
    result=$?
    message="DevOS AI Code Agent stopped (exit $result). Details: $LOG_FILE"
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --error "$message" --title "DevOS AI Code Agent" || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send "DevOS AI Code Agent" "$message" || true
    fi
    exit "$result"
fi
