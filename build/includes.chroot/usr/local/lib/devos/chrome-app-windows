#!/bin/bash
# DEVOS-APP-WINDOWS
# Connecting a Cloud PC is window.open() inside Windows App. Chrome opens that
# as a browser tab unless this is on in the Chrome process that is already
# running, so every launch of Chrome comes through here.
# Also injects Windows-like memory flags when callers bypass devos-browser.
set -u

here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
real="$here/google-chrome.devos-real"
if [ ! -x "$real" ]; then
    echo "DevOS: Chrome's own launcher is missing ($real)." >&2
    exit 1
fi

feature="PwaNavigationCapturing:aux_context_keep_same_container/true"
args=(--ozone-platform=x11 --process-per-site)
ram_gb=$(awk '/^MemTotal:/ {printf "%d", $2/1048576}' /proc/meminfo 2>/dev/null || echo 8)
renderer_limit=8
if [ "$ram_gb" -ge 24 ]; then
    renderer_limit=14
elif [ "$ram_gb" -ge 12 ]; then
    renderer_limit=10
elif [ "$ram_gb" -le 6 ]; then
    renderer_limit=4
fi
args+=("--renderer-process-limit=${renderer_limit}")

# Prefer /dev/shm when there is room; only fall back to /tmp when shm is tiny.
shm_free_kb=$(df -k /dev/shm 2>/dev/null | awk 'NR==2 {print $4}')
if [ -n "${shm_free_kb:-}" ] && [ "$shm_free_kb" -lt 262144 ]; then
    args+=(--disable-dev-shm-usage)
fi

extra=""
for a in "$@"; do
    case "$a" in
        --enable-features=*)
            piece="${a#--enable-features=}"
            if [ -n "$extra" ]; then
                extra="$extra,$piece"
            else
                extra="$piece"
            fi
            ;;
        --process-per-site|--renderer-process-limit=*|--disable-dev-shm-usage|--ozone-platform=*)
            # Already set above / ignore duplicates from wrappers.
            ;;
        *)
            args+=("$a")
            ;;
    esac
done
if [ -n "$extra" ]; then
    feature="$feature,$extra"
fi

# Keep argv0 as "google-chrome" so WM_CLASS stays google-chrome (not
# google-chrome.devos-real). That lets the taskbar match profile launchers
# and show per-profile avatar icons like Windows.
if [ "${#args[@]}" -eq 0 ]; then
    exec -a google-chrome "$real" "--enable-features=$feature"
fi
exec -a google-chrome "$real" "${args[@]}" "--enable-features=$feature"
