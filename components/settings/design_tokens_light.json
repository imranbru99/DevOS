{
  "theme": "DevOS Fluent Light",
  "colors": {
    "background_primary": "#f8fafc",
    "background_secondary": "#f1f5f9",
    "background_surface": "#ffffff",
    "background_acrylic": "rgba(255, 255, 255, 0.85)",
    "accent_primary": "#2563eb",
    "accent_hover": "#1d4ed8",
    "text_primary": "#0f172a",
    "text_secondary": "#475569",
    "border_subtle": "rgba(0, 0, 0, 0.08)",
    "success": "#16a34a",
    "warning": "#d97706",
    "danger": "#dc2626"
  },
  "effects": {
    "backdrop_filter": "blur(24px) saturate(140%)",
    "border_radius_window": "20px",
    "border_radius_card": "12px",
    "border_radius_button": "8px",
    "shadow_elevation": "0 8px 32px rgba(0, 0, 0, 0.12)"
  },
  "typography": {
    "font_ui": "Inter, -apple-system, system-ui, sans-serif",
    "font_code": "Fira Code, JetBrains Mono, monospace",
    "font_size_base": "14px",
    "font_size_heading": "20px"
  },
  "desktop_layout": {
    "taskbar_position": "bottom",
    "taskbar_alignment": "center",
    "start_menu_style": "fluent_grid",
    "file_manager_places": [
      "This PC",
      "DevOS Projects",
      "Downloads",
      "Android Shared",
      "Network"
    ]
  }
}
