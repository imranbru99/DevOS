{
  "theme": "DevOS Fluent Dark",
  "colors": {
    "background_primary": "#0b1020",
    "background_secondary": "#101a2c",
    "background_surface": "#172135",
    "background_acrylic": "rgba(26, 28, 35, 0.78)",
    "accent_primary": "#60a5fa",
    "accent_hover": "#7dd3fc",
    "text_primary": "#f8fafc",
    "text_secondary": "#b9c7db",
    "border_subtle": "rgba(255, 255, 255, 0.08)",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444"
  },
  "effects": {
    "backdrop_filter": "blur(24px) saturate(140%)",
    "border_radius_window": "20px",
    "border_radius_card": "12px",
    "border_radius_button": "8px",
    "shadow_elevation": "0 8px 32px rgba(0, 0, 0, 0.36)"
  },
  "typography": {
    "font_ui": "Inter, -apple-system, system-ui, sans-serif",
    "font_code": "Fira Code, JetBrains Mono, monospace",
    "font_size_base": "14px",
    "font_size_heading": "20px"
  },
  "desktop_layout": {
    "taskbar_position": "bottom",
    "taskbar_alignment": "center",
    "start_menu_style": "fluent_grid",
    "file_manager_places": [
      "This PC",
      "DevOS Projects",
      "Downloads",
      "Android Shared",
      "Network"
    ]
  }
}
